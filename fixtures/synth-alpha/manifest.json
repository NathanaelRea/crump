  "decisions": [
    {
      "id": "wavetable-formats-import-morph-normalization",
      "status": "accepted",
      "disposition": "Exact mono WAV, explicit frame metadata, preserve/global/per-frame peak policy, linear or Catmull-Rom morph."
    },
    {
      "id": "presentation-source-roles",
      "status": "accepted",
      "disposition": "Non-authoritative durable section metadata with custom-topology fallback and exact source sites."
    },
    {
      "id": "resource-ceilings",
      "status": "accepted",
      "disposition": "Independent structural limits plus aggregate admission and qualification-max-v1 probe evidence."
    },
    {
      "id": "oscillator-warp-order",
      "status": "accepted",
      "disposition": "Typed FM/PM/sync, at most two ordered phase warps, table read, AM/ring, then one post-read distortion."
    },
    {
      "id": "filter-palette",
      "status": "candidate_needs_producer_validation",
      "disposition": "Implement and level-match svf_clean and ladder_drive; producer evidence selects the supported palette and defaults."
    },
    {
      "id": "modulation-sources-curves-aux-order",
      "status": "accepted",
      "disposition": "Stable Instrument sources/routes, linear/power/smoothstep, multiplicative auxiliary, macro DAG, explicit ownership tiers."
    },
    {
      "id": "voice-shared-boundary",
      "status": "accepted",
      "disposition": "Explicit graph voice/shared domains with one latency-aligned voice-sum crossing and no shared-to-voice edge."
    },
    {
      "id": "sample-loop-slice-rate-sfz",
      "status": "accepted",
      "disposition": "Normalized half-open regions, explicit loops/slices, repitch only; SFZ import deferred outside initial alpha."
    },
    {
      "id": "granular-algorithm",
      "status": "accepted",
      "disposition": "Sample-accurate density accumulator, fixed grain pool, semantic spawn identity, Hann/triangle/Tukey windows."
    },
    {
      "id": "spectral-algorithm",
      "status": "accepted",
      "disposition": "2048/256 periodic-Hann analysis retaining at most 128 deterministic sinusoidal peaks per frame."
    },
    {
      "id": "missing-creative-processors",
      "status": "deferred_until_demonstrated_gap",
      "disposition": "Reuse current processors; add only when a complete-track patch and listening evidence demonstrate a specific missing capability."
    },
    {
      "id": "starter-content-policy",
      "status": "accepted",
      "disposition": "Original procedural fixture assets under MIT; reference patches and audition phrases remain later content work."
    },
    {
      "id": "producer-reference-hardware-protocol",
      "status": "qualification_input",
      "disposition": "Protocol is fixed; evaluator, lawful reference excerpts, CPU/interface/device IDs are named before qualification and cannot be fabricated in Milestone 0."
    }
  ]
