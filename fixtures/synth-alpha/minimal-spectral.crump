crump-module 2-alpha
asset source-texture "Deterministic source texture" wav "media/sample-source.wav" sha256 "ae8757e2a42ad7602b7bd6825ab0987444677a8e7f8515d0447e86aa01907de9" {
  usage spectral
}
instrument alpha-minimal-spectral "Minimal Spectral" graph {
  polyphony 4
  parameter scan "Scan" ratio 0 1 0 0 modulatable
  faceplate {
    control scan "Scan" "Scans bounded sinusoidal-peak analysis frames" maps scan
  }
  presentation {
    section source-panel sources "Spectral Source" { node source asset source-texture }
  }
  modulation {
    source motion lfo per_voice unipolar sine sync 2bar phase 0 retrigger note one_shot forward
    route scan-motion source motion target scan depth 100% map unipolar curve linear order 0 bypass false
  }
  graph voice 8 {
    node source spectral {
      asset source-texture
      algorithm crump-spectral-peaks-v1
      max_peaks 128
      scan $scan
      rate 0
      tune 0st
      low 80hz
      high 18khz
      transients reset
      phase_randomization 0
      freeze true
      level 0.4
    }
    node output voice_output
    bus pitch note.pitch -> source.pitch
    bus output-audio source.audio -> output.audio
  }
}
