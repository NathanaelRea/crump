crump-module 2-alpha
asset zone-low "Low multisample zone" wav "media/multisample-low.wav" sha256 "5675332919d951ff59291a90b991e596a443e5b368b4360dfca3b157e161a0e0" {
  usage multisample
}
asset zone-high "High multisample zone" wav "media/multisample-high.wav" sha256 "1e3309e6b805299f66308bd603d304387cba4e7affadf63f57d6835e82d5345d" {
  usage multisample
}
instrument alpha-minimal-multisample "Minimal Multisample" graph {
  polyphony 4
  parameter tone "Tone" ratio 0 1 0.5 0.5 macro
  faceplate {
    control tone "Tone" "Scales the mapped source layer" maps tone
  }
  presentation {
    section source-panel sources "Multisample Map" { node source asset zone-low asset zone-high }
  }
  modulation {
    source tone parameter tone instrument unipolar
    source velocity note_velocity per_voice unipolar
    route velocity-tone source velocity target tone depth 20% map unipolar curve linear order 0 bypass false
  }
  graph voice 8 {
    node source multisample {
      zone low asset zone-low keys C1 B3 velocity 0 1 root C3 layer body articulation default round_robin low-rr 0 region 0 24000 gain -3db pan 0
      zone high asset zone-high keys C4 C7 velocity 0 1 root C5 layer body articulation default round_robin high-rr 0 region 0 24000 gain -3db pan 0
      tune 0st
      level $tone
    }
    node output voice_output
    bus pitch note.pitch -> source.pitch
    bus output-audio source.audio -> output.audio
  }
}
