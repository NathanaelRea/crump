crump-module 2
instrument dh-percussion "Deep House Percussion" stock_drums {
  polyphony 16
  parameter tone "Tone" ratio 0 1 0.5 0.6 automatable modulatable
  parameter punch "Punch" ratio 0 1 0.5 0.76 automatable modulatable
  faceplate {
    control tone "Tone" "Balances dark and bright synthesized percussion" maps tone
    control punch "Punch" "Shapes the synthesized kick transient" maps punch
  }
  presentation {
    tags drums percussion deep-house
    preview C2 C5 velocity 45% 95% duration 1beat
  }
}
