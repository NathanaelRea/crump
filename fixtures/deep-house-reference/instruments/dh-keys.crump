crump-module 2
instrument dh-keys "Deep House Multisample Keys" graph {
  polyphony 10
  parameter tone "Tone" ratio 0.15 1 0.58 0.62 automatable modulatable
  parameter start "Texture Start" ratio 0 0.7 0.08 0.12 automatable modulatable
  parameter decay "Decay" seconds 40ms 800ms 220ms 260ms automatable
  faceplate {
    control tone "Tone" "Scales the two exact multisample zones" maps tone
    control start "Texture" "Moves the exact sample-source attack region" maps start
    control decay "Decay" "Shapes the hybrid pluck envelope" maps decay
  }
  presentation {
    tags keys pluck multisample sample
    preview C2 C6 velocity 35% 95% duration 1beat
    section source-panel sources "Multisample and Texture Sources" {
      node source
      node texture
      asset zone-low
      asset zone-high
      asset source-texture
    }
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    route velocity-tone source velocity target tone depth 20% map unipolar curve smoothstep order 0 bypass false
  }
  graph voice 10 {
    node source multisample {
      playback gated
      tune 0st
      rate 1
      velocity_amount 0.22
      level $tone
      pan 0
      zone low asset zone-low keys C1 B3 velocity 0 1 root C3 layer body articulation default round_robin low-rr 0 region 0 24000 gain -4db pan -0.18
      zone high asset zone-high keys C4 C7 velocity 0 1 root C5 layer body articulation default round_robin high-rr 0 region 0 24000 gain -4db pan 0.18
    }
    node texture sample_source {
      asset source-texture
      selected_slice whole
      start $start
      end 0.92
      loop_mode off
      loop_start 0.2
      loop_end 0.8
      loop_crossfade 64
      playback gated
      direction forward
      root C4
      tune 0st
      rate 1
      velocity_amount 0.2
      level 0.2
      pan 0
      slice whole 0 48000
    }
    node sources stereo_mixer a_level 0.86 b_level 0.36
    node envelope envelope mode ahdsr attack 3ms hold 0ms decay $decay sustain 0.28 release 320ms attack_curve 0 decay_curve -0.15 release_curve 0 retrigger always
    node voice-out output
    bus source-pitch note.pitch -> source.pitch
    bus source-gate note.gate -> source.gate
    bus source-velocity note.velocity -> source.velocity
    bus texture-pitch note.pitch -> texture.pitch
    bus texture-gate note.gate -> texture.gate
    bus texture-velocity note.velocity -> texture.velocity
    bus envelope-gate note.gate -> envelope.gate
    bus source-gain envelope.control -> source.gain
    bus texture-gain envelope.control -> texture.gain
    bus multisample-audio source.audio -> sources.a
    bus texture-audio texture.audio -> sources.b
    bus output-audio sources.audio -> voice-out.audio
  }
}
