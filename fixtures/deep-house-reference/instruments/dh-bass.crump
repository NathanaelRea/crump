crump-module 2
instrument dh-bass "Deep House Bass" graph {
  polyphony 1
  voicing mono retrigger legato glide 4ms glide_mode legato note_priority last steal_priority release_oldest seed 7101
  parameter cutoff "Cutoff" hz 70hz 6000hz 1800hz 1800hz automatable modulatable
  parameter drive "Drive" ratio 0 1 0.57 0.57 automatable modulatable
  parameter grit "Grit" ratio 0 1 0.1 0.15 automatable modulatable
  faceplate {
    control cutoff "Cutoff" "Balances the round body and its driven overtones" maps cutoff
    control drive "Drive" "Adds bounded ladder color" maps drive
    control grit "Grit" "Distorts the triangle body before the filter" maps grit
  }
  presentation {
    tags bass deep-house analog mono
    preview A1 A3 velocity 45% 95% duration 1/2beat
    section source-panel sources "Triangle Body and Sine Sub" {
      node sub
      node body
      parameter grit
    }
    section filter-panel filters "Bass Filter" {
      node filter
      parameter cutoff
      parameter drive
    }
  }
  # Patch-matched against an isolated Anjunadeep rolling bass (see
  # docs/research/anjunadeep-measured.md): a near-unison triangle pair with a
  # touch of tanh, a short pluck envelope with no sustain, and a driven ladder
  # left mostly open. The weight comes from saturation on the Track, not the filter.
  modulation {
    source velocity note_velocity per_voice unipolar
    source drift lfo instrument bipolar triangle sync 2bar phase 0
    route velocity-cutoff source velocity target cutoff depth 600hz map unipolar curve smoothstep order 0 bypass false
    route drift-cutoff source drift target cutoff depth 150hz map bipolar curve linear order 10 bypass false
    route velocity-grit source velocity target grit depth 20% map unipolar curve linear order 20 bypass false
  }
  graph voice 10 {
    node sub analog_oscillator {
      waveform sine
      unison 1
      coarse 0st
      fine 0st
      phase 0
      random_phase 0
      detune 0st
      blend 1
      width 0
      drift 0st
      glide 4ms
      velocity_amount 0.1
      level 0.3
      pan 0
    }
    node body analog_oscillator {
      waveform triangle
      unison 2
      coarse 0st
      fine 0st
      phase 0
      random_phase 0.5
      detune 0.015st
      blend 0.99
      width 0.12
      drift 0.03st
      glide 4ms
      velocity_amount 0.3
      level 0.2
      pan 0
      distortion body-grit tanh amount $grit
    }
    node sources stereo_mixer a_level 1 b_level 1
    node envelope envelope mode ahdsr attack 1ms hold 0ms decay 150ms sustain 0.02 release 32ms attack_curve 0 decay_curve -0.3 release_curve 0 retrigger always
    node filter stereo_filter model ladder_drive mode lowpass cutoff $cutoff resonance 0.05 drive $drive mix 1 pan 0 mod_depth 0hz velocity_depth 0hz key_track 0.73 key_reference 110hz
    node voice-out output
    bus sub-pitch note.pitch -> sub.pitch
    bus sub-gain envelope.control -> sub.gain
    bus sub-velocity note.velocity -> sub.velocity
    bus body-pitch note.pitch -> body.pitch
    bus body-gain envelope.control -> body.gain
    bus body-velocity note.velocity -> body.velocity
    bus envelope-gate note.gate -> envelope.gate
    bus source-a sub.audio -> sources.a
    bus source-b body.audio -> sources.b
    bus filter-audio sources.audio -> filter.audio
    bus filter-key note.pitch -> filter.key
    bus filter-velocity note.velocity -> filter.velocity
    bus output-audio filter.audio -> voice-out.audio
  }
}
