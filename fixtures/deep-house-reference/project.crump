    automation perc-tone target instrument/dh-percussion/tone {
      point dark 0bar 0.3 step
    }








    modulation pad-width-drift lfo global bipolar sine sync 8bar target instrument/dh-pad/width depth 8%
    modulation bass-touch lfo per_voice/dh-bass unipolar sine sync 1bar target instrument/dh-bass/drive depth 5%
    modulation echo-feedback-drift lfo global bipolar sine sync 16bar target processor/echo-delay/feedback depth 0.1
    modulation pad-tape-breath lfo global bipolar sine sync 4bar target processor/pad-tape/drive depth 0.3
    modulation room-swell lfo global bipolar sine sync 32bar target processor/room-reverb/decay depth 0.04
    modulation bass-grit-wobble lfo instrument/dh-bass bipolar triangle sync 2bar target instrument/dh-bass/grit depth 12%


    track kick-drums "Kick" instrument dh-kick level -8db pan 0 {
      processor kick-eq eq {
        setting high_pass 32hz
        setting mid1_frequency 450hz
        setting mid1_gain -7db
        setting mid1_q 0.7
        setting mid2_frequency 3.5khz
        setting mid2_gain -1.5db
        setting mid2_q 0.9
      }
      processor kick-crunch saturation {
        setting drive 1.8
        setting mix 0.05
        setting output -1db
        setting mode tape
      }
      processor kick-knock eq {
        setting mid1_frequency 140hz
        setting mid1_gain -5db
        setting mid1_q 0.9
      }
      send kick-room target return/room tap post level -34db
      output group/drums
      clip kick-four-8 pattern kick-four start 8bar duration 8bar mode loop
      clip kick-four-16 pattern kick-four start 16bar duration 14bar mode loop
      clip kick-four-32 pattern kick-four start 32bar duration 14bar mode loop
      clip kick-four-48 pattern kick-four start 48bar duration 8bar mode loop {
        fade 0bar 8bar
      }
      clip kick-four-76 pattern kick-four start 76bar duration 14bar mode loop
      clip kick-four-92 pattern kick-four start 92bar duration 16bar mode loop
      clip kick-four-108 pattern kick-four start 108bar duration 4bar mode loop
    }
    track percussion "Hats and Claps" instrument dh-percussion level 0db pan 0 {
      processor perc-eq eq {
        setting high_pass 280hz
        setting mid1_frequency 4.5khz
        setting mid1_gain -1db
        setting mid1_q 0.9
        setting high_frequency 8khz
        setting high_gain -4db
        setting low_pass 8khz
      }
      processor perc-tame compressor {
        setting detector peak
        setting threshold -20db
        setting ratio 4
        setting attack 0.5ms
        setting release 45ms
        setting knee 3db
        setting makeup 2db
        setting mix 1
      }
      processor perc-grit crusher {
        setting bit_depth 12bit
        setting sample_rate 20khz
        setting reconstruction 0.2
        setting mix 0.25
        setting output 0db
      }
      processor perc-spread modulation_delay {
        setting mode chorus
        setting delay 7ms
        setting depth 1.5ms
        setting rate 0.8hz
        setting feedback 0
        setting mix 0.6
        setting width 0.5
      }
      send percussion-room target return/room tap post level -16db
      output group/drums
      clip hats-8 pattern hats start 8bar duration 8bar mode loop {
        groove loose-hats
      }
      clip groove-hits-16 pattern groove-hits start 16bar duration 14bar mode loop {
        groove loose-hats
      }
      clip hats-30 pattern hats start 30bar duration 2bar mode loop {
        groove loose-hats
        gain -8db
      }
      clip groove-hits-32 pattern groove-hits start 32bar duration 14bar mode loop {
        groove loose-hats
      }
      clip hats-46 pattern hats start 46bar duration 2bar mode loop {
        groove loose-hats
        gain -8db
      }
      clip hats-48 pattern hats start 48bar duration 8bar mode loop {
        groove loose-hats
        fade 0bar 8bar
      }
      clip hats-70 pattern hats start 70bar duration 11/2bar mode loop {
        groove loose-hats
        gain -10db
        fade 4bar 0bar
      }
      clip groove-hits-76 pattern groove-hits start 76bar duration 14bar mode loop {
        groove loose-hats
      }
      clip hats-90 pattern hats start 90bar duration 2bar mode loop {
        groove loose-hats
        gain -8db
      }
      clip groove-hits-92 pattern groove-hits start 92bar duration 16bar mode loop {
        groove loose-hats
      }
      clip hats-108 pattern hats start 108bar duration 4bar mode loop {
        groove loose-hats
      }
    }
    track bass "Sub and Analog Bass" instrument dh-bass level -14db pan 0 {
      processor bass-shape eq {
        setting mid1_frequency 180hz
        setting mid1_gain -3db
        setting mid1_q 0.8
        setting low_pass 380hz
      }
      processor bass-duck compressor {
        setting detector peak
        setting threshold -26db
        setting ratio 3.5
        setting attack 1ms
        setting release 75ms
        setting knee 3db
        setting makeup 0db
        setting mix 1
        sidechain input detector
      }
      processor bass-color saturation {
        setting drive 3.2
        setting mix 0.45
        setting output -1db
        setting mode tape
      }
      send bass-room target return/room tap post level -40db
      output group/music
      clip bass-riff-16 pattern bass-riff start 16bar duration 14bar mode loop {
        groove deep-swing
      }
      clip bass-riff-32 pattern bass-riff start 32bar duration 14bar mode loop {
        groove deep-swing
      }
      clip bass-riff-48 pattern bass-riff start 48bar duration 8bar mode loop {
        groove deep-swing
        fade 0bar 8bar
      }
      clip bass-tease-68 pattern bass-tease start 68bar duration 2bar mode loop
      clip bass-tease-72 pattern bass-tease start 72bar duration 2bar mode loop
      clip bass-riff-76 pattern bass-riff start 76bar duration 14bar mode loop {
        groove deep-swing
      }
      clip bass-riff-92 pattern bass-riff start 92bar duration 16bar mode loop {
        groove deep-swing
      }
      clip bass-riff-108 pattern bass-riff start 108bar duration 2bar mode loop {
        groove deep-swing
        fade 0bar 2bar
      }
    }
    track horn "Swelling Horn" instrument dh-brass level -3db pan 0.1 {
      processor horn-eq eq {
        setting high_pass 250hz
      }
      processor horn-chorus modulation_delay {
        setting mode chorus
        setting delay 10ms
        setting depth 2ms
        setting rate 0.4hz
        setting feedback 0
        setting mix 0.28
        setting width 0.5
      }
      send horn-room target return/room tap post level -8db
      send horn-echo target return/echo tap post level -18db
      output group/music
      clip horn-line-50 pattern horn-line start 50bar duration 16bar mode loop {
        fade 4bar 2bar
      }
      clip horn-line-92 pattern horn-line start 92bar duration 16bar mode loop {
        fade 1bar 2bar
      }
    }
    track pad "Analog Pad" instrument dh-pad level 0db pan 0 {
      processor pad-eq eq {
        setting high_pass 110hz
        setting mid1_frequency 400hz
        setting mid1_gain -4db
        setting mid1_q 0.8
      }
      processor pad-tape saturation {
        setting drive 1.73
        setting mix 0.12
        setting output 0db
        setting mode tape
      }
      processor pad-chorus modulation_delay {
        setting mode chorus
        setting delay 14ms
        setting depth 6.1ms
        setting rate 1.15hz
        setting feedback 0.05
        setting mix 0.7
        setting width 0.5
      }
      send pad-room target return/room tap post level -4db
      output group/music
      clip pad-chords-0 pattern pad-chords start 0bar duration 48bar mode loop
      clip pad-chords-48 pattern pad-chords start 48bar duration 18bar mode loop {
        fade 0bar 2bar
      }
      clip pad-chords-68 pattern pad-chords start 68bar duration 15/2bar mode loop {
        fade 2bar 0bar
      }
      clip pad-chords-76 pattern pad-chords start 76bar duration 40bar mode loop
    }
    track transition "Risers" instrument dh-transition level -18db pan 0 {
      panner stereo_pan -0.8 0.8
      processor transition-eq eq {
        setting high_frequency 7khz
        setting high_gain -5db
        setting low_pass 9khz
      }
      send transition-room target return/room tap post level -12db
      send transition-echo target return/echo tap post level -18db
      output group/music
      clip riser-143-2 pattern riser start 143/2bar duration 4bar mode loop
      clip riser-90 pattern riser start 90bar duration 2bar mode loop
    }

    track sparkle "Soft Pluck" instrument dh-pluck level -16db pan -0.15 {
      panner stereo_pan -0.7 0.7
      processor sparkle-eq eq {
        setting high_pass 100hz
        setting high_frequency 9khz
        setting high_gain -2db
        setting low_pass 1200hz
      }
      processor sparkle-chorus modulation_delay {
        setting mode chorus
        setting delay 8ms
        setting depth 5ms
        setting rate 0.6hz
        setting feedback 0
        setting mix 0.8
        setting width 0.5
      }
      send sparkle-room target return/room tap post level -10db
      send sparkle-echo target return/echo tap post level -9db
      output group/music
      clip ostinato-52 pattern ostinato start 52bar duration 14bar mode loop {
        groove deep-swing
        fade 4bar 2bar
      }
    }
    track toms "Tribal Toms" instrument dh-kick level -17db pan 0 {
      panner stereo_pan -0.5 0.5
      processor toms-eq eq {
        setting high_pass 70hz
        setting mid1_frequency 300hz
        setting mid1_gain -3db
        setting mid1_q 1
      }
      send toms-room target return/room tap post level -14db
      output group/drums
      clip toms-32 pattern toms start 32bar duration 14bar mode loop {
        groove loose-hats
      }
      clip toms-92 pattern toms start 92bar duration 16bar mode loop {
        groove loose-hats
      }
    }
    track ostinato "Octave Saw Ostinato" instrument dh-octave-lead level -10.5db pan 0 {
      panner stereo_pan -0.5 0.5
      processor ostinato-eq eq {
        setting high_pass 180hz
      }
      processor ostinato-chorus modulation_delay {
        setting mode chorus
        setting delay 9ms
        setting depth 3ms
        setting rate 0.5hz
        setting feedback 0
        setting mix 0.35
        setting width 0.6
      }
      send ostinato-room target return/room tap post level -12db
      send ostinato-echo target return/echo tap post level -10db
      output group/music
      clip ostinato-cell-0 pattern ostinato-cell start 0bar duration 8bar mode loop {
        groove deep-swing
      }
      clip ostinato-8 pattern ostinato start 8bar duration 8bar mode loop {
        groove deep-swing
      }
      clip ostinato-16 pattern ostinato start 16bar duration 32bar mode loop {
        groove deep-swing
      }
      clip ostinato-48 pattern ostinato start 48bar duration 8bar mode loop {
        groove deep-swing
        fade 0bar 8bar
      }
      clip ostinato-68 pattern ostinato start 68bar duration 15/2bar mode loop {
        groove deep-swing
        fade 2bar 0bar
      }
      clip ostinato-76 pattern ostinato start 76bar duration 32bar mode loop {
        groove deep-swing
      }
      clip ostinato-108 pattern ostinato start 108bar duration 4bar mode loop {
        groove deep-swing
      }
      clip ostinato-cell-112 pattern ostinato-cell start 112bar duration 4bar mode loop {
        groove deep-swing
      }
    }
    track open-hat "Open Hat" instrument dh-open-hat level -21db pan 0 {
      panner stereo_pan -0.4 0.4
      send open-hat-room target return/room tap post level -18db
      output group/drums
      clip open-hats-16 pattern open-hats start 16bar duration 14bar mode loop {
        groove loose-hats
      }
      clip open-hats-32 pattern open-hats start 32bar duration 14bar mode loop {
        groove loose-hats
      }
      clip open-hats-76 pattern open-hats start 76bar duration 14bar mode loop {
        groove loose-hats
      }
      clip open-hats-92 pattern open-hats start 92bar duration 16bar mode loop {
        groove loose-hats
      }
    }
    group music "Music" level 1db {
      processor music-eq eq {
        setting high_pass 28hz
        setting mid1_frequency 350hz
        setting mid1_gain -3db
        setting mid1_q 0.9
      }
      processor music-pump compressor {
        setting detector peak
        setting threshold -24db
        setting ratio 1.8
        setting attack 12ms
        setting release 160ms
        setting knee 6db
        setting makeup 0db
        setting mix 1
        sidechain input detector
      }
      processor music-color saturation {
        setting drive 1.1
        setting mix 0.12
        setting output -0.5db
        setting mode tape
      }
      output master
    }
    group drums "Drums" level 2db {
      processor drum-color saturation {
        setting drive 1.6
        setting mix 0.4
        setting output -1db
        setting mode tape
      }
      processor drum-glue compressor {
        setting detector rms
        setting threshold -18db
        setting ratio 3
        setting attack 8ms
        setting release 90ms
        setting knee 6db
        setting makeup 2db
        setting mix 0.3
      }
      output master
    }
    return room "Shared Room" level 12db {
      processor room-eq eq {
        setting high_pass 300hz
        setting mid1_frequency 3khz
        setting mid1_gain -2db
        setting mid1_q 0.7
      }
      processor room-reverb reverb {
        setting pre_delay 20ms
        setting diffusion 0.75
        setting decay 0.84
        setting damping 0.6
        setting modulation 0.15
        setting width 1
        setting mix 1
      }
      output master
    }
    return echo "Shared Echo" level -4db {
      processor echo-delay delay {
        setting tempo_sync true
        setting division 1/8d
        setting feedback 0.35
        setting low_pass 4.5khz
        setting high_pass 350hz
        setting mode ping_pong
        setting mix 0.999
      }
      processor echo-dirt saturation {
        setting drive 2
        setting mix 0.5
        setting output -1db
        setting mode tape
      }
      output master
    }
    sidechain kick-detector from track/kick-drums tap post to processor/bass-duck/detector
    sidechain music-pump-key from track/kick-drums tap post to processor/music-pump/detector
    follower kick-motion from track/kick-drums tap post detector peak attack 2ms release 120ms floor -48db ceiling -6db target instrument/dh-bass/cutoff depth -300hz {
      clamp 0 1
    }
    follower kick-room-duck from track/kick-drums tap post detector peak attack 1ms release 160ms floor -40db ceiling -8db target return/room/level depth -5db {
      clamp 0 1
    }
    master level 0db {
      processor master-tape saturation {
        setting drive 1.05
        setting mix 0.1
        setting output 0db
        setting mode tape
      }
      processor master-dc eq {
        setting high_pass 20hz
      }
      processor master-glue compressor {
        setting detector rms
        setting threshold -14db
        setting ratio 1.4
        setting attack 40ms
        setting release 200ms
        setting knee 6db
        setting makeup 3.5db
        setting mix 1
      }
      processor ceiling limiter {
        setting ceiling -1db
        setting release 80ms
        setting lookahead 3ms
      }
    }

    locator intro "Intro" at 0bar
    locator groove-in "Groove In" at 16bar
    locator theme "Theme" at 32bar
    locator break "Break" at 48bar
    locator build "Build" at 68bar
    locator drop "Drop" at 76bar
    locator drop-b "Drop B" at 92bar
    locator turnaround "Turnaround" at 108bar
    locator end "End" at 116bar
  }
}
