crump-module 2
instrument dh-spectral-transform "Deep House Spectral Transform" graph {
  polyphony 3
  parameter scan "Scan" ratio 0 1 0.05 0.18 automatable modulatable
  faceplate {
    control scan "Scan" "Scans the bounded deterministic spectral analysis" maps scan
  }
  presentation {
    tags spectral transformation texture
    preview C2 C5 velocity 35% 85% duration 2beat
    section source-panel sources "Spectral Source" {
      node source
      asset source-texture
    }
  }
  modulation {
    source motion lfo per_voice unipolar sine sync 2bar phase 0 retrigger note one_shot forward
    route scan-motion source motion target scan depth 62% map unipolar curve smoothstep order 0 bypass false
  }
  graph voice 5 {
    node source spectral {
      asset source-texture
      algorithm crump-spectral-peaks-v1
      max_peaks 96
      scan $scan
      rate 0.22
      root C4
      tune 0st
      low 90hz
      high 16khz
      transients suppress
      phase_randomization 0.1
      freeze false
      seed 7901
      level 0.26
    }
    node voice-out output
    bus source-pitch note.pitch -> source.pitch
    bus output-audio source.audio -> voice-out.audio
  }
}
