crump-module 2
instrument dh-open-hat "Deep House Open Hat" graph {
  polyphony 4
  parameter tone "Tone" hz 2000hz 16000hz 8000hz 8000hz automatable modulatable
  faceplate {
    control tone "Tone" "Sets the hat's band centre" maps tone
  }
  presentation {
    tags drums hat percussion noise deep-house
    preview C4 C5 velocity 40% 90% duration 1/4beat
  }
  # A high-passed noise burst for the off-beat open hat: the bounce under the
  # four-on-the-floor kick.
  graph voice 8 {
    node hiss noise level 0.5
    node hiss-amp amplifier level 1
    node hiss-stereo mono_to_stereo
    node envelope envelope mode ahdsr attack 1ms hold 0ms decay 160ms sustain 0 release 120ms attack_curve 0 decay_curve -0.6 release_curve -0.4 retrigger always
    node filter stereo_filter model svf_clean mode highpass cutoff $tone resonance 0.2 drive 0 mix 1 pan 0 mod_depth 0hz velocity_depth 0hz key_track 0 key_reference 261.625565hz
    node voice-out output
    bus hiss-audio hiss.audio -> hiss-amp.audio
    bus hiss-gain envelope.control -> hiss-amp.gain
    bus hiss-wide hiss-amp.audio -> hiss-stereo.audio
    bus envelope-gate note.gate -> envelope.gate
    bus filter-audio hiss-stereo.audio -> filter.audio
    bus output-audio filter.audio -> voice-out.audio
  }
}
