crump-module 2
instrument dh-transition "Deep House Transition" graph {
  polyphony 2
  parameter cutoff "Rise" hz 180hz 16000hz 900hz 400hz automatable modulatable
  parameter noise-level "Noise" ratio 0 1 0.3 0.34 modulatable
  faceplate {
    control cutoff "Rise" "Opens the transition filter" maps cutoff
    control noise-level "Noise" "Blends the procedural noise layer" maps noise-level
  }
  presentation {
    tags transition riser noise
    preview C3 C5 velocity 40% 90% duration 2beat
    section source-panel sources "Tone and Noise" {
      node tone
      node noise
    }
    section effect-panel effects "Shared Rise" {
      node filter
      node echo
    }
  }
  modulation {
    source age note_age per_voice unipolar duration 4s
    route age-noise source age target noise-level depth 40% map unipolar curve power(2) order 10 bypass false
  }
  graph voice 9 {
    node tone analog_oscillator {
      waveform triangle
      unison 2
      coarse 0st
      fine 0st
      phase 0
      random_phase 0.2
      detune 0.1st
      blend 0.8
      width 0.7
      drift 0.02st
      glide 0s
      velocity_amount 0.1
      level 0.08
      pan 0
    }
    node noise noise level $noise-level
    node noise-envelope amplifier level 1
    node noise-stereo mono_to_stereo
    node sources stereo_mixer a_level 0.5 b_level 0.8
    node envelope envelope mode ahdsr attack 2bar hold 0ms decay 1500ms sustain 1 release 1/8beat attack_curve 0.6 decay_curve 0 release_curve -0.3 retrigger always
    node voice-out output
    bus tone-pitch note.pitch -> tone.pitch
    bus tone-gain envelope.control -> tone.gain
    bus noise-audio noise.audio -> noise-envelope.audio
    bus noise-gain envelope.control -> noise-envelope.gain
    bus noise-wide noise-envelope.audio -> noise-stereo.audio
    bus source-a tone.audio -> sources.a
    bus source-b noise-stereo.audio -> sources.b
    bus envelope-gate note.gate -> envelope.gate
    bus output-audio sources.audio -> voice-out.audio
  }
  graph shared 4 {
    node filter stereo_filter model svf_clean mode highpass cutoff $cutoff resonance 0.3 drive 0 mix 1 pan 0 mod_depth 0hz velocity_depth 0hz key_track 0 key_reference 261.625565hz
    node echo delay time 368.85ms feedback 0.3 mix 0.25
    node shared-out output
    bus voice-sum voice_sum.audio -> filter.audio
    bus echo-input filter.audio -> echo.audio
    bus shared-output echo.audio -> shared-out.audio
  }
}
