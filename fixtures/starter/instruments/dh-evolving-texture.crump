crump-module 2
instrument dh-evolving-texture "Deep House Evolving Wavetable Texture" graph {
  polyphony 6
  parameter position "Scan" ratio 0 1 0.15 0.25 automatable modulatable
  parameter width "Width" ratio 0 1 0.55 0.82 automatable modulatable
  faceplate {
    control position "Scan" "Moves across the exact wavetable frames" maps position
    control width "Width" "Spreads the evolving unison layer" maps width
  }
  presentation {
    tags texture evolving wavetable
    preview C2 C5 velocity 35% 85% duration 2beat
    section source-panel sources "Evolving Table" {
      node source
      asset wt-basic
    }
  }
  modulation {
    source scan-lfo lfo instrument bipolar triangle sync 4bar phase 0
    source velocity note_velocity per_voice unipolar
    route table-motion source scan-lfo target position depth 38% map bipolar curve smoothstep order 0 bypass false
    route touch-width source velocity target width depth 12% map unipolar curve linear order 10 bypass false
  }
  graph voice 7 {
    node source wavetable {
      asset wt-basic
      unison 4
      phase 0
      random_phase 0.35
      table_position $position
      detune 0.11st
      blend 0.8
      width $width
      drift 0.02st
      velocity_amount 0.15
      level 0.16
      pan 0
    }
    node envelope envelope mode ahdsr attack 320ms hold 0ms decay 1200ms sustain 0.78 release 1800ms attack_curve 0.1 decay_curve 0 release_curve 0.1 retrigger legato
    node voice-out output
    bus source-pitch note.pitch -> source.pitch
    bus source-gain envelope.control -> source.gain
    bus source-velocity note.velocity -> source.velocity
    bus envelope-gate note.gate -> envelope.gate
    bus output-audio source.audio -> voice-out.audio
  }
}
