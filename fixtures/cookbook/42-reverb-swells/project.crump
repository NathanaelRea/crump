crump 1
project "Cookbook 42 Reverb Swells" {
  id cookbook-42-reverb-swells
  seed 4042
  sample_rate 48000
  render_tail 500ms
  song {
    tempo 240bpm
    meter 4/4
    end 1bar
    instrument drums "Source" stock_drums {
      polyphony 8
      parameter tone "Tone" ratio 0 1 0.5 0.58
      parameter punch "Punch" ratio 0 1 0.5 0.68
      faceplate {
        control tone "Tone" "Controls source brightness" maps tone
        control punch "Punch" "Controls source impact" maps punch
      }
    }
    pattern accents 1bar {
      hit 0beat clap 0.72
      hit 2beat clap 0.68
    }
    automation swell-mix target processor/swell-room/mix {
      point dry 0bar 0 linear
      point crest 2beat 0.7 power(2)
      point end 1bar 0 step
    }
    track source "Reverb Swells" instrument drums level -9db pan 0 {
      processor swell-room reverb {
        setting pre_delay 20ms
        setting diffusion 0.8
        setting decay 0.9
        setting damping 0.45
        setting modulation 0.12
        setting width 1
        setting mix 0
      }
      output master
      clip accent-loop pattern accents start 0bar duration 1bar mode loop
    }
    master level -1db {
      processor ceiling limiter {
        setting ceiling -1db
        setting release 80ms
        setting lookahead 5ms
      }
    }
  }
}
