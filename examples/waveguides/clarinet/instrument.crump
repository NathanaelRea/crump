crump-module 2
instrument clarinet "Clarinet" graph {
  polyphony 4
  parameter level "Level" ratio 0 1 0.5 0.5
  parameter pressure "Breath pressure" ratio 0.3 1.2 0.75 0.75
  parameter breath "Breath noise" ratio 0 0.2 0.04 0.04
  parameter attack "Attack" seconds 0.005s 0.5s 0.03s 0.03s
  parameter release "Release" seconds 0.01s 1s 0.06s 0.06s
  parameter bell "Bell damping" ratio 0 1 0.5 0.5
  parameter tone "Tone" hz 500hz 16000hz 6000hz 6000hz
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control level "Level" "Output level" maps level
    control pressure "Breath pressure" "Mouth pressure against the reed" maps pressure
    control breath "Breath noise" "Turbulence in the breath" maps breath
    control attack "Attack" "How quickly the breath builds" maps attack
    control release "Release" "How quickly the breath stops" maps release
    control bell "Bell damping" "High-frequency loss at the bell reflection" maps bell
    control tone "Tone" "Radiated brightness" maps tone
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 24 {
    # Mouth pressure: a breath envelope plus a little turbulence.
    node blow envelope attack $attack decay 0ms sustain 1 release $release
    node blow-audio to_audio
    node blowing math operation scale amount $pressure
    node turbulence noise level 1
    node rough math operation multiply
    node noisy math operation scale amount $breath
    node mouth math operation add
    # Cylindrical bore: a round trip of half the period. The open bell reflects the
    # pressure wave inverted, so the loop sounds an octave below its length and keeps
    # mostly odd harmonics. The bell filter delays every frequency by one frame.
    node bore delay_line mode pitch ratio 0.5 interpolation lagrange3 tune_compensation 1 max_time 0.05s
    node bell-loss linear_phase_lowpass amount $bell
    node reflect math operation scale amount -0.95
    # Reed: the pressure difference across it sets how far it opens.
    node difference math operation subtract
    node reed shaper {
      curve table
      point closed input -1 output 1
      point open input 5.6666667 output -1
    }
    node flow math operation multiply
    node into-bore math operation add
    # Radiation.
    node dc dc_block cutoff 20hz
    node body lowpass mode lowpass cutoff $tone resonance 0.05
    node gain math operation scale amount $level
    node place pan position $pan
    node out output
    bus gate note.gate -> blow.gate
    bus envelope blow.control -> blow-audio.control
    bus breath-level blow-audio.audio -> blowing.a
    bus noise turbulence.audio -> rough.a
    bus noise-level blowing.audio -> rough.b
    bus noise-depth rough.audio -> noisy.a
    bus steady blowing.audio -> mouth.a
    bus turbulent noisy.audio -> mouth.b
    bus pitch note.pitch -> bore.pitch
    bus returning bore.audio -> bell-loss.audio
    bus damped bell-loss.audio -> reflect.a
    bus reflected reflect.audio -> difference.a
    bus pressing mouth.audio -> difference.b
    bus across difference.audio -> reed.audio
    bus opening reed.audio -> flow.a
    bus driving difference.audio -> flow.b
    bus blown mouth.audio -> into-bore.a
    bus flowing flow.audio -> into-bore.b
    bus bore-in into-bore.audio -> bore.audio
    bus radiate bore.audio -> dc.audio
    bus clean dc.audio -> body.audio
    bus body-out body.audio -> gain.a
    bus level-out gain.audio -> place.audio
    bus output place.audio -> out.audio
  }
}
