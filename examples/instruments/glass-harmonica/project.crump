crump 2
import "instrument.crump"
project "Glass Harmonica" {
  id example-glass-harmonica
  seed 1417501
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C5 2beat 0.48
      note 2beat D5 1beat 0.7
      note 3beat E5 1beat 0.7
      note 4beat G5 3beat 0.92
      note 8beat C5 0.35beat 0.85
      note 8.5beat E5 0.35beat 0.85
      note 9beat G5 0.35beat 0.85
      note 9.5beat C6 0.35beat 0.85
      note 10beat C6 2beat 0.6
      note 12beat G4 3.5beat 0.75
      note 16beat C5 3.5beat 0.62
      note 16beat E5 3.5beat 0.62
      note 16beat G5 3.5beat 0.62
      note 16beat C6 3.5beat 0.62
      note 20beat A4 3.5beat 0.62
      note 20beat C5 3.5beat 0.62
      note 20beat E5 3.5beat 0.62
      note 20beat A5 3.5beat 0.62
      note 24beat F4 3.5beat 0.62
      note 24beat C5 3.5beat 0.62
      note 24beat F5 3.5beat 0.62
      note 24beat A5 3.5beat 0.62
      note 28beat G4 3.5beat 0.62
      note 28beat D5 3.5beat 0.62
      note 28beat G5 3.5beat 0.62
      note 28beat B5 3.5beat 0.62
    }
    track instrument "Glass Harmonica" instrument glass-harmonica level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
