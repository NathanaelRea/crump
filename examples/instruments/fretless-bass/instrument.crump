crump-module 2
instrument fretless-bass "Fretless Bass" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z28-soft-0 asset fretless-bass-28-soft-0 keys E1 G1 velocity 0 0.65 root E1
      zone z28-hard-0 asset fretless-bass-28-hard-0 keys E1 G1 velocity 0.65 1 root E1
      zone z34-soft-0 asset fretless-bass-34-soft-0 keys G#1 C#2 velocity 0 0.65 root A#1
      zone z34-hard-0 asset fretless-bass-34-hard-0 keys G#1 C#2 velocity 0.65 1 root A#1
      zone z40-soft-0 asset fretless-bass-40-soft-0 keys D2 G2 velocity 0 0.65 root E2
      zone z40-hard-0 asset fretless-bass-40-hard-0 keys D2 G2 velocity 0.65 1 root E2
      zone z46-soft-0 asset fretless-bass-46-soft-0 keys G#2 C#3 velocity 0 0.65 root A#2
      zone z46-hard-0 asset fretless-bass-46-hard-0 keys G#2 C#3 velocity 0.65 1 root A#2
      zone z52-soft-0 asset fretless-bass-52-soft-0 keys D3 G3 velocity 0 0.65 root E3
      zone z52-hard-0 asset fretless-bass-52-hard-0 keys D3 G3 velocity 0.65 1 root E3
      zone z58-soft-0 asset fretless-bass-58-soft-0 keys G#3 C#4 velocity 0 0.65 root A#3
      zone z58-hard-0 asset fretless-bass-58-hard-0 keys G#3 C#4 velocity 0.65 1 root A#3
      zone z64-soft-0 asset fretless-bass-64-soft-0 keys D4 G4 velocity 0 0.65 root E4
      zone z64-hard-0 asset fretless-bass-64-hard-0 keys D4 G4 velocity 0.65 1 root E4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
