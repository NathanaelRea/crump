crump-module 2
instrument fm-bell "FM Bell" graph {
  polyphony 12
  voicing poly retrigger always glide 0ms glide_mode always note_priority last steal_priority release_oldest seed 30313
  parameter level "Level" ratio 0 1 0.12 0.12
  parameter index "Index" ratio 0 1 0.45 0.45 automatable modulatable
  parameter decay "Decay" seconds 200ms 8s 3.5s 3.5s automatable
  parameter space "Space" ratio 0 1 0.3 0.3 automatable
  faceplate {
    control index "Index" "Strength of the 3.5:1 modulator: the clang" maps index
    control decay "Decay" "Ring time" maps decay
    control space "Space" "Echo and hall" maps space
    control level "Level" "Output level" maps level
  }
  graph voice 8 {
    node modulator oscillator waveform sine detune 21.6883st glide 0s level 1
    node clang amplifier level 1
    node carrier analog_oscillator {
      waveform sine
      unison 1
      coarse 0st
      fine 0st
      phase 0
      random_phase 0
      pm_depth $index
      velocity_amount 0.5
      level $level
      pan 0
    }
    node amplitude envelope mode ahdsr attack 1ms hold 0ms decay $decay sustain 0 release 2s attack_curve 0 decay_curve -0.6 release_curve -0.3 retrigger always
    node brightness envelope mode ahdsr attack 0ms hold 0ms decay 1.2s sustain 0.08 release 1s attack_curve 0 decay_curve -0.5 release_curve 0 retrigger always
    node out output
    bus modulator-pitch note.pitch -> modulator.pitch
    bus clang-audio modulator.audio -> clang.audio
    bus clang-gain brightness.control -> clang.gain
    bus carrier-pitch note.pitch -> carrier.pitch
    bus carrier-pm clang.audio -> carrier.pm
    bus carrier-gain amplitude.control -> carrier.gain
    bus carrier-velocity note.velocity -> carrier.velocity
    bus amplitude-gate note.gate -> amplitude.gate
    bus brightness-gate note.gate -> brightness.gate
    bus output carrier.audio -> out.audio
  }
  graph shared 8 {
    node echo delay time 187.5ms feedback 0.3 mix $space
    node hall reverb room 0.7 damping 0.5 mix $space
    node shared-out output
    bus voice-sum voice_sum.audio -> echo.audio
    bus echo-hall echo.audio -> hall.audio
    bus shared-output hall.audio -> shared-out.audio
  }
}
