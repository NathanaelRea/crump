crump-module 2
instrument timpani "Timpani" graph {
  polyphony 8
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.2 0.2
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-level note_key per_voice bipolar reference A2 range 12st
    route key-gain-low source key-level target key-gain depth -0.0720685 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth 0.00847851 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 18 {
    # A felt mallet on a tuned kettle's modes.
    node strike1 exciter kind impact contact 0.00217878s hardness $hardness level 1
    node body2 modal_bank profile timpani-kettle max_modes 10 key_track 1 decay_scale $ring brightness 0 level 1
    node hiss3 noise level 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall4 math operation add
    node fall4-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall4-leak math operation scale amount 0.99653379897
    node times5 math operation multiply
    node hi-6 lowpass mode highpass cutoff 200hz resonance 0.308309
    node lo-7 lowpass mode lowpass cutoff 3000hz resonance 0.308309
    node gain8 math operation scale amount 0.034641
    node plus9 math operation add
    node hi-10 lowpass mode highpass cutoff 20hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.113482
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus fall4-audio-fall4-previous-audio fall4.audio -> fall4-previous.audio
    bus onset-audio-fall4-a onset.audio -> fall4.a
    bus fall4-previous-audio-fall4-leak-a fall4-previous.audio -> fall4-leak.a
    bus fall4-leak-audio-fall4-b fall4-leak.audio -> fall4.b
    bus hiss3-audio-times5-a hiss3.audio -> times5.a
    bus fall4-audio-times5-b fall4.audio -> times5.b
    bus times5-audio-hi-6-audio times5.audio -> hi-6.audio
    bus hi-6-audio-lo-7-audio hi-6.audio -> lo-7.audio
    bus lo-7-audio-gain8-a lo-7.audio -> gain8.a
    bus body2-audio-plus9-a body2.audio -> plus9.a
    bus gain8-audio-plus9-b gain8.audio -> plus9.b
    bus plus9-audio-hi-10-audio plus9.audio -> hi-10.audio
    bus hi-10-audio-register-a hi-10.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile timpani-kettle {
  root 261.626hz
  mode m0 frequency 214.533hz decay 0.135s gain 0.8 after_decay 0.135s after_gain 0
  mode m1 frequency 261.626hz decay 1.5s gain 1 after_decay 1.5s after_gain 0
  mode m2 frequency 393.485hz decay 0.93s gain 0.508679 after_decay 0.93s after_gain 0
  mode m3 frequency 518.019hz decay 0.6s gain 0.290832 after_decay 0.6s after_gain 0
  mode m4 frequency 638.366hz decay 0.405s gain 0.174047 after_decay 0.405s after_gain 0
  mode m5 frequency 758.714hz decay 0.285s gain 0.0951195 after_decay 0.285s after_gain 0
  mode m6 frequency 879.062hz decay 0.21s gain 0.0541374 after_decay 0.21s after_gain 0
  mode m7 frequency 994.177hz decay 0.15s gain 0.0312938 after_decay 0.15s after_gain 0
  mode m8 frequency 436.915hz decay 0.18s gain 0.0578856 after_decay 0.18s after_gain 0
  mode m9 frequency 583.425hz decay 0.135s gain 0.0374757 after_decay 0.135s after_gain 0
}
