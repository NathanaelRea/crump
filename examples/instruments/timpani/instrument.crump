crump-module 2
instrument timpani "Timpani" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z36-soft-0 asset timpani-36-soft-0 keys A1 D2 velocity 0 0.65 root C2
      zone z36-hard-0 asset timpani-36-hard-0 keys A1 D2 velocity 0.65 1 root C2
      zone z41-soft-0 asset timpani-41-soft-0 keys D#2 G2 velocity 0 0.65 root F2
      zone z41-hard-0 asset timpani-41-hard-0 keys D#2 G2 velocity 0.65 1 root F2
      zone z46-soft-0 asset timpani-46-soft-0 keys G#2 C3 velocity 0 0.65 root A#2
      zone z46-hard-0 asset timpani-46-hard-0 keys G#2 C3 velocity 0.65 1 root A#2
      zone z51-soft-0 asset timpani-51-soft-0 keys C#3 F3 velocity 0 0.65 root D#3
      zone z51-hard-0 asset timpani-51-hard-0 keys C#3 F3 velocity 0.65 1 root D#3
      zone z56-soft-0 asset timpani-56-soft-0 keys F#3 A#3 velocity 0 0.65 root G#3
      zone z56-hard-0 asset timpani-56-hard-0 keys F#3 A#3 velocity 0.65 1 root G#3
      zone z61-soft-0 asset timpani-61-soft-0 keys B3 E4 velocity 0 0.65 root C#4
      zone z61-hard-0 asset timpani-61-hard-0 keys B3 E4 velocity 0.65 1 root C#4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
