crump-module 2
instrument hoover "Hoover" graph {
  polyphony 6
  voicing poly retrigger always glide 60ms glide_mode legato note_priority last steal_priority release_oldest seed 30309
  parameter level "Level" ratio 0 1 0.04 0.04
  parameter scoop "Scoop" semitones -12st 0st 0st 0st modulatable
  parameter width "Pulse" ratio 0 0.9 0.35 0.35 automatable modulatable
  parameter space "Space" ratio 0 1 0.25 0.25 automatable
  faceplate {
    control width "Pulse" "Pulse-width bite of the detuned stack" maps width
    control space "Space" "Echo and hall" maps space
    control level "Level" "Output level" maps level
  }
  modulation {
    source scoop-envelope port scoop-shape.control per_voice unipolar
    source motion lfo instrument bipolar triangle free 0.6hz phase 0 retrigger transport loop forward
    route rise source scoop-envelope target scoop depth -7st map unipolar curve linear order 0 bypass false
    route pulse-motion source motion target width depth 0.25 map bipolar curve linear order 10 bypass false
  }
  graph voice 11 {
    node stack analog_oscillator {
      waveform saw
      unison 8
      coarse $scoop
      fine 0st
      phase 0
      random_phase 1
      detune 0.45st
      blend 0.85
      width 1
      drift 0.03st
      glide 60ms
      velocity_amount 0.3
      level $level
      pan 0
      warp bite pulse_width amount $width
    }
    node sub analog_oscillator {
      waveform saw
      unison 2
      coarse -12st
      fine 0st
      phase 0
      random_phase 1
      detune 0.1st
      blend 0.7
      width 0.4
      glide 60ms
      level $level
      pan 0
    }
    node sources stereo_mixer a_level 1 b_level 0.45
    node scoop-shape envelope mode ahdsr attack 0ms hold 0ms decay 180ms sustain 0 release 50ms attack_curve 0 decay_curve -0.2 release_curve 0 retrigger always
    node amplitude envelope mode ahdsr attack 8ms hold 0ms decay 300ms sustain 0.85 release 350ms attack_curve 0 decay_curve 0 release_curve 0 retrigger always
    node filter stereo_filter model svf_clean mode lowpass cutoff 5500hz resonance 0.15 drive 0.2 mix 1 pan 0 mod_depth 0hz velocity_depth 1500hz key_track 0.2 key_reference 261.625565hz
    node dc-block stereo_filter model svf_clean mode highpass cutoff 35hz resonance 0 drive 0 mix 1 pan 0 mod_depth 0hz velocity_depth 0hz key_track 0 key_reference 261.625565hz
    node out output
    bus stack-pitch note.pitch -> stack.pitch
    bus stack-gain amplitude.control -> stack.gain
    bus stack-velocity note.velocity -> stack.velocity
    bus sub-pitch note.pitch -> sub.pitch
    bus sub-gain amplitude.control -> sub.gain
    bus scoop-gate note.gate -> scoop-shape.gate
    bus amplitude-gate note.gate -> amplitude.gate
    bus mix-a stack.audio -> sources.a
    bus mix-b sub.audio -> sources.b
    bus filter-audio sources.audio -> filter.audio
    bus filter-key note.pitch -> filter.key
    bus filter-velocity note.velocity -> filter.velocity
    bus dc-audio filter.audio -> dc-block.audio
    bus output dc-block.audio -> out.audio
  }
  graph shared 8 {
    node echo delay time 187.5ms feedback 0.3 mix $space
    node hall reverb room 0.7 damping 0.5 mix $space
    node shared-out output
    bus voice-sum voice_sum.audio -> echo.audio
    bus echo-hall echo.audio -> hall.audio
    bus shared-output hall.audio -> shared-out.audio
  }
}
