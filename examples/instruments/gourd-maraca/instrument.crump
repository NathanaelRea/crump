crump-module 2
instrument gourd-maraca "Gourd Maraca" graph {
  polyphony 4
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 21 {
    # Beads or jingles: a burst of random contacts through small resonant shells.
    node grains1 exciter kind collisions contact 4e-05s hardness 0.5 rate 10000hz duration 0.0771398s attack 0.0364165s level 1
    node gain2 math operation scale amount 1.22787
    node body3 modal_bank profile gourd-maraca-shell max_modes 3 key_track 0 decay_scale $ring brightness 0 level 1
    node gain4 math operation scale amount 2
    node hiss5 noise level 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall6 onepole mode leak time 0.07715s
    node rise7 math operation subtract
    node fall8 onepole mode leak time 0.02474s
    node gain9 math operation scale amount 2.51826
    node times10 math operation multiply
    node hi-11 lowpass mode highpass cutoff 1000hz resonance 0.308309
    node lo-12 lowpass mode lowpass cutoff 16000hz resonance 0.308309
    node gain13 math operation scale amount 0.0234754
    node plus14 math operation add
    node hi-15 lowpass mode highpass cutoff 2395.4hz resonance 0.308309
    node hi-16 lowpass mode highpass cutoff 32hz resonance 0.308309
    node trim math operation scale amount 0.0561645
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-grains1-gate note.gate -> grains1.gate
    bus note-velocity-grains1-velocity note.velocity -> grains1.velocity
    bus grains1-audio-gain2-a grains1.audio -> gain2.a
    bus gain2-audio-body3-audio gain2.audio -> body3.audio
    bus note-pitch-body3-pitch note.pitch -> body3.pitch
    bus note-gate-body3-gate note.gate -> body3.gate
    bus body3-audio-gain4-a body3.audio -> gain4.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus onset-audio-fall6-audio onset.audio -> fall6.audio
    bus fall6-audio-rise7-a fall6.audio -> rise7.a
    bus onset-audio-fall8-audio onset.audio -> fall8.audio
    bus fall8-audio-rise7-b fall8.audio -> rise7.b
    bus rise7-audio-gain9-a rise7.audio -> gain9.a
    bus hiss5-audio-times10-a hiss5.audio -> times10.a
    bus gain9-audio-times10-b gain9.audio -> times10.b
    bus times10-audio-hi-11-audio times10.audio -> hi-11.audio
    bus hi-11-audio-lo-12-audio hi-11.audio -> lo-12.audio
    bus lo-12-audio-gain13-a lo-12.audio -> gain13.a
    bus gain4-audio-plus14-a gain4.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-hi-15-audio plus14.audio -> hi-15.audio
    bus hi-15-audio-hi-16-audio hi-15.audio -> hi-16.audio
    bus hi-16-audio-trim-a hi-16.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile gourd-maraca-shell {
  root 261.626hz
  mode m0 frequency 2892.93hz decay 0.000180832s gain 0.4 after_decay 0.000180832s after_gain 0
  mode m1 frequency 2786.1hz decay 0.000180832s gain 0.4 after_decay 0.000180832s after_gain 0
  mode m2 frequency 4734.97hz decay 0.000180832s gain 0.4 after_decay 0.000180832s after_gain 0
}
