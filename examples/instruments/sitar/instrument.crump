crump-module 2
instrument sitar "Sitar" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z50-soft-0 asset sitar-50-soft-0 keys C3 F3 velocity 0 0.65 root D3
      zone z50-hard-0 asset sitar-50-hard-0 keys C3 F3 velocity 0.65 1 root D3
      zone z56-soft-0 asset sitar-56-soft-0 keys F#3 B3 velocity 0 0.65 root G#3
      zone z56-hard-0 asset sitar-56-hard-0 keys F#3 B3 velocity 0.65 1 root G#3
      zone z62-soft-0 asset sitar-62-soft-0 keys C4 F4 velocity 0 0.65 root D4
      zone z62-hard-0 asset sitar-62-hard-0 keys C4 F4 velocity 0.65 1 root D4
      zone z68-soft-0 asset sitar-68-soft-0 keys F#4 B4 velocity 0 0.65 root G#4
      zone z68-hard-0 asset sitar-68-hard-0 keys F#4 B4 velocity 0.65 1 root G#4
      zone z74-soft-0 asset sitar-74-soft-0 keys C5 G5 velocity 0 0.65 root D5
      zone z74-hard-0 asset sitar-74-hard-0 keys C5 G5 velocity 0.65 1 root D5
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
