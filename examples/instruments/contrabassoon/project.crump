crump 2
import "instrument.crump"
project "Contrabassoon" {
  id example-contrabassoon
  seed 1274959
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat A#1 2beat 0.48
      note 2beat C2 1beat 0.7
      note 3beat D2 1beat 0.7
      note 4beat F2 3beat 0.92
      note 8beat A#1 0.35beat 0.85
      note 8.5beat D2 0.35beat 0.85
      note 9beat F2 0.35beat 0.85
      note 9.5beat A#2 0.35beat 0.85
      note 10beat A#2 2beat 0.6
      note 12beat F1 3.5beat 0.75
      note 16beat A#1 1beat 0.55
      note 17beat C2 1beat 0.6
      note 18beat D2 1beat 0.65
      note 19beat D#2 1beat 0.7
      note 20beat F2 1beat 0.75
      note 21beat G2 1beat 0.8
      note 22beat A2 1beat 0.85
      note 24beat A#2 6beat 0.8
    }
    track instrument "Contrabassoon" instrument contrabassoon level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
