crump-module 2
instrument contrabassoon "Contrabassoon" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z22-soft-0 asset contrabassoon-22-soft-0 keys A#0 C1 velocity 0 0.65 root A#0 loop 48000 125345 crossfade 8160
      zone z22-hard-0 asset contrabassoon-22-hard-0 keys A#0 C1 velocity 0.65 1 root A#0 loop 48000 123699 crossfade 8160
      zone z27-soft-0 asset contrabassoon-27-soft-0 keys C#1 F#1 velocity 0 0.65 root D#1 loop 48000 125292 crossfade 8160
      zone z27-hard-0 asset contrabassoon-27-hard-0 keys C#1 F#1 velocity 0.65 1 root D#1 loop 48000 124059 crossfade 8160
      zone z33-soft-0 asset contrabassoon-33-soft-0 keys G1 C2 velocity 0 0.65 root A1 loop 48000 124233 crossfade 8160
      zone z33-hard-0 asset contrabassoon-33-hard-0 keys G1 C2 velocity 0.65 1 root A1 loop 48000 124233 crossfade 8160
      zone z39-soft-0 asset contrabassoon-39-soft-0 keys C#2 F#2 velocity 0 0.65 root D#2 loop 48000 125916 crossfade 8160
      zone z39-hard-0 asset contrabassoon-39-hard-0 keys C#2 F#2 velocity 0.65 1 root D#2 loop 48000 124064 crossfade 8160
      zone z45-soft-0 asset contrabassoon-45-soft-0 keys G2 C3 velocity 0 0.65 root A2 loop 48000 123806 crossfade 8160
      zone z45-hard-0 asset contrabassoon-45-hard-0 keys G2 C3 velocity 0.65 1 root A2 loop 48000 123806 crossfade 8160
      zone z51-soft-0 asset contrabassoon-51-soft-0 keys C#3 F3 velocity 0 0.65 root D#3 loop 48000 123754 crossfade 8160
      zone z51-hard-0 asset contrabassoon-51-hard-0 keys C#3 F3 velocity 0.65 1 root D#3 loop 48000 123754 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
