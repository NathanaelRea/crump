crump-module 2
instrument contrabassoon "Contrabassoon" graph {
  polyphony 6
  parameter attack "Attack" seconds 0.002s 2s 0.0704855s 0.0704855s modulatable
  parameter release "Release" seconds 0.01s 4s 0.12s 0.12s
  parameter vibrato-depth "Vibrato" ratio 0 1 0 0 modulatable
  parameter noise "Air" ratio 0 4 0 0 modulatable
  parameter register "Register level" ratio 0.05 20 1.54882 1.54882 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0.357143 0.357143 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control vibrato-depth "Vibrato" "Vibrato depth in semitones" maps vibrato-depth
    control noise "Air" "Breath noise level" maps noise
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-from-as0-3 note_key per_voice bipolar reference A#0 range 3st
    source key-from-cs1-3 note_key per_voice bipolar reference C#1 range 3st
    source key-from-e1-3 note_key per_voice bipolar reference E1 range 3st
    source key-from-g1-3 note_key per_voice bipolar reference G1 range 3st
    source key-from-as1-3 note_key per_voice bipolar reference A#1 range 3st
    source key-from-cs2-3 note_key per_voice bipolar reference C#2 range 3st
    source key-from-e2-3 note_key per_voice bipolar reference E2 range 3st
    source key-from-g2-3 note_key per_voice bipolar reference G2 range 3st
    source key-from-as2-3 note_key per_voice bipolar reference A#2 range 3st
    source key-from-cs3-3 note_key per_voice bipolar reference C#3 range 3st
    source key-from-e3-1 note_key per_voice bipolar reference E3 range 1st
    route attack-velocity source velocity target attack depth -0.00161841s map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.09069 map unipolar curve linear order 0 bypass false
    route noise-velocity source velocity target noise depth 0.0144306 map unipolar curve linear order 0 bypass false
    route register-1 source key-from-as0-3 target register depth -0.152448 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-cs1-3 target register depth -0.108119 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-e1-3 target register depth -0.113352 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-g1-3 target register depth -0.0909706 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-as1-3 target register depth -0.0606339 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-cs2-3 target register depth -0.0460558 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-e2-3 target register depth -0.182909 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-g2-3 target register depth 0.00919789 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-as2-3 target register depth -0.142833 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-cs3-3 target register depth 0.0391485 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-e3-1 target register depth 0.0587356 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 0.642857 map unipolar curve linear order 0 bypass false
  }
  graph voice 54 {
    # A breath-driven tone: an oscillator and breath noise through fixed formants.
    node breath envelope mode adsr attack $attack decay 0.15s sustain 0.9 release $release attack_curve 0.3
    node breath-audio to_audio
    node vibrato lfo waveform sine rate 4.5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-fade envelope mode ahdsr attack 0.5s hold 0s decay 0.01s sustain 1 release 0.3s attack_curve 0.6
    node vibrato-fade-audio to_audio
    node vibrato-shape math operation multiply
    node vibrato-amount math operation scale amount $vibrato-depth
    node air noise level 1
    node wander lfo waveform sample_hold rate 2.7hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node wander-audio to_audio
    node wander-smooth onepole mode lowpass cutoff 2.5hz
    node wander-amount math operation scale amount 0.0727273
    node flutter onepole mode lowpass cutoff 18hz
    node flutter-amount math operation scale amount 1.5148
    node pitch-movement sum max_inputs 3
    node reed analog_oscillator waveform saw level 1 velocity_amount 1 fm_depth 1st random_phase 1
    node reed-mono stereo_to_mono
    node brightness lowpass mode lowpass cutoff 200hz resonance 0.1 mod_depth 0hz velocity_depth 1200hz key_track 0.585489 key_reference 261.626hz
    node smear1 biquad mode allpass frequency 142.652hz q 1.5
    node smear2 biquad mode allpass frequency 320.968hz q 1.2
    node smear3 biquad mode allpass frequency 641.936hz q 1
    node smear4 biquad mode allpass frequency 1069.89hz q 0.8
    node air-low biquad mode highpass frequency 150hz q 0.7071
    node air-band biquad mode lowpass frequency 9551.98hz q 0.7071
    node steady-air math operation scale amount 0.5
    node pulsed-air math operation scale amount 1.38366
    node air-drive sum max_inputs 2
    node breath-noise math operation multiply
    node breath-level math operation scale amount $noise
    node voice sum max_inputs 2
    node formant1 biquad mode peak frequency 67.8297hz q 2.5 gain -8.77631db
    node formant2 biquad mode peak frequency 1037.04hz q 2.5 gain -7.04671db
    node formant3 biquad mode peak frequency 298.42hz q 1.95204 gain 10.3073db
    node formant4 biquad mode peak frequency 723.502hz q 1.76895 gain 4.30681db
    node formant5 biquad mode peak frequency 1375.63hz q 1.94887 gain 12.476db
    node formant6 biquad mode peak frequency 3142.12hz q 2.44504 gain 14.988db
    node formant7 biquad mode lowshelf frequency 60hz q 0.7071 gain -15db
    node formant8 biquad mode highshelf frequency 1446.91hz q 0.7071 gain -6.33096db
    node formant9 biquad mode peak frequency 60hz q 1.71047 gain -1.97db
    node formant10 biquad mode peak frequency 164.87hz q 2.5 gain -3.60881db
    node formant11 biquad mode peak frequency 2671.45hz q 0.500001 gain -6.22208db
    node formant12 biquad mode peak frequency 1363.62hz q 2.5 gain 2.37966db
    node below-note biquad mode highpass frequency 104.65hz q 0.7071 key_track 1 key_reference 261.626hz
    node radiation biquad mode highpass frequency 25hz q 0.7071
    node shimmer-depth math operation scale amount 1.00987
    node shimmer math operation offset amount 1
    node alive math operation multiply
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.26374
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-breath-gate note.gate -> breath.gate
    bus breath-control-breath-audio-control breath.control -> breath-audio.control
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-fade-gate note.gate -> vibrato-fade.gate
    bus vibrato-fade-control-vibrato-fade-audio-control vibrato-fade.control -> vibrato-fade-audio.control
    bus vibrato-audio-audio-vibrato-shape-a vibrato-audio.audio -> vibrato-shape.a
    bus vibrato-fade-audio-audio-vibrato-shape-b vibrato-fade-audio.audio -> vibrato-shape.b
    bus vibrato-shape-audio-vibrato-amount-a vibrato-shape.audio -> vibrato-amount.a
    bus wander-control-wander-audio-control wander.control -> wander-audio.control
    bus wander-audio-audio-wander-smooth-audio wander-audio.audio -> wander-smooth.audio
    bus wander-smooth-audio-wander-amount-a wander-smooth.audio -> wander-amount.a
    bus air-audio-flutter-audio air.audio -> flutter.audio
    bus flutter-audio-flutter-amount-a flutter.audio -> flutter-amount.a
    bus vibrato-amount-audio-pitch-movement-inputs vibrato-amount.audio -> pitch-movement.inputs
    bus wander-amount-audio-pitch-movement-inputs wander-amount.audio -> pitch-movement.inputs
    bus flutter-amount-audio-pitch-movement-inputs flutter-amount.audio -> pitch-movement.inputs
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus breath-control-reed-gain breath.control -> reed.gain
    bus pitch-movement-audio-reed-fm pitch-movement.audio -> reed.fm
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus reed-mono-audio-brightness-audio reed-mono.audio -> brightness.audio
    bus breath-control-brightness-mod breath.control -> brightness.mod
    bus note-velocity-brightness-velocity note.velocity -> brightness.velocity
    bus note-pitch-brightness-key note.pitch -> brightness.key
    bus brightness-audio-smear1-audio brightness.audio -> smear1.audio
    bus smear1-audio-smear2-audio smear1.audio -> smear2.audio
    bus smear2-audio-smear3-audio smear2.audio -> smear3.audio
    bus smear3-audio-smear4-audio smear3.audio -> smear4.audio
    bus air-audio-air-low-audio air.audio -> air-low.audio
    bus air-low-audio-air-band-audio air-low.audio -> air-band.audio
    bus breath-audio-audio-steady-air-a breath-audio.audio -> steady-air.a
    bus reed-mono-audio-pulsed-air-a reed-mono.audio -> pulsed-air.a
    bus steady-air-audio-air-drive-inputs steady-air.audio -> air-drive.inputs
    bus pulsed-air-audio-air-drive-inputs pulsed-air.audio -> air-drive.inputs
    bus air-band-audio-breath-noise-a air-band.audio -> breath-noise.a
    bus air-drive-audio-breath-noise-b air-drive.audio -> breath-noise.b
    bus breath-noise-audio-breath-level-a breath-noise.audio -> breath-level.a
    bus smear4-audio-voice-inputs smear4.audio -> voice.inputs
    bus breath-level-audio-voice-inputs breath-level.audio -> voice.inputs
    bus voice-audio-formant1-audio voice.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-formant9-audio formant8.audio -> formant9.audio
    bus formant9-audio-formant10-audio formant9.audio -> formant10.audio
    bus formant10-audio-formant11-audio formant10.audio -> formant11.audio
    bus formant11-audio-formant12-audio formant11.audio -> formant12.audio
    bus formant12-audio-below-note-audio formant12.audio -> below-note.audio
    bus note-pitch-below-note-key note.pitch -> below-note.key
    bus below-note-audio-radiation-audio below-note.audio -> radiation.audio
    bus flutter-audio-shimmer-depth-a flutter.audio -> shimmer-depth.a
    bus shimmer-depth-audio-shimmer-a shimmer-depth.audio -> shimmer.a
    bus radiation-audio-alive-a radiation.audio -> alive.a
    bus shimmer-audio-alive-b shimmer.audio -> alive.b
    bus alive-audio-register-level-a alive.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
