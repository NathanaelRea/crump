crump-module 2
instrument tam-tam "Tam-tam" graph {
  polyphony 2
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 32 {
    # A felt strike on a dense plate, then a slow bloom into its upper modes.
    node hiss1 noise level 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall2 math operation add
    node fall2-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall2-leak math operation scale amount 0.99551010983
    node rise3 math operation subtract
    node fall4 math operation add
    node fall4-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall4-leak math operation scale amount 0.991040378773
    node gain5 math operation scale amount 4
    node times6 math operation multiply
    node lo-7 lowpass mode lowpass cutoff 1278hz resonance 0.308309
    node body8 modal_bank profile tam-tam-plate max_modes 160 key_track 0 decay_scale $ring brightness 0 rise 0.03s level 1
    node gain9 math operation scale amount 0.0183236
    node hiss10 noise level 1
    node fall11 math operation add
    node fall11-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall11-leak math operation scale amount 0.999985119158
    node rise12 math operation subtract
    node fall13 math operation add
    node fall13-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall13-leak math operation scale amount 0.999919381557
    node gain14 math operation scale amount 1.79773
    node times15 math operation multiply
    node body16 modal_bank profile tam-tam-bloom max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain17 math operation scale amount 0.0075139
    node plus18 math operation add
    node hi-19 lowpass mode highpass cutoff 20hz resonance 0.308309
    node trim math operation scale amount 0.201411
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus fall2-audio-fall2-previous-audio fall2.audio -> fall2-previous.audio
    bus onset-audio-fall2-a onset.audio -> fall2.a
    bus fall2-previous-audio-fall2-leak-a fall2-previous.audio -> fall2-leak.a
    bus fall2-leak-audio-fall2-b fall2-leak.audio -> fall2.b
    bus fall2-audio-rise3-a fall2.audio -> rise3.a
    bus fall4-audio-fall4-previous-audio fall4.audio -> fall4-previous.audio
    bus onset-audio-fall4-a onset.audio -> fall4.a
    bus fall4-previous-audio-fall4-leak-a fall4-previous.audio -> fall4-leak.a
    bus fall4-leak-audio-fall4-b fall4-leak.audio -> fall4.b
    bus fall4-audio-rise3-b fall4.audio -> rise3.b
    bus rise3-audio-gain5-a rise3.audio -> gain5.a
    bus hiss1-audio-times6-a hiss1.audio -> times6.a
    bus gain5-audio-times6-b gain5.audio -> times6.b
    bus times6-audio-lo-7-audio times6.audio -> lo-7.audio
    bus lo-7-audio-body8-audio lo-7.audio -> body8.audio
    bus note-pitch-body8-pitch note.pitch -> body8.pitch
    bus note-gate-body8-gate note.gate -> body8.gate
    bus body8-audio-gain9-a body8.audio -> gain9.a
    bus fall11-audio-fall11-previous-audio fall11.audio -> fall11-previous.audio
    bus onset-audio-fall11-a onset.audio -> fall11.a
    bus fall11-previous-audio-fall11-leak-a fall11-previous.audio -> fall11-leak.a
    bus fall11-leak-audio-fall11-b fall11-leak.audio -> fall11.b
    bus fall11-audio-rise12-a fall11.audio -> rise12.a
    bus fall13-audio-fall13-previous-audio fall13.audio -> fall13-previous.audio
    bus onset-audio-fall13-a onset.audio -> fall13.a
    bus fall13-previous-audio-fall13-leak-a fall13-previous.audio -> fall13-leak.a
    bus fall13-leak-audio-fall13-b fall13-leak.audio -> fall13.b
    bus fall13-audio-rise12-b fall13.audio -> rise12.b
    bus rise12-audio-gain14-a rise12.audio -> gain14.a
    bus hiss10-audio-times15-a hiss10.audio -> times15.a
    bus gain14-audio-times15-b gain14.audio -> times15.b
    bus times15-audio-body16-audio times15.audio -> body16.audio
    bus note-pitch-body16-pitch note.pitch -> body16.pitch
    bus note-gate-body16-gate note.gate -> body16.gate
    bus body16-audio-gain17-a body16.audio -> gain17.a
    bus gain9-audio-plus18-a gain9.audio -> plus18.a
    bus gain17-audio-plus18-b gain17.audio -> plus18.b
    bus plus18-audio-hi-19-audio plus18.audio -> hi-19.audio
    bus hi-19-audio-trim-a hi-19.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
