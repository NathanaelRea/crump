crump 2
import "instrument.crump"
project "Music Box" {
  id example-music-box
  seed 1108660
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat G5 0.25beat 0.92
      note 4beat G5 2beat 0.48
      note 8beat C5 0.5beat 0.85
      note 10beat D6 0.25beat 0.65
      note 12beat G6 0.75beat 0.8
      note 16beat G5 0.4beat 0.75
      note 16.5beat B5 0.4beat 0.75
      note 17beat D6 0.4beat 0.75
      note 17.5beat G6 0.4beat 0.75
      note 18beat B6 0.4beat 0.75
      note 18.5beat G6 0.4beat 0.75
      note 19beat D6 0.4beat 0.75
      note 19.5beat B5 0.4beat 0.75
      note 24beat G5 0.2beat 0.55
      note 24.25beat A5 0.2beat 0.6
      note 24.5beat B5 0.2beat 0.65
      note 24.75beat C6 0.2beat 0.55
      note 25beat D6 0.2beat 0.6
      note 25.25beat E6 0.2beat 0.65
      note 25.5beat F#6 0.2beat 0.55
      note 25.75beat G6 0.2beat 0.6
    }
    track instrument "Music Box" instrument music-box level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
