crump-module 2
instrument music-box "Music Box" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z62-soft-0 asset music-box-62-soft-0 keys C4 F4 velocity 0 0.65 root D4
      zone z62-hard-0 asset music-box-62-hard-0 keys C4 F4 velocity 0.65 1 root D4
      zone z68-soft-0 asset music-box-68-soft-0 keys F#4 B4 velocity 0 0.65 root G#4
      zone z68-hard-0 asset music-box-68-hard-0 keys F#4 B4 velocity 0.65 1 root G#4
      zone z74-soft-0 asset music-box-74-soft-0 keys C5 F5 velocity 0 0.65 root D5
      zone z74-hard-0 asset music-box-74-hard-0 keys C5 F5 velocity 0.65 1 root D5
      zone z80-soft-0 asset music-box-80-soft-0 keys F#5 B5 velocity 0 0.65 root G#5
      zone z80-hard-0 asset music-box-80-hard-0 keys F#5 B5 velocity 0.65 1 root G#5
      zone z86-soft-0 asset music-box-86-soft-0 keys C6 F6 velocity 0 0.65 root D6
      zone z86-hard-0 asset music-box-86-hard-0 keys C6 F6 velocity 0.65 1 root D6
      zone z92-soft-0 asset music-box-92-soft-0 keys F#6 C7 velocity 0 0.65 root G#6
      zone z92-hard-0 asset music-box-92-hard-0 keys F#6 C7 velocity 0.65 1 root G#6
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
