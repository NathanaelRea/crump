crump-module 2
instrument machine-hat "Machine Hat" graph {
  polyphony 4
  parameter hold-tone1 "Fixed pitch" semitones -48st 48st -4.19724st -4.19724st modulatable
  parameter hold-tone2 "Fixed pitch" semitones -48st 48st 2.62158st 2.62158st modulatable
  parameter hold-tone3 "Fixed pitch" semitones -48st 48st 5.98153st 5.98153st modulatable
  parameter hold-tone4 "Fixed pitch" semitones -48st 48st 11.9818st 11.9818st modulatable
  parameter hold-tone5 "Fixed pitch" semitones -48st 48st 12.5455st 12.5455st modulatable
  parameter hold-tone6 "Fixed pitch" semitones -48st 48st 19.35st 19.35st modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-position note_key per_voice bipolar reference C4 range 48st
    route hold-tone1-key source key-position target hold-tone1 depth -48st map bipolar curve linear order 0 bypass false
    route hold-tone2-key source key-position target hold-tone2 depth -48st map bipolar curve linear order 0 bypass false
    route hold-tone3-key source key-position target hold-tone3 depth -48st map bipolar curve linear order 0 bypass false
    route hold-tone4-key source key-position target hold-tone4 depth -48st map bipolar curve linear order 0 bypass false
    route hold-tone5-key source key-position target hold-tone5 depth -48st map bipolar curve linear order 0 bypass false
    route hold-tone6-key source key-position target hold-tone6 depth -48st map bipolar curve linear order 0 bypass false
  }
  graph voice 45 {
    # A drum-machine voice: swept sine, square clusters, noise and click.
    node tone1 analog_oscillator waveform square coarse $hold-tone1 level 1.11072
    node tone1-mono stereo_to_mono
    node tone2 analog_oscillator waveform square coarse $hold-tone2 level 1.11072
    node tone2-mono stereo_to_mono
    node tone3 analog_oscillator waveform square coarse $hold-tone3 level 1.11072
    node tone3-mono stereo_to_mono
    node tone4 analog_oscillator waveform square coarse $hold-tone4 level 1.11072
    node tone4-mono stereo_to_mono
    node tone5 analog_oscillator waveform square coarse $hold-tone5 level 1.11072
    node tone5-mono stereo_to_mono
    node tone6 analog_oscillator waveform square coarse $hold-tone6 level 1.11072
    node tone6-mono stereo_to_mono
    node mix7 sum max_inputs 6
    node hi-8 lowpass mode highpass cutoff 6500hz resonance 0.308309
    node lo-9 lowpass mode lowpass cutoff 18000hz resonance 0.308309
    node hi-10 lowpass mode highpass cutoff 6500hz resonance 0.308309
    node lo-11 lowpass mode lowpass cutoff 18000hz resonance 0.308309
    node gain12 math operation scale amount 0.79812
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall13 math operation add
    node fall13-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall13-leak math operation scale amount 0.99895887568
    node gain14 math operation scale amount 0.8
    node fall15 math operation add
    node fall15-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall15-leak math operation scale amount 0.999652838052
    node gain16 math operation scale amount 0.2
    node plus17 math operation add
    node times18 math operation multiply
    node hiss19 noise level 1
    node rise20 math operation subtract
    node fall21 math operation add
    node fall21-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall21-leak math operation scale amount 0.958190821638
    node gain22 math operation scale amount 1.12472
    node times23 math operation multiply
    node hi-24 lowpass mode highpass cutoff 9000hz resonance 0.308309
    node lo-25 lowpass mode lowpass cutoff 18000hz resonance 0.308309
    node gain26 math operation scale amount 1.12493
    node plus27 math operation add
    node hi-28 lowpass mode highpass cutoff 32hz resonance 0.308309
    node trim math operation scale amount 0.107118
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-pitch-tone1-pitch note.pitch -> tone1.pitch
    bus tone1-audio-tone1-mono-audio tone1.audio -> tone1-mono.audio
    bus note-pitch-tone2-pitch note.pitch -> tone2.pitch
    bus tone2-audio-tone2-mono-audio tone2.audio -> tone2-mono.audio
    bus note-pitch-tone3-pitch note.pitch -> tone3.pitch
    bus tone3-audio-tone3-mono-audio tone3.audio -> tone3-mono.audio
    bus note-pitch-tone4-pitch note.pitch -> tone4.pitch
    bus tone4-audio-tone4-mono-audio tone4.audio -> tone4-mono.audio
    bus note-pitch-tone5-pitch note.pitch -> tone5.pitch
    bus tone5-audio-tone5-mono-audio tone5.audio -> tone5-mono.audio
    bus note-pitch-tone6-pitch note.pitch -> tone6.pitch
    bus tone6-audio-tone6-mono-audio tone6.audio -> tone6-mono.audio
    bus tone1-mono-audio-mix7-inputs tone1-mono.audio -> mix7.inputs
    bus tone2-mono-audio-mix7-inputs tone2-mono.audio -> mix7.inputs
    bus tone3-mono-audio-mix7-inputs tone3-mono.audio -> mix7.inputs
    bus tone4-mono-audio-mix7-inputs tone4-mono.audio -> mix7.inputs
    bus tone5-mono-audio-mix7-inputs tone5-mono.audio -> mix7.inputs
    bus tone6-mono-audio-mix7-inputs tone6-mono.audio -> mix7.inputs
    bus mix7-audio-hi-8-audio mix7.audio -> hi-8.audio
    bus hi-8-audio-lo-9-audio hi-8.audio -> lo-9.audio
    bus lo-9-audio-hi-10-audio lo-9.audio -> hi-10.audio
    bus hi-10-audio-lo-11-audio hi-10.audio -> lo-11.audio
    bus lo-11-audio-gain12-a lo-11.audio -> gain12.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus fall13-audio-fall13-previous-audio fall13.audio -> fall13-previous.audio
    bus onset-audio-fall13-a onset.audio -> fall13.a
    bus fall13-previous-audio-fall13-leak-a fall13-previous.audio -> fall13-leak.a
    bus fall13-leak-audio-fall13-b fall13-leak.audio -> fall13.b
    bus fall13-audio-gain14-a fall13.audio -> gain14.a
    bus fall15-audio-fall15-previous-audio fall15.audio -> fall15-previous.audio
    bus onset-audio-fall15-a onset.audio -> fall15.a
    bus fall15-previous-audio-fall15-leak-a fall15-previous.audio -> fall15-leak.a
    bus fall15-leak-audio-fall15-b fall15-leak.audio -> fall15.b
    bus fall15-audio-gain16-a fall15.audio -> gain16.a
    bus gain14-audio-plus17-a gain14.audio -> plus17.a
    bus gain16-audio-plus17-b gain16.audio -> plus17.b
    bus gain12-audio-times18-a gain12.audio -> times18.a
    bus plus17-audio-times18-b plus17.audio -> times18.b
    bus fall13-audio-rise20-a fall13.audio -> rise20.a
    bus fall21-audio-fall21-previous-audio fall21.audio -> fall21-previous.audio
    bus onset-audio-fall21-a onset.audio -> fall21.a
    bus fall21-previous-audio-fall21-leak-a fall21-previous.audio -> fall21-leak.a
    bus fall21-leak-audio-fall21-b fall21-leak.audio -> fall21.b
    bus fall21-audio-rise20-b fall21.audio -> rise20.b
    bus rise20-audio-gain22-a rise20.audio -> gain22.a
    bus hiss19-audio-times23-a hiss19.audio -> times23.a
    bus gain22-audio-times23-b gain22.audio -> times23.b
    bus times23-audio-hi-24-audio times23.audio -> hi-24.audio
    bus hi-24-audio-lo-25-audio hi-24.audio -> lo-25.audio
    bus lo-25-audio-gain26-a lo-25.audio -> gain26.a
    bus times18-audio-plus27-a times18.audio -> plus27.a
    bus gain26-audio-plus27-b gain26.audio -> plus27.b
    bus plus27-audio-hi-28-audio plus27.audio -> hi-28.audio
    bus hi-28-audio-trim-a hi-28.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
