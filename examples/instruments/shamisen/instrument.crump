crump-module 2
instrument shamisen "Shamisen" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.92733746 0.92733746 modulatable
  parameter room "Room" ratio 0 1 0.12 0.12
  parameter register "Register level" ratio 0.05 20 0.933254 0.933254 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-from-c1-12 note_key per_voice bipolar reference C1 range 12st
    source key-from-c2-12 note_key per_voice bipolar reference C2 range 12st
    source key-from-c3-12 note_key per_voice bipolar reference C3 range 12st
    source key-from-c4-12 note_key per_voice bipolar reference C4 range 12st
    source key-from-c5-12 note_key per_voice bipolar reference C5 range 12st
    source key-from-c6-12 note_key per_voice bipolar reference C6 range 12st
    source key-from-c7-12 note_key per_voice bipolar reference C7 range 12st
    source key-from-c3-3 note_key per_voice bipolar reference C3 range 3st
    source key-from-ds3-3 note_key per_voice bipolar reference D#3 range 3st
    source key-from-fs3-3 note_key per_voice bipolar reference F#3 range 3st
    source key-from-a3-3 note_key per_voice bipolar reference A3 range 3st
    source key-from-c4-3 note_key per_voice bipolar reference C4 range 3st
    source key-from-ds4-3 note_key per_voice bipolar reference D#4 range 3st
    source key-from-fs4-3 note_key per_voice bipolar reference F#4 range 3st
    source key-from-a4-3 note_key per_voice bipolar reference A4 range 3st
    source key-from-c5-3 note_key per_voice bipolar reference C5 range 3st
    source key-from-ds5-3 note_key per_voice bipolar reference D#5 range 3st
    source key-from-fs5-3 note_key per_voice bipolar reference F#5 range 3st
    source velocity note_velocity per_voice unipolar
    route sustain-1 source key-from-c1-12 target sustain depth 0.035646166 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-2 source key-from-c2-12 target sustain depth 0.013443161 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-3 source key-from-c3-12 target sustain depth 0.0085989143 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-4 source key-from-c4-12 target sustain depth 0.0041448669 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-5 source key-from-c5-12 target sustain depth 0.0030021313 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-6 source key-from-c6-12 target sustain depth 0.0039059639 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route sustain-7 source key-from-c7-12 target sustain depth 0.0019587445 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-1 source key-from-c3-3 target register depth -0.0316832 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-ds3-3 target register depth 0.0984289 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-fs3-3 target register depth -0.0667457 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-a3-3 target register depth -0.148019 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-c4-3 target register depth 0.274018 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-ds4-3 target register depth -0.0592537 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-fs4-3 target register depth 0.109175 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-a4-3 target register depth 0.689696 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-c5-3 target register depth -0.250054 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-ds5-3 target register depth -0.593824 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-fs5-3 target register depth 0.092136 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 49 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.0004s hardness 0.8 level 1
    node released onepole mode leak time 0.003s
    node released-dc dc_block cutoff 25hz
    node finger lowpass mode lowpass cutoff 3000hz resonance 0.05 velocity_depth 8000hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.1 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node string delay_line mode pitch ratio 1 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node twang envelope mode adsr attack 0s decay 0.08s sustain 0 release 0.08s decay_curve -0.6
    node twang-audio to_audio
    node twang-velocity math operation multiply
    node velocity-audio to_audio
    node twang-amount math operation scale amount -0.00461032
    node bridge math operation add
    node loss linear_phase_lowpass amount 0.25
    node return math operation scale amount $sustain
    node bridge-dc dc_block cutoff 20hz
    node jawari shaper curve asymmetric drive 4 bias 0 asymmetry 0.7
    node jawari-dc dc_block cutoff 30hz
    node bridge-clean math operation scale amount 0.6
    node bridge-buzz math operation scale amount 0.1
    node bridge-out math operation add
    node body modal_bank profile shamisen-body max_modes 14 key_track 0 decay_scale 1 brightness 0 level 1
    node direct math operation scale amount 0.4
    node wood math operation scale amount 0.6
    node radiated math operation add
    node scrape noise level 1
    node knock-env envelope mode adsr attack 0.001s decay 0.12s sustain 0 release 0.12s decay_curve -0.7
    node knock-env-audio to_audio
    node knock-low biquad mode highpass frequency 150hz q 0.7071
    node knock-band biquad mode lowpass frequency 6000hz q 0.7071
    node knock-burst math operation multiply
    node knock-velocity math operation multiply
    node knock-level math operation scale amount 0.02
    node with-knock math operation add
    node formant1 biquad mode peak frequency 820.967hz q 1.05699 gain 13.5321db
    node formant2 biquad mode peak frequency 3276.43hz q 2.5 gain 6.49094db
    node formant3 biquad mode peak frequency 821.122hz q 1.057 gain 13.5321db
    node formant4 biquad mode peak frequency 2168.57hz q 2.14484 gain 9.95874db
    node formant5 biquad mode peak frequency 1559.21hz q 2.5 gain -8.72792db
    node formant6 biquad mode peak frequency 8089.85hz q 1.31029 gain -13.0092db
    node formant7 biquad mode lowshelf frequency 999.999hz q 0.7071 gain 4.91526db
    node formant8 biquad mode highshelf frequency 7433.18hz q 0.7071 gain -8.7595db
    node radiation biquad mode highpass frequency 50hz q 0.7071
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.0868812
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus pluck-audio-released-audio pluck.audio -> released.audio
    bus released-audio-released-dc-audio released.audio -> released-dc.audio
    bus released-dc-audio-finger-audio released-dc.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus note-gate-twang-gate note.gate -> twang.gate
    bus twang-control-twang-audio-control twang.control -> twang-audio.control
    bus twang-audio-audio-twang-velocity-a twang-audio.audio -> twang-velocity.a
    bus note-velocity-velocity-audio-control note.velocity -> velocity-audio.control
    bus velocity-audio-audio-twang-velocity-b velocity-audio.audio -> twang-velocity.b
    bus twang-velocity-audio-twang-amount-a twang-velocity.audio -> twang-amount.a
    bus twang-amount-audio-string-time-mod twang-amount.audio -> string.time_mod
    bus plucked-audio-bridge-a plucked.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus loss-audio-return-a loss.audio -> return.a
    bus string-audio-bridge-dc-audio string.audio -> bridge-dc.audio
    bus bridge-dc-audio-jawari-audio bridge-dc.audio -> jawari.audio
    bus jawari-audio-jawari-dc-audio jawari.audio -> jawari-dc.audio
    bus bridge-dc-audio-bridge-clean-a bridge-dc.audio -> bridge-clean.a
    bus jawari-dc-audio-bridge-buzz-a jawari-dc.audio -> bridge-buzz.a
    bus bridge-clean-audio-bridge-out-a bridge-clean.audio -> bridge-out.a
    bus bridge-buzz-audio-bridge-out-b bridge-buzz.audio -> bridge-out.b
    bus bridge-out-audio-body-audio bridge-out.audio -> body.audio
    bus note-pitch-body-pitch note.pitch -> body.pitch
    bus note-gate-body-gate note.gate -> body.gate
    bus bridge-out-audio-direct-a bridge-out.audio -> direct.a
    bus body-audio-wood-a body.audio -> wood.a
    bus direct-audio-radiated-a direct.audio -> radiated.a
    bus wood-audio-radiated-b wood.audio -> radiated.b
    bus note-gate-knock-env-gate note.gate -> knock-env.gate
    bus knock-env-control-knock-env-audio-control knock-env.control -> knock-env-audio.control
    bus scrape-audio-knock-low-audio scrape.audio -> knock-low.audio
    bus knock-low-audio-knock-band-audio knock-low.audio -> knock-band.audio
    bus knock-band-audio-knock-burst-a knock-band.audio -> knock-burst.a
    bus knock-env-audio-audio-knock-burst-b knock-env-audio.audio -> knock-burst.b
    bus knock-burst-audio-knock-velocity-a knock-burst.audio -> knock-velocity.a
    bus velocity-audio-audio-knock-velocity-b velocity-audio.audio -> knock-velocity.b
    bus knock-velocity-audio-knock-level-a knock-velocity.audio -> knock-level.a
    bus radiated-audio-with-knock-a radiated.audio -> with-knock.a
    bus knock-level-audio-with-knock-b knock-level.audio -> with-knock.b
    bus with-knock-audio-formant1-audio with-knock.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-radiation-audio formant8.audio -> radiation.audio
    bus radiation-audio-register-level-a radiation.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
  graph shared 2 {
    node room-reverb reverb room 0.35 damping 0.6 mix $room
    node shared-out output
    bus voice-sum voice_sum.audio -> room-reverb.audio
    bus shared-output room-reverb.audio -> shared-out.audio
  }
}
profile shamisen-body {
  root 261.626hz
  mode m0 frequency 240hz decay 0.0160997s gain 0.00181163 after_decay 0.0160997s after_gain 0
  mode m1 frequency 384hz decay 0.0134164s gain 0.00248452 after_decay 0.0134164s after_gain 0
  mode m2 frequency 520hz decay 0.0120748s gain 0.00276058 after_decay 0.0120748s after_gain 0
  mode m3 frequency 552hz decay 0.0120748s gain 0.00241551 after_decay 0.0120748s after_gain 0
  mode m4 frequency 704hz decay 0.0107331s gain 0.00349386 after_decay 0.0107331s after_gain 0
  mode m5 frequency 840hz decay 0.00939149s gain 0.00443664 after_decay 0.00939149s after_gain 0
  mode m6 frequency 992hz decay 0.00804984s gain 0.00517608 after_decay 0.00804984s after_gain 0
  mode m7 frequency 1200hz decay 0.0067082s gain 0.0062113 after_decay 0.0067082s after_gain 0
  mode m8 frequency 1400hz decay 0.00603738s gain 0.0062113 after_decay 0.00603738s after_gain 0
  mode m9 frequency 1680hz decay 0.00536656s gain 0.0062113 after_decay 0.00536656s after_gain 0
  mode m10 frequency 2000hz decay 0.00469574s gain 0.0062113 after_decay 0.00469574s after_gain 0
  mode m11 frequency 2400hz decay 0.00402492s gain 0.0062113 after_decay 0.00402492s after_gain 0
  mode m12 frequency 2880hz decay 0.0033541s gain 0.0062113 after_decay 0.0033541s after_gain 0
  mode m13 frequency 3440hz decay 0.00268328s gain 0.0062113 after_decay 0.00268328s after_gain 0
}
