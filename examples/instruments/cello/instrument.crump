crump-module 2
instrument cello "Cello" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.45s 0.45s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z36-soft-0 asset cello-36-soft-0 keys C2 D2 velocity 0 0.65 root C2 loop 48000 124401 crossfade 8160
      zone z36-hard-0 asset cello-36-hard-0 keys C2 D2 velocity 0.65 1 root C2 loop 48000 123668 crossfade 8160
      zone z41-soft-0 asset cello-41-soft-0 keys D#2 G2 velocity 0 0.65 root F2 loop 48000 123771 crossfade 8160
      zone z41-hard-0 asset cello-41-hard-0 keys D#2 G2 velocity 0.65 1 root F2 loop 48000 123771 crossfade 8160
      zone z46-soft-0 asset cello-46-soft-0 keys G#2 C#3 velocity 0 0.65 root A#2 loop 48000 125758 crossfade 8160
      zone z46-hard-0 asset cello-46-hard-0 keys G#2 C#3 velocity 0.65 1 root A#2 loop 48000 125759 crossfade 8160
      zone z52-soft-0 asset cello-52-soft-0 keys D3 G3 velocity 0 0.65 root E3 loop 48000 123712 crossfade 8160
      zone z52-hard-0 asset cello-52-hard-0 keys D3 G3 velocity 0.65 1 root E3 loop 48000 123712 crossfade 8160
      zone z58-soft-0 asset cello-58-soft-0 keys G#3 C#4 velocity 0 0.65 root A#3 loop 48000 123726 crossfade 8160
      zone z58-hard-0 asset cello-58-hard-0 keys G#3 C#4 velocity 0.65 1 root A#3 loop 48000 123725 crossfade 8160
      zone z64-soft-0 asset cello-64-soft-0 keys D4 G4 velocity 0 0.65 root E4 loop 48000 125933 crossfade 8160
      zone z64-hard-0 asset cello-64-hard-0 keys D4 G4 velocity 0.65 1 root E4 loop 48000 125932 crossfade 8160
      zone z70-soft-0 asset cello-70-soft-0 keys G#4 C#5 velocity 0 0.65 root A#4 loop 48000 125984 crossfade 8160
      zone z70-hard-0 asset cello-70-hard-0 keys G#4 C#5 velocity 0.65 1 root A#4 loop 48000 125983 crossfade 8160
      zone z76-soft-0 asset cello-76-soft-0 keys D5 A5 velocity 0 0.65 root E5 loop 48000 123665 crossfade 8160
      zone z76-hard-0 asset cello-76-hard-0 keys D5 A5 velocity 0.65 1 root E5 loop 48000 123665 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
