crump 2
import "instrument.crump"
project "Chip Square" {
  id example-chip-square
  seed 783981
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C5 1beat 0.75
      note 1beat D#5 1beat 0.75
      note 2beat G5 1.5beat 0.75
      note 3.5beat A#5 0.5beat 0.75
      note 4beat C6 3beat 0.75
      note 8beat D#6 0.5beat 0.75
      note 8.5beat D6 0.5beat 0.75
      note 9beat C6 0.5beat 0.75
      note 9.5beat A#5 0.5beat 0.75
      note 10beat C6 2beat 0.75
      note 12beat G5 1beat 0.75
      note 13beat A#5 1beat 0.75
      note 14beat D#5 2beat 0.75
      note 16beat C5 0.35beat 0.85
      note 16.5beat D#5 0.35beat 0.85
      note 17beat G5 0.35beat 0.85
      note 17.5beat A#5 0.35beat 0.85
      note 18beat C6 0.35beat 0.85
      note 18.5beat A#5 0.35beat 0.85
      note 19beat G5 0.35beat 0.85
      note 19.5beat D#5 0.35beat 0.85
      note 20beat C5 0.35beat 0.85
      note 20.5beat D#5 0.35beat 0.85
      note 21beat G5 0.35beat 0.85
      note 21.5beat A#5 0.35beat 0.85
      note 22beat C6 0.35beat 0.85
      note 22.5beat A#5 0.35beat 0.85
      note 23beat G5 0.35beat 0.85
      note 23.5beat D#5 0.35beat 0.85
      note 24beat C6 6beat 0.8
    }
    track instrument "Chip Square" instrument chip-square level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
