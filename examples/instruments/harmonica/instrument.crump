crump-module 2
instrument harmonica "Harmonica" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.003s 1s 0.0779041s 0.0779041s modulatable
  parameter release "Release" seconds 0.01s 3s 0.08s 0.08s
  parameter pressure "Breath" ratio 0 2 0.673477 0.673477 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "How quickly the note stops" maps release
    control pressure "Breath" "Breath pressure: louder and brighter" maps pressure
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    route attack-velocity source velocity target attack depth -0.0179041s map unipolar curve linear order 0 bypass false
    route pressure-velocity source velocity target pressure depth 0.0563173 map unipolar curve linear order 0 bypass false
  }
  graph voice 37 {
    # A free reed: air passes only while the swinging reed is open.
    node blow envelope mode adsr attack $attack decay 0.08s sustain 1 release $release attack_curve 0.3
    node blow-audio to_audio
    node pressure math operation scale amount $pressure
    node swell lfo waveform sample_hold rate 3.1hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node swell-audio to_audio
    node swell-smooth onepole mode lowpass cutoff 4hz
    node gain1 math operation scale amount 0.02
    node swell-depth math operation scale amount 1
    node swell-gain math operation offset amount 1
    node pressure-live math operation multiply
    node reed1 analog_oscillator waveform sine coarse 0st level 1.41421 phase 0 random_phase 0.2
    node reed1-mono stereo_to_mono
    node reed1-swing math operation multiply
    node reed1-gap shaper curve one_sided drive 1 bias -0.389993
    node reed1-flow math operation multiply
    node reed2 analog_oscillator waveform sine coarse 0.06st level 1.41421 phase 0.37 random_phase 0.2
    node reed2-mono stereo_to_mono
    node reed2-swing math operation multiply
    node reed2-gap shaper curve one_sided drive 1 bias -0.389993
    node reed2-flow math operation multiply
    node reeds math operation add
    node breath-noise noise level 1
    node breath-noise-band biquad mode bandpass frequency 3464.1hz q 0.532939
    node times2 math operation multiply
    node breath-noise-level math operation scale amount 0.0465617
    node with-breath math operation add
    node radiate dc_block cutoff 30hz
    node body1 biquad mode peak frequency 659.257hz q 5.95481 gain 1.7966db
    node body2 biquad mode peak frequency 3732.92hz q 2.73481 gain 12db
    node body3 biquad mode peak frequency 9888.83hz q 2.9173 gain 12db
    node body4 biquad mode highshelf frequency 4700.25hz q 0.7071 gain -4.77095db
    node radiation biquad mode lowpass frequency 8159.51hz q 0.7071
    node sub-cut biquad mode highpass frequency 234.446hz q 0.7071 key_track 1 key_reference 261.626hz
    node trim math operation scale amount 0.521477
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-blow-gate note.gate -> blow.gate
    bus blow-control-blow-audio-control blow.control -> blow-audio.control
    bus blow-audio-audio-pressure-a blow-audio.audio -> pressure.a
    bus swell-control-swell-audio-control swell.control -> swell-audio.control
    bus swell-audio-audio-swell-smooth-audio swell-audio.audio -> swell-smooth.audio
    bus swell-smooth-audio-gain1-a swell-smooth.audio -> gain1.a
    bus gain1-audio-swell-depth-a gain1.audio -> swell-depth.a
    bus swell-depth-audio-swell-gain-a swell-depth.audio -> swell-gain.a
    bus pressure-audio-pressure-live-a pressure.audio -> pressure-live.a
    bus swell-gain-audio-pressure-live-b swell-gain.audio -> pressure-live.b
    bus note-pitch-reed1-pitch note.pitch -> reed1.pitch
    bus reed1-audio-reed1-mono-audio reed1.audio -> reed1-mono.audio
    bus reed1-mono-audio-reed1-swing-a reed1-mono.audio -> reed1-swing.a
    bus pressure-live-audio-reed1-swing-b pressure-live.audio -> reed1-swing.b
    bus reed1-swing-audio-reed1-gap-audio reed1-swing.audio -> reed1-gap.audio
    bus reed1-gap-audio-reed1-flow-a reed1-gap.audio -> reed1-flow.a
    bus pressure-live-audio-reed1-flow-b pressure-live.audio -> reed1-flow.b
    bus note-pitch-reed2-pitch note.pitch -> reed2.pitch
    bus reed2-audio-reed2-mono-audio reed2.audio -> reed2-mono.audio
    bus reed2-mono-audio-reed2-swing-a reed2-mono.audio -> reed2-swing.a
    bus pressure-live-audio-reed2-swing-b pressure-live.audio -> reed2-swing.b
    bus reed2-swing-audio-reed2-gap-audio reed2-swing.audio -> reed2-gap.audio
    bus reed2-gap-audio-reed2-flow-a reed2-gap.audio -> reed2-flow.a
    bus pressure-live-audio-reed2-flow-b pressure-live.audio -> reed2-flow.b
    bus reed1-flow-audio-reeds-a reed1-flow.audio -> reeds.a
    bus reed2-flow-audio-reeds-b reed2-flow.audio -> reeds.b
    bus breath-noise-audio-breath-noise-band-audio breath-noise.audio -> breath-noise-band.audio
    bus breath-noise-band-audio-times2-a breath-noise-band.audio -> times2.a
    bus pressure-live-audio-times2-b pressure-live.audio -> times2.b
    bus times2-audio-breath-noise-level-a times2.audio -> breath-noise-level.a
    bus reeds-audio-with-breath-a reeds.audio -> with-breath.a
    bus breath-noise-level-audio-with-breath-b breath-noise-level.audio -> with-breath.b
    bus with-breath-audio-radiate-audio with-breath.audio -> radiate.audio
    bus radiate-audio-body1-audio radiate.audio -> body1.audio
    bus body1-audio-body2-audio body1.audio -> body2.audio
    bus body2-audio-body3-audio body2.audio -> body3.audio
    bus body3-audio-body4-audio body3.audio -> body4.audio
    bus body4-audio-radiation-audio body4.audio -> radiation.audio
    bus radiation-audio-sub-cut-audio radiation.audio -> sub-cut.audio
    bus note-pitch-sub-cut-key note.pitch -> sub-cut.key
    bus sub-cut-audio-trim-a sub-cut.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
