crump-module 2
instrument harmonica "Harmonica" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.1s 0.1s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset harmonica-60-soft-0 keys C4 D#4 velocity 0 0.65 root C4 loop 48000 124656 crossfade 8160
      zone z60-hard-0 asset harmonica-60-hard-0 keys C4 D#4 velocity 0.65 1 root C4 loop 48000 125941 crossfade 8160
      zone z66-soft-0 asset harmonica-66-soft-0 keys E4 A4 velocity 0 0.65 root F#4 loop 48000 123608 crossfade 8160
      zone z66-hard-0 asset harmonica-66-hard-0 keys E4 A4 velocity 0.65 1 root F#4 loop 48000 125816 crossfade 8160
      zone z72-soft-0 asset harmonica-72-soft-0 keys A#4 D#5 velocity 0 0.65 root C5 loop 48000 125976 crossfade 8160
      zone z72-hard-0 asset harmonica-72-hard-0 keys A#4 D#5 velocity 0.65 1 root C5 loop 48000 125792 crossfade 8160
      zone z78-soft-0 asset harmonica-78-soft-0 keys E5 A5 velocity 0 0.65 root F#5 loop 48000 125941 crossfade 8160
      zone z78-hard-0 asset harmonica-78-hard-0 keys E5 A5 velocity 0.65 1 root F#5 loop 48000 125953 crossfade 8160
      zone z84-soft-0 asset harmonica-84-soft-0 keys A#5 D#6 velocity 0 0.65 root C6 loop 48000 125994 crossfade 8160
      zone z84-hard-0 asset harmonica-84-hard-0 keys A#5 D#6 velocity 0.65 1 root C6 loop 48000 123697 crossfade 8160
      zone z90-soft-0 asset harmonica-90-soft-0 keys E6 A6 velocity 0 0.65 root F#6 loop 48000 125985 crossfade 8160
      zone z90-hard-0 asset harmonica-90-hard-0 keys E6 A6 velocity 0.65 1 root F#6 loop 48000 125987 crossfade 8160
      zone z96-soft-0 asset harmonica-96-soft-0 keys A#6 C7 velocity 0 0.65 root C7 loop 48000 123962 crossfade 8160
      zone z96-hard-0 asset harmonica-96-hard-0 keys A#6 C7 velocity 0.65 1 root C7 loop 48000 124683 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
