crump-module 2
instrument trumpet "Trumpet" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.12s 0.12s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z54-soft-0 asset trumpet-54-soft-0 keys E3 G#3 velocity 0 0.65 root F#3 loop 48000 123855 crossfade 8160
      zone z54-hard-0 asset trumpet-54-hard-0 keys E3 G#3 velocity 0.65 1 root F#3 loop 48000 123854 crossfade 8160
      zone z59-soft-0 asset trumpet-59-soft-0 keys A3 C#4 velocity 0 0.65 root B3 loop 48000 125905 crossfade 8160
      zone z59-hard-0 asset trumpet-59-hard-0 keys A3 C#4 velocity 0.65 1 root B3 loop 48000 125904 crossfade 8160
      zone z64-soft-0 asset trumpet-64-soft-0 keys D4 F#4 velocity 0 0.65 root E4 loop 48000 124603 crossfade 8160
      zone z64-hard-0 asset trumpet-64-hard-0 keys D4 F#4 velocity 0.65 1 root E4 loop 48000 125915 crossfade 8160
      zone z69-soft-0 asset trumpet-69-soft-0 keys G4 B4 velocity 0 0.65 root A4 loop 48000 123608 crossfade 8160
      zone z69-hard-0 asset trumpet-69-hard-0 keys G4 B4 velocity 0.65 1 root A4 loop 48000 125900 crossfade 8160
      zone z74-soft-0 asset trumpet-74-soft-0 keys C5 E5 velocity 0 0.65 root D5 loop 48000 124722 crossfade 8160
      zone z74-hard-0 asset trumpet-74-hard-0 keys C5 E5 velocity 0.65 1 root D5 loop 48000 123660 crossfade 8160
      zone z79-soft-0 asset trumpet-79-soft-0 keys F5 A5 velocity 0 0.65 root G5 loop 48000 125398 crossfade 8160
      zone z79-hard-0 asset trumpet-79-hard-0 keys F5 A5 velocity 0.65 1 root G5 loop 48000 123620 crossfade 8160
      zone z84-soft-0 asset trumpet-84-soft-0 keys A#5 F6 velocity 0 0.65 root C6 loop 48000 125974 crossfade 8160
      zone z84-hard-0 asset trumpet-84-hard-0 keys A#5 F6 velocity 0.65 1 root C6 loop 48000 123636 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
