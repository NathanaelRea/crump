crump 2
import "instrument.crump"
project "Trumpet" {
  id example-trumpet
  seed 578087
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat G4 2beat 0.48
      note 2beat A4 1beat 0.7
      note 3beat B4 1beat 0.7
      note 4beat D5 3beat 0.92
      note 8beat G4 0.35beat 0.85
      note 8.5beat B4 0.35beat 0.85
      note 9beat D5 0.35beat 0.85
      note 9.5beat G5 0.35beat 0.85
      note 10beat G5 2beat 0.6
      note 12beat D4 3.5beat 0.75
      note 16beat G4 1beat 0.55
      note 17beat A4 1beat 0.6
      note 18beat B4 1beat 0.65
      note 19beat C5 1beat 0.7
      note 20beat D5 1beat 0.75
      note 21beat E5 1beat 0.8
      note 22beat F#5 1beat 0.85
      note 24beat G5 6beat 0.8
    }
    track instrument "Trumpet" instrument trumpet level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
