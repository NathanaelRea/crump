crump-module 2
instrument clarinet "Clarinet" graph {
  polyphony 6
  parameter attack "Attack" seconds 0.003s 1s 0.106756s 0.106756s modulatable
  parameter release "Release" seconds 0.01s 3s 0.12s 0.12s
  parameter pressure "Breath" ratio 0 2 0.895335 0.895335 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "How quickly the note stops" maps release
    control pressure "Breath" "Breath pressure: louder and brighter" maps pressure
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    route attack-velocity source velocity target attack depth -0.0699744s map unipolar curve linear order 0 bypass false
    route pressure-velocity source velocity target pressure depth -0.241603 map unipolar curve linear order 0 bypass false
  }
  graph voice 35 {
    # A reed on a bore: breath pushes against the reed, the bore answers.
    node blow envelope mode adsr attack $attack decay 0.08s sustain 1 release $release attack_curve 0.3
    node blow-audio to_audio
    node pressure math operation scale amount $pressure
    node swell lfo waveform sample_hold rate 3.1hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node swell-audio to_audio
    node swell-smooth onepole mode lowpass cutoff 4hz
    node gain1 math operation scale amount 0.02
    node swell-depth math operation scale amount 1
    node swell-gain math operation offset amount 1
    node pressure-live math operation multiply
    node breath-noise noise level 1
    node breath-noise-band biquad mode bandpass frequency 2190.89hz q 0.421325
    node times2 math operation multiply
    node breath-noise-level math operation scale amount 0.0784024
    node mouth math operation add
    node bore delay_line mode pitch ratio 0.5 interpolation lagrange3 tune_compensation 1 max_time 0.1s mod_depth 1
    node bell linear_phase_lowpass amount 0.90236
    node reflect math operation scale amount -0.952248
    node across math operation subtract
    node reed shaper {
      curve table
      drive 1
      bias 0
      point closed input -1 output 1
      point open input 2 output -1
    }
    node flow math operation multiply
    node into-bore math operation add
    node radiate dc_block cutoff 20hz
    node flow-out math operation scale amount 0.465006
    node radiated math operation add
    node body1 biquad mode peak frequency 262.129hz q 0.4 gain -12db
    node body2 biquad mode peak frequency 437.509hz q 5.99354 gain 3.72803db
    node body3 biquad mode peak frequency 5616.19hz q 1.17529 gain -8.81196db
    node body4 biquad mode highshelf frequency 4681.83hz q 0.7071 gain -11.9951db
    node radiation biquad mode lowpass frequency 2627.7hz q 0.7071
    node sub-cut biquad mode highpass frequency 173.419hz q 0.7071 key_track 1 key_reference 261.626hz
    node trim math operation scale amount 0.436792
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-blow-gate note.gate -> blow.gate
    bus blow-control-blow-audio-control blow.control -> blow-audio.control
    bus blow-audio-audio-pressure-a blow-audio.audio -> pressure.a
    bus swell-control-swell-audio-control swell.control -> swell-audio.control
    bus swell-audio-audio-swell-smooth-audio swell-audio.audio -> swell-smooth.audio
    bus swell-smooth-audio-gain1-a swell-smooth.audio -> gain1.a
    bus gain1-audio-swell-depth-a gain1.audio -> swell-depth.a
    bus swell-depth-audio-swell-gain-a swell-depth.audio -> swell-gain.a
    bus pressure-audio-pressure-live-a pressure.audio -> pressure-live.a
    bus swell-gain-audio-pressure-live-b swell-gain.audio -> pressure-live.b
    bus breath-noise-audio-breath-noise-band-audio breath-noise.audio -> breath-noise-band.audio
    bus breath-noise-band-audio-times2-a breath-noise-band.audio -> times2.a
    bus pressure-live-audio-times2-b pressure-live.audio -> times2.b
    bus times2-audio-breath-noise-level-a times2.audio -> breath-noise-level.a
    bus pressure-live-audio-mouth-a pressure-live.audio -> mouth.a
    bus breath-noise-level-audio-mouth-b breath-noise-level.audio -> mouth.b
    bus note-pitch-bore-pitch note.pitch -> bore.pitch
    bus bore-audio-bell-audio bore.audio -> bell.audio
    bus bell-audio-reflect-a bell.audio -> reflect.a
    bus reflect-audio-across-a reflect.audio -> across.a
    bus mouth-audio-across-b mouth.audio -> across.b
    bus across-audio-reed-audio across.audio -> reed.audio
    bus reed-audio-flow-a reed.audio -> flow.a
    bus across-audio-flow-b across.audio -> flow.b
    bus mouth-audio-into-bore-a mouth.audio -> into-bore.a
    bus flow-audio-into-bore-b flow.audio -> into-bore.b
    bus into-bore-audio-bore-audio into-bore.audio -> bore.audio
    bus flow-audio-flow-out-a flow.audio -> flow-out.a
    bus bore-audio-radiated-a bore.audio -> radiated.a
    bus flow-out-audio-radiated-b flow-out.audio -> radiated.b
    bus radiated-audio-radiate-audio radiated.audio -> radiate.audio
    bus radiate-audio-body1-audio radiate.audio -> body1.audio
    bus body1-audio-body2-audio body1.audio -> body2.audio
    bus body2-audio-body3-audio body2.audio -> body3.audio
    bus body3-audio-body4-audio body3.audio -> body4.audio
    bus body4-audio-radiation-audio body4.audio -> radiation.audio
    bus radiation-audio-sub-cut-audio radiation.audio -> sub-cut.audio
    bus note-pitch-sub-cut-key note.pitch -> sub-cut.key
    bus sub-cut-audio-trim-a sub-cut.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
