crump-module 2
instrument clarinet "Clarinet" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z50-soft-0 asset clarinet-50-soft-0 keys C#3 E3 velocity 0 0.65 root D3 loop 48000 123771 crossfade 8160
      zone z50-hard-0 asset clarinet-50-hard-0 keys C#3 E3 velocity 0.65 1 root D3 loop 48000 123771 crossfade 8160
      zone z55-soft-0 asset clarinet-55-soft-0 keys F3 A3 velocity 0 0.65 root G3 loop 48000 123726 crossfade 8160
      zone z55-hard-0 asset clarinet-55-hard-0 keys F3 A3 velocity 0.65 1 root G3 loop 48000 123719 crossfade 8160
      zone z60-soft-0 asset clarinet-60-soft-0 keys A#3 D4 velocity 0 0.65 root C4 loop 48000 125901 crossfade 8160
      zone z60-hard-0 asset clarinet-60-hard-0 keys A#3 D4 velocity 0.65 1 root C4 loop 48000 125905 crossfade 8160
      zone z65-soft-0 asset clarinet-65-soft-0 keys D#4 G4 velocity 0 0.65 root F4 loop 48000 124515 crossfade 8160
      zone z65-hard-0 asset clarinet-65-hard-0 keys D#4 G4 velocity 0.65 1 root F4 loop 48000 124515 crossfade 8160
      zone z70-soft-0 asset clarinet-70-soft-0 keys G#4 C#5 velocity 0 0.65 root A#4 loop 48000 125983 crossfade 8160
      zone z70-hard-0 asset clarinet-70-hard-0 keys G#4 C#5 velocity 0.65 1 root A#4 loop 48000 123615 crossfade 8160
      zone z76-soft-0 asset clarinet-76-soft-0 keys D5 G5 velocity 0 0.65 root E5 loop 48000 125406 crossfade 8160
      zone z76-hard-0 asset clarinet-76-hard-0 keys D5 G5 velocity 0.65 1 root E5 loop 48000 125115 crossfade 8160
      zone z82-soft-0 asset clarinet-82-soft-0 keys G#5 C#6 velocity 0 0.65 root A#5 loop 48000 123616 crossfade 8160
      zone z82-hard-0 asset clarinet-82-hard-0 keys G#5 C#6 velocity 0.65 1 root A#5 loop 48000 124231 crossfade 8160
      zone z88-soft-0 asset clarinet-88-soft-0 keys D6 A#6 velocity 0 0.65 root E6 loop 48000 123624 crossfade 8160
      zone z88-hard-0 asset clarinet-88-hard-0 keys D6 A#6 velocity 0.65 1 root E6 loop 48000 125992 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
