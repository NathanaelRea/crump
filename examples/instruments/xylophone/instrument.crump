crump-module 2
instrument xylophone "Xylophone" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z65-soft-0 asset xylophone-65-soft-0 keys E4 G4 velocity 0 0.65 root F4
      zone z65-hard-0 asset xylophone-65-hard-0 keys E4 G4 velocity 0.65 1 root F4
      zone z70-soft-0 asset xylophone-70-soft-0 keys G#4 C5 velocity 0 0.65 root A#4
      zone z70-hard-0 asset xylophone-70-hard-0 keys G#4 C5 velocity 0.65 1 root A#4
      zone z75-soft-0 asset xylophone-75-soft-0 keys C#5 F5 velocity 0 0.65 root D#5
      zone z75-hard-0 asset xylophone-75-hard-0 keys C#5 F5 velocity 0.65 1 root D#5
      zone z80-soft-0 asset xylophone-80-soft-0 keys F#5 B5 velocity 0 0.65 root G#5
      zone z80-hard-0 asset xylophone-80-hard-0 keys F#5 B5 velocity 0.65 1 root G#5
      zone z86-soft-0 asset xylophone-86-soft-0 keys C6 F6 velocity 0 0.65 root D6
      zone z86-hard-0 asset xylophone-86-hard-0 keys C6 F6 velocity 0.65 1 root D6
      zone z92-soft-0 asset xylophone-92-soft-0 keys F#6 B6 velocity 0 0.65 root G#6
      zone z92-hard-0 asset xylophone-92-hard-0 keys F#6 B6 velocity 0.65 1 root G#6
      zone z98-soft-0 asset xylophone-98-soft-0 keys C7 F7 velocity 0 0.65 root D7
      zone z98-hard-0 asset xylophone-98-hard-0 keys C7 F7 velocity 0.65 1 root D7
      zone z104-soft-0 asset xylophone-104-soft-0 keys F#7 C8 velocity 0 0.65 root G#7
      zone z104-hard-0 asset xylophone-104-hard-0 keys F#7 C8 velocity 0.65 1 root G#7
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
