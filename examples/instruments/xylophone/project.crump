crump 2
import "instrument.crump"
project "Xylophone" {
  id example-xylophone
  seed 688953
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat F5 0.25beat 0.92
      note 4beat F5 2beat 0.48
      note 8beat A#4 0.5beat 0.85
      note 10beat C6 0.25beat 0.65
      note 12beat F6 0.75beat 0.8
      note 16beat F5 0.4beat 0.75
      note 16.5beat A5 0.4beat 0.75
      note 17beat C6 0.4beat 0.75
      note 17.5beat F6 0.4beat 0.75
      note 18beat A6 0.4beat 0.75
      note 18.5beat F6 0.4beat 0.75
      note 19beat C6 0.4beat 0.75
      note 19.5beat A5 0.4beat 0.75
      note 24beat F5 0.2beat 0.55
      note 24.25beat G5 0.2beat 0.6
      note 24.5beat A5 0.2beat 0.65
      note 24.75beat A#5 0.2beat 0.55
      note 25beat C6 0.2beat 0.6
      note 25.25beat D6 0.2beat 0.65
      note 25.5beat E6 0.2beat 0.55
      note 25.75beat F6 0.2beat 0.6
    }
    track instrument "Xylophone" instrument xylophone level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
