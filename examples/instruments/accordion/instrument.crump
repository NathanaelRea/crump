crump-module 2
instrument accordion "Accordion" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.169091s 0.169091s modulatable
  parameter release "Release" seconds 0.02s 4s 0.12s 0.12s
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-level note_key per_voice bipolar reference F4 range 12st
    route attack-velocity source velocity target attack depth -0.10227273s map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(1.44) order 0 bypass false
    route key-gain-low source key-level target key-gain depth -0.450417 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth -0.211983 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 49 {
    # Organ ranks: oscillators at each stop's pitch through a fixed body.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain1 math operation scale amount 0.005
    node stop1 analog_oscillator waveform saw coarse -0.00357497st level 1.41421 velocity_amount 0 fm_depth 1st
    node stop1-mono stereo_to_mono
    node stop2 analog_oscillator waveform saw coarse 0.0928929st level 1.13137 velocity_amount 0 fm_depth 1st
    node stop2-mono stereo_to_mono
    node stop3 analog_oscillator waveform saw coarse -0.100916st level 1.13137 velocity_amount 0 fm_depth 1st
    node stop3-mono stereo_to_mono
    node stop4 analog_oscillator waveform saw coarse -11.9985st level 0.707107 velocity_amount 0 fm_depth 1st
    node stop4-mono stereo_to_mono
    node mix2 sum max_inputs 4
    node breath noise level 1
    node hi-3 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-4 lowpass mode lowpass cutoff 9000hz resonance 0.308309
    node breath-comb-in math operation add
    node breath-comb delay_line mode pitch ratio 1 interpolation linear max_time 0.05s
    node gain5 math operation scale amount 0.7
    node gain6 math operation scale amount 0.3
    node gain7 math operation scale amount 0.2
    node gain8 math operation scale amount 0.8
    node plus9 math operation add
    node breath-amp to_audio
    node gain10 math operation scale amount 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall11 math operation add
    node fall11-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall11-leak math operation scale amount 0.999997916669
    node fall12 math operation add
    node fall12-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall12-leak math operation scale amount 0.998263315341
    node gain13 math operation scale amount -1
    node plus14 math operation add
    node gain15 math operation scale amount 22
    node plus16 math operation add
    node times17 math operation multiply
    node gain18 math operation scale amount 0.000658364
    node plus19 math operation add
    node hi-20 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-21 lowpass mode lowpass cutoff 5000hz resonance 0.308309
    node body22 modal_bank profile accordion-body max_modes 12 key_track 0 decay_scale 1 brightness 0 level 1
    node dynamics-gain math operation scale amount $dynamics
    node hi-23 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.0430215
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain1-a drift-audio.audio -> gain1.a
    bus note-pitch-stop1-pitch note.pitch -> stop1.pitch
    bus note-velocity-stop1-velocity note.velocity -> stop1.velocity
    bus gain1-audio-stop1-fm gain1.audio -> stop1.fm
    bus amplitude-control-stop1-gain amplitude.control -> stop1.gain
    bus stop1-audio-stop1-mono-audio stop1.audio -> stop1-mono.audio
    bus note-pitch-stop2-pitch note.pitch -> stop2.pitch
    bus note-velocity-stop2-velocity note.velocity -> stop2.velocity
    bus gain1-audio-stop2-fm gain1.audio -> stop2.fm
    bus amplitude-control-stop2-gain amplitude.control -> stop2.gain
    bus stop2-audio-stop2-mono-audio stop2.audio -> stop2-mono.audio
    bus note-pitch-stop3-pitch note.pitch -> stop3.pitch
    bus note-velocity-stop3-velocity note.velocity -> stop3.velocity
    bus gain1-audio-stop3-fm gain1.audio -> stop3.fm
    bus amplitude-control-stop3-gain amplitude.control -> stop3.gain
    bus stop3-audio-stop3-mono-audio stop3.audio -> stop3-mono.audio
    bus note-pitch-stop4-pitch note.pitch -> stop4.pitch
    bus note-velocity-stop4-velocity note.velocity -> stop4.velocity
    bus gain1-audio-stop4-fm gain1.audio -> stop4.fm
    bus amplitude-control-stop4-gain amplitude.control -> stop4.gain
    bus stop4-audio-stop4-mono-audio stop4.audio -> stop4-mono.audio
    bus stop1-mono-audio-mix2-inputs stop1-mono.audio -> mix2.inputs
    bus stop2-mono-audio-mix2-inputs stop2-mono.audio -> mix2.inputs
    bus stop3-mono-audio-mix2-inputs stop3-mono.audio -> mix2.inputs
    bus stop4-mono-audio-mix2-inputs stop4-mono.audio -> mix2.inputs
    bus breath-audio-hi-3-audio breath.audio -> hi-3.audio
    bus hi-3-audio-lo-4-audio hi-3.audio -> lo-4.audio
    bus lo-4-audio-breath-comb-in-a lo-4.audio -> breath-comb-in.a
    bus note-pitch-breath-comb-pitch note.pitch -> breath-comb.pitch
    bus breath-comb-in-audio-breath-comb-audio breath-comb-in.audio -> breath-comb.audio
    bus breath-comb-audio-gain5-a breath-comb.audio -> gain5.a
    bus gain5-audio-breath-comb-in-b gain5.audio -> breath-comb-in.b
    bus breath-comb-in-audio-gain6-a breath-comb-in.audio -> gain6.a
    bus lo-4-audio-gain7-a lo-4.audio -> gain7.a
    bus gain6-audio-gain8-a gain6.audio -> gain8.a
    bus gain7-audio-plus9-a gain7.audio -> plus9.a
    bus gain8-audio-plus9-b gain8.audio -> plus9.b
    bus amplitude-control-breath-amp-control amplitude.control -> breath-amp.control
    bus breath-amp-audio-gain10-a breath-amp.audio -> gain10.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus fall11-audio-fall11-previous-audio fall11.audio -> fall11-previous.audio
    bus onset-audio-fall11-a onset.audio -> fall11.a
    bus fall11-previous-audio-fall11-leak-a fall11-previous.audio -> fall11-leak.a
    bus fall11-leak-audio-fall11-b fall11-leak.audio -> fall11.b
    bus fall12-audio-fall12-previous-audio fall12.audio -> fall12-previous.audio
    bus onset-audio-fall12-a onset.audio -> fall12.a
    bus fall12-previous-audio-fall12-leak-a fall12-previous.audio -> fall12-leak.a
    bus fall12-leak-audio-fall12-b fall12-leak.audio -> fall12.b
    bus fall12-audio-gain13-a fall12.audio -> gain13.a
    bus fall11-audio-plus14-a fall11.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-gain15-a plus14.audio -> gain15.a
    bus gain10-audio-plus16-a gain10.audio -> plus16.a
    bus gain15-audio-plus16-b gain15.audio -> plus16.b
    bus plus9-audio-times17-a plus9.audio -> times17.a
    bus plus16-audio-times17-b plus16.audio -> times17.b
    bus times17-audio-gain18-a times17.audio -> gain18.a
    bus mix2-audio-plus19-a mix2.audio -> plus19.a
    bus gain18-audio-plus19-b gain18.audio -> plus19.b
    bus plus19-audio-hi-20-audio plus19.audio -> hi-20.audio
    bus hi-20-audio-lo-21-audio hi-20.audio -> lo-21.audio
    bus lo-21-audio-body22-audio lo-21.audio -> body22.audio
    bus note-pitch-body22-pitch note.pitch -> body22.pitch
    bus note-gate-body22-gate note.gate -> body22.gate
    bus body22-audio-dynamics-gain-a body22.audio -> dynamics-gain.a
    bus dynamics-gain-audio-hi-23-audio dynamics-gain.audio -> hi-23.audio
    bus hi-23-audio-register-a hi-23.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile accordion-body {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.0558038 after_decay 0.0159155s after_gain 0
  mode m1 frequency 77.1282hz decay 0.0103176s gain 0.0587983 after_decay 0.0103176s after_gain 0
  mode m2 frequency 118.975hz decay 0.00668859s gain 0.0567458 after_decay 0.00668859s after_gain 0
  mode m3 frequency 183.526hz decay 0.00433602s gain 0.0541149 after_decay 0.00433602s after_gain 0
  mode m4 frequency 283.101hz decay 0.00281092s gain 0.0503685 after_decay 0.00281092s after_gain 0
  mode m5 frequency 436.701hz decay 0.00182224s gain 0.0450058 after_decay 0.00182224s after_gain 0
  mode m6 frequency 673.64hz decay 0.00118131s gain 0.0287649 after_decay 0.00118131s after_gain 0
  mode m7 frequency 2472.61hz decay 0.000321835s gain 0.0237642 after_decay 0.000321835s after_gain 0
  mode m8 frequency 3814.16hz decay 0.000208637s gain 0.410668 after_decay 0.000208637s after_gain 0
  mode m9 frequency 5883.59hz decay 0.000135253s gain 0.594435 after_decay 0.000135253s after_gain 0
  mode m10 frequency 9075.8hz decay 0.0001s gain 0.89204 after_decay 0.0001s after_gain 0
  mode m11 frequency 14000hz decay 0.0001s gain 1 after_decay 0.0001s after_gain 0
}
