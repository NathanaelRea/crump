crump-module 2
instrument opera-gong "Opera Gong" graph {
  polyphony 4
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.2 0.2
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 10 {
    # A strike on a body with explicit mode ratios, plus a contact tick.
    node strike1 exciter kind impact contact 0.000336111s hardness $hardness level 1
    node body2 modal_bank profile opera-gong-body max_modes 10 key_track 0 decay_scale $ring brightness 0 level 1
    node hi-3 lowpass mode highpass cutoff 40hz resonance 0.308309
    node contour lfo {
      waveform custom
      rate 0.37037037hz
      depth 1
      phase 0
      random_phase 0
      mode one_shot
      direction forward
      polarity bipolar
      retrigger note
      point c0 phase 0 value -0.99611057
      point c1 phase 0.001 value -0.99611057
      point c2 phase 0.00112421 value -0.99611057
      point c3 phase 0.0012638482 value -0.99611057
      point c4 phase 0.0014208308 value -0.99611057
      point c5 phase 0.0015973123 value -0.99611057
      point c6 phase 0.0017957145 value -0.99611057
      point c7 phase 0.0020187603 value -0.99611057
      point c8 phase 0.0022695105 value -0.99611057
      point c9 phase 0.0025514065 value -0.99611057
      point c10 phase 0.0028683168 value -0.99611057
      point c11 phase 0.0032245905 value -0.99611057
      point c12 phase 0.003625117 value -0.99611057
      point c13 phase 0.004075393 value -0.99611057
      point c14 phase 0.0045815977 value -0.99611057
      point c15 phase 0.0051506781 value -0.99611057
      point c16 phase 0.005790444 value -0.99611057
      point c17 phase 0.0065096752 value -0.99611057
      point c18 phase 0.0073182422 value -0.99611057
      point c19 phase 0.0082272413 value -0.99611057
      point c20 phase 0.0092491473 value -0.99611057
      point c21 phase 0.010397984 value -0.99611057
      point c22 phase 0.011689518 value -0.99611057
      point c23 phase 0.013141474 value -0.99611057
      point c24 phase 0.014773777 value -0.99611057
      point c25 phase 0.016608828 value -0.99611057
      point c26 phase 0.018671811 value -0.99611057
      point c27 phase 0.020991037 value -0.99611057
      point c28 phase 0.023598335 value -0.99611057
      point c29 phase 0.026529485 value -0.99611057
      point c30 phase 0.029824713 value -0.99611057
      point c31 phase 0.033529241 value -0.99611057
      point c32 phase 0.03769391 value -0.99610987
      point c33 phase 0.042375872 value -0.99605047
      point c34 phase 0.04763938 value -0.99586939
      point c35 phase 0.053556669 value -0.99552139
      point c36 phase 0.060208945 value -0.99494765
      point c37 phase 0.0676875 value -0.99407199
      point c38 phase 0.076094967 value -0.99279616
      point c39 phase 0.085546725 value -0.99099362
      point c40 phase 0.096172487 value -0.9885019
      point c41 phase 0.10811808 value -0.9851128
      point c42 phase 0.12154743 value -0.98055998
      point c43 phase 0.13664483 value -0.97450325
      point c44 phase 0.15361749 value -0.96650867
      point c45 phase 0.17269833 value -0.9560234
      point c46 phase 0.19414919 value -0.94234387
      point c47 phase 0.21826447 value -0.92457547
      point c48 phase 0.24537511 value -0.90158171
      point c49 phase 0.27585316 value -0.87191985
      point c50 phase 0.31011689 value -0.83375968
      point c51 phase 0.34863652 value -0.7847809
      point c52 phase 0.39194068 value -0.7220436
      point c53 phase 0.44062364 value -0.64182477
      point c54 phase 0.49535352 value -0.53941219
      point c55 phase 0.5568814 value -0.40884446
      point c56 phase 0.62605166 value -0.24258339
      point c57 phase 0.70381356 value -0.031101297
      point c58 phase 0.79123426 value 0.23763838
      point c59 phase 0.8895135 value 0.57883483
      point c60 phase 1 value 1
    }
    node contour-audio to_audio
    node bend delay_line mode time time 0.0160692s mod_depth 1 interpolation lagrange3 max_time 0.0421384s
    node trim math operation scale amount 0.0832565
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-hi-3-audio body2.audio -> hi-3.audio
    bus contour-control-contour-audio-control contour.control -> contour-audio.control
    bus hi-3-audio-bend-audio hi-3.audio -> bend.audio
    bus contour-audio-audio-bend-time-mod contour-audio.audio -> bend.time_mod
    bus bend-audio-trim-a bend.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile opera-gong-body {
  root 260hz
  mode m0 frequency 260hz decay 2s gain 0.7 after_decay 2s after_gain 0
  mode m1 frequency 468hz decay 0.8s gain 0.0935248 after_decay 0.8s after_gain 0
  mode m2 frequency 733.2hz decay 1.5s gain 1.1371 after_decay 1.5s after_gain 0
  mode m3 frequency 772.2hz decay 1s gain 0.245416 after_decay 1s after_gain 0
  mode m4 frequency 806hz decay 1s gain 0.306033 after_decay 1s after_gain 0
  mode m5 frequency 889.2hz decay 0.8s gain 0.286217 after_decay 0.8s after_gain 0
  mode m6 frequency 1448.2hz decay 0.5s gain 0.334605 after_decay 0.5s after_gain 0
  mode m7 frequency 1586hz decay 0.4s gain 0.250351 after_decay 0.4s after_gain 0
  mode m8 frequency 2158hz decay 0.3s gain 0.175605 after_decay 0.3s after_gain 0
  mode m9 frequency 2496hz decay 0.25s gain 0.10949 after_decay 0.25s after_gain 0
}
