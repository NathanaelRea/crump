crump-module 2
instrument opera-gong "Opera Gong" graph {
  polyphony 2
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter bloom "Bloom" ratio 0 1 0.6 0.6
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the gong rings" maps ring
    control bloom "Bloom" "How much the shimmer swells after the strike" maps bloom
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 23 {
    # An opera gong: measured inharmonic modes beat in close clusters; the strike energy blooms into the upper cluster and the pitch falls as the plate relaxes.
    node mallet exciter kind impact contact 0.0015s hardness 0.4 level 1
    node plate modal_bank profile opera-gong-plate max_modes 48 key_track 0 decay_scale $ring brightness 0 rise 0.05s level 1
    node tension shaper curve tanh drive 4 bias 0
    node tension-coupling math operation scale amount 0.00012
    node bloom modal_bank profile opera-gong-bloom max_modes 44 key_track 0 decay_scale $ring brightness 0 rise 0.25s level 1
    node bloom-level math operation scale amount $bloom
    node plate-sum math operation add
    node hiss1 noise level 1
    node fall2 math operation add
    node fall2-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall2-leak math operation scale amount 0.999305796626
    node times3 math operation multiply
    node hi-4 lowpass mode highpass cutoff 300hz resonance 0.308309
    node lo-5 lowpass mode lowpass cutoff 6000hz resonance 0.308309
    node mallet-noise math operation scale amount 0.04
    node struck math operation add
    node contour lfo {
      waveform custom
      rate 0.16666667hz
      depth 1
      phase 0
      random_phase 0
      mode one_shot
      direction forward
      polarity bipolar
      retrigger note
      point c0 phase 0 value -0.99942555
      point c1 phase 0.001 value -0.99942028
      point c2 phase 0.00112421 value -0.99941881
      point c3 phase 0.0012638482 value -0.99941696
      point c4 phase 0.0014208308 value -0.99941462
      point c5 phase 0.0015973123 value -0.99941164
      point c6 phase 0.0017957145 value -0.99940785
      point c7 phase 0.0020187603 value -0.99940307
      point c8 phase 0.0022695105 value -0.99939701
      point c9 phase 0.0025514065 value -0.99938933
      point c10 phase 0.0028683168 value -0.99937961
      point c11 phase 0.0032245905 value -0.9993673
      point c12 phase 0.003625117 value -0.99935172
      point c13 phase 0.004075393 value -0.999332
      point c14 phase 0.0045815977 value -0.99930706
      point c15 phase 0.0051506781 value -0.99927549
      point c16 phase 0.005790444 value -0.99923556
      point c17 phase 0.0065096752 value -0.99918507
      point c18 phase 0.0073182422 value -0.9991212
      point c19 phase 0.0082272413 value -0.99904043
      point c20 phase 0.0092491473 value -0.99893831
      point c21 phase 0.010397984 value -0.99880918
      point c22 phase 0.011689518 value -0.99864592
      point c23 phase 0.013141474 value -0.99843954
      point c24 phase 0.014773777 value -0.99817865
      point c25 phase 0.016608828 value -0.99784887
      point c26 phase 0.018671811 value -0.99743206
      point c27 phase 0.020991037 value -0.99690523
      point c28 phase 0.023598335 value -0.99623943
      point c29 phase 0.026529485 value -0.99539802
      point c30 phase 0.029824713 value -0.99433476
      point c31 phase 0.033529241 value -0.99299122
      point c32 phase 0.03769391 value -0.99129365
      point c33 phase 0.042375872 value -0.98914937
      point c34 phase 0.04763938 value -0.98647703
      point c35 phase 0.053556669 value -0.98316681
      point c36 phase 0.060208945 value -0.97905916
      point c37 phase 0.0676875 value -0.97395365
      point c38 phase 0.076094967 value -0.96759848
      point c39 phase 0.085546725 value -0.95968118
      point c40 phase 0.096172487 value -0.94993303
      point c41 phase 0.10811808 value -0.93796961
      point c42 phase 0.12154743 value -0.92325283
      point c43 phase 0.13664483 value -0.90520316
      point c44 phase 0.15361749 value -0.88326421
      point c45 phase 0.17269833 value -0.85655456
      point c46 phase 0.19414919 value -0.82430281
      point c47 phase 0.21826447 value -0.78542092
      point c48 phase 0.24537511 value -0.73887257
      point c49 phase 0.27585316 value -0.68334092
      point c50 phase 0.31011689 value -0.6174731
      point c51 phase 0.34863652 value -0.53977911
      point c52 phase 0.39194068 value -0.44863855
      point c53 phase 0.44062364 value -0.34231865
      point c54 phase 0.49535352 value -0.21896983
      point c55 phase 0.5568814 value -0.076625571
      point c56 phase 0.62605166 value 0.086799738
      point c57 phase 0.70381356 value 0.27357083
      point c58 phase 0.79123426 value 0.48615391
      point c59 phase 0.8895135 value 0.72727573
      point c60 phase 1 value 1
    }
    node contour-audio to_audio
    node bend delay_line mode time time 0.108799s mod_depth 1 interpolation lagrange3 max_time 0.227598s
    node trim math operation scale amount 0.175368
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-mallet-gate note.gate -> mallet.gate
    bus note-velocity-mallet-velocity note.velocity -> mallet.velocity
    bus mallet-audio-plate-audio mallet.audio -> plate.audio
    bus note-pitch-plate-pitch note.pitch -> plate.pitch
    bus note-gate-plate-gate note.gate -> plate.gate
    bus plate-audio-tension-audio plate.audio -> tension.audio
    bus tension-audio-tension-coupling-a tension.audio -> tension-coupling.a
    bus tension-coupling-audio-bloom-audio tension-coupling.audio -> bloom.audio
    bus note-pitch-bloom-pitch note.pitch -> bloom.pitch
    bus note-gate-bloom-gate note.gate -> bloom.gate
    bus bloom-audio-bloom-level-a bloom.audio -> bloom-level.a
    bus plate-audio-plate-sum-a plate.audio -> plate-sum.a
    bus bloom-level-audio-plate-sum-b bloom-level.audio -> plate-sum.b
    bus fall2-audio-fall2-previous-audio fall2.audio -> fall2-previous.audio
    bus mallet-audio-fall2-a mallet.audio -> fall2.a
    bus fall2-previous-audio-fall2-leak-a fall2-previous.audio -> fall2-leak.a
    bus fall2-leak-audio-fall2-b fall2-leak.audio -> fall2.b
    bus hiss1-audio-times3-a hiss1.audio -> times3.a
    bus fall2-audio-times3-b fall2.audio -> times3.b
    bus times3-audio-hi-4-audio times3.audio -> hi-4.audio
    bus hi-4-audio-lo-5-audio hi-4.audio -> lo-5.audio
    bus lo-5-audio-mallet-noise-a lo-5.audio -> mallet-noise.a
    bus plate-sum-audio-struck-a plate-sum.audio -> struck.a
    bus mallet-noise-audio-struck-b mallet-noise.audio -> struck.b
    bus contour-control-contour-audio-control contour.control -> contour-audio.control
    bus struck-audio-bend-audio struck.audio -> bend.audio
    bus contour-audio-audio-bend-time-mod contour-audio.audio -> bend.time_mod
    bus bend-audio-trim-a bend.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
