crump-module 2
instrument clean-electric "Clean Electric" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.993211 0.993211 modulatable
  parameter length "String length 1" ratio 0.5 1.1 0.98845944 0.98845944 modulatable
  parameter length2 "String length 2" ratio 0.5 1.1 0.98817401 0.98817401 modulatable
  parameter register "Register level" ratio 0.05 20 1.88365 1.88365 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-c4-24 note_key per_voice bipolar reference C4 range 24st
    source key-from-c1-24 note_key per_voice bipolar reference C1 range 24st
    source key-from-c3-12 note_key per_voice bipolar reference C3 range 12st
    source key-from-c4-6 note_key per_voice bipolar reference C4 range 6st
    source key-from-fs4-6 note_key per_voice bipolar reference F#4 range 6st
    source key-from-c5-6 note_key per_voice bipolar reference C5 range 6st
    source key-from-fs5-6 note_key per_voice bipolar reference F#5 range 6st
    source key-from-c6-6 note_key per_voice bipolar reference C6 range 6st
    source key-from-fs6-18 note_key per_voice bipolar reference F#6 range 18st
    source key-from-e2-3 note_key per_voice bipolar reference E2 range 3st
    source key-from-g2-3 note_key per_voice bipolar reference G2 range 3st
    source key-from-as2-3 note_key per_voice bipolar reference A#2 range 3st
    source key-from-cs3-3 note_key per_voice bipolar reference C#3 range 3st
    source key-from-e3-3 note_key per_voice bipolar reference E3 range 3st
    source key-from-g3-3 note_key per_voice bipolar reference G3 range 3st
    source key-from-as3-3 note_key per_voice bipolar reference A#3 range 3st
    source key-from-cs4-3 note_key per_voice bipolar reference C#4 range 3st
    source key-from-e4-3 note_key per_voice bipolar reference E4 range 3st
    source key-from-g4-3 note_key per_voice bipolar reference G4 range 3st
    source key-from-as4-3 note_key per_voice bipolar reference A#4 range 3st
    source key-from-cs5-3 note_key per_voice bipolar reference C#5 range 3st
    source key-from-e5-3 note_key per_voice bipolar reference E5 range 3st
    source key-from-g5-3 note_key per_voice bipolar reference G5 range 3st
    source key-from-as5-3 note_key per_voice bipolar reference A#5 range 3st
    source key-from-cs6-1 note_key per_voice bipolar reference C#6 range 1st
    source velocity note_velocity per_voice unipolar
    route sustain-low source key-c4-24 target sustain depth -0.00539998 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route sustain-high source key-c4-24 target sustain depth 0.0065891 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-1 source key-from-c1-24 target length depth 0.00088766474 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-2 source key-from-c3-12 target length depth 0.0030440437 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-3 source key-from-c4-6 target length depth 0.0046558862 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-4 source key-from-fs4-6 target length depth 0.0022391777 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-5 source key-from-c5-6 target length depth -0.00029605511 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-6 source key-from-fs5-6 target length depth -0.00041940979 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-7 source key-from-c6-6 target length depth -0.00059519199 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-8 source key-from-fs6-18 target length depth -0.0038310095 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-1 source key-from-c1-24 target length2 depth 0.00088740841 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-2 source key-from-c3-12 target length2 depth 0.0030431646 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-3 source key-from-c4-6 target length2 depth 0.0046545417 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-4 source key-from-fs4-6 target length2 depth 0.0022385311 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-5 source key-from-c5-6 target length2 depth -0.00029596961 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-6 source key-from-fs5-6 target length2 depth -0.00041928867 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-7 source key-from-c6-6 target length2 depth -0.00059502011 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-8 source key-from-fs6-18 target length2 depth -0.0038299032 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-1 source key-from-e2-3 target register depth -1.68866 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-g2-3 target register depth -0.129671 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-as2-3 target register depth 0.206957 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-cs3-3 target register depth -0.0657321 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-e3-3 target register depth 0.0989541 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-g3-3 target register depth 1.39275 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-as3-3 target register depth -0.536795 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-cs4-3 target register depth -1.10145 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-e4-3 target register depth 1.15619 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-g4-3 target register depth 0.667463 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-as4-3 target register depth -0.471112 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-12 source key-from-cs5-3 target register depth 0.514987 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-13 source key-from-e5-3 target register depth -0.892383 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-14 source key-from-g5-3 target register depth 0.682766 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-15 source key-from-as5-3 target register depth -1.01807 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-16 source key-from-cs6-1 target register depth 0.311737 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 54 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.00101663s hardness 0.4 level 1
    node scrape noise level 1
    node scrape-band biquad mode bandpass frequency 3464.1hz q 0.532939
    node scrape-env envelope mode adsr attack 0.0005s decay 0.004s sustain 0 release 0.004s
    node scrape-env-audio to_audio
    node scrape-burst math operation multiply
    node scrape-level math operation scale amount 0.223533
    node attack sum max_inputs 2
    node finger lowpass mode lowpass cutoff 1930.64hz resonance 0.05 velocity_depth 9743.35hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.175753 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.6
    node string delay_line mode pitch ratio $length interpolation lagrange3 max_time 0.05s
    node bridge math operation add
    node loss biquad mode lowpass frequency 13556.4hz q 0.764324 key_track 1 key_reference 261.626hz
    node stiffness biquad mode allpass frequency 15697.5hz q 0.7 key_track 1 key_reference 261.626hz
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.4
    node string2 delay_line mode pitch ratio $length2 interpolation lagrange3 max_time 0.05s
    node bridge2 math operation add
    node loss2 biquad mode lowpass frequency 13556.4hz q 0.764324 key_track 1 key_reference 261.626hz
    node stiffness2 biquad mode allpass frequency 15697.5hz q 0.7 key_track 1 key_reference 261.626hz
    node trim-loss2 math operation scale amount 0.9995
    node return2 math operation scale amount $sustain
    node strings sum max_inputs 2
    node bridge-dc dc_block cutoff 20hz
    node pickup-delay delay_line mode pitch ratio 0.12 interpolation lagrange3 max_time 0.03s
    node pickup math operation subtract
    node coil biquad mode lowpass frequency 3800hz q 2
    node preamp math operation scale amount 1
    node valve shaper curve asymmetric drive 1.2 bias 0.05 asymmetry 0.1
    node valve-dc dc_block cutoff 30hz
    node formant1 biquad mode peak frequency 1012.96hz q 0.698259 gain -14.9549db
    node formant2 biquad mode peak frequency 1266.79hz q 2.4023 gain -14.9989db
    node formant3 biquad mode peak frequency 3960.52hz q 2.5 gain -14.9997db
    node formant4 biquad mode peak frequency 3381.46hz q 2.5 gain -14.9386db
    node formant5 biquad mode peak frequency 12000hz q 1.45446 gain 13.113db
    node formant6 biquad mode peak frequency 9346.94hz q 2.49426 gain 8.21444db
    node formant7 biquad mode lowshelf frequency 460.407hz q 0.7071 gain 14.982db
    node formant8 biquad mode highshelf frequency 3895.84hz q 0.7071 gain 12.5847db
    node formant9 biquad mode peak frequency 921.356hz q 0.5 gain 13.4494db
    node formant10 biquad mode peak frequency 2457.29hz q 2.5 gain 15db
    node formant11 biquad mode peak frequency 5660.27hz q 1.24062 gain 14.1693db
    node formant12 biquad mode peak frequency 311.341hz q 1.92543 gain 14.3605db
    node cabinet1 biquad mode highpass frequency 70hz q 0.7
    node cabinet2 biquad mode peak frequency 120hz q 0.8 gain 2db
    node cabinet3 biquad mode lowpass frequency 6500hz q 0.8
    node radiation biquad mode highpass frequency 60hz q 0.7071
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.0840263
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus scrape-audio-scrape-band-audio scrape.audio -> scrape-band.audio
    bus note-gate-scrape-env-gate note.gate -> scrape-env.gate
    bus scrape-env-control-scrape-env-audio-control scrape-env.control -> scrape-env-audio.control
    bus scrape-band-audio-scrape-burst-a scrape-band.audio -> scrape-burst.a
    bus scrape-env-audio-audio-scrape-burst-b scrape-env-audio.audio -> scrape-burst.b
    bus scrape-burst-audio-scrape-level-a scrape-burst.audio -> scrape-level.a
    bus pluck-audio-attack-inputs pluck.audio -> attack.inputs
    bus scrape-level-audio-attack-inputs scrape-level.audio -> attack.inputs
    bus attack-audio-finger-audio attack.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus note-pitch-loss-key note.pitch -> loss.key
    bus loss-audio-stiffness-audio loss.audio -> stiffness.audio
    bus note-pitch-stiffness-key note.pitch -> stiffness.key
    bus stiffness-audio-return-a stiffness.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus note-pitch-loss2-key note.pitch -> loss2.key
    bus loss2-audio-stiffness2-audio loss2.audio -> stiffness2.audio
    bus note-pitch-stiffness2-key note.pitch -> stiffness2.key
    bus stiffness2-audio-trim-loss2-a stiffness2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus note-pitch-pickup-delay-pitch note.pitch -> pickup-delay.pitch
    bus bridge-dc-audio-pickup-delay-audio bridge-dc.audio -> pickup-delay.audio
    bus bridge-dc-audio-pickup-a bridge-dc.audio -> pickup.a
    bus pickup-delay-audio-pickup-b pickup-delay.audio -> pickup.b
    bus pickup-audio-coil-audio pickup.audio -> coil.audio
    bus coil-audio-preamp-a coil.audio -> preamp.a
    bus preamp-audio-valve-audio preamp.audio -> valve.audio
    bus valve-audio-valve-dc-audio valve.audio -> valve-dc.audio
    bus valve-dc-audio-formant1-audio valve-dc.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-formant9-audio formant8.audio -> formant9.audio
    bus formant9-audio-formant10-audio formant9.audio -> formant10.audio
    bus formant10-audio-formant11-audio formant10.audio -> formant11.audio
    bus formant11-audio-formant12-audio formant11.audio -> formant12.audio
    bus formant12-audio-cabinet1-audio formant12.audio -> cabinet1.audio
    bus cabinet1-audio-cabinet2-audio cabinet1.audio -> cabinet2.audio
    bus cabinet2-audio-cabinet3-audio cabinet2.audio -> cabinet3.audio
    bus cabinet3-audio-radiation-audio cabinet3.audio -> radiation.audio
    bus radiation-audio-register-level-a radiation.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
