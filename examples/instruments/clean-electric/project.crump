crump 2
import "instrument.crump"
project "Clean Electric" {
  id example-clean-electric
  seed 1148255
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat E4 0.25beat 0.92
      note 4beat E4 2beat 0.48
      note 8beat A3 0.5beat 0.85
      note 10beat B4 0.25beat 0.65
      note 12beat E5 0.75beat 0.8
      note 16beat E4 0.4beat 0.75
      note 16.5beat G#4 0.4beat 0.75
      note 17beat B4 0.4beat 0.75
      note 17.5beat E5 0.4beat 0.75
      note 18beat G#5 0.4beat 0.75
      note 18.5beat E5 0.4beat 0.75
      note 19beat B4 0.4beat 0.75
      note 19.5beat G#4 0.4beat 0.75
      note 24beat E4 0.2beat 0.55
      note 24.25beat F#4 0.2beat 0.6
      note 24.5beat G#4 0.2beat 0.65
      note 24.75beat A4 0.2beat 0.55
      note 25beat B4 0.2beat 0.6
      note 25.25beat C#5 0.2beat 0.65
      note 25.5beat D#5 0.2beat 0.55
      note 25.75beat E5 0.2beat 0.6
    }
    track instrument "Clean Electric" instrument clean-electric level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
