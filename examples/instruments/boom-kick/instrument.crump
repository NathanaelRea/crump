crump-module 2
instrument boom-kick "Boom Kick" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z26-soft-0 asset boom-kick-26-soft-0 keys C1 E1 velocity 0 0.65 root D1
      zone z26-hard-0 asset boom-kick-26-hard-0 keys C1 E1 velocity 0.65 1 root D1
      zone z31-soft-0 asset boom-kick-31-soft-0 keys F1 A1 velocity 0 0.65 root G1
      zone z31-hard-0 asset boom-kick-31-hard-0 keys F1 A1 velocity 0.65 1 root G1
      zone z36-soft-0 asset boom-kick-36-soft-0 keys A#1 D2 velocity 0 0.65 root C2
      zone z36-hard-0 asset boom-kick-36-hard-0 keys A#1 D2 velocity 0.65 1 root C2
      zone z41-soft-0 asset boom-kick-41-soft-0 keys D#2 G2 velocity 0 0.65 root F2
      zone z41-hard-0 asset boom-kick-41-hard-0 keys D#2 G2 velocity 0.65 1 root F2
      zone z46-soft-0 asset boom-kick-46-soft-0 keys G#2 C3 velocity 0 0.65 root A#2
      zone z46-hard-0 asset boom-kick-46-hard-0 keys G#2 C3 velocity 0.65 1 root A#2
      zone z51-soft-0 asset boom-kick-51-soft-0 keys C#3 G3 velocity 0 0.65 root D#3
      zone z51-hard-0 asset boom-kick-51-hard-0 keys C#3 G3 velocity 0.65 1 root D#3
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
