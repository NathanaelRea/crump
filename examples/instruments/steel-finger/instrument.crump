crump-module 2
instrument steel-finger "Steel Finger" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.998509 0.998509 modulatable
  parameter length "String length 1" ratio 0.5 1.1 0.98865731 0.98865731 modulatable
  parameter length2 "String length 2" ratio 0.5 1.1 0.98820056 0.98820056 modulatable
  parameter room "Room" ratio 0 1 0.271538 0.271538
  parameter register "Register level" ratio 0.05 20 1.46218 1.46218 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-c4-24 note_key per_voice bipolar reference C4 range 24st
    source key-from-c1-24 note_key per_voice bipolar reference C1 range 24st
    source key-from-c3-12 note_key per_voice bipolar reference C3 range 12st
    source key-from-c4-6 note_key per_voice bipolar reference C4 range 6st
    source key-from-fs4-6 note_key per_voice bipolar reference F#4 range 6st
    source key-from-c5-6 note_key per_voice bipolar reference C5 range 6st
    source key-from-fs5-6 note_key per_voice bipolar reference F#5 range 6st
    source key-from-c6-6 note_key per_voice bipolar reference C6 range 6st
    source key-from-fs6-18 note_key per_voice bipolar reference F#6 range 18st
    source key-from-c1-3 note_key per_voice bipolar reference C1 range 3st
    source key-from-ds1-3 note_key per_voice bipolar reference D#1 range 3st
    source key-from-fs1-3 note_key per_voice bipolar reference F#1 range 3st
    source key-from-a1-3 note_key per_voice bipolar reference A1 range 3st
    source key-from-c2-3 note_key per_voice bipolar reference C2 range 3st
    source key-from-ds2-3 note_key per_voice bipolar reference D#2 range 3st
    source key-from-fs2-3 note_key per_voice bipolar reference F#2 range 3st
    source key-from-a2-3 note_key per_voice bipolar reference A2 range 3st
    source key-from-c3-3 note_key per_voice bipolar reference C3 range 3st
    source key-from-ds3-3 note_key per_voice bipolar reference D#3 range 3st
    source key-from-fs3-3 note_key per_voice bipolar reference F#3 range 3st
    source key-from-a3-3 note_key per_voice bipolar reference A3 range 3st
    source key-from-c4-3 note_key per_voice bipolar reference C4 range 3st
    source key-from-ds4-3 note_key per_voice bipolar reference D#4 range 3st
    source key-from-fs4-3 note_key per_voice bipolar reference F#4 range 3st
    source key-from-a4-3 note_key per_voice bipolar reference A4 range 3st
    source key-from-c5-3 note_key per_voice bipolar reference C5 range 3st
    source key-from-ds5-3 note_key per_voice bipolar reference D#5 range 3st
    source key-from-fs5-3 note_key per_voice bipolar reference F#5 range 3st
    source key-from-a5-3 note_key per_voice bipolar reference A5 range 3st
    source key-from-c6-3 note_key per_voice bipolar reference C6 range 3st
    source key-from-ds6-3 note_key per_voice bipolar reference D#6 range 3st
    source key-from-fs6-1 note_key per_voice bipolar reference F#6 range 1st
    source velocity note_velocity per_voice unipolar
    route sustain-low source key-c4-24 target sustain depth 0.00352251 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route sustain-high source key-c4-24 target sustain depth 0.000990561 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-1 source key-from-c1-24 target length depth 0.00042015037 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-2 source key-from-c3-12 target length depth 0.0013880067 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-3 source key-from-c4-6 target length depth 0.0019639884 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-4 source key-from-fs4-6 target length depth 0.0043974127 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-5 source key-from-c5-6 target length depth 0.002480475 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-6 source key-from-fs5-6 target length depth -0.00028767648 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-7 source key-from-c6-6 target length depth -0.00040824673 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-8 source key-from-fs6-18 target length depth -0.0026277102 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-1 source key-from-c1-24 target length2 depth 0.00041995627 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-2 source key-from-c3-12 target length2 depth 0.0013873655 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-3 source key-from-c4-6 target length2 depth 0.001963081 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-4 source key-from-fs4-6 target length2 depth 0.0043953811 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-5 source key-from-c5-6 target length2 depth 0.002479329 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-6 source key-from-fs5-6 target length2 depth -0.00028754357 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-7 source key-from-c6-6 target length2 depth -0.00040805812 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-8 source key-from-fs6-18 target length2 depth -0.0026264962 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-1 source key-from-c1-3 target register depth -0.496126 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-ds1-3 target register depth -0.02199 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-fs1-3 target register depth 0.19095 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-a1-3 target register depth 0.0811752 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-c2-3 target register depth 0.180182 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-ds2-3 target register depth -0.463114 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-fs2-3 target register depth -0.26491 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-a2-3 target register depth 0.0314981 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-c3-3 target register depth -0.023759 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-ds3-3 target register depth -0.282533 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-fs3-3 target register depth 0.391686 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-12 source key-from-a3-3 target register depth -0.161501 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-13 source key-from-c4-3 target register depth 0.709787 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-14 source key-from-ds4-3 target register depth -0.86037 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-15 source key-from-fs4-3 target register depth 0.0638805 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-16 source key-from-a4-3 target register depth 0.0939255 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-17 source key-from-c5-3 target register depth 1.29657 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-18 source key-from-ds5-3 target register depth -0.752627 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-19 source key-from-fs5-3 target register depth 0.843469 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-20 source key-from-a5-3 target register depth -0.653783 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-21 source key-from-c6-3 target register depth 1.69034 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-22 source key-from-ds6-3 target register depth -1.60948 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-23 source key-from-fs6-1 target register depth -0.410298 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 61 {
    # A steel-string guitar: a stiffer, brighter string than nylon, plucked with the fingers.
    node pluck exciter kind impact contact 0.000210901s hardness 0.2 level 1
    node scrape noise level 1
    node scrape-band biquad mode bandpass frequency 2000hz q 0.47619
    node scrape-env envelope mode adsr attack 0.0005s decay 0.008s sustain 0 release 0.008s
    node scrape-env-audio to_audio
    node scrape-burst math operation multiply
    node scrape-level math operation scale amount 0.239426
    node attack sum max_inputs 2
    node released onepole mode leak time 0.000740886s
    node released-dc dc_block cutoff 25hz
    node finger lowpass mode lowpass cutoff 1174.08hz resonance 0.05 velocity_depth 14860.1hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.196205 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.6
    node string delay_line mode pitch ratio $length interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node twang envelope mode adsr attack 0s decay 0.08s sustain 0 release 0.08s decay_curve -0.6
    node twang-audio to_audio
    node twang-velocity math operation multiply
    node velocity-audio to_audio
    node twang-amount math operation scale amount -0.0068656
    node bridge math operation add
    node loss linear_phase_lowpass amount 0.6
    node stiffness biquad mode allpass frequency 10465hz q 0.7 key_track 1 key_reference 261.626hz
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.4
    node string2 delay_line mode pitch ratio $length2 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node bridge2 math operation add
    node loss2 linear_phase_lowpass amount 0.6
    node stiffness2 biquad mode allpass frequency 10465hz q 0.7 key_track 1 key_reference 261.626hz
    node trim-loss2 math operation scale amount 0.9985
    node return2 math operation scale amount $sustain
    node strings sum max_inputs 2
    node bridge-dc dc_block cutoff 20hz
    node body modal_bank profile steel-finger-body max_modes 16 key_track 0 decay_scale 1 brightness 0 level 1
    node direct math operation scale amount 0.297323
    node wood math operation scale amount 0.702677
    node radiated math operation add
    node knock-env envelope mode adsr attack 0.001s decay 0.0457636s sustain 0 release 0.0457636s decay_curve -0.7
    node knock-env-audio to_audio
    node knock-low biquad mode highpass frequency 150hz q 0.7071
    node knock-band biquad mode lowpass frequency 1508.82hz q 0.7071
    node knock-burst math operation multiply
    node knock-velocity math operation multiply
    node knock-level math operation scale amount 0
    node with-knock math operation add
    node formant1 biquad mode peak frequency 2068.37hz q 1.80984 gain -5.78417db
    node formant2 biquad mode peak frequency 144.647hz q 1.58198 gain -6.05209db
    node formant3 biquad mode peak frequency 491.748hz q 0.5 gain 12db
    node formant4 biquad mode peak frequency 2543.97hz q 2 gain -9.16795db
    node formant5 biquad mode peak frequency 731.595hz q 2 gain -11.1037db
    node formant6 biquad mode peak frequency 934.978hz q 1.29035 gain -7.49081db
    node formant7 biquad mode lowshelf frequency 140.296hz q 0.7071 gain -12db
    node formant8 biquad mode highshelf frequency 2188.11hz q 0.7071 gain 4.39036db
    node formant9 biquad mode highshelf frequency 2500hz q 0.7071 gain 4db
    node radiation biquad mode highpass frequency 60hz q 0.7071
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.526526
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus scrape-audio-scrape-band-audio scrape.audio -> scrape-band.audio
    bus note-gate-scrape-env-gate note.gate -> scrape-env.gate
    bus scrape-env-control-scrape-env-audio-control scrape-env.control -> scrape-env-audio.control
    bus scrape-band-audio-scrape-burst-a scrape-band.audio -> scrape-burst.a
    bus scrape-env-audio-audio-scrape-burst-b scrape-env-audio.audio -> scrape-burst.b
    bus scrape-burst-audio-scrape-level-a scrape-burst.audio -> scrape-level.a
    bus pluck-audio-attack-inputs pluck.audio -> attack.inputs
    bus scrape-level-audio-attack-inputs scrape-level.audio -> attack.inputs
    bus attack-audio-released-audio attack.audio -> released.audio
    bus released-audio-released-dc-audio released.audio -> released-dc.audio
    bus released-dc-audio-finger-audio released-dc.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus note-gate-twang-gate note.gate -> twang.gate
    bus twang-control-twang-audio-control twang.control -> twang-audio.control
    bus twang-audio-audio-twang-velocity-a twang-audio.audio -> twang-velocity.a
    bus note-velocity-velocity-audio-control note.velocity -> velocity-audio.control
    bus velocity-audio-audio-twang-velocity-b velocity-audio.audio -> twang-velocity.b
    bus twang-velocity-audio-twang-amount-a twang-velocity.audio -> twang-amount.a
    bus twang-amount-audio-string-time-mod twang-amount.audio -> string.time_mod
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus loss-audio-stiffness-audio loss.audio -> stiffness.audio
    bus note-pitch-stiffness-key note.pitch -> stiffness.key
    bus stiffness-audio-return-a stiffness.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus twang-amount-audio-string2-time-mod twang-amount.audio -> string2.time_mod
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus loss2-audio-stiffness2-audio loss2.audio -> stiffness2.audio
    bus note-pitch-stiffness2-key note.pitch -> stiffness2.key
    bus stiffness2-audio-trim-loss2-a stiffness2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus bridge-dc-audio-body-audio bridge-dc.audio -> body.audio
    bus note-pitch-body-pitch note.pitch -> body.pitch
    bus note-gate-body-gate note.gate -> body.gate
    bus bridge-dc-audio-direct-a bridge-dc.audio -> direct.a
    bus body-audio-wood-a body.audio -> wood.a
    bus direct-audio-radiated-a direct.audio -> radiated.a
    bus wood-audio-radiated-b wood.audio -> radiated.b
    bus note-gate-knock-env-gate note.gate -> knock-env.gate
    bus knock-env-control-knock-env-audio-control knock-env.control -> knock-env-audio.control
    bus scrape-audio-knock-low-audio scrape.audio -> knock-low.audio
    bus knock-low-audio-knock-band-audio knock-low.audio -> knock-band.audio
    bus knock-band-audio-knock-burst-a knock-band.audio -> knock-burst.a
    bus knock-env-audio-audio-knock-burst-b knock-env-audio.audio -> knock-burst.b
    bus knock-burst-audio-knock-velocity-a knock-burst.audio -> knock-velocity.a
    bus velocity-audio-audio-knock-velocity-b velocity-audio.audio -> knock-velocity.b
    bus knock-velocity-audio-knock-level-a knock-velocity.audio -> knock-level.a
    bus radiated-audio-with-knock-a radiated.audio -> with-knock.a
    bus knock-level-audio-with-knock-b knock-level.audio -> with-knock.b
    bus with-knock-audio-formant1-audio with-knock.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-formant9-audio formant8.audio -> formant9.audio
    bus formant9-audio-radiation-audio formant9.audio -> radiation.audio
    bus radiation-audio-register-level-a radiation.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
  graph shared 2 {
    node room-reverb reverb room 0.35 damping 0.6 mix $room
    node shared-out output
    bus voice-sum voice_sum.audio -> room-reverb.audio
    bus shared-output room-reverb.audio -> shared-out.audio
  }
}
profile steel-finger-body {
  root 261.626hz
  mode m0 frequency 98hz decay 0.03s gain 0.00111111 after_decay 0.03s after_gain 0
  mode m1 frequency 196hz decay 0.025s gain 0.00166667 after_decay 0.025s after_gain 0
  mode m2 frequency 235hz decay 0.02s gain 0.00104167 after_decay 0.02s after_gain 0
  mode m3 frequency 385hz decay 0.015s gain 0.00166667 after_decay 0.015s after_gain 0
  mode m4 frequency 440hz decay 0.012s gain 0.00173611 after_decay 0.012s after_gain 0
  mode m5 frequency 555hz decay 0.01s gain 0.001875 after_decay 0.01s after_gain 0
  mode m6 frequency 650hz decay 0.009s gain 0.00185185 after_decay 0.009s after_gain 0
  mode m7 frequency 790hz decay 0.008s gain 0.00182292 after_decay 0.008s after_gain 0
  mode m8 frequency 925hz decay 0.007s gain 0.00208333 after_decay 0.007s after_gain 0
  mode m9 frequency 1100hz decay 0.006s gain 0.00208333 after_decay 0.006s after_gain 0
  mode m10 frequency 1350hz decay 0.005s gain 0.0025 after_decay 0.005s after_gain 0
  mode m11 frequency 1620hz decay 0.0045s gain 0.00259259 after_decay 0.0045s after_gain 0
  mode m12 frequency 1950hz decay 0.004s gain 0.00260417 after_decay 0.004s after_gain 0
  mode m13 frequency 2400hz decay 0.0035s gain 0.00261905 after_decay 0.0035s after_gain 0
  mode m14 frequency 2900hz decay 0.003s gain 0.00277778 after_decay 0.003s after_gain 0
  mode m15 frequency 3500hz decay 0.0025s gain 0.003 after_decay 0.0025s after_gain 0
}
