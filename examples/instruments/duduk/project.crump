crump 2
import "instrument.crump"
project "Duduk" {
  id example-duduk
  seed 1322473
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat E4 2beat 0.48
      note 2beat F#4 1beat 0.7
      note 3beat G#4 1beat 0.7
      note 4beat B4 3beat 0.92
      note 8beat E4 0.35beat 0.85
      note 8.5beat G#4 0.35beat 0.85
      note 9beat B4 0.35beat 0.85
      note 9.5beat E5 0.35beat 0.85
      note 10beat E5 2beat 0.6
      note 12beat B3 3.5beat 0.75
      note 16beat E4 1beat 0.55
      note 17beat F#4 1beat 0.6
      note 18beat G#4 1beat 0.65
      note 19beat A4 1beat 0.7
      note 20beat B4 1beat 0.75
      note 21beat C#5 1beat 0.8
      note 22beat D#5 1beat 0.85
      note 24beat E5 6beat 0.8
    }
    track instrument "Duduk" instrument duduk level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
