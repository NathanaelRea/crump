crump-module 2
instrument felt-afterhours "Felt Afterhours" graph {
  polyphony 7
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-gain-curve key_curve per_voice bipolar {
      point c3 key C3 value -0.384902
      point c4 key C4 value 0
      point c5 key C5 value 1
    }
    route key-gain-by-key source key-gain-curve target key-gain depth 0.26097 map bipolar curve linear order 0 bypass false
  }
  graph voice 18 {
    # Hammered strings: stretched partials on two courses.
    node strike1 exciter kind impact contact 0.000648502s hardness $hardness level 1
    node body2 modal_bank profile felt-afterhours-strings max_modes 40 key_track 1 decay_scale $ring brightness 0 level 1
    node hiss3 noise level 1
    node fall4 onepole mode leak time 0.008s
    node times5 math operation multiply
    node lo-6 lowpass mode lowpass cutoff 2600hz resonance 0.308309
    node gain7 math operation scale amount 0.0277128
    node plus8 math operation add
    node body9 modal_bank profile felt-afterhours-box max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain10 math operation scale amount 0.2
    node plus11 math operation add
    node hi-12 lowpass mode highpass cutoff 32hz resonance 0.308309
    node lo-13 lowpass mode lowpass cutoff 4200hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.189459
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus strike1-audio-fall4-audio strike1.audio -> fall4.audio
    bus hiss3-audio-times5-a hiss3.audio -> times5.a
    bus fall4-audio-times5-b fall4.audio -> times5.b
    bus times5-audio-lo-6-audio times5.audio -> lo-6.audio
    bus lo-6-audio-gain7-a lo-6.audio -> gain7.a
    bus body2-audio-plus8-a body2.audio -> plus8.a
    bus gain7-audio-plus8-b gain7.audio -> plus8.b
    bus plus8-audio-body9-audio plus8.audio -> body9.audio
    bus note-pitch-body9-pitch note.pitch -> body9.pitch
    bus note-gate-body9-gate note.gate -> body9.gate
    bus body9-audio-gain10-a body9.audio -> gain10.a
    bus plus8-audio-plus11-a plus8.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-hi-12-audio plus11.audio -> hi-12.audio
    bus hi-12-audio-lo-13-audio hi-12.audio -> lo-13.audio
    bus lo-13-audio-register-a lo-13.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
