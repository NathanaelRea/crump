crump-module 2
instrument udu "Udu" graph {
  polyphony 4
  parameter upper-stroke "Upper stroke" ratio 0 1 0 0 modulatable
  parameter lower-stroke "Lower stroke" ratio 0 1 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-step note_key per_voice unipolar reference C4 range 1st
    route key-upper source key-step target upper-stroke depth 1 map unipolar curve linear order 0 bypass false
    route key-lower source key-step target lower-stroke depth -1 map unipolar curve linear order 0 bypass false
  }
  graph voice 49 {
    # Layers of simpler models, each peak-normalised.
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall1 onepole mode leak time 0.07s
    node fall2 onepole mode leak time 0.15s
    node fall3 math operation add
    node fall3-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall3-leak math operation scale amount 1
    node hold4 math operation min
    node gain5 math operation scale amount 1.7046
    node tone6-pitch constant frequency 88hz
    node tone6 analog_oscillator waveform sine level 1.41421 fm_depth -7.45786st am_mode ring am_depth 1
    node tone6-mono stereo_to_mono
    node gain7 math operation scale amount 1
    node gain8 math operation scale amount 1
    node strike9 exciter kind impact contact 0.000672222s hardness 0.3 level 1
    node body10 modal_bank profile udu-bass-l1-body max_modes 3 key_track 0 decay_scale $ring brightness 0 level 1
    node hiss11 noise level 1
    node fall12 onepole mode leak time 0.002s
    node times13 math operation multiply
    node hi-14 lowpass mode highpass cutoff 2000hz resonance 0.308309
    node lo-15 lowpass mode lowpass cutoff 12000hz resonance 0.308309
    node gain16 math operation scale amount 0.34401
    node plus17 math operation add
    node gain18 math operation scale amount 0.263585
    node plus19 math operation add
    node hi-20 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain21 math operation scale amount $lower-stroke
    node strike22 exciter kind impact contact 0.000168056s hardness 0.3 level 1
    node body23 modal_bank profile udu-tap-l0-body max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node hiss24 noise level 1
    node times25 math operation multiply
    node hi-26 lowpass mode highpass cutoff 2000hz resonance 0.308309
    node lo-27 lowpass mode lowpass cutoff 12000hz resonance 0.308309
    node gain28 math operation scale amount 1.22605
    node plus29 math operation add
    node gain30 math operation scale amount 0.306328
    node fall31 onepole mode leak time 0.1s
    node tone32-pitch constant frequency 137hz
    node tone32 analog_oscillator waveform sine level 1.41421 am_mode ring am_depth 1
    node tone32-mono stereo_to_mono
    node gain33 math operation scale amount 1
    node gain34 math operation scale amount 0.0254561
    node plus35 math operation add
    node hi-36 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain37 math operation scale amount $upper-stroke
    node plus38 math operation add
    node trim math operation scale amount 0.227616
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus onset-audio-fall1-audio onset.audio -> fall1.audio
    bus onset-audio-fall2-audio onset.audio -> fall2.audio
    bus fall3-audio-fall3-previous-audio fall3.audio -> fall3-previous.audio
    bus onset-audio-fall3-a onset.audio -> fall3.a
    bus fall3-previous-audio-fall3-leak-a fall3-previous.audio -> fall3-leak.a
    bus fall3-leak-audio-fall3-b fall3-leak.audio -> fall3.b
    bus fall3-audio-hold4-a fall3.audio -> hold4.a
    bus fall2-audio-gain5-a fall2.audio -> gain5.a
    bus gain5-audio-hold4-b gain5.audio -> hold4.b
    bus tone6-pitch-pitch-tone6-pitch tone6-pitch.pitch -> tone6.pitch
    bus fall1-audio-tone6-fm fall1.audio -> tone6.fm
    bus hold4-audio-tone6-am hold4.audio -> tone6.am
    bus tone6-audio-tone6-mono-audio tone6.audio -> tone6-mono.audio
    bus tone6-mono-audio-gain7-a tone6-mono.audio -> gain7.a
    bus gain7-audio-gain8-a gain7.audio -> gain8.a
    bus note-gate-strike9-gate note.gate -> strike9.gate
    bus note-velocity-strike9-velocity note.velocity -> strike9.velocity
    bus strike9-audio-body10-audio strike9.audio -> body10.audio
    bus note-pitch-body10-pitch note.pitch -> body10.pitch
    bus note-gate-body10-gate note.gate -> body10.gate
    bus onset-audio-fall12-audio onset.audio -> fall12.audio
    bus hiss11-audio-times13-a hiss11.audio -> times13.a
    bus fall12-audio-times13-b fall12.audio -> times13.b
    bus times13-audio-hi-14-audio times13.audio -> hi-14.audio
    bus hi-14-audio-lo-15-audio hi-14.audio -> lo-15.audio
    bus lo-15-audio-gain16-a lo-15.audio -> gain16.a
    bus body10-audio-plus17-a body10.audio -> plus17.a
    bus gain16-audio-plus17-b gain16.audio -> plus17.b
    bus plus17-audio-gain18-a plus17.audio -> gain18.a
    bus gain8-audio-plus19-a gain8.audio -> plus19.a
    bus gain18-audio-plus19-b gain18.audio -> plus19.b
    bus plus19-audio-hi-20-audio plus19.audio -> hi-20.audio
    bus hi-20-audio-gain21-a hi-20.audio -> gain21.a
    bus note-gate-strike22-gate note.gate -> strike22.gate
    bus note-velocity-strike22-velocity note.velocity -> strike22.velocity
    bus strike22-audio-body23-audio strike22.audio -> body23.audio
    bus note-pitch-body23-pitch note.pitch -> body23.pitch
    bus note-gate-body23-gate note.gate -> body23.gate
    bus hiss24-audio-times25-a hiss24.audio -> times25.a
    bus fall12-audio-times25-b fall12.audio -> times25.b
    bus times25-audio-hi-26-audio times25.audio -> hi-26.audio
    bus hi-26-audio-lo-27-audio hi-26.audio -> lo-27.audio
    bus lo-27-audio-gain28-a lo-27.audio -> gain28.a
    bus body23-audio-plus29-a body23.audio -> plus29.a
    bus gain28-audio-plus29-b gain28.audio -> plus29.b
    bus plus29-audio-gain30-a plus29.audio -> gain30.a
    bus onset-audio-fall31-audio onset.audio -> fall31.audio
    bus tone32-pitch-pitch-tone32-pitch tone32-pitch.pitch -> tone32.pitch
    bus fall31-audio-tone32-am fall31.audio -> tone32.am
    bus tone32-audio-tone32-mono-audio tone32.audio -> tone32-mono.audio
    bus tone32-mono-audio-gain33-a tone32-mono.audio -> gain33.a
    bus gain33-audio-gain34-a gain33.audio -> gain34.a
    bus gain30-audio-plus35-a gain30.audio -> plus35.a
    bus gain34-audio-plus35-b gain34.audio -> plus35.b
    bus plus35-audio-hi-36-audio plus35.audio -> hi-36.audio
    bus hi-36-audio-gain37-a hi-36.audio -> gain37.a
    bus gain21-audio-plus38-a gain21.audio -> plus38.a
    bus gain37-audio-plus38-b gain37.audio -> plus38.b
    bus plus38-audio-trim-a plus38.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile udu-bass-l1-body {
  root 1000hz
  mode m0 frequency 1000hz decay 0.05s gain 1 after_decay 0.05s after_gain 0
  mode m1 frequency 1500hz decay 0.0368894s gain 0.654674 after_decay 0.0368894s after_gain 0
  mode m2 frequency 2000hz decay 0.0297302s gain 0.524814 after_decay 0.0297302s after_gain 0
}
profile udu-tap-l0-body {
  root 1000hz
  mode m0 frequency 1000hz decay 0.06s gain 0.6 after_decay 0.06s after_gain 0
  mode m1 frequency 1410hz decay 0.04637s gain 0.654674 after_decay 0.04637s after_gain 0
  mode m2 frequency 1500hz decay 0.0442673s gain 0.524814 after_decay 0.0442673s after_gain 0
  mode m3 frequency 1960hz decay 0.0362209s gain 0.654442 after_decay 0.0362209s after_gain 0
  mode m4 frequency 2000hz decay 0.0356762s gain 0.765082 after_decay 0.0356762s after_gain 0
}
