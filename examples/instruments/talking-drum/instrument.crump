crump-module 2
instrument talking-drum "Talking Drum" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z50-soft-0 asset talking-drum-50-soft-0 keys C3 F3 velocity 0 0.65 root D3
      zone z50-hard-0 asset talking-drum-50-hard-0 keys C3 F3 velocity 0.65 1 root D3
      zone z56-soft-0 asset talking-drum-56-soft-0 keys F#3 B3 velocity 0 0.65 root G#3
      zone z56-hard-0 asset talking-drum-56-hard-0 keys F#3 B3 velocity 0.65 1 root G#3
      zone z62-soft-0 asset talking-drum-62-soft-0 keys C4 F4 velocity 0 0.65 root D4
      zone z62-hard-0 asset talking-drum-62-hard-0 keys C4 F4 velocity 0.65 1 root D4
      zone z68-soft-0 asset talking-drum-68-soft-0 keys F#4 C5 velocity 0 0.65 root G#4
      zone z68-hard-0 asset talking-drum-68-hard-0 keys F#4 C5 velocity 0.65 1 root G#4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
