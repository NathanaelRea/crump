crump 2
import "instrument.crump"
project "Talking Drum" {
  id example-talking-drum
  seed 997794
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat A3 0.25beat 0.92
      note 4beat A3 2beat 0.48
      note 8beat D3 0.5beat 0.85
      note 10beat E4 0.25beat 0.65
      note 12beat A4 0.75beat 0.8
      note 16beat A3 0.4beat 0.75
      note 16.5beat C#4 0.4beat 0.75
      note 17beat E4 0.4beat 0.75
      note 17.5beat A4 0.4beat 0.75
      note 18.5beat A4 0.4beat 0.75
      note 19beat E4 0.4beat 0.75
      note 19.5beat C#4 0.4beat 0.75
      note 24beat A3 0.2beat 0.55
      note 24.25beat B3 0.2beat 0.6
      note 24.5beat C#4 0.2beat 0.65
      note 24.75beat D4 0.2beat 0.55
      note 25beat E4 0.2beat 0.6
      note 25.25beat F#4 0.2beat 0.65
      note 25.5beat G#4 0.2beat 0.55
      note 25.75beat A4 0.2beat 0.6
    }
    track instrument "Talking Drum" instrument talking-drum level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
