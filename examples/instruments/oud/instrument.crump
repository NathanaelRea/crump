crump-module 2
instrument oud "Oud" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.996158 0.996158 modulatable
  parameter room "Room" ratio 0 1 0 0
  parameter register "Register level" ratio 0.05 20 1.10917 1.10917 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-c4-24 note_key per_voice bipolar reference C4 range 24st
    source key-from-e2-3 note_key per_voice bipolar reference E2 range 3st
    source key-from-g2-3 note_key per_voice bipolar reference G2 range 3st
    source key-from-as2-3 note_key per_voice bipolar reference A#2 range 3st
    source key-from-cs3-3 note_key per_voice bipolar reference C#3 range 3st
    source key-from-e3-3 note_key per_voice bipolar reference E3 range 3st
    source key-from-g3-3 note_key per_voice bipolar reference G3 range 3st
    source key-from-as3-3 note_key per_voice bipolar reference A#3 range 3st
    source key-from-cs4-3 note_key per_voice bipolar reference C#4 range 3st
    source key-from-e4-3 note_key per_voice bipolar reference E4 range 3st
    source key-from-g4-3 note_key per_voice bipolar reference G4 range 3st
    source key-from-as4-3 note_key per_voice bipolar reference A#4 range 3st
    source key-from-cs5-3 note_key per_voice bipolar reference C#5 range 3st
    source key-from-e5-1 note_key per_voice bipolar reference E5 range 1st
    source velocity note_velocity per_voice unipolar
    route sustain-low source key-c4-24 target sustain depth 0.00992515 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route sustain-high source key-c4-24 target sustain depth 0.00364215 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-1 source key-from-e2-3 target register depth -0.217924 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-g2-3 target register depth -0.215168 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-as2-3 target register depth 0.0318628 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-cs3-3 target register depth 0.193625 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-e3-3 target register depth 0.273326 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-g3-3 target register depth -0.313904 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-as3-3 target register depth -0.251457 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-cs4-3 target register depth 1.57822 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-e4-3 target register depth -1.15262 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-g4-3 target register depth -0.0690913 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-as4-3 target register depth 0.479389 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-12 source key-from-cs5-3 target register depth 0.395332 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-13 source key-from-e5-1 target register depth 0.945349 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 58 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.00673081s hardness 0.4 level 1
    node scrape noise level 1
    node scrape-band biquad mode bandpass frequency 2000hz q 0.47619
    node scrape-env envelope mode adsr attack 0.0005s decay 0.005s sustain 0 release 0.005s
    node scrape-env-audio to_audio
    node scrape-burst math operation multiply
    node scrape-level math operation scale amount 0.751045
    node attack sum max_inputs 2
    node released onepole mode leak time 0.00266146s
    node released-dc dc_block cutoff 25hz
    node finger lowpass mode lowpass cutoff 4126.12hz resonance 0.05 velocity_depth 6980.05hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.0576717 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.5
    node string delay_line mode pitch ratio 1 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node twang envelope mode adsr attack 0s decay 0.08s sustain 0 release 0.08s decay_curve -0.6
    node twang-audio to_audio
    node twang-velocity math operation multiply
    node velocity-audio to_audio
    node twang-amount math operation scale amount -0.00315956
    node bridge math operation add
    node loss linear_phase_lowpass amount 0.0419189
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.5
    node string2 delay_line mode pitch ratio 0.99855699 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node bridge2 math operation add
    node loss2 linear_phase_lowpass amount 0.0419189
    node trim-loss2 math operation scale amount 0.998
    node return2 math operation scale amount $sustain
    node strings sum max_inputs 2
    node bridge-dc dc_block cutoff 20hz
    node body modal_bank profile oud-body max_modes 16 key_track 0 decay_scale 1 brightness 0 level 1
    node direct math operation scale amount 1
    node wood math operation scale amount 0
    node radiated math operation add
    node knock-env envelope mode adsr attack 0.001s decay 0.345937s sustain 0 release 0.345937s decay_curve -0.7
    node knock-env-audio to_audio
    node knock-low biquad mode highpass frequency 150hz q 0.7071
    node knock-band biquad mode lowpass frequency 3498.73hz q 0.7071
    node knock-burst math operation multiply
    node knock-velocity math operation multiply
    node knock-level math operation scale amount 0.0630637
    node with-knock math operation add
    node formant1 biquad mode peak frequency 264.579hz q 2 gain 11.7853db
    node formant2 biquad mode peak frequency 157.507hz q 1.46227 gain 9.02001db
    node formant3 biquad mode peak frequency 1942.76hz q 2 gain -7.18181db
    node formant4 biquad mode peak frequency 1129.97hz q 1.60354 gain 12db
    node formant5 biquad mode peak frequency 11581.7hz q 0.683739 gain 9.35993db
    node formant6 biquad mode peak frequency 6785.76hz q 2 gain 10.8633db
    node formant7 biquad mode lowshelf frequency 232.542hz q 0.7071 gain 8.80046db
    node formant8 biquad mode highshelf frequency 2667.63hz q 0.7071 gain -11.9999db
    node radiation biquad mode highpass frequency 50hz q 0.7071
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.103668
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus scrape-audio-scrape-band-audio scrape.audio -> scrape-band.audio
    bus note-gate-scrape-env-gate note.gate -> scrape-env.gate
    bus scrape-env-control-scrape-env-audio-control scrape-env.control -> scrape-env-audio.control
    bus scrape-band-audio-scrape-burst-a scrape-band.audio -> scrape-burst.a
    bus scrape-env-audio-audio-scrape-burst-b scrape-env-audio.audio -> scrape-burst.b
    bus scrape-burst-audio-scrape-level-a scrape-burst.audio -> scrape-level.a
    bus pluck-audio-attack-inputs pluck.audio -> attack.inputs
    bus scrape-level-audio-attack-inputs scrape-level.audio -> attack.inputs
    bus attack-audio-released-audio attack.audio -> released.audio
    bus released-audio-released-dc-audio released.audio -> released-dc.audio
    bus released-dc-audio-finger-audio released-dc.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus note-gate-twang-gate note.gate -> twang.gate
    bus twang-control-twang-audio-control twang.control -> twang-audio.control
    bus twang-audio-audio-twang-velocity-a twang-audio.audio -> twang-velocity.a
    bus note-velocity-velocity-audio-control note.velocity -> velocity-audio.control
    bus velocity-audio-audio-twang-velocity-b velocity-audio.audio -> twang-velocity.b
    bus twang-velocity-audio-twang-amount-a twang-velocity.audio -> twang-amount.a
    bus twang-amount-audio-string-time-mod twang-amount.audio -> string.time_mod
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus loss-audio-return-a loss.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus twang-amount-audio-string2-time-mod twang-amount.audio -> string2.time_mod
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus loss2-audio-trim-loss2-a loss2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus bridge-dc-audio-body-audio bridge-dc.audio -> body.audio
    bus note-pitch-body-pitch note.pitch -> body.pitch
    bus note-gate-body-gate note.gate -> body.gate
    bus bridge-dc-audio-direct-a bridge-dc.audio -> direct.a
    bus body-audio-wood-a body.audio -> wood.a
    bus direct-audio-radiated-a direct.audio -> radiated.a
    bus wood-audio-radiated-b wood.audio -> radiated.b
    bus note-gate-knock-env-gate note.gate -> knock-env.gate
    bus knock-env-control-knock-env-audio-control knock-env.control -> knock-env-audio.control
    bus scrape-audio-knock-low-audio scrape.audio -> knock-low.audio
    bus knock-low-audio-knock-band-audio knock-low.audio -> knock-band.audio
    bus knock-band-audio-knock-burst-a knock-band.audio -> knock-burst.a
    bus knock-env-audio-audio-knock-burst-b knock-env-audio.audio -> knock-burst.b
    bus knock-burst-audio-knock-velocity-a knock-burst.audio -> knock-velocity.a
    bus velocity-audio-audio-knock-velocity-b velocity-audio.audio -> knock-velocity.b
    bus knock-velocity-audio-knock-level-a knock-velocity.audio -> knock-level.a
    bus radiated-audio-with-knock-a radiated.audio -> with-knock.a
    bus knock-level-audio-with-knock-b knock-level.audio -> with-knock.b
    bus with-knock-audio-formant1-audio with-knock.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-radiation-audio formant8.audio -> radiation.audio
    bus radiation-audio-register-level-a radiation.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
  graph shared 2 {
    node room-reverb reverb room 0.35 damping 0.6 mix $room
    node shared-out output
    bus voice-sum voice_sum.audio -> room-reverb.audio
    bus shared-output room-reverb.audio -> shared-out.audio
  }
}
profile oud-body {
  root 261.626hz
  mode m0 frequency 83.3hz decay 0.0292856s gain 0.00113822 after_decay 0.0292856s after_gain 0
  mode m1 frequency 166.6hz decay 0.0244047s gain 0.00170732 after_decay 0.0244047s after_gain 0
  mode m2 frequency 199.8hz decay 0.0195237s gain 0.00106708 after_decay 0.0195237s after_gain 0
  mode m3 frequency 327.2hz decay 0.0146428s gain 0.00170732 after_decay 0.0146428s after_gain 0
  mode m4 frequency 374hz decay 0.0117142s gain 0.00177846 after_decay 0.0117142s after_gain 0
  mode m5 frequency 471.8hz decay 0.00976187s gain 0.00192074 after_decay 0.00976187s after_gain 0
  mode m6 frequency 552.5hz decay 0.00878568s gain 0.00189703 after_decay 0.00878568s after_gain 0
  mode m7 frequency 671.5hz decay 0.0078095s gain 0.00186738 after_decay 0.0078095s after_gain 0
  mode m8 frequency 786.2hz decay 0.00683331s gain 0.00213415 after_decay 0.00683331s after_gain 0
  mode m9 frequency 935hz decay 0.00585712s gain 0.00213415 after_decay 0.00585712s after_gain 0
  mode m10 frequency 1147.5hz decay 0.00488094s gain 0.00256098 after_decay 0.00488094s after_gain 0
  mode m11 frequency 1377hz decay 0.00439284s gain 0.00265584 after_decay 0.00439284s after_gain 0
  mode m12 frequency 1657.5hz decay 0.00390475s gain 0.00266769 after_decay 0.00390475s after_gain 0
  mode m13 frequency 2040hz decay 0.00341665s gain 0.00268294 after_decay 0.00341665s after_gain 0
  mode m14 frequency 2465hz decay 0.00292856s gain 0.00284554 after_decay 0.00292856s after_gain 0
  mode m15 frequency 2975hz decay 0.00244047s gain 0.00307318 after_decay 0.00244047s after_gain 0
}
