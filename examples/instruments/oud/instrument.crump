crump-module 2
instrument oud "Oud" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z41-soft-0 asset oud-41-soft-0 keys E2 G#2 velocity 0 0.65 root F2
      zone z41-hard-0 asset oud-41-hard-0 keys E2 G#2 velocity 0.65 1 root F2
      zone z47-soft-0 asset oud-47-soft-0 keys A2 D3 velocity 0 0.65 root B2
      zone z47-hard-0 asset oud-47-hard-0 keys A2 D3 velocity 0.65 1 root B2
      zone z53-soft-0 asset oud-53-soft-0 keys D#3 G#3 velocity 0 0.65 root F3
      zone z53-hard-0 asset oud-53-hard-0 keys D#3 G#3 velocity 0.65 1 root F3
      zone z59-soft-0 asset oud-59-soft-0 keys A3 D4 velocity 0 0.65 root B3
      zone z59-hard-0 asset oud-59-hard-0 keys A3 D4 velocity 0.65 1 root B3
      zone z65-soft-0 asset oud-65-soft-0 keys D#4 G#4 velocity 0 0.65 root F4
      zone z65-hard-0 asset oud-65-hard-0 keys D#4 G#4 velocity 0.65 1 root F4
      zone z71-soft-0 asset oud-71-soft-0 keys A4 D5 velocity 0 0.65 root B4
      zone z71-hard-0 asset oud-71-hard-0 keys A4 D5 velocity 0.65 1 root B4
      zone z77-soft-0 asset oud-77-soft-0 keys D#5 F5 velocity 0 0.65 root F5
      zone z77-hard-0 asset oud-77-hard-0 keys D#5 F5 velocity 0.65 1 root F5
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
