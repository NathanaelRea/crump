crump-module 2
instrument motor-vibes "Motor Vibes" graph {
  polyphony 8
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-gain-curve key_curve per_voice unipolar {
      point c3 key C3 value 1
      point c4 key C4 value 0
      point c5 key C5 value 0.298469
    }
    route key-gain-by-key source key-gain-curve target key-gain depth 0.0594966 map unipolar curve linear order 0 bypass false
  }
  graph voice 13 {
    # A mallet on a tuned bar's modes, optionally through a pickup.
    node strike1 exciter kind impact contact 9.08893e-05s hardness $hardness level 1
    node body2 modal_bank profile motor-vibes-bar max_modes 4 key_track 1 decay_scale $ring brightness 0 level 1
    node hi-3 lowpass mode highpass cutoff 32hz resonance 0.308309
    node tremolo lfo waveform sine rate 4.1hz depth 1 phase 0.25 polarity bipolar retrigger note
    node tremolo-audio to_audio
    node tremolo-depth math operation scale amount 0.22
    node tremolo-gain math operation offset amount 0.78
    node times4 math operation multiply
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.107104
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-hi-3-audio body2.audio -> hi-3.audio
    bus tremolo-control-tremolo-audio-control tremolo.control -> tremolo-audio.control
    bus tremolo-audio-audio-tremolo-depth-a tremolo-audio.audio -> tremolo-depth.a
    bus tremolo-depth-audio-tremolo-gain-a tremolo-depth.audio -> tremolo-gain.a
    bus hi-3-audio-times4-a hi-3.audio -> times4.a
    bus tremolo-gain-audio-times4-b tremolo-gain.audio -> times4.b
    bus times4-audio-register-a times4.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile motor-vibes-bar {
  root 261.626hz
  mode m0 frequency 261.626hz decay 3.01498s gain 1 after_decay 3.01498s after_gain 0
  mode m1 frequency 1046.5hz decay 0.416985s gain 0.231527 after_decay 0.416985s after_gain 0
  mode m2 frequency 2616.26hz decay 0.112783s gain 0.687046 after_decay 0.112783s after_gain 0
  mode m3 frequency 4761.59hz decay 0.0479857s gain 0.316995 after_decay 0.0479857s after_gain 0
}
