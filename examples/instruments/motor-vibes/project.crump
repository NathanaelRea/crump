crump 2
import "instrument.crump"
project "Motor Vibes" {
  id example-motor-vibes
  seed 467221
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C4 0.25beat 0.92
      note 4beat C4 2beat 0.48
      note 8beat C3 0.5beat 0.85
      note 10beat G4 0.25beat 0.65
      note 12beat C5 0.75beat 0.8
      note 16beat C3 0.5beat 0.65
      note 16beat G3 0.5beat 0.65
      note 16beat A#3 0.5beat 0.65
      note 16beat D#4 0.5beat 0.65
    }
    track instrument "Motor Vibes" instrument motor-vibes level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
