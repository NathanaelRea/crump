crump-module 2
instrument ride-bell "Ride Bell" graph {
  polyphony 3
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.4 0.4
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 27 {
    # Layers of simpler models, each peak-normalised.
    node strike1 exciter kind impact contact 0.0001936s hardness $hardness level 1
    node body2 modal_bank profile ride-bell-l0-rod max_modes 14 key_track 0 decay_scale $ring brightness 0 level 1
    node hiss3 noise level 1
    node fall4 onepole mode leak time 0.0008s
    node times5 math operation multiply
    node hi-6 lowpass mode highpass cutoff 6000hz resonance 0.308309
    node gain7 math operation scale amount 1.28984
    node plus8 math operation add
    node hi-9 lowpass mode highpass cutoff 400hz resonance 0.308309
    node gain10 math operation scale amount 0.366522
    node strike11 exciter kind impact contact 7.26e-05s hardness 0.3 level 1
    node body12 modal_bank profile ride-bell-l1-plate max_modes 90 key_track 0 decay_scale 1 brightness 0 level 1
    node hiss13 noise level 1
    node fall14 onepole mode leak time 0.105s
    node times15 math operation multiply
    node hi-16 lowpass mode highpass cutoff 2500hz resonance 0.308309
    node lo-17 lowpass mode lowpass cutoff 17000hz resonance 0.308309
    node gain18 math operation scale amount 0.207846
    node plus19 math operation add
    node hi-20 lowpass mode highpass cutoff 800hz resonance 0.308309
    node gain21 math operation scale amount 0.36694
    node plus22 math operation add
    node hi-23 lowpass mode highpass cutoff 32hz resonance 0.308309
    node trim math operation scale amount 0.214711
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus strike1-audio-fall4-audio strike1.audio -> fall4.audio
    bus hiss3-audio-times5-a hiss3.audio -> times5.a
    bus fall4-audio-times5-b fall4.audio -> times5.b
    bus times5-audio-hi-6-audio times5.audio -> hi-6.audio
    bus hi-6-audio-gain7-a hi-6.audio -> gain7.a
    bus body2-audio-plus8-a body2.audio -> plus8.a
    bus gain7-audio-plus8-b gain7.audio -> plus8.b
    bus plus8-audio-hi-9-audio plus8.audio -> hi-9.audio
    bus hi-9-audio-gain10-a hi-9.audio -> gain10.a
    bus note-gate-strike11-gate note.gate -> strike11.gate
    bus note-velocity-strike11-velocity note.velocity -> strike11.velocity
    bus strike11-audio-body12-audio strike11.audio -> body12.audio
    bus note-pitch-body12-pitch note.pitch -> body12.pitch
    bus note-gate-body12-gate note.gate -> body12.gate
    bus strike1-audio-fall14-audio strike1.audio -> fall14.audio
    bus hiss13-audio-times15-a hiss13.audio -> times15.a
    bus fall14-audio-times15-b fall14.audio -> times15.b
    bus times15-audio-hi-16-audio times15.audio -> hi-16.audio
    bus hi-16-audio-lo-17-audio hi-16.audio -> lo-17.audio
    bus lo-17-audio-gain18-a lo-17.audio -> gain18.a
    bus body12-audio-plus19-a body12.audio -> plus19.a
    bus gain18-audio-plus19-b gain18.audio -> plus19.b
    bus plus19-audio-hi-20-audio plus19.audio -> hi-20.audio
    bus hi-20-audio-gain21-a hi-20.audio -> gain21.a
    bus gain10-audio-plus22-a gain10.audio -> plus22.a
    bus gain21-audio-plus22-b gain21.audio -> plus22.b
    bus plus22-audio-hi-23-audio plus22.audio -> hi-23.audio
    bus hi-23-audio-trim-a hi-23.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
