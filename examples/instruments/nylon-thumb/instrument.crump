crump-module 2
instrument nylon-thumb "Nylon Thumb" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.997516 0.997516 modulatable
  parameter room "Room" ratio 0 1 0.271538 0.271538
  parameter register "Register level" ratio 0.05 20 0.822243 0.822243 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source sustain-curve key_curve per_voice bipolar {
      point c2 key C2 value -1
      point c4 key C4 value 0
      point c6 key C6 value 0.389086
    }
    source register-curve key_curve per_voice bipolar {
      point c1 key C1 value 0
      point ds1 key D#1 value 0.117728
      point fs1 key F#1 value 0.167911
      point a1 key A1 value 0.0169855
      point c2 key C2 value 0.829797
      point ds2 key D#2 value 0.597722
      point fs2 key F#2 value 0.14749
      point a2 key A2 value 0.0432067
      point c3 key C3 value -0.274372
      point ds3 key D#3 value -0.252937
      point fs3 key F#3 value -0.470468
      point a3 key A3 value -0.136484
      point c4 key C4 value 0.0611983
      point ds4 key D#4 value 0.188806
      point fs4 key F#4 value -0.438898
      point a4 key A4 value -0.230491
      point c5 key C5 value 0.21019
      point ds5 key D#5 value 0.644353
      point fs5 key F#5 value 0.644353
      point a5 key A5 value 0.523495
      point c6 key C6 value 0.922173
      point ds6 key D#6 value 1
      point fs6 key F#6 value 0.759631
      point g6 key G6 value 0.567518
    }
    route sustain-by-key source sustain-curve target sustain depth 0.00587086 map bipolar curve linear order 0 bypass false
    route register-by-key source register-curve target register depth 1.1276 map bipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 49 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.000351502s hardness 0.2 level 1
    node scrape noise level 1
    node scrape-band biquad mode bandpass frequency 2000hz q 0.47619
    node scrape-env envelope mode adsr attack 0.0005s decay 0.008s sustain 0 release 0.008s
    node scrape-env-audio to_audio
    node scrape-burst math operation multiply
    node scrape-level math operation scale amount 0.239426
    node attack sum max_inputs 2
    node released onepole mode leak time 0.000740886s
    node released-dc dc_block cutoff 25hz
    node finger lowpass mode lowpass cutoff 652.269hz resonance 0.05 velocity_depth 9906.75hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.196205 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.6
    node string delay_line mode pitch ratio 1 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node twang envelope mode adsr attack 0s decay 0.08s sustain 0 release 0.08s decay_curve -0.6
    node twang-audio to_audio
    node twang-velocity math operation multiply
    node velocity-audio to_audio
    node twang-amount math operation scale amount -0.0068656
    node bridge math operation add
    node loss linear_phase_lowpass amount 1
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.4
    node string2 delay_line mode pitch ratio 0.99953801 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node bridge2 math operation add
    node loss2 linear_phase_lowpass amount 1
    node trim-loss2 math operation scale amount 0.9985
    node return2 math operation scale amount $sustain
    node strings sum max_inputs 2
    node bridge-dc dc_block cutoff 20hz
    node body modal_bank profile nylon-thumb-body max_modes 16 key_track 0 decay_scale 1 brightness 0 level 1
    node direct math operation scale amount 0.297323
    node wood math operation scale amount 0.702677
    node radiated math operation add
    node knock-env envelope mode adsr attack 0.001s decay 0.0457636s sustain 0 release 0.0457636s decay_curve -0.7
    node knock-env-audio to_audio
    node knock-filter biquad_chain {
      band knock-low mode highpass frequency 150hz q 0.7071
      band knock-band mode lowpass frequency 1508.82hz q 0.7071
    }
    node knock-burst math operation multiply
    node knock-velocity math operation multiply
    node knock-level math operation scale amount 0
    node with-knock math operation add
    node formants biquad_chain {
      band formant1 mode peak frequency 2068.37hz q 1.80984 gain -5.78417db
      band formant2 mode peak frequency 144.647hz q 1.58198 gain -6.05209db
      band formant3 mode peak frequency 491.748hz q 0.5 gain 12db
      band formant4 mode peak frequency 2543.97hz q 2 gain -9.16795db
      band formant5 mode peak frequency 731.595hz q 2 gain -11.1037db
      band formant6 mode peak frequency 934.978hz q 1.29035 gain -7.49081db
      band formant7 mode lowshelf frequency 140.296hz q 0.7071 gain -12db
      band formant8 mode highshelf frequency 2188.11hz q 0.7071 gain 4.39036db
      band radiation mode highpass frequency 60hz q 0.7071
    }
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.808537
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus scrape-audio-scrape-band-audio scrape.audio -> scrape-band.audio
    bus note-gate-scrape-env-gate note.gate -> scrape-env.gate
    bus scrape-env-control-scrape-env-audio-control scrape-env.control -> scrape-env-audio.control
    bus scrape-band-audio-scrape-burst-a scrape-band.audio -> scrape-burst.a
    bus scrape-env-audio-audio-scrape-burst-b scrape-env-audio.audio -> scrape-burst.b
    bus scrape-burst-audio-scrape-level-a scrape-burst.audio -> scrape-level.a
    bus pluck-audio-attack-inputs pluck.audio -> attack.inputs
    bus scrape-level-audio-attack-inputs scrape-level.audio -> attack.inputs
    bus attack-audio-released-audio attack.audio -> released.audio
    bus released-audio-released-dc-audio released.audio -> released-dc.audio
    bus released-dc-audio-finger-audio released-dc.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus note-gate-twang-gate note.gate -> twang.gate
    bus twang-control-twang-audio-control twang.control -> twang-audio.control
    bus twang-audio-audio-twang-velocity-a twang-audio.audio -> twang-velocity.a
    bus note-velocity-velocity-audio-control note.velocity -> velocity-audio.control
    bus velocity-audio-audio-twang-velocity-b velocity-audio.audio -> twang-velocity.b
    bus twang-velocity-audio-twang-amount-a twang-velocity.audio -> twang-amount.a
    bus twang-amount-audio-string-time-mod twang-amount.audio -> string.time_mod
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus loss-audio-return-a loss.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus twang-amount-audio-string2-time-mod twang-amount.audio -> string2.time_mod
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus loss2-audio-trim-loss2-a loss2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus bridge-dc-audio-body-audio bridge-dc.audio -> body.audio
    bus note-pitch-body-pitch note.pitch -> body.pitch
    bus note-gate-body-gate note.gate -> body.gate
    bus bridge-dc-audio-direct-a bridge-dc.audio -> direct.a
    bus body-audio-wood-a body.audio -> wood.a
    bus direct-audio-radiated-a direct.audio -> radiated.a
    bus wood-audio-radiated-b wood.audio -> radiated.b
    bus note-gate-knock-env-gate note.gate -> knock-env.gate
    bus knock-env-control-knock-env-audio-control knock-env.control -> knock-env-audio.control
    bus scrape-audio-knock-filter-audio scrape.audio -> knock-filter.audio
    bus knock-filter-audio-knock-burst-a knock-filter.audio -> knock-burst.a
    bus knock-env-audio-audio-knock-burst-b knock-env-audio.audio -> knock-burst.b
    bus knock-burst-audio-knock-velocity-a knock-burst.audio -> knock-velocity.a
    bus velocity-audio-audio-knock-velocity-b velocity-audio.audio -> knock-velocity.b
    bus knock-velocity-audio-knock-level-a knock-velocity.audio -> knock-level.a
    bus radiated-audio-with-knock-a radiated.audio -> with-knock.a
    bus knock-level-audio-with-knock-b knock-level.audio -> with-knock.b
    bus with-knock-audio-formants-audio with-knock.audio -> formants.audio
    bus formants-audio-register-level-a formants.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
  graph shared 2 {
    node room-reverb reverb room 0.35 damping 0.6 mix $room
    node shared-out output
    bus voice-sum voice_sum.audio -> room-reverb.audio
    bus shared-output room-reverb.audio -> shared-out.audio
  }
}
profile nylon-thumb-body {
  root 261.626hz
  mode m0 frequency 98hz decay 0.03s gain 0.00111111 after_decay 0.03s after_gain 0
  mode m1 frequency 196hz decay 0.025s gain 0.00166667 after_decay 0.025s after_gain 0
  mode m2 frequency 235hz decay 0.02s gain 0.00104167 after_decay 0.02s after_gain 0
  mode m3 frequency 385hz decay 0.015s gain 0.00166667 after_decay 0.015s after_gain 0
  mode m4 frequency 440hz decay 0.012s gain 0.00173611 after_decay 0.012s after_gain 0
  mode m5 frequency 555hz decay 0.01s gain 0.001875 after_decay 0.01s after_gain 0
  mode m6 frequency 650hz decay 0.009s gain 0.00185185 after_decay 0.009s after_gain 0
  mode m7 frequency 790hz decay 0.008s gain 0.00182292 after_decay 0.008s after_gain 0
  mode m8 frequency 925hz decay 0.007s gain 0.00208333 after_decay 0.007s after_gain 0
  mode m9 frequency 1100hz decay 0.006s gain 0.00208333 after_decay 0.006s after_gain 0
  mode m10 frequency 1350hz decay 0.005s gain 0.0025 after_decay 0.005s after_gain 0
  mode m11 frequency 1620hz decay 0.0045s gain 0.00259259 after_decay 0.0045s after_gain 0
  mode m12 frequency 1950hz decay 0.004s gain 0.00260417 after_decay 0.004s after_gain 0
  mode m13 frequency 2400hz decay 0.0035s gain 0.00261905 after_decay 0.0035s after_gain 0
  mode m14 frequency 2900hz decay 0.003s gain 0.00277778 after_decay 0.003s after_gain 0
  mode m15 frequency 3500hz decay 0.0025s gain 0.003 after_decay 0.0025s after_gain 0
}
