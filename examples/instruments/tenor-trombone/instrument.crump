crump-module 2
instrument tenor-trombone "Tenor Trombone" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z40-soft-0 asset tenor-trombone-40-soft-0 keys D2 F#2 velocity 0 0.65 root E2 loop 48000 125479 crossfade 8160
      zone z40-hard-0 asset tenor-trombone-40-hard-0 keys D2 F#2 velocity 0.65 1 root E2 loop 48000 124897 crossfade 8160
      zone z45-soft-0 asset tenor-trombone-45-soft-0 keys G2 B2 velocity 0 0.65 root A2 loop 48000 123803 crossfade 8160
      zone z45-hard-0 asset tenor-trombone-45-hard-0 keys G2 B2 velocity 0.65 1 root A2 loop 48000 125110 crossfade 8160
      zone z50-soft-0 asset tenor-trombone-50-soft-0 keys C3 E3 velocity 0 0.65 root D3 loop 48000 123795 crossfade 8160
      zone z50-hard-0 asset tenor-trombone-50-hard-0 keys C3 E3 velocity 0.65 1 root D3 loop 48000 125756 crossfade 8160
      zone z55-soft-0 asset tenor-trombone-55-soft-0 keys F3 A3 velocity 0 0.65 root G3 loop 48000 125991 crossfade 8160
      zone z55-hard-0 asset tenor-trombone-55-hard-0 keys F3 A3 velocity 0.65 1 root G3 loop 48000 125991 crossfade 8160
      zone z60-soft-0 asset tenor-trombone-60-soft-0 keys A#3 D4 velocity 0 0.65 root C4 loop 48000 124005 crossfade 8160
      zone z60-hard-0 asset tenor-trombone-60-hard-0 keys A#3 D4 velocity 0.65 1 root C4 loop 48000 125838 crossfade 8160
      zone z65-soft-0 asset tenor-trombone-65-soft-0 keys D#4 G4 velocity 0 0.65 root F4 loop 48000 123734 crossfade 8160
      zone z65-hard-0 asset tenor-trombone-65-hard-0 keys D#4 G4 velocity 0.65 1 root F4 loop 48000 125933 crossfade 8160
      zone z70-soft-0 asset tenor-trombone-70-soft-0 keys G#4 C5 velocity 0 0.65 root A#4 loop 48000 125972 crossfade 8160
      zone z70-hard-0 asset tenor-trombone-70-hard-0 keys G#4 C5 velocity 0.65 1 root A#4 loop 48000 123600 crossfade 8160
      zone z75-soft-0 asset tenor-trombone-75-soft-0 keys C#5 G5 velocity 0 0.65 root D#5 loop 48000 123629 crossfade 8160
      zone z75-hard-0 asset tenor-trombone-75-hard-0 keys C#5 G5 velocity 0.65 1 root D#5 loop 48000 125944 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
