crump 2
import "instrument.crump"
project "Tenor Trombone" {
  id example-tenor-trombone
  seed 593925
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat D3 2beat 0.48
      note 2beat E3 1beat 0.7
      note 3beat F#3 1beat 0.7
      note 4beat A3 3beat 0.92
      note 8beat D3 0.35beat 0.85
      note 8.5beat F#3 0.35beat 0.85
      note 9beat A3 0.35beat 0.85
      note 9.5beat D4 0.35beat 0.85
      note 10beat D4 2beat 0.6
      note 12beat A2 3.5beat 0.75
      note 16beat D3 1beat 0.55
      note 17beat E3 1beat 0.6
      note 18beat F#3 1beat 0.65
      note 19beat G3 1beat 0.7
      note 20beat A3 1beat 0.75
      note 21beat B3 1beat 0.8
      note 22beat C#4 1beat 0.85
      note 24beat D4 6beat 0.8
    }
    track instrument "Tenor Trombone" instrument tenor-trombone level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
