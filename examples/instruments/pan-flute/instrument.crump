crump-module 2
instrument pan-flute "Pan Flute" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z57-soft-0 asset pan-flute-57-soft-0 keys G3 C4 velocity 0 0.65 root A3 loop 48000 125788 crossfade 8160
      zone z57-hard-0 asset pan-flute-57-hard-0 keys G3 C4 velocity 0.65 1 root A3 loop 48000 123607 crossfade 8160
      zone z63-soft-0 asset pan-flute-63-soft-0 keys C#4 F#4 velocity 0 0.65 root D#4 loop 48000 123634 crossfade 8160
      zone z63-hard-0 asset pan-flute-63-hard-0 keys C#4 F#4 velocity 0.65 1 root D#4 loop 48000 123634 crossfade 8160
      zone z69-soft-0 asset pan-flute-69-soft-0 keys G4 C5 velocity 0 0.65 root A4 loop 48000 125932 crossfade 8160
      zone z69-hard-0 asset pan-flute-69-hard-0 keys G4 C5 velocity 0.65 1 root A4 loop 48000 125931 crossfade 8160
      zone z75-soft-0 asset pan-flute-75-soft-0 keys C#5 F#5 velocity 0 0.65 root D#5 loop 48000 125928 crossfade 8160
      zone z75-hard-0 asset pan-flute-75-hard-0 keys C#5 F#5 velocity 0.65 1 root D#5 loop 48000 125927 crossfade 8160
      zone z81-soft-0 asset pan-flute-81-soft-0 keys G5 C6 velocity 0 0.65 root A5 loop 48000 125988 crossfade 8160
      zone z81-hard-0 asset pan-flute-81-hard-0 keys G5 C6 velocity 0.65 1 root A5 loop 48000 123636 crossfade 8160
      zone z87-soft-0 asset pan-flute-87-soft-0 keys C#6 G6 velocity 0 0.65 root D#6 loop 48000 124260 crossfade 8160
      zone z87-hard-0 asset pan-flute-87-hard-0 keys C#6 G6 velocity 0.65 1 root D#6 loop 48000 123604 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
