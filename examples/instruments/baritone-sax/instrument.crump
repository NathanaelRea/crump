crump-module 2
instrument baritone-sax "Baritone Sax" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.12s 0.12s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z36-soft-0 asset baritone-sax-36-soft-0 keys C2 D2 velocity 0 0.65 root C2 loop 48000 125043 crossfade 8160
      zone z36-hard-0 asset baritone-sax-36-hard-0 keys C2 D2 velocity 0.65 1 root C2 loop 48000 125774 crossfade 8160
      zone z41-soft-0 asset baritone-sax-41-soft-0 keys D#2 G2 velocity 0 0.65 root F2 loop 48000 125945 crossfade 8160
      zone z41-hard-0 asset baritone-sax-41-hard-0 keys D#2 G2 velocity 0.65 1 root F2 loop 48000 124294 crossfade 8160
      zone z46-soft-0 asset baritone-sax-46-soft-0 keys G#2 C3 velocity 0 0.65 root A#2 loop 48000 124433 crossfade 8160
      zone z46-hard-0 asset baritone-sax-46-hard-0 keys G#2 C3 velocity 0.65 1 root A#2 loop 48000 124841 crossfade 8160
      zone z51-soft-0 asset baritone-sax-51-soft-0 keys C#3 F3 velocity 0 0.65 root D#3 loop 48000 125914 crossfade 8160
      zone z51-hard-0 asset baritone-sax-51-hard-0 keys C#3 F3 velocity 0.65 1 root D#3 loop 48000 125905 crossfade 8160
      zone z56-soft-0 asset baritone-sax-56-soft-0 keys F#3 A#3 velocity 0 0.65 root G#3 loop 48000 123678 crossfade 8160
      zone z56-hard-0 asset baritone-sax-56-hard-0 keys F#3 A#3 velocity 0.65 1 root G#3 loop 48000 124835 crossfade 8160
      zone z61-soft-0 asset baritone-sax-61-soft-0 keys B3 D#4 velocity 0 0.65 root C#4 loop 48000 123731 crossfade 8160
      zone z61-hard-0 asset baritone-sax-61-hard-0 keys B3 D#4 velocity 0.65 1 root C#4 loop 48000 123728 crossfade 8160
      zone z66-soft-0 asset baritone-sax-66-soft-0 keys E4 A4 velocity 0 0.65 root F#4 loop 48000 125940 crossfade 8160
      zone z66-hard-0 asset baritone-sax-66-hard-0 keys E4 A4 velocity 0.65 1 root F#4 loop 48000 125938 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
