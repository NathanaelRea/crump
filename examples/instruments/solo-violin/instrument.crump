crump-module 2
instrument solo-violin "Solo Violin" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.35s 0.35s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z55-soft-0 asset solo-violin-55-soft-0 keys G3 A3 velocity 0 0.65 root G3 loop 48000 125940 crossfade 8160
      zone z55-hard-0 asset solo-violin-55-hard-0 keys G3 A3 velocity 0.65 1 root G3 loop 48000 125939 crossfade 8160
      zone z60-soft-0 asset solo-violin-60-soft-0 keys A#3 D4 velocity 0 0.65 root C4 loop 48000 125890 crossfade 8160
      zone z60-hard-0 asset solo-violin-60-hard-0 keys A#3 D4 velocity 0.65 1 root C4 loop 48000 125889 crossfade 8160
      zone z65-soft-0 asset solo-violin-65-soft-0 keys D#4 G4 velocity 0 0.65 root F4 loop 48000 125985 crossfade 8160
      zone z65-hard-0 asset solo-violin-65-hard-0 keys D#4 G4 velocity 0.65 1 root F4 loop 48000 125985 crossfade 8160
      zone z70-soft-0 asset solo-violin-70-soft-0 keys G#4 C#5 velocity 0 0.65 root A#4 loop 48000 124600 crossfade 8160
      zone z70-hard-0 asset solo-violin-70-hard-0 keys G#4 C#5 velocity 0.65 1 root A#4 loop 48000 124700 crossfade 8160
      zone z76-soft-0 asset solo-violin-76-soft-0 keys D5 G5 velocity 0 0.65 root E5 loop 48000 123641 crossfade 8160
      zone z76-hard-0 asset solo-violin-76-hard-0 keys D5 G5 velocity 0.65 1 root E5 loop 48000 125671 crossfade 8160
      zone z82-soft-0 asset solo-violin-82-soft-0 keys G#5 C#6 velocity 0 0.65 root A#5 loop 48000 124274 crossfade 8160
      zone z82-hard-0 asset solo-violin-82-hard-0 keys G#5 C#6 velocity 0.65 1 root A#5 loop 48000 124381 crossfade 8160
      zone z88-soft-0 asset solo-violin-88-soft-0 keys D6 G6 velocity 0 0.65 root E6 loop 48000 123663 crossfade 8160
      zone z88-hard-0 asset solo-violin-88-hard-0 keys D6 G6 velocity 0.65 1 root E6 loop 48000 125960 crossfade 8160
      zone z94-soft-0 asset solo-violin-94-soft-0 keys G#6 C#7 velocity 0 0.65 root A#6 loop 48000 123619 crossfade 8160
      zone z94-hard-0 asset solo-violin-94-hard-0 keys G#6 C#7 velocity 0.65 1 root A#6 loop 48000 123600 crossfade 8160
      zone z100-soft-0 asset solo-violin-100-soft-0 keys D7 E7 velocity 0 0.65 root E7 loop 48000 124416 crossfade 8160
      zone z100-hard-0 asset solo-violin-100-hard-0 keys D7 E7 velocity 0.65 1 root E7 loop 48000 124165 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
