crump-module 2
instrument string-section "String Section" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.6s 0.6s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z36-soft-0 asset string-section-36-soft-0 keys E1 D#2 velocity 0 0.65 root C2 loop 48000 125509 crossfade 8160
      zone z36-hard-0 asset string-section-36-hard-0 keys E1 D#2 velocity 0.65 1 root C2 loop 48000 125513 crossfade 8160
      zone z43-soft-0 asset string-section-43-soft-0 keys E2 A#2 velocity 0 0.65 root G2 loop 48000 125736 crossfade 8160
      zone z43-hard-0 asset string-section-43-hard-0 keys E2 A#2 velocity 0.65 1 root G2 loop 48000 125748 crossfade 8160
      zone z50-soft-0 asset string-section-50-soft-0 keys B2 F3 velocity 0 0.65 root D3 loop 48000 123643 crossfade 8160
      zone z50-hard-0 asset string-section-50-hard-0 keys B2 F3 velocity 0.65 1 root D3 loop 48000 124332 crossfade 8160
      zone z57-soft-0 asset string-section-57-soft-0 keys F#3 C4 velocity 0 0.65 root A3 loop 48000 125863 crossfade 8160
      zone z57-hard-0 asset string-section-57-hard-0 keys F#3 C4 velocity 0.65 1 root A3 loop 48000 125862 crossfade 8160
      zone z64-soft-0 asset string-section-64-soft-0 keys C#4 G4 velocity 0 0.65 root E4 loop 48000 124107 crossfade 8160
      zone z64-hard-0 asset string-section-64-hard-0 keys C#4 G4 velocity 0.65 1 root E4 loop 48000 123663 crossfade 8160
      zone z71-soft-0 asset string-section-71-soft-0 keys G#4 D5 velocity 0 0.65 root B4 loop 48000 123677 crossfade 8160
      zone z71-hard-0 asset string-section-71-hard-0 keys G#4 D5 velocity 0.65 1 root B4 loop 48000 123668 crossfade 8160
      zone z78-soft-0 asset string-section-78-soft-0 keys D#5 A5 velocity 0 0.65 root F#5 loop 48000 124801 crossfade 8160
      zone z78-hard-0 asset string-section-78-hard-0 keys D#5 A5 velocity 0.65 1 root F#5 loop 48000 124555 crossfade 8160
      zone z85-soft-0 asset string-section-85-soft-0 keys A#5 E6 velocity 0 0.65 root C#6 loop 48000 123655 crossfade 8160
      zone z85-hard-0 asset string-section-85-hard-0 keys A#5 E6 velocity 0.65 1 root C#6 loop 48000 125173 crossfade 8160
      zone z92-soft-0 asset string-section-92-soft-0 keys F6 B6 velocity 0 0.65 root G#6 loop 48000 123856 crossfade 8160
      zone z92-hard-0 asset string-section-92-hard-0 keys F6 B6 velocity 0.65 1 root G#6 loop 48000 123612 crossfade 8160
      zone z98-soft-0 asset string-section-98-soft-0 keys C7 D7 velocity 0 0.65 root D7 loop 48000 123619 crossfade 8160
      zone z98-hard-0 asset string-section-98-hard-0 keys C7 D7 velocity 0.65 1 root D7 loop 48000 125589 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
