crump-module 2
instrument harpsichord "Harpsichord" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.18s 0.18s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z29-soft-0 asset harpsichord-29-soft-0 keys F1 G#1 velocity 0 0.65 root F1
      zone z29-hard-0 asset harpsichord-29-hard-0 keys F1 G#1 velocity 0.65 1 root F1
      zone z36-soft-0 asset harpsichord-36-soft-0 keys A1 D#2 velocity 0 0.65 root C2
      zone z36-hard-0 asset harpsichord-36-hard-0 keys A1 D#2 velocity 0.65 1 root C2
      zone z43-soft-0 asset harpsichord-43-soft-0 keys E2 A#2 velocity 0 0.65 root G2
      zone z43-hard-0 asset harpsichord-43-hard-0 keys E2 A#2 velocity 0.65 1 root G2
      zone z50-soft-0 asset harpsichord-50-soft-0 keys B2 F3 velocity 0 0.65 root D3
      zone z50-hard-0 asset harpsichord-50-hard-0 keys B2 F3 velocity 0.65 1 root D3
      zone z57-soft-0 asset harpsichord-57-soft-0 keys F#3 C4 velocity 0 0.65 root A3
      zone z57-hard-0 asset harpsichord-57-hard-0 keys F#3 C4 velocity 0.65 1 root A3
      zone z64-soft-0 asset harpsichord-64-soft-0 keys C#4 G4 velocity 0 0.65 root E4
      zone z64-hard-0 asset harpsichord-64-hard-0 keys C#4 G4 velocity 0.65 1 root E4
      zone z71-soft-0 asset harpsichord-71-soft-0 keys G#4 D5 velocity 0 0.65 root B4
      zone z71-hard-0 asset harpsichord-71-hard-0 keys G#4 D5 velocity 0.65 1 root B4
      zone z78-soft-0 asset harpsichord-78-soft-0 keys D#5 A5 velocity 0 0.65 root F#5
      zone z78-hard-0 asset harpsichord-78-hard-0 keys D#5 A5 velocity 0.65 1 root F#5
      zone z85-soft-0 asset harpsichord-85-soft-0 keys A#5 F6 velocity 0 0.65 root C#6
      zone z85-hard-0 asset harpsichord-85-hard-0 keys A#5 F6 velocity 0.65 1 root C#6
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
