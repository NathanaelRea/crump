crump 2
import "instrument.crump"
project "Harpsichord" {
  id example-harpsichord
  seed 720629
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C4 2beat 0.48
      note 2beat D4 1beat 0.7
      note 3beat E4 1beat 0.7
      note 4beat G4 3beat 0.92
      note 8beat C4 0.35beat 0.85
      note 8.5beat E4 0.35beat 0.85
      note 9beat G4 0.35beat 0.85
      note 9.5beat C5 0.35beat 0.85
      note 10beat C5 2beat 0.6
      note 12beat G3 3.5beat 0.75
      note 16beat C4 3.5beat 0.62
      note 16beat E4 3.5beat 0.62
      note 16beat G4 3.5beat 0.62
      note 16beat C5 3.5beat 0.62
      note 20beat A3 3.5beat 0.62
      note 20beat C4 3.5beat 0.62
      note 20beat E4 3.5beat 0.62
      note 20beat A4 3.5beat 0.62
      note 24beat F3 3.5beat 0.62
      note 24beat C4 3.5beat 0.62
      note 24beat F4 3.5beat 0.62
      note 24beat A4 3.5beat 0.62
      note 28beat G3 3.5beat 0.62
      note 28beat D4 3.5beat 0.62
      note 28beat G4 3.5beat 0.62
      note 28beat B4 3.5beat 0.62
    }
    track instrument "Harpsichord" instrument harpsichord level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
