crump-module 2
instrument didgeridoo "Didgeridoo" graph {
  polyphony 2
  parameter attack "Attack" seconds 0.002s 2s 0.0773724s 0.0773724s modulatable
  parameter release "Release" seconds 0.01s 4s 0.12s 0.12s
  parameter vibrato-depth "Vibrato" ratio 0 1 0 0 modulatable
  parameter noise "Air" ratio 0 4 0.135038 0.135038 modulatable
  parameter register "Register level" ratio 0.05 20 0.660693 0.660693 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0.357143 0.357143 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control vibrato-depth "Vibrato" "Vibrato depth in semitones" maps vibrato-depth
    control noise "Air" "Breath noise level" maps noise
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source register-curve key_curve per_voice bipolar {
      point g1 key G1 value 0
      point as1 key A#1 value 0.402069
      point cs2 key C#2 value 1
      point e2 key E2 value 0.905607
      point g2 key G2 value -0.273209
      point as2 key A#2 value -0.00786855
      point cs3 key C#3 value 0.440356
      point d3 key D3 value 0.306206
    }
    route attack-velocity source velocity target attack depth -0.0579079s map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.0117763 map unipolar curve linear order 0 bypass false
    route noise-velocity source velocity target noise depth -0.0280598 map unipolar curve linear order 0 bypass false
    route register-by-key source register-curve target register depth 0.961117 map bipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 0.642857 map unipolar curve linear order 0 bypass false
  }
  graph voice 48 {
    # A breath-driven tone: an oscillator and breath noise through fixed formants.
    node breath envelope mode adsr attack $attack decay 0.15s sustain 0.9 release $release attack_curve 0.3
    node breath-audio to_audio
    node vibrato lfo waveform sine rate 5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-fade envelope mode ahdsr attack 0.5s hold 0s decay 0.01s sustain 1 release 0.3s attack_curve 0.6
    node vibrato-fade-audio to_audio
    node vibrato-shape math operation multiply
    node vibrato-amount math operation scale amount $vibrato-depth
    node air noise level 1
    node wander lfo waveform sample_hold rate 2.7hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node wander-audio to_audio
    node wander-smooth onepole mode lowpass cutoff 2.5hz
    node wander-amount math operation scale amount 0.0545455
    node flutter onepole mode lowpass cutoff 18hz
    node flutter-amount math operation scale amount 1.5148
    node pitch-movement sum max_inputs 3
    node reed analog_oscillator {
      waveform square
      level 1
      velocity_amount 1
      fm_depth 1st
      random_phase 1
      warp width pulse_width amount -0.4
    }
    node reed-mono stereo_to_mono
    node tone-wander math operation scale amount 0.133928
    node tone-sum math operation add
    node tone-drive to_control
    node brightness lowpass mode lowpass cutoff 1466.78hz resonance 0.1 mod_depth 0hz velocity_depth 800hz key_track 0.370116 key_reference 261.626hz
    node air-filter biquad_chain {
      band air-low mode highpass frequency 182.535hz q 0.7071
      band air-band mode lowpass frequency 8378.98hz q 0.7071
    }
    node steady-air math operation scale amount 0.5
    node pulsed-air math operation scale amount 0.360636
    node air-drive sum max_inputs 2
    node breath-noise math operation multiply
    node breath-level math operation scale amount $noise
    node voice sum max_inputs 2
    node bore modal_bank profile didgeridoo-bore max_modes 5 key_track 1 decay_scale 1 brightness 0 level 1
    node open-air math operation scale amount 0.2
    node in-tube math operation scale amount 0.8
    node tube math operation add
    node mouth lfo waveform triangle rate 1.2hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node mouth-shape lowpass mode bandpass cutoff 900hz resonance 0.5 mod_depth 500hz
    node lips math operation scale amount 0.5
    node mouthed math operation scale amount 1.5
    node voiced math operation add
    node formants biquad_chain {
      band formant1 mode peak frequency 130.084hz q 2.5 gain -10.9985db
      band formant2 mode peak frequency 129.92hz q 2.5 gain -10.4869db
      band formant3 mode peak frequency 206.973hz q 2.5 gain 14.9736db
      band formant4 mode peak frequency 592.736hz q 1.75628 gain 11.1611db
      band formant5 mode peak frequency 2493.68hz q 2.10381 gain 6.71806db
      band formant6 mode peak frequency 1792.1hz q 2.34097 gain 5.31081db
      band formant7 mode lowshelf frequency 73.7908hz q 0.7071 gain -5.91243db
      band formant8 mode highshelf frequency 2315.4hz q 0.7071 gain 3.01082db
      band formant9 mode peak frequency 203.567hz q 2.5 gain 14.9927db
      band formant10 mode peak frequency 1688.75hz q 1.59481 gain 6.40446db
      band formant11 mode peak frequency 707.285hz q 1.44766 gain 4.24828db
      band formant12 mode peak frequency 2597.85hz q 1.07543 gain -6.57885db
      band radiation mode highpass frequency 30hz q 0.7071
    }
    node shimmer-depth math operation scale amount 1.00987
    node shimmer math operation offset amount 1
    node alive math operation multiply
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.285955
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-breath-gate note.gate -> breath.gate
    bus breath-control-breath-audio-control breath.control -> breath-audio.control
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-fade-gate note.gate -> vibrato-fade.gate
    bus vibrato-fade-control-vibrato-fade-audio-control vibrato-fade.control -> vibrato-fade-audio.control
    bus vibrato-audio-audio-vibrato-shape-a vibrato-audio.audio -> vibrato-shape.a
    bus vibrato-fade-audio-audio-vibrato-shape-b vibrato-fade-audio.audio -> vibrato-shape.b
    bus vibrato-shape-audio-vibrato-amount-a vibrato-shape.audio -> vibrato-amount.a
    bus wander-control-wander-audio-control wander.control -> wander-audio.control
    bus wander-audio-audio-wander-smooth-audio wander-audio.audio -> wander-smooth.audio
    bus wander-smooth-audio-wander-amount-a wander-smooth.audio -> wander-amount.a
    bus air-audio-flutter-audio air.audio -> flutter.audio
    bus flutter-audio-flutter-amount-a flutter.audio -> flutter-amount.a
    bus vibrato-amount-audio-pitch-movement-inputs vibrato-amount.audio -> pitch-movement.inputs
    bus wander-amount-audio-pitch-movement-inputs wander-amount.audio -> pitch-movement.inputs
    bus flutter-amount-audio-pitch-movement-inputs flutter-amount.audio -> pitch-movement.inputs
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus breath-control-reed-gain breath.control -> reed.gain
    bus pitch-movement-audio-reed-fm pitch-movement.audio -> reed.fm
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus wander-smooth-audio-tone-wander-a wander-smooth.audio -> tone-wander.a
    bus breath-audio-audio-tone-sum-a breath-audio.audio -> tone-sum.a
    bus tone-wander-audio-tone-sum-b tone-wander.audio -> tone-sum.b
    bus tone-sum-audio-tone-drive-audio tone-sum.audio -> tone-drive.audio
    bus reed-mono-audio-brightness-audio reed-mono.audio -> brightness.audio
    bus tone-drive-control-brightness-mod tone-drive.control -> brightness.mod
    bus note-velocity-brightness-velocity note.velocity -> brightness.velocity
    bus note-pitch-brightness-key note.pitch -> brightness.key
    bus air-audio-air-filter-audio air.audio -> air-filter.audio
    bus breath-audio-audio-steady-air-a breath-audio.audio -> steady-air.a
    bus reed-mono-audio-pulsed-air-a reed-mono.audio -> pulsed-air.a
    bus steady-air-audio-air-drive-inputs steady-air.audio -> air-drive.inputs
    bus pulsed-air-audio-air-drive-inputs pulsed-air.audio -> air-drive.inputs
    bus air-filter-audio-breath-noise-a air-filter.audio -> breath-noise.a
    bus air-drive-audio-breath-noise-b air-drive.audio -> breath-noise.b
    bus breath-noise-audio-breath-level-a breath-noise.audio -> breath-level.a
    bus brightness-audio-voice-inputs brightness.audio -> voice.inputs
    bus breath-level-audio-voice-inputs breath-level.audio -> voice.inputs
    bus voice-audio-bore-audio voice.audio -> bore.audio
    bus note-pitch-bore-pitch note.pitch -> bore.pitch
    bus note-gate-bore-gate note.gate -> bore.gate
    bus voice-audio-open-air-a voice.audio -> open-air.a
    bus bore-audio-in-tube-a bore.audio -> in-tube.a
    bus open-air-audio-tube-a open-air.audio -> tube.a
    bus in-tube-audio-tube-b in-tube.audio -> tube.b
    bus tube-audio-mouth-shape-audio tube.audio -> mouth-shape.audio
    bus mouth-control-mouth-shape-mod mouth.control -> mouth-shape.mod
    bus tube-audio-lips-a tube.audio -> lips.a
    bus mouth-shape-audio-mouthed-a mouth-shape.audio -> mouthed.a
    bus lips-audio-voiced-a lips.audio -> voiced.a
    bus mouthed-audio-voiced-b mouthed.audio -> voiced.b
    bus voiced-audio-formants-audio voiced.audio -> formants.audio
    bus flutter-audio-shimmer-depth-a flutter.audio -> shimmer-depth.a
    bus shimmer-depth-audio-shimmer-a shimmer-depth.audio -> shimmer.a
    bus formants-audio-alive-a formants.audio -> alive.a
    bus shimmer-audio-alive-b shimmer.audio -> alive.b
    bus alive-audio-register-level-a alive.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile didgeridoo-bore {
  root 261.626hz
  mode m0 frequency 261.626hz decay 0.02s gain 0.00208333 after_decay 0.02s after_gain 0
  mode m1 frequency 706.389hz decay 0.02s gain 0.00160256 after_decay 0.02s after_gain 0
  mode m2 frequency 1151.15hz decay 0.02s gain 0.00130208 after_decay 0.02s after_gain 0
  mode m3 frequency 1569.75hz decay 0.02s gain 0.00109649 after_decay 0.02s after_gain 0
  mode m4 frequency 1988.35hz decay 0.02s gain 0.00094697 after_decay 0.02s after_gain 0
}
