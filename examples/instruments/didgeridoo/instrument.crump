crump-module 2
instrument didgeridoo "Didgeridoo" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.245455s 0.245455s modulatable
  parameter release "Release" seconds 0.02s 4s 0.2s 0.2s
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-level note_key per_voice bipolar reference D2 range 12st
    route attack-velocity source velocity target attack depth -0.13636364s map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(1.687) order 0 bypass false
    route key-gain-low source key-level target key-gain depth 0.166849 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth -0.316713 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 30 {
    # A lip-buzzed drone whose vocal-tract shape moves between two vowels.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain1 math operation scale amount 0.03
    node lips analog_oscillator waveform saw coarse 0st level 1.41421 velocity_amount 0 fm_depth 1st
    node lips-mono stereo_to_mono
    node hi-2 lowpass mode highpass cutoff 100hz resonance 0.308309
    node body3 modal_bank profile didgeridoo-shape-a max_modes 7 key_track 0 decay_scale 1 brightness 0 level 1
    node body4 modal_bank profile didgeridoo-shape-a-between max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain5 math operation scale amount -1
    node plus6 math operation add
    node hi-7 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-8 lowpass mode lowpass cutoff 10000hz resonance 0.308309
    node body9 modal_bank profile didgeridoo-shape-b max_modes 12 key_track 0 decay_scale 1 brightness 0 level 1
    node wah lfo waveform sine rate 1.25hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node wah-audio to_audio
    node wah-mix math operation offset amount 1
    node wah-rest math operation negate
    node wah-other math operation offset amount 1
    node times10 math operation multiply
    node times11 math operation multiply
    node plus12 math operation add
    node gain13 math operation scale amount 0.5
    node dynamics-gain math operation scale amount $dynamics
    node hi-14 lowpass mode highpass cutoff 20hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.0287589
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain1-a drift-audio.audio -> gain1.a
    bus note-pitch-lips-pitch note.pitch -> lips.pitch
    bus note-velocity-lips-velocity note.velocity -> lips.velocity
    bus gain1-audio-lips-fm gain1.audio -> lips.fm
    bus amplitude-control-lips-gain amplitude.control -> lips.gain
    bus lips-audio-lips-mono-audio lips.audio -> lips-mono.audio
    bus lips-mono-audio-hi-2-audio lips-mono.audio -> hi-2.audio
    bus hi-2-audio-body3-audio hi-2.audio -> body3.audio
    bus note-pitch-body3-pitch note.pitch -> body3.pitch
    bus note-gate-body3-gate note.gate -> body3.gate
    bus hi-2-audio-body4-audio hi-2.audio -> body4.audio
    bus note-pitch-body4-pitch note.pitch -> body4.pitch
    bus note-gate-body4-gate note.gate -> body4.gate
    bus body4-audio-gain5-a body4.audio -> gain5.a
    bus body3-audio-plus6-a body3.audio -> plus6.a
    bus gain5-audio-plus6-b gain5.audio -> plus6.b
    bus lips-mono-audio-hi-7-audio lips-mono.audio -> hi-7.audio
    bus hi-7-audio-lo-8-audio hi-7.audio -> lo-8.audio
    bus lo-8-audio-body9-audio lo-8.audio -> body9.audio
    bus note-pitch-body9-pitch note.pitch -> body9.pitch
    bus note-gate-body9-gate note.gate -> body9.gate
    bus wah-control-wah-audio-control wah.control -> wah-audio.control
    bus wah-audio-audio-wah-mix-a wah-audio.audio -> wah-mix.a
    bus wah-audio-audio-wah-rest-a wah-audio.audio -> wah-rest.a
    bus wah-rest-audio-wah-other-a wah-rest.audio -> wah-other.a
    bus plus6-audio-times10-a plus6.audio -> times10.a
    bus wah-other-audio-times10-b wah-other.audio -> times10.b
    bus body9-audio-times11-a body9.audio -> times11.a
    bus wah-mix-audio-times11-b wah-mix.audio -> times11.b
    bus times10-audio-plus12-a times10.audio -> plus12.a
    bus times11-audio-plus12-b times11.audio -> plus12.b
    bus plus12-audio-gain13-a plus12.audio -> gain13.a
    bus gain13-audio-dynamics-gain-a gain13.audio -> dynamics-gain.a
    bus dynamics-gain-audio-hi-14-audio dynamics-gain.audio -> hi-14.audio
    bus hi-14-audio-register-a hi-14.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile didgeridoo-shape-a {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.0214656 after_decay 0.0159155s after_gain 0
  mode m1 frequency 83.4524hz decay 0.00953567s gain 0.0151281 after_decay 0.00953567s after_gain 0
  mode m2 frequency 139.286hz decay 0.00571324s gain 0.00442883 after_decay 0.00571324s after_gain 0
  mode m3 frequency 388.012hz decay 0.0020509s gain 0.574319 after_decay 0.0020509s after_gain 0
  mode m4 frequency 1080.89hz decay 0.000736218s gain 0.855468 after_decay 0.000736218s after_gain 0
  mode m5 frequency 3011.07hz decay 0.000264283s gain 0.743764 after_decay 0.000264283s after_gain 0
  mode m6 frequency 8388.01hz decay 0.0001s gain 0.75481 after_decay 0.0001s after_gain 0
}
profile didgeridoo-shape-a-between {
  root 261.626hz
  mode m0 frequency 232.475hz decay 0.00342305s gain 0.0242223 after_decay 0.00342305s after_gain 0
  mode m1 frequency 647.612hz decay 0.00122878s gain 0.56378 after_decay 0.00122878s after_gain 0
  mode m2 frequency 1804.07hz decay 0.000441101s gain 1 after_decay 0.000441101s after_gain 0
  mode m3 frequency 5025.63hz decay 0.000158343s gain 0.725519 after_decay 0.000158343s after_gain 0
  mode m4 frequency 14000hz decay 0.0001s gain 0.774132 after_decay 0.0001s after_gain 0
}
profile didgeridoo-shape-b {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.812801 after_decay 0.0159155s after_gain 0
  mode m1 frequency 83.4524hz decay 0.00953567s gain 0.54955 after_decay 0.00953567s after_gain 0
  mode m2 frequency 139.286hz decay 0.00571324s gain 0.405526 after_decay 0.00571324s after_gain 0
  mode m3 frequency 232.475hz decay 0.00342305s gain 0.349184 after_decay 0.00342305s after_gain 0
  mode m4 frequency 388.012hz decay 0.0020509s gain 0.282749 after_decay 0.0020509s after_gain 0
  mode m5 frequency 647.612hz decay 0.00122878s gain 0.827796 after_decay 0.00122878s after_gain 0
  mode m6 frequency 1080.89hz decay 0.000736218s gain 0.258946 after_decay 0.000736218s after_gain 0
  mode m7 frequency 1804.07hz decay 0.000441101s gain 0.752776 after_decay 0.000441101s after_gain 0
  mode m8 frequency 3011.07hz decay 0.000264283s gain 0.484807 after_decay 0.000264283s after_gain 0
  mode m9 frequency 5025.63hz decay 0.000158343s gain 0.329163 after_decay 0.000158343s after_gain 0
  mode m10 frequency 8388.01hz decay 0.0001s gain 0.408253 after_decay 0.0001s after_gain 0
  mode m11 frequency 14000hz decay 0.0001s gain 1 after_decay 0.0001s after_gain 0
}
