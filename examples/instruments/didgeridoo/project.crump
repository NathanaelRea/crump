crump 2
import "instrument.crump"
project "Didgeridoo" {
  id example-didgeridoo
  seed 1354149
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat D2 2beat 0.48
      note 2beat E2 1beat 0.7
      note 3beat F#2 1beat 0.7
      note 4beat A2 3beat 0.92
      note 8beat D2 0.35beat 0.85
      note 8.5beat F#2 0.35beat 0.85
      note 9beat A2 0.35beat 0.85
      note 9.5beat D3 0.35beat 0.85
      note 10beat D3 2beat 0.6
      note 12beat A1 3.5beat 0.75
      note 16beat D2 1beat 0.55
      note 17beat E2 1beat 0.6
      note 18beat F#2 1beat 0.65
      note 19beat G2 1beat 0.7
      note 20beat A2 1beat 0.75
      note 21beat B2 1beat 0.8
      note 22beat C#3 1beat 0.85
      note 24beat D3 6beat 0.8
    }
    track instrument "Didgeridoo" instrument didgeridoo level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
