crump-module 2
instrument prepared-piano "Prepared Piano" graph {
  polyphony 8
  parameter ring "Ring" ratio 0.1 4 1.1688 1.1688 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter hardness "Hardness" ratio 0 1 0.8 0.8
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control ring "Ring" "Decay time of the body" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-range note_key per_voice bipolar reference A3 range 33st
    source key-gain-curve key_curve per_voice bipolar {
      point c3 key C3 value -0.515978
      point c4 key C4 value 0
      point c5 key C5 value 1
    }
    route ring-key source key-range target ring depth -2.00508 map bipolar curve linear order 0 bypass false
    route key-gain-by-key source key-gain-curve target key-gain depth 0.829685 map bipolar curve linear order 0 bypass false
  }
  graph voice 31 {
    # A prepared piano string, a bolt's modes and a rattle.
    node strike1 exciter kind impact contact 0.000166035s hardness $hardness level 1
    node body2 modal_bank profile prepared-piano-strings max_modes 28 key_track 1 decay_scale $ring brightness 0 level 1
    node gain3 math operation scale amount 0.103594
    node hiss4 noise level 1
    node fall5 onepole mode leak time 0.033173s
    node times6 math operation multiply
    node hi-7 lowpass mode highpass cutoff 90hz resonance 0.308309
    node lo-8 lowpass mode lowpass cutoff 12000hz resonance 0.308309
    node lo-9 lowpass mode lowpass cutoff 2946.03hz resonance 0.308309
    node gain10 math operation scale amount 0.383016
    node plus11 math operation add
    node body12 modal_bank profile prepared-piano-box max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain13 math operation scale amount 1.17165
    node plus14 math operation add
    node strike15 exciter kind impact contact 0.0005s hardness 0.9 level 1
    node body16 modal_bank profile prepared-piano-bolt max_modes 5 key_track 1 decay_scale 1 brightness 0 level 1
    node gain17 math operation scale amount 0.152731
    node plus18 math operation add
    node rattle noise level 1
    node hi-19 lowpass mode highpass cutoff 1500hz resonance 0.308309
    node lo-20 lowpass mode lowpass cutoff 7000hz resonance 0.308309
    node fall21 onepole mode leak time 0.5s
    node times22 math operation multiply
    node gain23 math operation scale amount 0.105434
    node plus24 math operation add
    node hi-25 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.194786
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-gain3-a body2.audio -> gain3.a
    bus strike1-audio-fall5-audio strike1.audio -> fall5.audio
    bus hiss4-audio-times6-a hiss4.audio -> times6.a
    bus fall5-audio-times6-b fall5.audio -> times6.b
    bus times6-audio-hi-7-audio times6.audio -> hi-7.audio
    bus hi-7-audio-lo-8-audio hi-7.audio -> lo-8.audio
    bus lo-8-audio-lo-9-audio lo-8.audio -> lo-9.audio
    bus lo-9-audio-gain10-a lo-9.audio -> gain10.a
    bus gain3-audio-plus11-a gain3.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-body12-audio plus11.audio -> body12.audio
    bus note-pitch-body12-pitch note.pitch -> body12.pitch
    bus note-gate-body12-gate note.gate -> body12.gate
    bus body12-audio-gain13-a body12.audio -> gain13.a
    bus plus11-audio-plus14-a plus11.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus note-gate-strike15-gate note.gate -> strike15.gate
    bus note-velocity-strike15-velocity note.velocity -> strike15.velocity
    bus strike15-audio-body16-audio strike15.audio -> body16.audio
    bus note-pitch-body16-pitch note.pitch -> body16.pitch
    bus note-gate-body16-gate note.gate -> body16.gate
    bus body16-audio-gain17-a body16.audio -> gain17.a
    bus plus14-audio-plus18-a plus14.audio -> plus18.a
    bus gain17-audio-plus18-b gain17.audio -> plus18.b
    bus rattle-audio-hi-19-audio rattle.audio -> hi-19.audio
    bus hi-19-audio-lo-20-audio hi-19.audio -> lo-20.audio
    bus strike1-audio-fall21-audio strike1.audio -> fall21.audio
    bus lo-20-audio-times22-a lo-20.audio -> times22.a
    bus fall21-audio-times22-b fall21.audio -> times22.b
    bus times22-audio-gain23-a times22.audio -> gain23.a
    bus plus18-audio-plus24-a plus18.audio -> plus24.a
    bus gain23-audio-plus24-b gain23.audio -> plus24.b
    bus plus24-audio-hi-25-audio plus24.audio -> hi-25.audio
    bus hi-25-audio-register-a hi-25.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile prepared-piano-strings {
