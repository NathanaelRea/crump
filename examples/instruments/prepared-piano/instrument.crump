  root 261.626hz
  mode m0 frequency 95hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
  mode m1 frequency 190hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
  mode m2 frequency 380hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
