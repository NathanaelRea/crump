crump-module 2
instrument oboe "Oboe" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z58-soft-0 asset oboe-58-soft-0 keys A3 C4 velocity 0 0.65 root A#3 loop 48000 125933 crossfade 8160
      zone z58-hard-0 asset oboe-58-hard-0 keys A3 C4 velocity 0.65 1 root A#3 loop 48000 125933 crossfade 8160
      zone z63-soft-0 asset oboe-63-soft-0 keys C#4 F4 velocity 0 0.65 root D#4 loop 48000 123650 crossfade 8160
      zone z63-hard-0 asset oboe-63-hard-0 keys C#4 F4 velocity 0.65 1 root D#4 loop 48000 123647 crossfade 8160
      zone z68-soft-0 asset oboe-68-soft-0 keys F#4 A#4 velocity 0 0.65 root G#4 loop 48000 125466 crossfade 8160
      zone z68-hard-0 asset oboe-68-hard-0 keys F#4 A#4 velocity 0.65 1 root G#4 loop 48000 125350 crossfade 8160
      zone z73-soft-0 asset oboe-73-soft-0 keys B4 D#5 velocity 0 0.65 root C#5 loop 48000 125983 crossfade 8160
      zone z73-hard-0 asset oboe-73-hard-0 keys B4 D#5 velocity 0.65 1 root C#5 loop 48000 125976 crossfade 8160
      zone z78-soft-0 asset oboe-78-soft-0 keys E5 A5 velocity 0 0.65 root F#5 loop 48000 123636 crossfade 8160
      zone z78-hard-0 asset oboe-78-hard-0 keys E5 A5 velocity 0.65 1 root F#5 loop 48000 124688 crossfade 8160
      zone z84-soft-0 asset oboe-84-soft-0 keys A#5 D#6 velocity 0 0.65 root C6 loop 48000 125967 crossfade 8160
      zone z84-hard-0 asset oboe-84-hard-0 keys A#5 D#6 velocity 0.65 1 root C6 loop 48000 125875 crossfade 8160
      zone z90-soft-0 asset oboe-90-soft-0 keys E6 A#6 velocity 0 0.65 root F#6 loop 48000 125981 crossfade 8160
      zone z90-hard-0 asset oboe-90-hard-0 keys E6 A#6 velocity 0.65 1 root F#6 loop 48000 125981 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
