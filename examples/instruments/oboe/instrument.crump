crump-module 2
instrument oboe "Oboe" graph {
  polyphony 6
  parameter attack "Attack" seconds 0.003s 1s 0.106513s 0.106513s modulatable
  parameter release "Release" seconds 0.01s 3s 0.1s 0.1s
  parameter pressure "Breath" ratio 0 2 0.731108 0.731108 modulatable
  parameter vibrato-depth "Vibrato" ratio 0 0.05 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "How quickly the note stops" maps release
    control pressure "Breath" "Breath pressure: louder and brighter" maps pressure
    control vibrato-depth "Vibrato" "Vibrato depth" maps vibrato-depth
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    route attack-velocity source velocity target attack depth -0.0962357s map unipolar curve linear order 0 bypass false
    route pressure-velocity source velocity target pressure depth -0.10857 map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.00577701 map unipolar curve linear order 0 bypass false
  }
  graph voice 44 {
    # A reed on a conical bore, split at the reed into two delays.
    node blow envelope mode adsr attack $attack decay 0.08s sustain 1 release $release attack_curve 0.3
    node blow-audio to_audio
    node pressure math operation scale amount $pressure
    node swell lfo waveform sample_hold rate 3.1hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node swell-audio to_audio
    node swell-smooth onepole mode lowpass cutoff 4hz
    node gain1 math operation scale amount 0.02
    node swell-depth math operation scale amount 1
    node swell-gain math operation offset amount 1
    node pressure-live math operation multiply
    node breath-noise noise level 1
    node breath-noise-band biquad mode bandpass frequency 2645.75hz q 0.440959
    node times2 math operation multiply
    node breath-noise-level math operation scale amount 0.0114064
    node mouth math operation add
    node far delay_line mode pitch ratio 0.55 interpolation lagrange3 tune_compensation 1.06166 max_time 0.1s mod_depth 1
    node near delay_line mode pitch ratio 0.45 interpolation lagrange3 max_time 0.03s
    node vibrato lfo waveform sine rate 5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-wait envelope mode ahdsr attack 0s hold 0.4s decay 0.5s sustain 0 release 0.5s
    node vibrato-wait-audio to_audio
    node vibrato-ramp math operation scale amount -1
    node vibrato-in math operation offset amount 1
    node vibrato-shape math operation multiply
    node vibrato-amount math operation scale amount $vibrato-depth
    node bell linear_phase_lowpass amount 0.621939
    node returning math operation scale amount -0.95
    node at-reed math operation subtract
    node across math operation subtract
    node reed shaper {
      curve table
      drive 1
      bias 0
      point closed input -4.60704 output -1
      point open input 0.813007 output 1
    }
    node flow math operation multiply
    node blown math operation subtract
    node into-bore math operation subtract
    node radiate dc_block cutoff 20hz
    node body1 biquad mode peak frequency 367.12hz q 2.10879 gain -11.662db
    node body2 biquad mode peak frequency 1435.88hz q 2.4815 gain 9.04128db
    node body3 biquad mode peak frequency 2639.32hz q 6 gain -10.7517db
    node body4 biquad mode highshelf frequency 659.257hz q 0.7071 gain 10.4478db
    node radiation biquad mode lowpass frequency 1500hz q 0.7071
    node sub-cut biquad mode highpass frequency 186.44hz q 0.7071 key_track 1 key_reference 261.626hz
    node trim math operation scale amount 0.0621451
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-blow-gate note.gate -> blow.gate
    bus blow-control-blow-audio-control blow.control -> blow-audio.control
    bus blow-audio-audio-pressure-a blow-audio.audio -> pressure.a
    bus swell-control-swell-audio-control swell.control -> swell-audio.control
    bus swell-audio-audio-swell-smooth-audio swell-audio.audio -> swell-smooth.audio
    bus swell-smooth-audio-gain1-a swell-smooth.audio -> gain1.a
    bus gain1-audio-swell-depth-a gain1.audio -> swell-depth.a
    bus swell-depth-audio-swell-gain-a swell-depth.audio -> swell-gain.a
    bus pressure-audio-pressure-live-a pressure.audio -> pressure-live.a
    bus swell-gain-audio-pressure-live-b swell-gain.audio -> pressure-live.b
    bus breath-noise-audio-breath-noise-band-audio breath-noise.audio -> breath-noise-band.audio
    bus breath-noise-band-audio-times2-a breath-noise-band.audio -> times2.a
    bus pressure-live-audio-times2-b pressure-live.audio -> times2.b
    bus times2-audio-breath-noise-level-a times2.audio -> breath-noise-level.a
    bus pressure-live-audio-mouth-a pressure-live.audio -> mouth.a
    bus breath-noise-level-audio-mouth-b breath-noise-level.audio -> mouth.b
    bus note-pitch-far-pitch note.pitch -> far.pitch
    bus note-pitch-near-pitch note.pitch -> near.pitch
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-wait-gate note.gate -> vibrato-wait.gate
    bus vibrato-wait-control-vibrato-wait-audio-control vibrato-wait.control -> vibrato-wait-audio.control
    bus vibrato-wait-audio-audio-vibrato-ramp-a vibrato-wait-audio.audio -> vibrato-ramp.a
    bus vibrato-ramp-audio-vibrato-in-a vibrato-ramp.audio -> vibrato-in.a
    bus vibrato-audio-audio-vibrato-shape-a vibrato-audio.audio -> vibrato-shape.a
    bus vibrato-in-audio-vibrato-shape-b vibrato-in.audio -> vibrato-shape.b
    bus vibrato-shape-audio-vibrato-amount-a vibrato-shape.audio -> vibrato-amount.a
    bus vibrato-amount-audio-far-time-mod vibrato-amount.audio -> far.time_mod
    bus far-audio-bell-audio far.audio -> bell.audio
    bus bell-audio-returning-a bell.audio -> returning.a
    bus returning-audio-near-audio returning.audio -> near.audio
    bus returning-audio-at-reed-a returning.audio -> at-reed.a
    bus near-audio-at-reed-b near.audio -> at-reed.b
    bus mouth-audio-across-a mouth.audio -> across.a
    bus at-reed-audio-across-b at-reed.audio -> across.b
    bus across-audio-reed-audio across.audio -> reed.audio
    bus reed-audio-flow-a reed.audio -> flow.a
    bus across-audio-flow-b across.audio -> flow.b
    bus mouth-audio-blown-a mouth.audio -> blown.a
    bus flow-audio-blown-b flow.audio -> blown.b
    bus blown-audio-into-bore-a blown.audio -> into-bore.a
    bus returning-audio-into-bore-b returning.audio -> into-bore.b
    bus into-bore-audio-far-audio into-bore.audio -> far.audio
    bus at-reed-audio-radiate-audio at-reed.audio -> radiate.audio
    bus radiate-audio-body1-audio radiate.audio -> body1.audio
    bus body1-audio-body2-audio body1.audio -> body2.audio
    bus body2-audio-body3-audio body2.audio -> body3.audio
    bus body3-audio-body4-audio body3.audio -> body4.audio
    bus body4-audio-radiation-audio body4.audio -> radiation.audio
    bus radiation-audio-sub-cut-audio radiation.audio -> sub-cut.audio
    bus note-pitch-sub-cut-key note.pitch -> sub-cut.key
    bus sub-cut-audio-trim-a sub-cut.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
