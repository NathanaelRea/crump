crump 2
import "instrument.crump"
project "Glockenspiel" {
  id example-glockenspiel
  seed 681034
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat E6 0.25beat 0.92
      note 4beat E6 2beat 0.48
      note 8beat A5 0.5beat 0.85
      note 10beat B6 0.25beat 0.65
      note 12beat E7 0.75beat 0.8
      note 16beat E6 0.4beat 0.75
      note 16.5beat G#6 0.4beat 0.75
      note 17beat B6 0.4beat 0.75
      note 17.5beat E7 0.4beat 0.75
      note 18beat G#7 0.4beat 0.75
      note 18.5beat E7 0.4beat 0.75
      note 19beat B6 0.4beat 0.75
      note 19.5beat G#6 0.4beat 0.75
      note 24beat E6 0.2beat 0.55
      note 24.25beat F#6 0.2beat 0.6
      note 24.5beat G#6 0.2beat 0.65
      note 24.75beat A6 0.2beat 0.55
      note 25beat B6 0.2beat 0.6
      note 25.25beat C#7 0.2beat 0.65
      note 25.5beat D#7 0.2beat 0.55
      note 25.75beat E7 0.2beat 0.6
    }
    track instrument "Glockenspiel" instrument glockenspiel level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
