crump-module 2
instrument glockenspiel "Glockenspiel" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z79-soft-0 asset glockenspiel-79-soft-0 keys F5 A5 velocity 0 0.65 root G5
      zone z79-hard-0 asset glockenspiel-79-hard-0 keys F5 A5 velocity 0.65 1 root G5
      zone z84-soft-0 asset glockenspiel-84-soft-0 keys A#5 D6 velocity 0 0.65 root C6
      zone z84-hard-0 asset glockenspiel-84-hard-0 keys A#5 D6 velocity 0.65 1 root C6
      zone z89-soft-0 asset glockenspiel-89-soft-0 keys D#6 G6 velocity 0 0.65 root F6
      zone z89-hard-0 asset glockenspiel-89-hard-0 keys D#6 G6 velocity 0.65 1 root F6
      zone z94-soft-0 asset glockenspiel-94-soft-0 keys G#6 C7 velocity 0 0.65 root A#6
      zone z94-hard-0 asset glockenspiel-94-hard-0 keys G#6 C7 velocity 0.65 1 root A#6
      zone z99-soft-0 asset glockenspiel-99-soft-0 keys C#7 F7 velocity 0 0.65 root D#7
      zone z99-hard-0 asset glockenspiel-99-hard-0 keys C#7 F7 velocity 0.65 1 root D#7
      zone z104-soft-0 asset glockenspiel-104-soft-0 keys F#7 D8 velocity 0 0.65 root G#7
      zone z104-hard-0 asset glockenspiel-104-hard-0 keys F#7 D8 velocity 0.65 1 root G#7
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
