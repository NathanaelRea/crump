crump-module 2
instrument room-chop "Room Chop" graph {
  polyphony 8
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-gain-curve key_curve per_voice bipolar {
      point c3 key C3 value -0.534625
      point c4 key C4 value 0
      point c5 key C5 value 1
    }
    route key-gain-by-key source key-gain-curve target key-gain depth 0.187016 map bipolar curve linear order 0 bypass false
  }
  graph voice 45 {
    # A plucked string: a pitch-tuned delay loop with a per-trip loss, a pickup and a body.
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node held math operation add
    node held-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node held-leak math operation scale amount 1
    node period-later delay_line mode pitch ratio 1 interpolation linear max_time 0.1s
    node period math operation subtract
    node pluck-window shaper curve hard_clip drive 64 bias 0
    node pluck-noise noise level 1
    node pluck math operation multiply
    node pluck-tone lowpass mode lowpass cutoff 2880hz resonance 0.308309 velocity_depth 4160hz
    node string-in math operation add
    node string delay_line mode pitch ratio 1 interpolation lagrange3 tune_compensation 1 max_time 0.1s
    node string-loss linear_phase_lowpass amount 0.45
    node string-keep math operation scale amount 0.99999
    node string-pickup delay_line mode pitch ratio 0.12 interpolation linear max_time 0.05s
    node string-out math operation subtract
    node gain1 math operation scale amount 0.7
    node gain2 math operation scale amount 1.73205
    node string-tone lowpass mode lowpass cutoff 2880hz resonance 0.308309 velocity_depth 4160hz
    node string-decay onepole mode leak time 0.13s
    node times3 math operation multiply
    node hiss4 noise level 1
    node fall5 onepole mode leak time 0.015s
    node times6 math operation multiply
    node hi-7 lowpass mode highpass cutoff 1700hz resonance 0.308309
    node lo-8 lowpass mode lowpass cutoff 9000hz resonance 0.308309
    node gain9 math operation scale amount 0.138564
    node plus10 math operation add
    node body11 modal_bank profile room-chop-box max_modes 4 key_track 0 decay_scale $ring brightness 0 level 1
    node gain12 math operation scale amount 0.15
    node plus13 math operation add
    node hi-14 lowpass mode highpass cutoff 32hz resonance 0.308309
    node echo15 delay_line mode time time 0.023s interpolation linear max_time 0.033s
    node gain16 math operation scale amount 0.18
    node echo17 delay_line mode time time 0.037s interpolation linear max_time 0.047s
    node gain18 math operation scale amount -0.13
    node echo19 delay_line mode time time 0.057s interpolation linear max_time 0.067s
    node gain20 math operation scale amount 0.1
    node mix21 sum max_inputs 4
    node gain22 math operation scale amount 0.7
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.140988
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus held-audio-held-previous-audio held.audio -> held-previous.audio
    bus onset-audio-held-a onset.audio -> held.a
    bus held-previous-audio-held-leak-a held-previous.audio -> held-leak.a
    bus held-leak-audio-held-b held-leak.audio -> held.b
    bus note-pitch-period-later-pitch note.pitch -> period-later.pitch
    bus held-audio-period-later-audio held.audio -> period-later.audio
    bus held-audio-period-a held.audio -> period.a
    bus period-later-audio-period-b period-later.audio -> period.b
    bus period-audio-pluck-window-audio period.audio -> pluck-window.audio
    bus pluck-noise-audio-pluck-a pluck-noise.audio -> pluck.a
    bus pluck-window-audio-pluck-b pluck-window.audio -> pluck.b
    bus pluck-audio-pluck-tone-audio pluck.audio -> pluck-tone.audio
    bus note-velocity-pluck-tone-velocity note.velocity -> pluck-tone.velocity
    bus pluck-tone-audio-string-in-a pluck-tone.audio -> string-in.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus string-in-audio-string-audio string-in.audio -> string.audio
    bus string-audio-string-loss-audio string.audio -> string-loss.audio
    bus string-loss-audio-string-keep-a string-loss.audio -> string-keep.a
    bus string-keep-audio-string-in-b string-keep.audio -> string-in.b
    bus note-pitch-string-pickup-pitch note.pitch -> string-pickup.pitch
    bus string-audio-string-pickup-audio string.audio -> string-pickup.audio
    bus string-audio-string-out-a string.audio -> string-out.a
    bus string-pickup-audio-gain1-a string-pickup.audio -> gain1.a
    bus gain1-audio-string-out-b gain1.audio -> string-out.b
    bus string-out-audio-gain2-a string-out.audio -> gain2.a
    bus gain2-audio-string-tone-audio gain2.audio -> string-tone.audio
    bus note-velocity-string-tone-velocity note.velocity -> string-tone.velocity
    bus onset-audio-string-decay-audio onset.audio -> string-decay.audio
    bus string-tone-audio-times3-a string-tone.audio -> times3.a
    bus string-decay-audio-times3-b string-decay.audio -> times3.b
    bus onset-audio-fall5-audio onset.audio -> fall5.audio
    bus hiss4-audio-times6-a hiss4.audio -> times6.a
    bus fall5-audio-times6-b fall5.audio -> times6.b
    bus times6-audio-hi-7-audio times6.audio -> hi-7.audio
    bus hi-7-audio-lo-8-audio hi-7.audio -> lo-8.audio
    bus lo-8-audio-gain9-a lo-8.audio -> gain9.a
    bus times3-audio-plus10-a times3.audio -> plus10.a
    bus gain9-audio-plus10-b gain9.audio -> plus10.b
    bus plus10-audio-body11-audio plus10.audio -> body11.audio
    bus note-pitch-body11-pitch note.pitch -> body11.pitch
    bus note-gate-body11-gate note.gate -> body11.gate
    bus body11-audio-gain12-a body11.audio -> gain12.a
    bus plus10-audio-plus13-a plus10.audio -> plus13.a
    bus gain12-audio-plus13-b gain12.audio -> plus13.b
    bus plus13-audio-hi-14-audio plus13.audio -> hi-14.audio
    bus hi-14-audio-echo15-audio hi-14.audio -> echo15.audio
    bus echo15-audio-gain16-a echo15.audio -> gain16.a
    bus hi-14-audio-echo17-audio hi-14.audio -> echo17.audio
    bus echo17-audio-gain18-a echo17.audio -> gain18.a
    bus hi-14-audio-echo19-audio hi-14.audio -> echo19.audio
    bus echo19-audio-gain20-a echo19.audio -> gain20.a
    bus hi-14-audio-mix21-inputs hi-14.audio -> mix21.inputs
    bus gain16-audio-mix21-inputs gain16.audio -> mix21.inputs
    bus gain18-audio-mix21-inputs gain18.audio -> mix21.inputs
    bus gain20-audio-mix21-inputs gain20.audio -> mix21.inputs
    bus mix21-audio-gain22-a mix21.audio -> gain22.a
    bus gain22-audio-register-a gain22.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile room-chop-box {
  root 261.626hz
  mode m0 frequency 110hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
  mode m1 frequency 220hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
  mode m2 frequency 430hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
  mode m3 frequency 2100hz decay 0.006s gain 0.012 after_decay 0.006s after_gain 0
}
