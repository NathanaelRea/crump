crump-module 2
instrument recorder "Recorder" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z65-soft-0 asset recorder-65-soft-0 keys F4 G4 velocity 0 0.65 root F4 loop 48000 125935 crossfade 8160
      zone z65-hard-0 asset recorder-65-hard-0 keys F4 G4 velocity 0.65 1 root F4 loop 48000 125933 crossfade 8160
      zone z70-soft-0 asset recorder-70-soft-0 keys G#4 C5 velocity 0 0.65 root A#4 loop 48000 125980 crossfade 8160
      zone z70-hard-0 asset recorder-70-hard-0 keys G#4 C5 velocity 0.65 1 root A#4 loop 48000 125980 crossfade 8160
      zone z75-soft-0 asset recorder-75-soft-0 keys C#5 F5 velocity 0 0.65 root D#5 loop 48000 125934 crossfade 8160
      zone z75-hard-0 asset recorder-75-hard-0 keys C#5 F5 velocity 0.65 1 root D#5 loop 48000 123622 crossfade 8160
      zone z80-soft-0 asset recorder-80-soft-0 keys F#5 A#5 velocity 0 0.65 root G#5 loop 48000 125229 crossfade 8160
      zone z80-hard-0 asset recorder-80-hard-0 keys F#5 A#5 velocity 0.65 1 root G#5 loop 48000 123613 crossfade 8160
      zone z85-soft-0 asset recorder-85-soft-0 keys B5 D#6 velocity 0 0.65 root C#6 loop 48000 125981 crossfade 8160
      zone z85-hard-0 asset recorder-85-hard-0 keys B5 D#6 velocity 0.65 1 root C#6 loop 48000 123601 crossfade 8160
      zone z90-soft-0 asset recorder-90-soft-0 keys E6 A6 velocity 0 0.65 root F#6 loop 48000 125970 crossfade 8160
      zone z90-hard-0 asset recorder-90-hard-0 keys E6 A6 velocity 0.65 1 root F#6 loop 48000 123701 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
