crump 2
import "instrument.crump"
project "Recorder" {
  id example-recorder
  seed 1282878
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat F5 2beat 0.48
      note 2beat G5 1beat 0.7
      note 3beat A5 1beat 0.7
      note 4beat C6 3beat 0.92
      note 8beat F5 0.35beat 0.85
      note 8.5beat A5 0.35beat 0.85
      note 9beat C6 0.35beat 0.85
      note 9.5beat F6 0.35beat 0.85
      note 10beat F6 2beat 0.6
      note 12beat C5 3.5beat 0.75
      note 16beat F5 1beat 0.55
      note 17beat G5 1beat 0.6
      note 18beat A5 1beat 0.65
      note 19beat A#5 1beat 0.7
      note 20beat C6 1beat 0.75
      note 21beat D6 1beat 0.8
      note 22beat E6 1beat 0.85
      note 24beat F6 6beat 0.8
    }
    track instrument "Recorder" instrument recorder level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
