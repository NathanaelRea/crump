crump-module 2
instrument djembe-center "Djembe Center" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset djembe-center-60-soft-0 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-0 asset djembe-center-60-hard-0 keys C-1 G9 velocity 0.65 1 root C4
      zone z60-soft-1 asset djembe-center-60-soft-1 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-1 asset djembe-center-60-hard-1 keys C-1 G9 velocity 0.65 1 root C4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
asset djembe-center-60-soft-0 "Djembe Center" wav "media/60-soft-0.wav" sha256 "31f58bc1111f25ee74106c390f2915257438b2dd7470d2e4632f17f17ffbf464" {
  usage multisample
}
