crump 2
import "instrument.crump"
project "French Horn" {
  id example-french-horn
  seed 586006
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat F3 2beat 0.48
      note 2beat G3 1beat 0.7
      note 3beat A3 1beat 0.7
      note 4beat C4 3beat 0.92
      note 8beat F3 0.35beat 0.85
      note 8.5beat A3 0.35beat 0.85
      note 9beat C4 0.35beat 0.85
      note 9.5beat F4 0.35beat 0.85
      note 10beat F4 2beat 0.6
      note 12beat C3 3.5beat 0.75
      note 16beat F3 1beat 0.55
      note 17beat G3 1beat 0.6
      note 18beat A3 1beat 0.65
      note 19beat A#3 1beat 0.7
      note 20beat C4 1beat 0.75
      note 21beat D4 1beat 0.8
      note 22beat E4 1beat 0.85
      note 24beat F4 6beat 0.8
    }
    track instrument "French Horn" instrument french-horn level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
