crump-module 2
instrument french-horn "French Horn" graph {
  polyphony 6
  parameter attack "Attack" seconds 0.002s 2s 0.0968563s 0.0968563s modulatable
  parameter release "Release" seconds 0.01s 4s 0.12s 0.12s
  parameter noise "Air" ratio 0 4 0.00834467 0.00834467 modulatable
  parameter register "Register level" ratio 0.05 20 1.34896 1.34896 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0.357143 0.357143 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control noise "Air" "Breath noise level" maps noise
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-from-d2-3 note_key per_voice bipolar reference D2 range 3st
    source key-from-f2-3 note_key per_voice bipolar reference F2 range 3st
    source key-from-gs2-3 note_key per_voice bipolar reference G#2 range 3st
    source key-from-b2-3 note_key per_voice bipolar reference B2 range 3st
    source key-from-d3-3 note_key per_voice bipolar reference D3 range 3st
    source key-from-f3-3 note_key per_voice bipolar reference F3 range 3st
    source key-from-gs3-3 note_key per_voice bipolar reference G#3 range 3st
    source key-from-b3-3 note_key per_voice bipolar reference B3 range 3st
    source key-from-d4-3 note_key per_voice bipolar reference D4 range 3st
    source key-from-f4-3 note_key per_voice bipolar reference F4 range 3st
    source key-from-gs4-3 note_key per_voice bipolar reference G#4 range 3st
    source key-from-b4-3 note_key per_voice bipolar reference B4 range 3st
    source key-from-d5-3 note_key per_voice bipolar reference D5 range 3st
    source key-from-f5-2 note_key per_voice bipolar reference F5 range 2st
    route attack-velocity source velocity target attack depth -0.0561877s map unipolar curve linear order 0 bypass false
    route noise-velocity source velocity target noise depth -0.00634467 map unipolar curve linear order 0 bypass false
    route register-1 source key-from-d2-3 target register depth -0.0607133 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-f2-3 target register depth -0.191771 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-gs2-3 target register depth -0.130427 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-b2-3 target register depth 0.105468 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-d3-3 target register depth -0.148948 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-f3-3 target register depth -0.276917 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-gs3-3 target register depth 0.413599 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-b3-3 target register depth -0.0820165 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-d4-3 target register depth -0.440205 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-f4-3 target register depth -0.182218 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-gs4-3 target register depth 0.345029 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-12 source key-from-b4-3 target register depth 0.300158 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-13 source key-from-d5-3 target register depth 0.258925 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-14 source key-from-f5-2 target register depth 0.203252 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 0.642857 map unipolar curve linear order 0 bypass false
  }
  graph voice 50 {
    # A breath-driven tone: an oscillator and breath noise through fixed formants.
    node breath envelope mode adsr attack $attack decay 0.15s sustain 0.9 release $release attack_curve 0.3
    node breath-audio to_audio
    node air noise level 1
    node wander lfo waveform sample_hold rate 2.7hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node wander-audio to_audio
    node wander-smooth onepole mode lowpass cutoff 2.5hz
    node wander-amount math operation scale amount 0.0727273
    node flutter onepole mode lowpass cutoff 18hz
    node flutter-amount math operation scale amount 1.5148
    node scoop envelope mode adsr attack 0s decay 0.05s sustain 0 release 0.01s decay_curve -0.5
    node scoop-audio to_audio
    node scoop-amount math operation scale amount -0.2
    node pitch-movement sum max_inputs 3
    node reed analog_oscillator waveform saw level 1 velocity_amount 1 fm_depth 1st random_phase 1
    node reed-mono stereo_to_mono
    node brightness lowpass mode lowpass cutoff 486.836hz resonance 0.1 mod_depth 2954.83hz velocity_depth 1500hz key_track 0.492391 key_reference 261.626hz
    node brightness2 lowpass mode lowpass cutoff 486.836hz resonance 0.1 mod_depth 2954.83hz velocity_depth 1500hz key_track 0.492391 key_reference 261.626hz
    node brightness3 lowpass mode lowpass cutoff 486.836hz resonance 0.1 mod_depth 2954.83hz velocity_depth 1500hz key_track 0.492391 key_reference 261.626hz
    node brightness4 lowpass mode lowpass cutoff 486.836hz resonance 0.1 mod_depth 2954.83hz velocity_depth 1500hz key_track 0.492391 key_reference 261.626hz
    node smear1 biquad mode allpass frequency 767.717hz q 1.5
    node smear2 biquad mode allpass frequency 1727.36hz q 1.2
    node smear3 biquad mode allpass frequency 3454.73hz q 1
    node smear4 biquad mode allpass frequency 5757.88hz q 0.8
    node air-low biquad mode highpass frequency 672.885hz q 0.7071
    node air-band biquad mode lowpass frequency 1736.26hz q 0.7071
    node steady-air math operation scale amount 0.5
    node pulsed-air math operation scale amount 0.557928
    node air-drive sum max_inputs 2
    node breath-noise math operation multiply
    node breath-level math operation scale amount $noise
    node voice sum max_inputs 2
    node formant1 biquad mode peak frequency 104.954hz q 2.5 gain -14.9966db
    node formant2 biquad mode peak frequency 94.3224hz q 2.10753 gain -14.9735db
    node formant3 biquad mode peak frequency 393.776hz q 2.5 gain 13.4836db
    node formant4 biquad mode peak frequency 1349.13hz q 1.69182 gain -12.4747db
    node formant5 biquad mode peak frequency 2772.85hz q 2.02225 gain -6.91311db
    node formant6 biquad mode peak frequency 6408.12hz q 2.5 gain 14.8984db
    node formant7 biquad mode lowshelf frequency 206.448hz q 0.7071 gain -14.9962db
    node formant8 biquad mode highshelf frequency 7053.91hz q 0.7071 gain 9.91852db
    node below-note biquad mode highpass frequency 156.975hz q 0.7071 key_track 1 key_reference 261.626hz
    node radiation biquad mode highpass frequency 40hz q 0.7071
    node shimmer-depth math operation scale amount 1.00987
    node shimmer math operation offset amount 1
    node alive math operation multiply
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.362634
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-breath-gate note.gate -> breath.gate
    bus breath-control-breath-audio-control breath.control -> breath-audio.control
    bus wander-control-wander-audio-control wander.control -> wander-audio.control
    bus wander-audio-audio-wander-smooth-audio wander-audio.audio -> wander-smooth.audio
    bus wander-smooth-audio-wander-amount-a wander-smooth.audio -> wander-amount.a
    bus air-audio-flutter-audio air.audio -> flutter.audio
    bus flutter-audio-flutter-amount-a flutter.audio -> flutter-amount.a
    bus note-gate-scoop-gate note.gate -> scoop.gate
    bus scoop-control-scoop-audio-control scoop.control -> scoop-audio.control
    bus scoop-audio-audio-scoop-amount-a scoop-audio.audio -> scoop-amount.a
    bus wander-amount-audio-pitch-movement-inputs wander-amount.audio -> pitch-movement.inputs
    bus flutter-amount-audio-pitch-movement-inputs flutter-amount.audio -> pitch-movement.inputs
    bus scoop-amount-audio-pitch-movement-inputs scoop-amount.audio -> pitch-movement.inputs
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus breath-control-reed-gain breath.control -> reed.gain
    bus pitch-movement-audio-reed-fm pitch-movement.audio -> reed.fm
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus reed-mono-audio-brightness-audio reed-mono.audio -> brightness.audio
    bus breath-control-brightness-mod breath.control -> brightness.mod
    bus note-velocity-brightness-velocity note.velocity -> brightness.velocity
    bus note-pitch-brightness-key note.pitch -> brightness.key
    bus brightness-audio-brightness2-audio brightness.audio -> brightness2.audio
    bus breath-control-brightness2-mod breath.control -> brightness2.mod
    bus note-velocity-brightness2-velocity note.velocity -> brightness2.velocity
    bus note-pitch-brightness2-key note.pitch -> brightness2.key
    bus brightness2-audio-brightness3-audio brightness2.audio -> brightness3.audio
    bus breath-control-brightness3-mod breath.control -> brightness3.mod
    bus note-velocity-brightness3-velocity note.velocity -> brightness3.velocity
    bus note-pitch-brightness3-key note.pitch -> brightness3.key
    bus brightness3-audio-brightness4-audio brightness3.audio -> brightness4.audio
    bus breath-control-brightness4-mod breath.control -> brightness4.mod
    bus note-velocity-brightness4-velocity note.velocity -> brightness4.velocity
    bus note-pitch-brightness4-key note.pitch -> brightness4.key
    bus brightness4-audio-smear1-audio brightness4.audio -> smear1.audio
    bus smear1-audio-smear2-audio smear1.audio -> smear2.audio
    bus smear2-audio-smear3-audio smear2.audio -> smear3.audio
    bus smear3-audio-smear4-audio smear3.audio -> smear4.audio
    bus air-audio-air-low-audio air.audio -> air-low.audio
    bus air-low-audio-air-band-audio air-low.audio -> air-band.audio
    bus breath-audio-audio-steady-air-a breath-audio.audio -> steady-air.a
    bus reed-mono-audio-pulsed-air-a reed-mono.audio -> pulsed-air.a
    bus steady-air-audio-air-drive-inputs steady-air.audio -> air-drive.inputs
    bus pulsed-air-audio-air-drive-inputs pulsed-air.audio -> air-drive.inputs
    bus air-band-audio-breath-noise-a air-band.audio -> breath-noise.a
    bus air-drive-audio-breath-noise-b air-drive.audio -> breath-noise.b
    bus breath-noise-audio-breath-level-a breath-noise.audio -> breath-level.a
    bus smear4-audio-voice-inputs smear4.audio -> voice.inputs
    bus breath-level-audio-voice-inputs breath-level.audio -> voice.inputs
    bus voice-audio-formant1-audio voice.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-below-note-audio formant8.audio -> below-note.audio
    bus note-pitch-below-note-key note.pitch -> below-note.key
    bus below-note-audio-radiation-audio below-note.audio -> radiation.audio
    bus flutter-audio-shimmer-depth-a flutter.audio -> shimmer-depth.a
    bus shimmer-depth-audio-shimmer-a shimmer-depth.audio -> shimmer.a
    bus radiation-audio-alive-a radiation.audio -> alive.a
    bus shimmer-audio-alive-b shimmer.audio -> alive.b
    bus alive-audio-register-level-a alive.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
