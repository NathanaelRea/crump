crump-module 2
instrument french-horn "French Horn" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.25s 0.25s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z41-soft-0 asset french-horn-41-soft-0 keys D2 G2 velocity 0 0.65 root F2 loop 48000 125991 crossfade 8160
      zone z41-hard-0 asset french-horn-41-hard-0 keys D2 G2 velocity 0.65 1 root F2 loop 48000 125991 crossfade 8160
      zone z46-soft-0 asset french-horn-46-soft-0 keys G#2 C3 velocity 0 0.65 root A#2 loop 48000 123665 crossfade 8160
      zone z46-hard-0 asset french-horn-46-hard-0 keys G#2 C3 velocity 0.65 1 root A#2 loop 48000 125721 crossfade 8160
      zone z51-soft-0 asset french-horn-51-soft-0 keys C#3 F3 velocity 0 0.65 root D#3 loop 48000 125868 crossfade 8160
      zone z51-hard-0 asset french-horn-51-hard-0 keys C#3 F3 velocity 0.65 1 root D#3 loop 48000 125867 crossfade 8160
      zone z56-soft-0 asset french-horn-56-soft-0 keys F#3 A#3 velocity 0 0.65 root G#3 loop 48000 125973 crossfade 8160
      zone z56-hard-0 asset french-horn-56-hard-0 keys F#3 A#3 velocity 0.65 1 root G#3 loop 48000 125972 crossfade 8160
      zone z61-soft-0 asset french-horn-61-soft-0 keys B3 D#4 velocity 0 0.65 root C#4 loop 48000 123665 crossfade 8160
      zone z61-hard-0 asset french-horn-61-hard-0 keys B3 D#4 velocity 0.65 1 root C#4 loop 48000 125909 crossfade 8160
      zone z66-soft-0 asset french-horn-66-soft-0 keys E4 G#4 velocity 0 0.65 root F#4 loop 48000 123674 crossfade 8160
      zone z66-hard-0 asset french-horn-66-hard-0 keys E4 G#4 velocity 0.65 1 root F#4 loop 48000 124971 crossfade 8160
      zone z71-soft-0 asset french-horn-71-soft-0 keys A4 C#5 velocity 0 0.65 root B4 loop 48000 123938 crossfade 8160
      zone z71-hard-0 asset french-horn-71-hard-0 keys A4 C#5 velocity 0.65 1 root B4 loop 48000 123645 crossfade 8160
      zone z76-soft-0 asset french-horn-76-soft-0 keys D5 G5 velocity 0 0.65 root E5 loop 48000 123707 crossfade 8160
      zone z76-hard-0 asset french-horn-76-hard-0 keys D5 G5 velocity 0.65 1 root E5 loop 48000 125965 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
