crump-module 2
instrument singing-bowl "Singing Bowl" graph {
  polyphony 8
  parameter ring "Ring" ratio 0.1 4 0.8556 0.8556 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "Decay time of the body" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-range note_key per_voice bipolar reference A4 range 14st
    source key-level note_key per_voice bipolar reference A4 range 12st
    route ring-key source key-range target ring depth -0.207569 map bipolar curve linear order 0 bypass false
    route key-gain-low source key-level target key-gain depth 0.131926 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth 0.562495 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 8 {
    # A strike on a tuned body with explicit mode ratios, plus a contact tick.
    node strike1 exciter kind impact contact 0.000336111s hardness 0 level 1
    node body2 modal_bank profile singing-bowl-body max_modes 10 key_track 1 decay_scale $ring brightness 0 level 1
    node hi-3 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.086881
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-hi-3-audio body2.audio -> hi-3.audio
    bus hi-3-audio-register-a hi-3.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile singing-bowl-body {
  root 261.626hz
  mode m0 frequency 261.233hz decay 3.5s gain 0.65 after_decay 3.5s after_gain 0
  mode m1 frequency 723.616hz decay 2.5s gain 0.54712 after_decay 2.5s after_gain 0
  mode m2 frequency 1350.58hz decay 2s gain 0.682258 after_decay 2s after_gain 0
  mode m3 frequency 2087.25hz decay 1.4s gain 0.478561 after_decay 1.4s after_gain 0
  mode m4 frequency 2962.38hz decay 1s gain 0.348112 after_decay 1s after_gain 0
  mode m5 frequency 262.018hz decay 3.5s gain 0.35 after_decay 3.5s after_gain 0
  mode m6 frequency 725.79hz decay 2.5s gain 0.294603 after_decay 2.5s after_gain 0
  mode m7 frequency 1354.63hz decay 2s gain 0.36737 after_decay 2s after_gain 0
  mode m8 frequency 2093.52hz decay 1.4s gain 0.257686 after_decay 1.4s after_gain 0
  mode m9 frequency 2971.28hz decay 1s gain 0.187445 after_decay 1s after_gain 0
}
