crump-module 2
instrument bassoon "Bassoon" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z34-soft-0 asset bassoon-34-soft-0 keys A1 C2 velocity 0 0.65 root A#1 loop 48000 123639 crossfade 8160
      zone z34-hard-0 asset bassoon-34-hard-0 keys A1 C2 velocity 0.65 1 root A#1 loop 48000 123639 crossfade 8160
      zone z39-soft-0 asset bassoon-39-soft-0 keys C#2 F2 velocity 0 0.65 root D#2 loop 48000 124035 crossfade 8160
      zone z39-hard-0 asset bassoon-39-hard-0 keys C#2 F2 velocity 0.65 1 root D#2 loop 48000 124035 crossfade 8160
      zone z44-soft-0 asset bassoon-44-soft-0 keys F#2 B2 velocity 0 0.65 root G#2 loop 48000 125509 crossfade 8160
      zone z44-hard-0 asset bassoon-44-hard-0 keys F#2 B2 velocity 0.65 1 root G#2 loop 48000 125509 crossfade 8160
      zone z50-soft-0 asset bassoon-50-soft-0 keys C3 F3 velocity 0 0.65 root D3 loop 48000 125834 crossfade 8160
      zone z50-hard-0 asset bassoon-50-hard-0 keys C3 F3 velocity 0.65 1 root D3 loop 48000 125833 crossfade 8160
      zone z56-soft-0 asset bassoon-56-soft-0 keys F#3 B3 velocity 0 0.65 root G#3 loop 48000 123812 crossfade 8160
      zone z56-hard-0 asset bassoon-56-hard-0 keys F#3 B3 velocity 0.65 1 root G#3 loop 48000 123812 crossfade 8160
      zone z62-soft-0 asset bassoon-62-soft-0 keys C4 F4 velocity 0 0.65 root D4 loop 48000 125967 crossfade 8160
      zone z62-hard-0 asset bassoon-62-hard-0 keys C4 F4 velocity 0.65 1 root D4 loop 48000 125966 crossfade 8160
      zone z68-soft-0 asset bassoon-68-soft-0 keys F#4 B4 velocity 0 0.65 root G#4 loop 48000 125386 crossfade 8160
      zone z68-hard-0 asset bassoon-68-hard-0 keys F#4 B4 velocity 0.65 1 root G#4 loop 48000 125962 crossfade 8160
      zone z74-soft-0 asset bassoon-74-soft-0 keys C5 F5 velocity 0 0.65 root D5 loop 48000 123612 crossfade 8160
      zone z74-hard-0 asset bassoon-74-hard-0 keys C5 F5 velocity 0.65 1 root D5 loop 48000 123611 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
