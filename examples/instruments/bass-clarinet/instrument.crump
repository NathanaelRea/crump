crump-module 2
instrument bass-clarinet "Bass Clarinet" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z35-soft-0 asset bass-clarinet-35-soft-0 keys A#1 D2 velocity 0 0.65 root B1 loop 48000 125350 crossfade 8160
      zone z35-hard-0 asset bass-clarinet-35-hard-0 keys A#1 D2 velocity 0.65 1 root B1 loop 48000 124571 crossfade 8160
      zone z41-soft-0 asset bass-clarinet-41-soft-0 keys D#2 G#2 velocity 0 0.65 root F2 loop 48000 123845 crossfade 8160
      zone z41-hard-0 asset bass-clarinet-41-hard-0 keys D#2 G#2 velocity 0.65 1 root F2 loop 48000 123845 crossfade 8160
      zone z47-soft-0 asset bass-clarinet-47-soft-0 keys A2 D3 velocity 0 0.65 root B2 loop 48000 125731 crossfade 8160
      zone z47-hard-0 asset bass-clarinet-47-hard-0 keys A2 D3 velocity 0.65 1 root B2 loop 48000 123784 crossfade 8160
      zone z53-soft-0 asset bass-clarinet-53-soft-0 keys D#3 G#3 velocity 0 0.65 root F3 loop 48000 125985 crossfade 8160
      zone z53-hard-0 asset bass-clarinet-53-hard-0 keys D#3 G#3 velocity 0.65 1 root F3 loop 48000 125982 crossfade 8160
      zone z59-soft-0 asset bass-clarinet-59-soft-0 keys A3 D4 velocity 0 0.65 root B3 loop 48000 124788 crossfade 8160
      zone z59-hard-0 asset bass-clarinet-59-hard-0 keys A3 D4 velocity 0.65 1 root B3 loop 48000 123623 crossfade 8160
      zone z65-soft-0 asset bass-clarinet-65-soft-0 keys D#4 G#4 velocity 0 0.65 root F4 loop 48000 123633 crossfade 8160
      zone z65-hard-0 asset bass-clarinet-65-hard-0 keys D#4 G#4 velocity 0.65 1 root F4 loop 48000 123627 crossfade 8160
      zone z71-soft-0 asset bass-clarinet-71-soft-0 keys A4 D5 velocity 0 0.65 root B4 loop 48000 123616 crossfade 8160
      zone z71-hard-0 asset bass-clarinet-71-hard-0 keys A4 D5 velocity 0.65 1 root B4 loop 48000 123812 crossfade 8160
      zone z77-soft-0 asset bass-clarinet-77-soft-0 keys D#5 F5 velocity 0 0.65 root F5 loop 48000 123653 crossfade 8160
      zone z77-hard-0 asset bass-clarinet-77-hard-0 keys D#5 F5 velocity 0.65 1 root F5 loop 48000 123653 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
