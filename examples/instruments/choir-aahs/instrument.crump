crump-module 2
instrument choir-aahs "Choir Aahs" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.45s 0.45s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z41-soft-0 asset choir-aahs-41-soft-0 keys C2 G#2 velocity 0 0.65 root F2 loop 48000 124688 crossfade 8160
      zone z41-hard-0 asset choir-aahs-41-hard-0 keys C2 G#2 velocity 0.65 1 root F2 loop 48000 124681 crossfade 8160
      zone z47-soft-0 asset choir-aahs-47-soft-0 keys A2 D3 velocity 0 0.65 root B2 loop 48000 123993 crossfade 8160
      zone z47-hard-0 asset choir-aahs-47-hard-0 keys A2 D3 velocity 0.65 1 root B2 loop 48000 125682 crossfade 8160
      zone z53-soft-0 asset choir-aahs-53-soft-0 keys D#3 G#3 velocity 0 0.65 root F3 loop 48000 125254 crossfade 8160
      zone z53-hard-0 asset choir-aahs-53-hard-0 keys D#3 G#3 velocity 0.65 1 root F3 loop 48000 125808 crossfade 8160
      zone z59-soft-0 asset choir-aahs-59-soft-0 keys A3 D4 velocity 0 0.65 root B3 loop 48000 125849 crossfade 8160
      zone z59-hard-0 asset choir-aahs-59-hard-0 keys A3 D4 velocity 0.65 1 root B3 loop 48000 125649 crossfade 8160
      zone z65-soft-0 asset choir-aahs-65-soft-0 keys D#4 G#4 velocity 0 0.65 root F4 loop 48000 125962 crossfade 8160
      zone z65-hard-0 asset choir-aahs-65-hard-0 keys D#4 G#4 velocity 0.65 1 root F4 loop 48000 124386 crossfade 8160
      zone z71-soft-0 asset choir-aahs-71-soft-0 keys A4 D5 velocity 0 0.65 root B4 loop 48000 123665 crossfade 8160
      zone z71-hard-0 asset choir-aahs-71-hard-0 keys A4 D5 velocity 0.65 1 root B4 loop 48000 123950 crossfade 8160
      zone z77-soft-0 asset choir-aahs-77-soft-0 keys D#5 G#5 velocity 0 0.65 root F5 loop 48000 125673 crossfade 8160
      zone z77-hard-0 asset choir-aahs-77-hard-0 keys D#5 G#5 velocity 0.65 1 root F5 loop 48000 125989 crossfade 8160
      zone z83-soft-0 asset choir-aahs-83-soft-0 keys A5 D6 velocity 0 0.65 root B5 loop 48000 125957 crossfade 8160
      zone z83-hard-0 asset choir-aahs-83-hard-0 keys A5 D6 velocity 0.65 1 root B5 loop 48000 124475 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
