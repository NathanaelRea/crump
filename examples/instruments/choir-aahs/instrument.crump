  root 261.626hz
  mode m0 frequency 50hz decay 0.0127324s gain 0.069033 after_decay 0.0127324s after_gain 0
  mode m1 frequency 625hz decay 0.00454728s gain 1 after_decay 0.00454728s after_gain 0
  mode m2 frequency 1251.26hz decay 0.000508785s gain 0.355009 after_decay 0.000508785s after_gain 0
