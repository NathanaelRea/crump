crump-module 2
instrument shakuhachi "Shakuhachi" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z52-soft-0 asset shakuhachi-52-soft-0 keys E3 G3 velocity 0 0.65 root E3 loop 48000 125463 crossfade 8160
      zone z52-hard-0 asset shakuhachi-52-hard-0 keys E3 G3 velocity 0.65 1 root E3 loop 48000 124881 crossfade 8160
      zone z58-soft-0 asset shakuhachi-58-soft-0 keys G#3 C#4 velocity 0 0.65 root A#3 loop 48000 123894 crossfade 8160
      zone z58-hard-0 asset shakuhachi-58-hard-0 keys G#3 C#4 velocity 0.65 1 root A#3 loop 48000 124101 crossfade 8160
      zone z64-soft-0 asset shakuhachi-64-soft-0 keys D4 G4 velocity 0 0.65 root E4 loop 48000 125914 crossfade 8160
      zone z64-hard-0 asset shakuhachi-64-hard-0 keys D4 G4 velocity 0.65 1 root E4 loop 48000 125905 crossfade 8160
      zone z70-soft-0 asset shakuhachi-70-soft-0 keys G#4 C#5 velocity 0 0.65 root A#4 loop 48000 123608 crossfade 8160
      zone z70-hard-0 asset shakuhachi-70-hard-0 keys G#4 C#5 velocity 0.65 1 root A#4 loop 48000 123698 crossfade 8160
      zone z76-soft-0 asset shakuhachi-76-soft-0 keys D5 G5 velocity 0 0.65 root E5 loop 48000 123822 crossfade 8160
      zone z76-hard-0 asset shakuhachi-76-hard-0 keys D5 G5 velocity 0.65 1 root E5 loop 48000 123600 crossfade 8160
      zone z82-soft-0 asset shakuhachi-82-soft-0 keys G#5 C6 velocity 0 0.65 root A#5 loop 48000 125972 crossfade 8160
      zone z82-hard-0 asset shakuhachi-82-hard-0 keys G#5 C6 velocity 0.65 1 root A#5 loop 48000 125970 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
