      zone zbass-58-soft-1 asset frame-drum-bass-60-soft-1 keys G#3 C4 velocity 0 0.65 root A#3
      zone zbass-38-hard-1 asset frame-drum-bass-60-hard-1 keys C2 E2 velocity 0.65 1 root D2
      zone zbass-43-hard-1 asset frame-drum-bass-60-hard-1 keys F2 A2 velocity 0.65 1 root G2
      zone zbass-48-hard-1 asset frame-drum-bass-60-hard-1 keys A#2 D3 velocity 0.65 1 root C3
      zone zbass-53-hard-1 asset frame-drum-bass-60-hard-1 keys D#3 G3 velocity 0.65 1 root F3
      zone zbass-58-hard-1 asset frame-drum-bass-60-hard-1 keys G#3 C4 velocity 0.65 1 root A#3
      zone zrim-63-soft-0 asset frame-drum-rim-60-soft-0 keys C#4 F4 velocity 0 0.65 root D#4
      zone zrim-68-soft-0 asset frame-drum-rim-60-soft-0 keys F#4 A#4 velocity 0 0.65 root G#4
      zone zrim-73-soft-0 asset frame-drum-rim-60-soft-0 keys B4 D#5 velocity 0 0.65 root C#5
      zone zrim-78-soft-0 asset frame-drum-rim-60-soft-0 keys E5 G#5 velocity 0 0.65 root F#5
      zone zrim-83-soft-0 asset frame-drum-rim-60-soft-0 keys A5 C#6 velocity 0 0.65 root B5
      zone zrim-63-hard-0 asset frame-drum-rim-60-hard-0 keys C#4 F4 velocity 0.65 1 root D#4
