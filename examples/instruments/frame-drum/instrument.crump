crump-module 2
instrument frame-drum "Frame Drum" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone zbass-38-soft-0 asset frame-drum-bass-60-soft-0 keys C2 E2 velocity 0 0.65 root D2
      zone zbass-43-soft-0 asset frame-drum-bass-60-soft-0 keys F2 A2 velocity 0 0.65 root G2
      zone zbass-48-soft-0 asset frame-drum-bass-60-soft-0 keys A#2 D3 velocity 0 0.65 root C3
      zone zbass-53-soft-0 asset frame-drum-bass-60-soft-0 keys D#3 G3 velocity 0 0.65 root F3
      zone zbass-58-soft-0 asset frame-drum-bass-60-soft-0 keys G#3 C4 velocity 0 0.65 root A#3
      zone zbass-38-hard-0 asset frame-drum-bass-60-hard-0 keys C2 E2 velocity 0.65 1 root D2
      zone zbass-43-hard-0 asset frame-drum-bass-60-hard-0 keys F2 A2 velocity 0.65 1 root G2
      zone zbass-48-hard-0 asset frame-drum-bass-60-hard-0 keys A#2 D3 velocity 0.65 1 root C3
      zone zbass-53-hard-0 asset frame-drum-bass-60-hard-0 keys D#3 G3 velocity 0.65 1 root F3
      zone zbass-58-hard-0 asset frame-drum-bass-60-hard-0 keys G#3 C4 velocity 0.65 1 root A#3
      zone zbass-38-soft-1 asset frame-drum-bass-60-soft-1 keys C2 E2 velocity 0 0.65 root D2
      zone zbass-43-soft-1 asset frame-drum-bass-60-soft-1 keys F2 A2 velocity 0 0.65 root G2
      zone zbass-48-soft-1 asset frame-drum-bass-60-soft-1 keys A#2 D3 velocity 0 0.65 root C3
