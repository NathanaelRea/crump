crump-module 2
instrument darbuka "Darbuka" graph {
  polyphony 4
  parameter upper-stroke "Upper stroke" ratio 0 1 0 0 modulatable
  parameter lower-stroke "Lower stroke" ratio 0 1 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-step note_key per_voice unipolar reference C4 range 1st
    route key-upper source key-step target upper-stroke depth 1 map unipolar curve linear order 0 bypass false
    route key-lower source key-step target lower-stroke depth -1 map unipolar curve linear order 0 bypass false
  }
  graph voice 48 {
    # Layers of simpler models, each peak-normalised.
    node strike1 exciter kind impact contact 0.00252083s hardness 0 level 1
    node body2 modal_bank profile darbuka-doum-l0-body max_modes 4 key_track 0 decay_scale $ring brightness 0 level 1
    node gain3 math operation scale amount 1.07716
    node hiss4 noise level 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall5 onepole mode leak time 0.01s
    node rise6 math operation subtract
    node fall7 onepole mode leak time 0.0004762s
    node gain8 math operation scale amount 1.22264
    node times9 math operation multiply
    node hi-10 lowpass mode highpass cutoff 400hz resonance 0.308309
    node lo-11 lowpass mode lowpass cutoff 2500hz resonance 0.308309
    node gain12 math operation scale amount 2.15856
    node gain13 math operation scale amount 0.543477
    node plus14 math operation add
    node hi-15 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain16 math operation scale amount $lower-stroke
    node strike17 exciter kind impact contact 0.000840278s hardness 0.1 level 1
    node body18 modal_bank profile darbuka-tek-l0-body max_modes 1 key_track 0 decay_scale 1 brightness 0 level 1
    node gain19 math operation scale amount 0.0516292
    node strike20 exciter kind impact contact 0.000336111s hardness 0.4 level 1
    node body21 modal_bank profile darbuka-tek-l1-body max_modes 7 key_track 0 decay_scale 1 brightness 0 level 1
    node hiss22 noise level 1
    node fall23 onepole mode leak time 0.002s
    node times24 math operation multiply
    node hi-25 lowpass mode highpass cutoff 2000hz resonance 0.308309
    node lo-26 lowpass mode lowpass cutoff 12000hz resonance 0.308309
    node gain27 math operation scale amount 1.15612
    node plus28 math operation add
    node gain29 math operation scale amount 0.296408
    node hiss30 noise level 1
    node fall31 onepole mode leak time 0.02s
    node rise32 math operation subtract
    node fall33 onepole mode leak time 0.0004878s
    node gain34 math operation scale amount 1.12472
    node times35 math operation multiply
    node hi-36 lowpass mode highpass cutoff 300hz resonance 0.308309
    node lo-37 lowpass mode lowpass cutoff 3000hz resonance 0.308309
    node gain38 math operation scale amount 1.839
    node gain39 math operation scale amount 0.543478
    node mix40 sum max_inputs 3
    node hi-41 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain42 math operation scale amount $upper-stroke
    node plus43 math operation add
    node trim math operation scale amount 0.189397
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-gain3-a body2.audio -> gain3.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus onset-audio-fall5-audio onset.audio -> fall5.audio
    bus fall5-audio-rise6-a fall5.audio -> rise6.a
    bus onset-audio-fall7-audio onset.audio -> fall7.audio
    bus fall7-audio-rise6-b fall7.audio -> rise6.b
    bus rise6-audio-gain8-a rise6.audio -> gain8.a
    bus hiss4-audio-times9-a hiss4.audio -> times9.a
    bus gain8-audio-times9-b gain8.audio -> times9.b
    bus times9-audio-hi-10-audio times9.audio -> hi-10.audio
    bus hi-10-audio-lo-11-audio hi-10.audio -> lo-11.audio
    bus lo-11-audio-gain12-a lo-11.audio -> gain12.a
    bus gain12-audio-gain13-a gain12.audio -> gain13.a
    bus gain3-audio-plus14-a gain3.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-hi-15-audio plus14.audio -> hi-15.audio
    bus hi-15-audio-gain16-a hi-15.audio -> gain16.a
    bus note-gate-strike17-gate note.gate -> strike17.gate
    bus note-velocity-strike17-velocity note.velocity -> strike17.velocity
    bus strike17-audio-body18-audio strike17.audio -> body18.audio
    bus note-pitch-body18-pitch note.pitch -> body18.pitch
    bus note-gate-body18-gate note.gate -> body18.gate
    bus body18-audio-gain19-a body18.audio -> gain19.a
    bus note-gate-strike20-gate note.gate -> strike20.gate
    bus note-velocity-strike20-velocity note.velocity -> strike20.velocity
    bus strike20-audio-body21-audio strike20.audio -> body21.audio
    bus note-pitch-body21-pitch note.pitch -> body21.pitch
    bus note-gate-body21-gate note.gate -> body21.gate
    bus onset-audio-fall23-audio onset.audio -> fall23.audio
    bus hiss22-audio-times24-a hiss22.audio -> times24.a
    bus fall23-audio-times24-b fall23.audio -> times24.b
    bus times24-audio-hi-25-audio times24.audio -> hi-25.audio
    bus hi-25-audio-lo-26-audio hi-25.audio -> lo-26.audio
    bus lo-26-audio-gain27-a lo-26.audio -> gain27.a
    bus body21-audio-plus28-a body21.audio -> plus28.a
    bus gain27-audio-plus28-b gain27.audio -> plus28.b
    bus plus28-audio-gain29-a plus28.audio -> gain29.a
    bus onset-audio-fall31-audio onset.audio -> fall31.audio
    bus fall31-audio-rise32-a fall31.audio -> rise32.a
    bus onset-audio-fall33-audio onset.audio -> fall33.audio
    bus fall33-audio-rise32-b fall33.audio -> rise32.b
    bus rise32-audio-gain34-a rise32.audio -> gain34.a
    bus hiss30-audio-times35-a hiss30.audio -> times35.a
    bus gain34-audio-times35-b gain34.audio -> times35.b
    bus times35-audio-hi-36-audio times35.audio -> hi-36.audio
    bus hi-36-audio-lo-37-audio hi-36.audio -> lo-37.audio
    bus lo-37-audio-gain38-a lo-37.audio -> gain38.a
    bus gain38-audio-gain39-a gain38.audio -> gain39.a
    bus gain19-audio-mix40-inputs gain19.audio -> mix40.inputs
    bus gain29-audio-mix40-inputs gain29.audio -> mix40.inputs
    bus gain39-audio-mix40-inputs gain39.audio -> mix40.inputs
    bus mix40-audio-hi-41-audio mix40.audio -> hi-41.audio
    bus hi-41-audio-gain42-a hi-41.audio -> gain42.a
    bus gain16-audio-plus43-a gain16.audio -> plus43.a
    bus gain42-audio-plus43-b gain42.audio -> plus43.b
    bus plus43-audio-trim-a plus43.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile darbuka-doum-l0-body {
  root 125hz
  mode m0 frequency 125hz decay 0.17s gain 1 after_decay 0.17s after_gain 0
  mode m1 frequency 200hz decay 0.05s gain 0.0280575 after_decay 0.05s after_gain 0
  mode m2 frequency 287.5hz decay 0.04s gain 0.0174938 after_decay 0.04s after_gain 0
  mode m3 frequency 425hz decay 0.03s gain 0.0122708 after_decay 0.03s after_gain 0
}
profile darbuka-tek-l0-body {
  root 125hz
  mode m0 frequency 125hz decay 0.08s gain 1 after_decay 0.08s after_gain 0
}
profile darbuka-tek-l1-body {
  root 730hz
  mode m0 frequency 730hz decay 0.05s gain 0.7 after_decay 0.05s after_gain 0
  mode m1 frequency 1073.1hz decay 0.0374526s gain 0.935248 after_decay 0.0374526s after_gain 0
  mode m2 frequency 1387hz decay 0.0308962s gain 0.524814 after_decay 0.0308962s after_gain 0
  mode m3 frequency 1511.1hz decay 0.0289729s gain 0.572637 after_decay 0.0289729s after_gain 0
  mode m4 frequency 1679hz decay 0.0267716s gain 0.765082 after_decay 0.0267716s after_gain 0
  mode m5 frequency 1971hz decay 0.0237382s gain 0.429325 after_decay 0.0237382s after_gain 0
  mode m6 frequency 2263hz decay 0.0214017s gain 0.334605 after_decay 0.0214017s after_gain 0
}
