crump-module 2
instrument buzz-balafon "Buzz Balafon" graph {
  polyphony 8
  parameter contact "Contact" seconds 0.00002s 0.003s 2e-05s 2e-05s
  parameter ring "Ring" ratio 0.1 4 0.652179534405 0.652179534405
  parameter brightness "Brightness" ratio -2 2 -0.447812058361 -0.447812058361
  parameter hardness "Hardness" ratio 0 1 0.35 0.35
  parameter output-level "Level" ratio 0 2 1 1
  faceplate {
    control output-level "Level" "Output level" maps output-level
    control contact "Contact" "Strike duration" maps contact
    control ring "Ring" "Body decay" maps ring
    control brightness "Brightness" "Resonance tilt" maps brightness
    control hardness "Hardness" "Contact concentration" maps hardness
  }
  graph voice 12 {
    node body-force exciter kind impact contact $contact hardness $hardness rate 5000hz duration 0.075s attack 0s
    node body modal_bank profile buzz-balafon-body max_modes 30 key_track 1 decay_scale $ring brightness $brightness level 1
    node stereo mono_to_stereo
    node out output
    node output-gain mixer a_level 0.0228038278352 b_level 0
    node output-level mixer a_level $output-level b_level 0
    bus body-hit note.gate -> body-force.gate
    bus body-velocity note.velocity -> body-force.velocity
    bus body-gate note.gate -> body.gate
    bus body-pitch note.pitch -> body.pitch
    bus body-input body-force.audio -> body.audio
    bus mono body.audio -> output-gain.a
    bus output-gain output-gain.audio -> output-level.a
    bus output-level output-level.audio -> stereo.audio
    bus output stereo.audio -> out.audio
  }
}
profile buzz-balafon-body {
