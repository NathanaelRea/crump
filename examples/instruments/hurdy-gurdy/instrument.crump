crump-module 2
instrument hurdy-gurdy "Hurdy-Gurdy" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.25s 0.25s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z55-soft-0 asset hurdy-gurdy-55-soft-0 keys G3 A#3 velocity 0 0.65 root G3 loop 48000 125715 crossfade 8160
      zone z55-hard-0 asset hurdy-gurdy-55-hard-0 keys G3 A#3 velocity 0.65 1 root G3 loop 48000 125716 crossfade 8160
      zone z61-soft-0 asset hurdy-gurdy-61-soft-0 keys B3 E4 velocity 0 0.65 root C#4 loop 48000 124041 crossfade 8160
      zone z61-hard-0 asset hurdy-gurdy-61-hard-0 keys B3 E4 velocity 0.65 1 root C#4 loop 48000 124039 crossfade 8160
      zone z67-soft-0 asset hurdy-gurdy-67-soft-0 keys F4 A#4 velocity 0 0.65 root G4 loop 48000 125737 crossfade 8160
      zone z67-hard-0 asset hurdy-gurdy-67-hard-0 keys F4 A#4 velocity 0.65 1 root G4 loop 48000 125740 crossfade 8160
      zone z73-soft-0 asset hurdy-gurdy-73-soft-0 keys B4 E5 velocity 0 0.65 root C#5 loop 48000 123606 crossfade 8160
      zone z73-hard-0 asset hurdy-gurdy-73-hard-0 keys B4 E5 velocity 0.65 1 root C#5 loop 48000 125514 crossfade 8160
      zone z79-soft-0 asset hurdy-gurdy-79-soft-0 keys F5 A5 velocity 0 0.65 root G5 loop 48000 125309 crossfade 8160
      zone z79-hard-0 asset hurdy-gurdy-79-hard-0 keys F5 A5 velocity 0.65 1 root G5 loop 48000 125310 crossfade 8160
      zone z84-soft-0 asset hurdy-gurdy-84-soft-0 keys A#5 D6 velocity 0 0.65 root C6 loop 48000 123681 crossfade 8160
      zone z84-hard-0 asset hurdy-gurdy-84-hard-0 keys A#5 D6 velocity 0.65 1 root C6 loop 48000 125971 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
