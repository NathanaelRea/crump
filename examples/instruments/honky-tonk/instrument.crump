crump-module 2
instrument honky-tonk "Honky-Tonk" graph {
  polyphony 8
  parameter ring "Ring" ratio 0.1 4 1.1688 1.1688 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter hardness "Hardness" ratio 0 1 0.8 0.8
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control ring "Ring" "Decay time of the body" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-range note_key per_voice bipolar reference A3 range 33st
    source key-level note_key per_voice bipolar reference C4 range 12st
    route ring-key source key-range target ring depth -2.00508 map bipolar curve linear order 0 bypass false
    route key-gain-low source key-level target key-gain depth 0.477231 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth 1.3778 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 22 {
    # Hammered strings: stiff partials on two unequal courses with an aftersound.
    node strike1 exciter kind impact contact 0.000166035s hardness $hardness level 1
    node body2 modal_bank profile honky-tonk-strings max_modes 36 key_track 1 decay_scale $ring brightness 0 level 1
    node gain3 math operation scale amount 0.103594
    node hiss4 noise level 1
    node fall5 math operation add
    node fall5-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall5-leak math operation scale amount 0.999372178345
    node times6 math operation multiply
    node hi-7 lowpass mode highpass cutoff 90hz resonance 0.308309
    node lo-8 lowpass mode lowpass cutoff 12000hz resonance 0.308309
    node lo-9 lowpass mode lowpass cutoff 2946.03hz resonance 0.308309
    node gain10 math operation scale amount 0.460357
    node plus11 math operation add
    node body12 modal_bank profile honky-tonk-box max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain13 math operation scale amount 1.17165
    node plus14 math operation add
    node hi-15 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.196402
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-gain3-a body2.audio -> gain3.a
    bus fall5-audio-fall5-previous-audio fall5.audio -> fall5-previous.audio
    bus strike1-audio-fall5-a strike1.audio -> fall5.a
    bus fall5-previous-audio-fall5-leak-a fall5-previous.audio -> fall5-leak.a
    bus fall5-leak-audio-fall5-b fall5-leak.audio -> fall5.b
    bus hiss4-audio-times6-a hiss4.audio -> times6.a
    bus fall5-audio-times6-b fall5.audio -> times6.b
    bus times6-audio-hi-7-audio times6.audio -> hi-7.audio
    bus hi-7-audio-lo-8-audio hi-7.audio -> lo-8.audio
    bus lo-8-audio-lo-9-audio lo-8.audio -> lo-9.audio
    bus lo-9-audio-gain10-a lo-9.audio -> gain10.a
    bus gain3-audio-plus11-a gain3.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-body12-audio plus11.audio -> body12.audio
    bus note-pitch-body12-pitch note.pitch -> body12.pitch
    bus note-gate-body12-gate note.gate -> body12.gate
    bus body12-audio-gain13-a body12.audio -> gain13.a
    bus plus11-audio-plus14-a plus11.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-hi-15-audio plus14.audio -> hi-15.audio
    bus hi-15-audio-register-a hi-15.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile honky-tonk-strings {
  root 261.626hz
  mode m0 frequency 260.416hz decay 1.13235s gain 1.63636 after_decay 3.22844s after_gain 0.08909
  mode m1 frequency 521.046hz decay 1.11083s gain 1.21862 after_decay 3.16708s after_gain 0.0663466
