crump-module 2
instrument mark-tree "Mark Tree" graph {
  polyphony 2
  parameter upper-stroke "Upper stroke" ratio 0 1 0 0 modulatable
  parameter lower-stroke "Lower stroke" ratio 0 1 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-step note_key per_voice unipolar reference C4 range 1st
    route key-upper source key-step target upper-stroke depth 1 map unipolar curve linear order 0 bypass false
    route key-lower source key-step target lower-stroke depth -1 map unipolar curve linear order 0 bypass false
  }
  graph voice 19 {
    # A hand sweeping a row of rods: contacts filtered by a moving band.
    node grains1 exciter kind collisions contact 0.0001s hardness 0.6 rate 40hz duration 1.26s attack 0s level 1
    node up-hand envelope attack 1.4s decay 0s sustain 1 release 1.4s attack_curve -0.5
    node up-row lowpass mode bandpass cutoff 6500hz resonance 0.9 mod_depth 9500hz
    node body2 modal_bank profile mark-tree-up-rods max_modes 76 key_track 0 decay_scale $ring brightness 0 level 1
    node hi-3 lowpass mode highpass cutoff 1500hz resonance 0.308309
    node hi-4 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain5 math operation scale amount $lower-stroke
    node grains6 exciter kind collisions contact 0.0001s hardness 0.6 rate 40hz duration 1.26s attack 0s level 1
    node down-hand envelope attack 1.4s decay 0s sustain 1 release 1.4s attack_curve -0.5
    node down-row lowpass mode bandpass cutoff 16000hz resonance 0.9 mod_depth 0.001hz
    node body7 modal_bank profile mark-tree-down-rods max_modes 76 key_track 0 decay_scale 1 brightness 0 level 1
    node hi-8 lowpass mode highpass cutoff 1500hz resonance 0.308309
    node hi-9 lowpass mode highpass cutoff 32hz resonance 0.308309
    node gain10 math operation scale amount $upper-stroke
    node plus11 math operation add
    node trim math operation scale amount 0.0158704
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-grains1-gate note.gate -> grains1.gate
    bus note-velocity-grains1-velocity note.velocity -> grains1.velocity
    bus note-gate-up-hand-gate note.gate -> up-hand.gate
    bus grains1-audio-up-row-audio grains1.audio -> up-row.audio
    bus up-hand-control-up-row-mod up-hand.control -> up-row.mod
    bus up-row-audio-body2-audio up-row.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-hi-3-audio body2.audio -> hi-3.audio
    bus hi-3-audio-hi-4-audio hi-3.audio -> hi-4.audio
    bus hi-4-audio-gain5-a hi-4.audio -> gain5.a
    bus note-gate-grains6-gate note.gate -> grains6.gate
    bus note-velocity-grains6-velocity note.velocity -> grains6.velocity
    bus note-gate-down-hand-gate note.gate -> down-hand.gate
    bus grains6-audio-down-row-audio grains6.audio -> down-row.audio
    bus down-hand-control-down-row-mod down-hand.control -> down-row.mod
    bus down-row-audio-body7-audio down-row.audio -> body7.audio
    bus note-pitch-body7-pitch note.pitch -> body7.pitch
    bus note-gate-body7-gate note.gate -> body7.gate
    bus body7-audio-hi-8-audio body7.audio -> hi-8.audio
    bus hi-8-audio-hi-9-audio hi-8.audio -> hi-9.audio
    bus hi-9-audio-gain10-a hi-9.audio -> gain10.a
    bus gain5-audio-plus11-a gain5.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-trim-a plus11.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
