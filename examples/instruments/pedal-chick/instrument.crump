crump-module 2
instrument pedal-chick "Pedal Chick" graph {
  polyphony 3
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  graph voice 20 {
    # A strike on dense metal modes, with rattle and broadband shimmer.
    node strike1 exciter kind impact contact 7.26e-05s hardness $hardness level 1
    node hiss2 noise level 1
    node fall3 onepole mode leak time 0.025s
    node times4 math operation multiply
    node gain5 math operation scale amount 0.069282
    node plus6 math operation add
    node body7 modal_bank profile pedal-chick-plate max_modes 100 key_track 0 decay_scale $ring brightness 0 level 1
    node hiss8 noise level 1
    node fall9 onepole mode leak time 0.05264s
    node times10 math operation multiply
    node hi-11 lowpass mode highpass cutoff 2500hz resonance 0.308309
    node lo-12 lowpass mode lowpass cutoff 17000hz resonance 0.308309
    node gain13 math operation scale amount 0.301511
    node plus14 math operation add
    node hi-15 lowpass mode highpass cutoff 3778.84hz resonance 0.308309
    node hi-16 lowpass mode highpass cutoff 32hz resonance 0.308309
    node trim math operation scale amount 0.299418
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-fall3-audio strike1.audio -> fall3.audio
    bus hiss2-audio-times4-a hiss2.audio -> times4.a
    bus fall3-audio-times4-b fall3.audio -> times4.b
    bus times4-audio-gain5-a times4.audio -> gain5.a
    bus strike1-audio-plus6-a strike1.audio -> plus6.a
    bus gain5-audio-plus6-b gain5.audio -> plus6.b
    bus plus6-audio-body7-audio plus6.audio -> body7.audio
    bus note-pitch-body7-pitch note.pitch -> body7.pitch
    bus note-gate-body7-gate note.gate -> body7.gate
    bus strike1-audio-fall9-audio strike1.audio -> fall9.audio
    bus hiss8-audio-times10-a hiss8.audio -> times10.a
    bus fall9-audio-times10-b fall9.audio -> times10.b
    bus times10-audio-hi-11-audio times10.audio -> hi-11.audio
    bus hi-11-audio-lo-12-audio hi-11.audio -> lo-12.audio
    bus lo-12-audio-gain13-a lo-12.audio -> gain13.a
    bus body7-audio-plus14-a body7.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-hi-15-audio plus14.audio -> hi-15.audio
    bus hi-15-audio-hi-16-audio hi-15.audio -> hi-16.audio
    bus hi-16-audio-trim-a hi-16.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
