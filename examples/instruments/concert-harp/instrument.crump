crump-module 2
instrument concert-harp "Concert Harp" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z24-soft-0 asset concert-harp-24-soft-0 keys B0 E1 velocity 0 0.65 root C1
      zone z24-hard-0 asset concert-harp-24-hard-0 keys B0 E1 velocity 0.65 1 root C1
      zone z33-soft-0 asset concert-harp-33-soft-0 keys F1 C#2 velocity 0 0.65 root A1
      zone z33-hard-0 asset concert-harp-33-hard-0 keys F1 C#2 velocity 0.65 1 root A1
      zone z41-soft-0 asset concert-harp-41-soft-0 keys D2 G#2 velocity 0 0.65 root F2
      zone z41-hard-0 asset concert-harp-41-hard-0 keys D2 G#2 velocity 0.65 1 root F2
      zone z48-soft-0 asset concert-harp-48-soft-0 keys A2 D#3 velocity 0 0.65 root C3
      zone z48-hard-0 asset concert-harp-48-hard-0 keys A2 D#3 velocity 0.65 1 root C3
      zone z55-soft-0 asset concert-harp-55-soft-0 keys E3 A#3 velocity 0 0.65 root G3
      zone z55-hard-0 asset concert-harp-55-hard-0 keys E3 A#3 velocity 0.65 1 root G3
      zone z62-soft-0 asset concert-harp-62-soft-0 keys B3 F4 velocity 0 0.65 root D4
      zone z62-hard-0 asset concert-harp-62-hard-0 keys B3 F4 velocity 0.65 1 root D4
      zone z69-soft-0 asset concert-harp-69-soft-0 keys F#4 C#5 velocity 0 0.65 root A4
      zone z69-hard-0 asset concert-harp-69-hard-0 keys F#4 C#5 velocity 0.65 1 root A4
      zone z77-soft-0 asset concert-harp-77-soft-0 keys D5 A5 velocity 0 0.65 root F5
      zone z77-hard-0 asset concert-harp-77-hard-0 keys D5 A5 velocity 0.65 1 root F5
      zone z86-soft-0 asset concert-harp-86-soft-0 keys A#5 G6 velocity 0 0.65 root D6
      zone z86-hard-0 asset concert-harp-86-hard-0 keys A#5 G6 velocity 0.65 1 root D6
      zone z96-soft-0 asset concert-harp-96-soft-0 keys G#6 G7 velocity 0 0.65 root C7
      zone z96-hard-0 asset concert-harp-96-hard-0 keys G#6 G7 velocity 0.65 1 root C7
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
