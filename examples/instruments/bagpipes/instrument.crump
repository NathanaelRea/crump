crump-module 2
instrument bagpipes "Bagpipes" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.122727s 0.122727s modulatable
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter hold-drone1 "Fixed pitch" semitones -48st 48st -15st -15st modulatable
  parameter hold-drone2 "Fixed pitch" semitones -48st 48st -3st -3st modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-position note_key per_voice bipolar reference C4 range 48st
    source key-level note_key per_voice bipolar reference A4 range 12st
    route attack-velocity source velocity target attack depth -0.068181818s map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(1.726) order 0 bypass false
    route hold-drone1-key source key-position target hold-drone1 depth -48st map bipolar curve linear order 0 bypass false
    route hold-drone2-key source key-position target hold-drone2 depth -48st map bipolar curve linear order 0 bypass false
    route key-gain-low source key-level target key-gain depth -0.0580384 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth -0.0438639 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 59 {
    # Layers of simpler models tuned to the key, each peak-normalised.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain1 math operation scale amount 0.01
    node reed analog_oscillator waveform saw coarse 0st level 1.41421 velocity_amount 0 fm_depth 1st
    node reed-mono stereo_to_mono
    node velocity-tone lowpass mode lowpass cutoff 30hz resonance 0.308309 velocity_depth 21000hz
    node breath noise level 1
    node hi-2 lowpass mode highpass cutoff 500hz resonance 0.308309
    node lo-3 lowpass mode lowpass cutoff 9000hz resonance 0.308309
    node breath-comb-in math operation add
    node breath-comb delay_line mode pitch ratio 1 interpolation linear max_time 0.05s
    node gain4 math operation scale amount 0.7
    node gain5 math operation scale amount 0.3
    node gain6 math operation scale amount 0.3
    node gain7 math operation scale amount 0.7
    node plus8 math operation add
    node breath-amp to_audio
    node gain9 math operation scale amount 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall10 math operation add
    node fall10-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall10-leak math operation scale amount 0.999996527784
    node fall11 math operation add
    node fall11-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall11-leak math operation scale amount 0.998261928865
    node gain12 math operation scale amount -1
    node plus13 math operation add
    node gain14 math operation scale amount 13.2
    node plus15 math operation add
    node times16 math operation multiply
    node gain17 math operation scale amount 0.00365208
    node plus18 math operation add
    node hi-19 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-20 lowpass mode lowpass cutoff 2500hz resonance 0.308309
    node body21 modal_bank profile bagpipes-body max_modes 14 key_track 0 decay_scale 1 brightness 0 level 1
    node dynamics-gain math operation scale amount $dynamics
    node gain22 math operation scale amount 0.0878568
    node drone1 analog_oscillator waveform saw coarse $hold-drone1 level 1.41421 velocity_amount 0
    node drone1-mono stereo_to_mono
    node hi-23 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-24 lowpass mode lowpass cutoff 2500hz resonance 0.308309
    node body25 modal_bank profile bagpipes-drone1 max_modes 10 key_track 0 decay_scale 1 brightness 0 level 1
    node hi-26 lowpass mode highpass cutoff 100hz resonance 0.308309
    node gain27 math operation scale amount 0.0697792
    node drone2 analog_oscillator waveform saw coarse $hold-drone2 level 1.41421 velocity_amount 0
    node drone2-mono stereo_to_mono
    node hi-28 lowpass mode highpass cutoff 800hz resonance 0.308309
    node lo-29 lowpass mode lowpass cutoff 2500hz resonance 0.308309
    node body30 modal_bank profile bagpipes-drone2 max_modes 10 key_track 0 decay_scale 1 brightness 0 level 1
    node hi-31 lowpass mode highpass cutoff 100hz resonance 0.308309
    node gain32 math operation scale amount 0.055779
    node mix33 sum max_inputs 3
    node hi-34 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.357992
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain1-a drift-audio.audio -> gain1.a
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus gain1-audio-reed-fm gain1.audio -> reed.fm
    bus amplitude-control-reed-gain amplitude.control -> reed.gain
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus reed-mono-audio-velocity-tone-audio reed-mono.audio -> velocity-tone.audio
    bus note-velocity-velocity-tone-velocity note.velocity -> velocity-tone.velocity
    bus breath-audio-hi-2-audio breath.audio -> hi-2.audio
    bus hi-2-audio-lo-3-audio hi-2.audio -> lo-3.audio
    bus lo-3-audio-breath-comb-in-a lo-3.audio -> breath-comb-in.a
    bus note-pitch-breath-comb-pitch note.pitch -> breath-comb.pitch
    bus breath-comb-in-audio-breath-comb-audio breath-comb-in.audio -> breath-comb.audio
    bus breath-comb-audio-gain4-a breath-comb.audio -> gain4.a
    bus gain4-audio-breath-comb-in-b gain4.audio -> breath-comb-in.b
    bus breath-comb-in-audio-gain5-a breath-comb-in.audio -> gain5.a
    bus lo-3-audio-gain6-a lo-3.audio -> gain6.a
    bus gain5-audio-gain7-a gain5.audio -> gain7.a
    bus gain6-audio-plus8-a gain6.audio -> plus8.a
    bus gain7-audio-plus8-b gain7.audio -> plus8.b
    bus amplitude-control-breath-amp-control amplitude.control -> breath-amp.control
    bus breath-amp-audio-gain9-a breath-amp.audio -> gain9.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus fall10-audio-fall10-previous-audio fall10.audio -> fall10-previous.audio
    bus onset-audio-fall10-a onset.audio -> fall10.a
    bus fall10-previous-audio-fall10-leak-a fall10-previous.audio -> fall10-leak.a
    bus fall10-leak-audio-fall10-b fall10-leak.audio -> fall10.b
    bus fall11-audio-fall11-previous-audio fall11.audio -> fall11-previous.audio
    bus onset-audio-fall11-a onset.audio -> fall11.a
    bus fall11-previous-audio-fall11-leak-a fall11-previous.audio -> fall11-leak.a
    bus fall11-leak-audio-fall11-b fall11-leak.audio -> fall11.b
    bus fall11-audio-gain12-a fall11.audio -> gain12.a
    bus fall10-audio-plus13-a fall10.audio -> plus13.a
    bus gain12-audio-plus13-b gain12.audio -> plus13.b
    bus plus13-audio-gain14-a plus13.audio -> gain14.a
    bus gain9-audio-plus15-a gain9.audio -> plus15.a
    bus gain14-audio-plus15-b gain14.audio -> plus15.b
    bus plus8-audio-times16-a plus8.audio -> times16.a
    bus plus15-audio-times16-b plus15.audio -> times16.b
    bus times16-audio-gain17-a times16.audio -> gain17.a
    bus velocity-tone-audio-plus18-a velocity-tone.audio -> plus18.a
    bus gain17-audio-plus18-b gain17.audio -> plus18.b
    bus plus18-audio-hi-19-audio plus18.audio -> hi-19.audio
    bus hi-19-audio-lo-20-audio hi-19.audio -> lo-20.audio
    bus lo-20-audio-body21-audio lo-20.audio -> body21.audio
    bus note-pitch-body21-pitch note.pitch -> body21.pitch
    bus note-gate-body21-gate note.gate -> body21.gate
    bus body21-audio-dynamics-gain-a body21.audio -> dynamics-gain.a
    bus dynamics-gain-audio-gain22-a dynamics-gain.audio -> gain22.a
    bus note-pitch-drone1-pitch note.pitch -> drone1.pitch
    bus note-velocity-drone1-velocity note.velocity -> drone1.velocity
    bus amplitude-control-drone1-gain amplitude.control -> drone1.gain
    bus drone1-audio-drone1-mono-audio drone1.audio -> drone1-mono.audio
    bus drone1-mono-audio-hi-23-audio drone1-mono.audio -> hi-23.audio
    bus hi-23-audio-lo-24-audio hi-23.audio -> lo-24.audio
    bus lo-24-audio-body25-audio lo-24.audio -> body25.audio
    bus note-pitch-body25-pitch note.pitch -> body25.pitch
    bus note-gate-body25-gate note.gate -> body25.gate
    bus body25-audio-hi-26-audio body25.audio -> hi-26.audio
    bus hi-26-audio-gain27-a hi-26.audio -> gain27.a
    bus note-pitch-drone2-pitch note.pitch -> drone2.pitch
    bus note-velocity-drone2-velocity note.velocity -> drone2.velocity
    bus amplitude-control-drone2-gain amplitude.control -> drone2.gain
    bus drone2-audio-drone2-mono-audio drone2.audio -> drone2-mono.audio
    bus drone2-mono-audio-hi-28-audio drone2-mono.audio -> hi-28.audio
    bus hi-28-audio-lo-29-audio hi-28.audio -> lo-29.audio
    bus lo-29-audio-body30-audio lo-29.audio -> body30.audio
    bus note-pitch-body30-pitch note.pitch -> body30.pitch
    bus note-gate-body30-gate note.gate -> body30.gate
    bus body30-audio-hi-31-audio body30.audio -> hi-31.audio
    bus hi-31-audio-gain32-a hi-31.audio -> gain32.a
    bus gain22-audio-mix33-inputs gain22.audio -> mix33.inputs
    bus gain27-audio-mix33-inputs gain27.audio -> mix33.inputs
    bus gain32-audio-mix33-inputs gain32.audio -> mix33.inputs
    bus mix33-audio-hi-34-audio mix33.audio -> hi-34.audio
    bus hi-34-audio-register-a hi-34.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile bagpipes-body {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.0669063 after_decay 0.0159155s after_gain 0
  mode m1 frequency 77.1282hz decay 0.0103176s gain 0.0734506 after_decay 0.0103176s after_gain 0
  mode m2 frequency 118.975hz decay 0.00668859s gain 0.072884 after_decay 0.00668859s after_gain 0
  mode m3 frequency 183.526hz decay 0.00433602s gain 0.0728446 after_decay 0.00433602s after_gain 0
  mode m4 frequency 283.101hz decay 0.00281092s gain 0.0701206 after_decay 0.00281092s after_gain 0
