crump-module 2
instrument slit-drum "Slit Drum" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z42-soft-0 asset slit-drum-42-soft-0 keys E2 A2 velocity 0 0.65 root F#2
      zone z42-hard-0 asset slit-drum-42-hard-0 keys E2 A2 velocity 0.65 1 root F#2
      zone z48-soft-0 asset slit-drum-48-soft-0 keys A#2 D#3 velocity 0 0.65 root C3
      zone z48-hard-0 asset slit-drum-48-hard-0 keys A#2 D#3 velocity 0.65 1 root C3
      zone z54-soft-0 asset slit-drum-54-soft-0 keys E3 A3 velocity 0 0.65 root F#3
      zone z54-hard-0 asset slit-drum-54-hard-0 keys E3 A3 velocity 0.65 1 root F#3
      zone z60-soft-0 asset slit-drum-60-soft-0 keys A#3 D#4 velocity 0 0.65 root C4
      zone z60-hard-0 asset slit-drum-60-hard-0 keys A#3 D#4 velocity 0.65 1 root C4
      zone z66-soft-0 asset slit-drum-66-soft-0 keys E4 A4 velocity 0 0.65 root F#4
      zone z66-hard-0 asset slit-drum-66-hard-0 keys E4 A4 velocity 0.65 1 root F#4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
