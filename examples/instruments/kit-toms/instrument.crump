crump-module 2
instrument kit-toms "Kit Toms" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z38-soft-0 asset kit-toms-38-soft-0 keys C2 E2 velocity 0 0.65 root D2
      zone z38-hard-0 asset kit-toms-38-hard-0 keys C2 E2 velocity 0.65 1 root D2
      zone z43-soft-0 asset kit-toms-43-soft-0 keys F2 A2 velocity 0 0.65 root G2
      zone z43-hard-0 asset kit-toms-43-hard-0 keys F2 A2 velocity 0.65 1 root G2
      zone z48-soft-0 asset kit-toms-48-soft-0 keys A#2 D3 velocity 0 0.65 root C3
      zone z48-hard-0 asset kit-toms-48-hard-0 keys A#2 D3 velocity 0.65 1 root C3
      zone z53-soft-0 asset kit-toms-53-soft-0 keys D#3 G3 velocity 0 0.65 root F3
      zone z53-hard-0 asset kit-toms-53-hard-0 keys D#3 G3 velocity 0.65 1 root F3
      zone z58-soft-0 asset kit-toms-58-soft-0 keys G#3 D4 velocity 0 0.65 root A#3
      zone z58-hard-0 asset kit-toms-58-hard-0 keys G#3 D4 velocity 0.65 1 root A#3
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
asset kit-toms-38-soft-0 "Kit Toms" wav "media/38-soft-0.wav" sha256 "f9548794fc009aa988443bf64e9313a2b64d34184aa9245aa950eecbfa988a6a" {
  usage multisample
}
