crump 2
import "instrument.crump"
project "Kit Toms" {
  id example-kit-toms
  seed 934442
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C3 0.25beat 0.92
      note 4beat C3 2beat 0.48
      note 8beat F2 0.5beat 0.85
      note 10beat G3 0.25beat 0.65
      note 12beat C4 0.75beat 0.8
      note 16beat C3 0.4beat 0.75
      note 16.5beat E3 0.4beat 0.75
      note 17beat G3 0.4beat 0.75
      note 17.5beat C4 0.4beat 0.75
      note 18.5beat C4 0.4beat 0.75
      note 19beat G3 0.4beat 0.75
      note 19.5beat E3 0.4beat 0.75
      note 24beat C3 0.2beat 0.55
      note 24.25beat D3 0.2beat 0.6
      note 24.5beat E3 0.2beat 0.65
      note 24.75beat F3 0.2beat 0.55
      note 25beat G3 0.2beat 0.6
      note 25.25beat A3 0.2beat 0.65
      note 25.5beat B3 0.2beat 0.55
      note 25.75beat C4 0.2beat 0.6
    }
    track instrument "Kit Toms" instrument kit-toms level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
