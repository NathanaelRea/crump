crump-module 2
instrument ukulele "Ukulele" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z57-soft-0 asset ukulele-57-soft-0 keys G3 C4 velocity 0 0.65 root A3
      zone z57-hard-0 asset ukulele-57-hard-0 keys G3 C4 velocity 0.65 1 root A3
      zone z63-soft-0 asset ukulele-63-soft-0 keys C#4 F#4 velocity 0 0.65 root D#4
      zone z63-hard-0 asset ukulele-63-hard-0 keys C#4 F#4 velocity 0.65 1 root D#4
      zone z69-soft-0 asset ukulele-69-soft-0 keys G4 C5 velocity 0 0.65 root A4
      zone z69-hard-0 asset ukulele-69-hard-0 keys G4 C5 velocity 0.65 1 root A4
      zone z75-soft-0 asset ukulele-75-soft-0 keys C#5 F#5 velocity 0 0.65 root D#5
      zone z75-hard-0 asset ukulele-75-hard-0 keys C#5 F#5 velocity 0.65 1 root D#5
      zone z81-soft-0 asset ukulele-81-soft-0 keys G5 C6 velocity 0 0.65 root A5
      zone z81-hard-0 asset ukulele-81-hard-0 keys G5 C6 velocity 0.65 1 root A5
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
