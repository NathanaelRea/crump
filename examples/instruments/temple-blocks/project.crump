crump 2
import "instrument.crump"
project "Temple Blocks" {
  id example-temple-blocks
  seed 1037389
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C5 0.25beat 0.92
      note 4beat C5 2beat 0.48
      note 8beat F4 0.5beat 0.85
      note 10beat G5 0.25beat 0.65
      note 12beat C6 0.75beat 0.8
      note 16beat C5 0.4beat 0.75
      note 16.5beat E5 0.4beat 0.75
      note 17beat G5 0.4beat 0.75
      note 17.5beat C6 0.4beat 0.75
      note 18.5beat C6 0.4beat 0.75
      note 19beat G5 0.4beat 0.75
      note 19.5beat E5 0.4beat 0.75
      note 24beat C5 0.2beat 0.55
      note 24.25beat D5 0.2beat 0.6
      note 24.5beat E5 0.2beat 0.65
      note 24.75beat F5 0.2beat 0.55
      note 25beat G5 0.2beat 0.6
      note 25.25beat A5 0.2beat 0.65
      note 25.5beat B5 0.2beat 0.55
      note 25.75beat C6 0.2beat 0.6
