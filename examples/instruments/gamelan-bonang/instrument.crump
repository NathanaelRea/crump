crump-module 2
instrument gamelan-bonang "Gamelan Bonang" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z57-soft-0 asset gamelan-bonang-57-soft-0 keys G3 B3 velocity 0 0.65 root A3
      zone z57-hard-0 asset gamelan-bonang-57-hard-0 keys G3 B3 velocity 0.65 1 root A3
      zone z62-soft-0 asset gamelan-bonang-62-soft-0 keys C4 E4 velocity 0 0.65 root D4
      zone z62-hard-0 asset gamelan-bonang-62-hard-0 keys C4 E4 velocity 0.65 1 root D4
      zone z67-soft-0 asset gamelan-bonang-67-soft-0 keys F4 A4 velocity 0 0.65 root G4
      zone z67-hard-0 asset gamelan-bonang-67-hard-0 keys F4 A4 velocity 0.65 1 root G4
      zone z72-soft-0 asset gamelan-bonang-72-soft-0 keys A#4 D5 velocity 0 0.65 root C5
      zone z72-hard-0 asset gamelan-bonang-72-hard-0 keys A#4 D5 velocity 0.65 1 root C5
      zone z77-soft-0 asset gamelan-bonang-77-soft-0 keys D#5 G5 velocity 0 0.65 root F5
      zone z77-hard-0 asset gamelan-bonang-77-hard-0 keys D#5 G5 velocity 0.65 1 root F5
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
