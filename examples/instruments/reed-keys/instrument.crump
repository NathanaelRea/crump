crump-module 2
instrument reed-keys "Reed Keys" graph {
  polyphony 8
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-gain-curve key_curve per_voice unipolar {
      point c3 key C3 value 1
      point c4 key C4 value 0
      point c5 key C5 value 0.73543
    }
    route key-gain-by-key source key-gain-curve target key-gain depth 0.0759949 map unipolar curve linear order 0 bypass false
  }
  graph voice 13 {
    # A mallet on a tuned bar's modes, optionally through a pickup.
    node strike1 exciter kind impact contact 0.000163241s hardness $hardness level 1
    node body2 modal_bank profile reed-keys-bar max_modes 5 key_track 1 decay_scale $ring brightness 0 level 1
    node shape3 shaper curve tanh drive 2.12769 bias 0
    node gain4 math operation scale amount 0.469994
    node times5 math operation multiply
    node gain6 math operation scale amount 0.18
    node plus7 math operation add
    node hi-8 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.18241
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-shape3-audio body2.audio -> shape3.audio
    bus shape3-audio-gain4-a shape3.audio -> gain4.a
    bus body2-audio-times5-a body2.audio -> times5.a
    bus body2-audio-times5-b body2.audio -> times5.b
    bus times5-audio-gain6-a times5.audio -> gain6.a
    bus gain4-audio-plus7-a gain4.audio -> plus7.a
    bus gain6-audio-plus7-b gain6.audio -> plus7.b
    bus plus7-audio-hi-8-audio plus7.audio -> hi-8.audio
    bus hi-8-audio-register-a hi-8.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile reed-keys-bar {
  root 261.626hz
  mode m0 frequency 260.432hz decay 1.09607s gain 1 after_decay 1.09607s after_gain 0
  mode m1 frequency 520.864hz decay 0.640665s gain 0.93501 after_decay 0.640665s after_gain 0
  mode m2 frequency 781.295hz decay 0.467965s gain 0.591898 after_decay 0.467965s after_gain 0
  mode m3 frequency 1062.56hz decay 0.368775s gain 0.0344022 after_decay 0.368775s after_gain 0
  mode m4 frequency 1614.68hz decay 0.266671s gain 0.00518008 after_decay 0.266671s after_gain 0
}
