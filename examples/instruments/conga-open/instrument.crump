crump-module 2
instrument conga-open "Conga Open" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset conga-open-60-soft-0 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-0 asset conga-open-60-hard-0 keys C-1 G9 velocity 0.65 1 root C4
      zone z60-soft-1 asset conga-open-60-soft-1 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-1 asset conga-open-60-hard-1 keys C-1 G9 velocity 0.65 1 root C4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
asset conga-open-60-soft-0 "Conga Open" wav "media/60-soft-0.wav" sha256 "a8073f3d9d9c5bc08009b025ea1e5901fe7a7badc444b818debe467e3060bc65" {
  usage multisample
}
