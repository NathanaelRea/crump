crump-module 2
instrument bass-trombone "Bass Trombone" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.284727s 0.284727s modulatable
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  parameter vibrato-depth "Vibrato" ratio 0 2 0 0 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control vibrato-depth "Vibrato" "Vibrato depth in semitones" maps vibrato-depth
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-level note_key per_voice bipolar reference F2 range 12st
    route attack-velocity source velocity target attack depth -0.21818182s map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.043478261 map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(3.394) order 0 bypass false
    route key-gain-low source key-level target key-gain depth -0.618328 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth -0.415436 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 59 {
    # A blown, bowed or sung tone: a saw through a fixed resonator bank fitted to the body.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node vibrato lfo waveform sine rate 5.2hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-wait envelope mode ahdsr attack 0s hold 0.5s decay 0.5s sustain 0 release 0.5s
    node vibrato-wait-audio to_audio
    node vibrato-ramp math operation scale amount -1
    node vibrato-in math operation offset amount 1
    node times1 math operation multiply
    node gain2 math operation scale amount $vibrato-depth
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain3 math operation scale amount 0.015
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node scoop math operation add
    node scoop-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node scoop-leak math operation scale amount 0.999404939024
    node gain4 math operation scale amount -0.456522
    node mix5 sum max_inputs 3
    node reed analog_oscillator waveform saw coarse 0st level 1.41421 velocity_amount 0 fm_depth 1st
    node reed-mono stereo_to_mono
    node velocity-tone lowpass mode lowpass cutoff 30hz resonance 0.308309 velocity_depth 21000hz
    node breath noise level 1
    node hi-6 lowpass mode highpass cutoff 300hz resonance 0.308309
    node lo-7 lowpass mode lowpass cutoff 6000hz resonance 0.308309
    node breath-comb-in math operation add
    node breath-comb delay_line mode pitch ratio 1 interpolation linear max_time 0.05s
    node gain8 math operation scale amount 0.7
    node gain9 math operation scale amount 0.3
    node gain10 math operation scale amount 0.3
    node gain11 math operation scale amount 0.7
    node plus12 math operation add
    node breath-amp to_audio
    node gain13 math operation scale amount 1
    node fall14 math operation add
    node fall14-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall14-leak math operation scale amount 0.999998958334
    node fall15 math operation add
    node fall15-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall15-leak math operation scale amount 0.998264355199
    node gain16 math operation scale amount -1
    node plus17 math operation add
    node gain18 math operation scale amount 44
    node plus19 math operation add
    node times20 math operation multiply
    node gain21 math operation scale amount 0.000390441
    node plus22 math operation add
    node hi-23 lowpass mode highpass cutoff 100hz resonance 0.308309
    node body24 modal_bank profile bass-trombone-body max_modes 6 key_track 0 decay_scale 1 brightness 0 level 1
    node body25 modal_bank profile bass-trombone-body-between max_modes 8 key_track 0 decay_scale 1 brightness 0 level 1
    node gain26 math operation scale amount -1
    node plus27 math operation add
    node dynamics-gain math operation scale amount $dynamics
    node hi-28 lowpass mode highpass cutoff 20hz resonance 0.308309
    node hi-29 lowpass mode highpass cutoff 110hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.039304
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-wait-gate note.gate -> vibrato-wait.gate
    bus vibrato-wait-control-vibrato-wait-audio-control vibrato-wait.control -> vibrato-wait-audio.control
    bus vibrato-wait-audio-audio-vibrato-ramp-a vibrato-wait-audio.audio -> vibrato-ramp.a
    bus vibrato-ramp-audio-vibrato-in-a vibrato-ramp.audio -> vibrato-in.a
    bus vibrato-audio-audio-times1-a vibrato-audio.audio -> times1.a
    bus vibrato-in-audio-times1-b vibrato-in.audio -> times1.b
    bus times1-audio-gain2-a times1.audio -> gain2.a
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain3-a drift-audio.audio -> gain3.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus scoop-audio-scoop-previous-audio scoop.audio -> scoop-previous.audio
    bus onset-audio-scoop-a onset.audio -> scoop.a
    bus scoop-previous-audio-scoop-leak-a scoop-previous.audio -> scoop-leak.a
    bus scoop-leak-audio-scoop-b scoop-leak.audio -> scoop.b
    bus scoop-audio-gain4-a scoop.audio -> gain4.a
    bus gain2-audio-mix5-inputs gain2.audio -> mix5.inputs
    bus gain3-audio-mix5-inputs gain3.audio -> mix5.inputs
    bus gain4-audio-mix5-inputs gain4.audio -> mix5.inputs
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus mix5-audio-reed-fm mix5.audio -> reed.fm
    bus amplitude-control-reed-gain amplitude.control -> reed.gain
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus reed-mono-audio-velocity-tone-audio reed-mono.audio -> velocity-tone.audio
    bus note-velocity-velocity-tone-velocity note.velocity -> velocity-tone.velocity
    bus breath-audio-hi-6-audio breath.audio -> hi-6.audio
    bus hi-6-audio-lo-7-audio hi-6.audio -> lo-7.audio
    bus lo-7-audio-breath-comb-in-a lo-7.audio -> breath-comb-in.a
    bus note-pitch-breath-comb-pitch note.pitch -> breath-comb.pitch
    bus breath-comb-in-audio-breath-comb-audio breath-comb-in.audio -> breath-comb.audio
    bus breath-comb-audio-gain8-a breath-comb.audio -> gain8.a
    bus gain8-audio-breath-comb-in-b gain8.audio -> breath-comb-in.b
    bus breath-comb-in-audio-gain9-a breath-comb-in.audio -> gain9.a
    bus lo-7-audio-gain10-a lo-7.audio -> gain10.a
    bus gain9-audio-gain11-a gain9.audio -> gain11.a
    bus gain10-audio-plus12-a gain10.audio -> plus12.a
    bus gain11-audio-plus12-b gain11.audio -> plus12.b
    bus amplitude-control-breath-amp-control amplitude.control -> breath-amp.control
    bus breath-amp-audio-gain13-a breath-amp.audio -> gain13.a
    bus fall14-audio-fall14-previous-audio fall14.audio -> fall14-previous.audio
    bus onset-audio-fall14-a onset.audio -> fall14.a
    bus fall14-previous-audio-fall14-leak-a fall14-previous.audio -> fall14-leak.a
    bus fall14-leak-audio-fall14-b fall14-leak.audio -> fall14.b
    bus fall15-audio-fall15-previous-audio fall15.audio -> fall15-previous.audio
    bus onset-audio-fall15-a onset.audio -> fall15.a
    bus fall15-previous-audio-fall15-leak-a fall15-previous.audio -> fall15-leak.a
    bus fall15-leak-audio-fall15-b fall15-leak.audio -> fall15.b
    bus fall15-audio-gain16-a fall15.audio -> gain16.a
    bus fall14-audio-plus17-a fall14.audio -> plus17.a
    bus gain16-audio-plus17-b gain16.audio -> plus17.b
    bus plus17-audio-gain18-a plus17.audio -> gain18.a
    bus gain13-audio-plus19-a gain13.audio -> plus19.a
    bus gain18-audio-plus19-b gain18.audio -> plus19.b
    bus plus12-audio-times20-a plus12.audio -> times20.a
    bus plus19-audio-times20-b plus19.audio -> times20.b
    bus times20-audio-gain21-a times20.audio -> gain21.a
    bus velocity-tone-audio-plus22-a velocity-tone.audio -> plus22.a
    bus gain21-audio-plus22-b gain21.audio -> plus22.b
    bus plus22-audio-hi-23-audio plus22.audio -> hi-23.audio
    bus hi-23-audio-body24-audio hi-23.audio -> body24.audio
    bus note-pitch-body24-pitch note.pitch -> body24.pitch
    bus note-gate-body24-gate note.gate -> body24.gate
    bus hi-23-audio-body25-audio hi-23.audio -> body25.audio
    bus note-pitch-body25-pitch note.pitch -> body25.pitch
    bus note-gate-body25-gate note.gate -> body25.gate
    bus body25-audio-gain26-a body25.audio -> gain26.a
    bus body24-audio-plus27-a body24.audio -> plus27.a
    bus gain26-audio-plus27-b gain26.audio -> plus27.b
    bus plus27-audio-dynamics-gain-a plus27.audio -> dynamics-gain.a
    bus dynamics-gain-audio-hi-28-audio dynamics-gain.audio -> hi-28.audio
    bus hi-28-audio-hi-29-audio hi-28.audio -> hi-29.audio
    bus hi-29-audio-register-a hi-29.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile bass-trombone-body {
  root 261.626hz
  mode m0 frequency 183.526hz decay 0.00433602s gain 0.00814253 after_decay 0.00433602s after_gain 0
  mode m1 frequency 283.101hz decay 0.00281092s gain 0.0233326 after_decay 0.00281092s after_gain 0
  mode m2 frequency 673.64hz decay 0.00118131s gain 0.581162 after_decay 0.00118131s after_gain 0
  mode m3 frequency 1602.93hz decay 0.000496451s gain 0.986427 after_decay 0.000496451s after_gain 0
  mode m4 frequency 3814.16hz decay 0.000208637s gain 0.239375 after_decay 0.000208637s after_gain 0
  mode m5 frequency 9075.8hz decay 0.0001s gain 0.103149 after_decay 0.0001s after_gain 0
}
profile bass-trombone-body-between {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.00378986 after_decay 0.0159155s after_gain 0
  mode m1 frequency 77.1282hz decay 0.0103176s gain 0.00370662 after_decay 0.0103176s after_gain 0
  mode m2 frequency 118.975hz decay 0.00668859s gain 0.00162659 after_decay 0.00668859s after_gain 0
  mode m3 frequency 436.701hz decay 0.00182224s gain 0.319398 after_decay 0.00182224s after_gain 0
  mode m4 frequency 1039.13hz decay 0.000765808s gain 1 after_decay 0.000765808s after_gain 0
  mode m5 frequency 2472.61hz decay 0.000321835s gain 0.574872 after_decay 0.000321835s after_gain 0
  mode m6 frequency 5883.59hz decay 0.000135253s gain 0.124315 after_decay 0.000135253s after_gain 0
  mode m7 frequency 14000hz decay 0.0001s gain 0.0741672 after_decay 0.0001s after_gain 0
}
