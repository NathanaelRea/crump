crump-module 2
instrument bass-trombone "Bass Trombone" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z28-soft-0 asset bass-trombone-28-soft-0 keys E1 G1 velocity 0 0.65 root E1 loop 48000 124918 crossfade 8160
      zone z28-hard-0 asset bass-trombone-28-hard-0 keys E1 G1 velocity 0.65 1 root E1 loop 48000 123752 crossfade 8160
      zone z34-soft-0 asset bass-trombone-34-soft-0 keys G#1 C#2 velocity 0 0.65 root A#1 loop 48000 123697 crossfade 8160
      zone z34-hard-0 asset bass-trombone-34-hard-0 keys G#1 C#2 velocity 0.65 1 root A#1 loop 48000 125344 crossfade 8160
      zone z40-soft-0 asset bass-trombone-40-soft-0 keys D2 G2 velocity 0 0.65 root E2 loop 48000 123765 crossfade 8160
      zone z40-hard-0 asset bass-trombone-40-hard-0 keys D2 G2 velocity 0.65 1 root E2 loop 48000 125509 crossfade 8160
      zone z46-soft-0 asset bass-trombone-46-soft-0 keys G#2 C#3 velocity 0 0.65 root A#2 loop 48000 123733 crossfade 8160
      zone z46-hard-0 asset bass-trombone-46-hard-0 keys G#2 C#3 velocity 0.65 1 root A#2 loop 48000 123734 crossfade 8160
      zone z52-soft-0 asset bass-trombone-52-soft-0 keys D3 G3 velocity 0 0.65 root E3 loop 48000 123706 crossfade 8160
      zone z52-hard-0 asset bass-trombone-52-hard-0 keys D3 G3 velocity 0.65 1 root E3 loop 48000 125745 crossfade 8160
      zone z58-soft-0 asset bass-trombone-58-soft-0 keys G#3 C#4 velocity 0 0.65 root A#3 loop 48000 125943 crossfade 8160
      zone z58-hard-0 asset bass-trombone-58-hard-0 keys G#3 C#4 velocity 0.65 1 root A#3 loop 48000 123680 crossfade 8160
      zone z64-soft-0 asset bass-trombone-64-soft-0 keys D4 F4 velocity 0 0.65 root E4 loop 48000 123739 crossfade 8160
      zone z64-hard-0 asset bass-trombone-64-hard-0 keys D4 F4 velocity 0.65 1 root E4 loop 48000 123739 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
