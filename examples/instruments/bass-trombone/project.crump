crump 2
import "instrument.crump"
project "Bass Trombone" {
  id example-bass-trombone
  seed 1385825
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat F2 2beat 0.48
      note 2beat G2 1beat 0.7
      note 3beat A2 1beat 0.7
      note 4beat C3 3beat 0.92
      note 8beat F2 0.35beat 0.85
      note 8.5beat A2 0.35beat 0.85
      note 9beat C3 0.35beat 0.85
      note 9.5beat F3 0.35beat 0.85
      note 10beat F3 2beat 0.6
      note 12beat C2 3.5beat 0.75
      note 16beat F2 1beat 0.55
      note 17beat G2 1beat 0.6
      note 18beat A2 1beat 0.65
      note 19beat A#2 1beat 0.7
      note 20beat C3 1beat 0.75
      note 21beat D3 1beat 0.8
      note 22beat E3 1beat 0.85
      note 24beat F3 6beat 0.8
    }
    track instrument "Bass Trombone" instrument bass-trombone level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
