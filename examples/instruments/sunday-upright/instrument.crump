crump-module 2
instrument sunday-upright "Sunday Upright" graph {
  polyphony 8
  parameter contact "Contact" seconds 0.00002s 0.003s 0.000173342618871s 0.000173342618871s
  parameter ring "Ring" ratio 0.1 4 1.7976772405 1.7976772405
  parameter brightness "Brightness" ratio -2 2 0.167709025255 0.167709025255
  parameter detail "Detail" ratio 0 1 0.2133768348 0.2133768348
  parameter output-level "Level" ratio 0 2 1 1
  faceplate {
    control output-level "Level" "Output level" maps output-level
    control contact "Contact" "Strike duration" maps contact
    control ring "Ring" "Body decay" maps ring
    control brightness "Brightness" "Resonance tilt" maps brightness
    control detail "Detail" "Overlapping contact layer" maps detail
  }
  graph voice 12 {
    node body-force exciter kind impact contact $contact hardness 0.191577533628 rate 300hz duration 0.075s
    node body modal_bank profile sunday-upright-body max_modes 13 key_track 1 decay_scale $ring brightness $brightness level 1
    node detail-force exciter kind collisions contact 2e-05s hardness 0.2 rate 8000hz duration 0.018s
    node detail modal_bank profile sunday-upright-detail max_modes 28 key_track 0 decay_scale 1.0 brightness 0.0 level 1
    node blend mixer a_level 1 b_level $detail
    node stereo mono_to_stereo
    node out output
    node output-gain mixer a_level 0.0722328736834 b_level 0
    node output-level mixer a_level $output-level b_level 0
    bus body-hit note.gate -> body-force.gate
    bus body-velocity note.velocity -> body-force.velocity
    bus body-gate note.gate -> body.gate
    bus body-pitch note.pitch -> body.pitch
    bus body-input body-force.audio -> body.audio
    bus detail-hit note.gate -> detail-force.gate
    bus detail-velocity note.velocity -> detail-force.velocity
    bus detail-gate note.gate -> detail.gate
    bus detail-pitch note.pitch -> detail.pitch
    bus detail-input detail-force.audio -> detail.audio
    bus main body.audio -> blend.a
    bus detail detail.audio -> blend.b
    bus mono blend.audio -> output-gain.a
    bus output-gain output-gain.audio -> output-level.a
    bus output-level output-level.audio -> stereo.audio
    bus output stereo.audio -> out.audio
  }
}
