crump-module 2
instrument hammered-dulcimer "Hammered Dulcimer" graph {
  polyphony 12
  parameter sustain "Sustain" ratio 0.5 0.99999 0.992373 0.992373 modulatable
  parameter length "String length 1" ratio 0.5 1.1 0.98807967 0.98807967 modulatable
  parameter length2 "String length 2" ratio 0.5 1.1 0.98716691 0.98716691 modulatable
  parameter length3 "String length 3" ratio 0.5 1.1 0.98882191 0.98882191 modulatable
  parameter register "Register level" ratio 0.05 20 0.749894 0.749894 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source sustain-curve key_curve per_voice bipolar {
      point c2 key C2 value -0.498888
      point c4 key C4 value 0
      point c6 key C6 value 1
    }
    source length-curve key_curve per_voice unipolar {
      point c1 key C1 value 0
      point c3 key C3 value 0.0863656
      point c4 key C4 value 0.38972
      point fs4 key F#4 value 0.679557
      point c5 key C5 value 1
      point fs5 key F#5 value 0.972615
      point c6 key C6 value 0.933819
      point fs6 key F#6 value 0.878763
      point c8 key C8 value 0.524394
    }
    source length2-curve key_curve per_voice unipolar {
      point c1 key C1 value 0
      point c3 key C3 value 0.0863656
      point c4 key C4 value 0.38972
      point fs4 key F#4 value 0.679557
      point c5 key C5 value 1
      point fs5 key F#5 value 0.972615
      point c6 key C6 value 0.933819
      point fs6 key F#6 value 0.878763
      point c8 key C8 value 0.524394
    }
    source length3-curve key_curve per_voice unipolar {
      point c1 key C1 value 0
      point c3 key C3 value 0.0863656
      point c4 key C4 value 0.38972
      point fs4 key F#4 value 0.679557
      point c5 key C5 value 1
      point fs5 key F#5 value 0.972615
      point c6 key C6 value 0.933819
      point fs6 key F#6 value 0.878763
      point c8 key C8 value 0.524394
    }
    source register-curve key_curve per_voice bipolar {
      point d3 key D3 value 0
      point f3 key F3 value -0.324049
      point gs3 key G#3 value 0.0825364
      point b3 key B3 value 0.0489507
      point d4 key D4 value 0.574638
      point f4 key F4 value 0.597421
      point gs4 key G#4 value 0.764465
      point b4 key B4 value -0.16569
      point d5 key D5 value 0.691224
      point f5 key F5 value 0.972608
      point gs5 key G#5 value 1
      point b5 key B5 value 0.360667
      point d6 key D6 value 0.667367
      point e6 key E6 value 0.301134
    }
    route sustain-by-key source sustain-curve target sustain depth 0.0062218 map bipolar curve linear order 0 bypass false
    route length-by-key source length-curve target length depth 0.011182 map unipolar curve linear order 0 bypass false
    route length2-by-key source length2-curve target length2 depth 0.0111717 map unipolar curve linear order 0 bypass false
    route length3-by-key source length3-curve target length3 depth 0.0111904 map unipolar curve linear order 0 bypass false
    route register-by-key source register-curve target register depth 0.538356 map bipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 41 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.000304968s hardness 0.7 level 1
    node scrape noise level 1
    node scrape-band biquad mode bandpass frequency 4000hz q 0.666667
    node scrape-env envelope mode adsr attack 0.0005s decay 0.003s sustain 0 release 0.003s
    node scrape-env-audio to_audio
    node scrape-burst math operation multiply
    node scrape-level math operation scale amount 0.221628
    node attack sum max_inputs 2
    node finger lowpass mode lowpass cutoff 1519.73hz resonance 0.05 velocity_depth 5786.61hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.04 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.34
    node string delay_line mode pitch ratio $length interpolation lagrange3 max_time 0.05s
    node bridge math operation add
    node loss biquad_chain {
      band loss mode lowpass frequency 20930hz q 0.688985 key_track 1 key_reference 261.626hz
      band stiffness mode allpass frequency 13081.3hz q 0.7 key_track 1 key_reference 261.626hz
    }
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.33
    node string2 delay_line mode pitch ratio $length2 interpolation lagrange3 max_time 0.05s
    node bridge2 math operation add
    node loss2 biquad_chain {
      band loss2 mode lowpass frequency 20930hz q 0.688985 key_track 1 key_reference 261.626hz
      band stiffness2 mode allpass frequency 13081.3hz q 0.7 key_track 1 key_reference 261.626hz
    }
    node trim-loss2 math operation scale amount 0.9998
    node return2 math operation scale amount $sustain
    node share3 math operation scale amount 0.33
    node string3 delay_line mode pitch ratio $length3 interpolation lagrange3 max_time 0.05s
    node bridge3 math operation add
    node loss3 biquad_chain {
      band loss3 mode lowpass frequency 20930hz q 0.688985 key_track 1 key_reference 261.626hz
      band stiffness3 mode allpass frequency 13081.3hz q 0.7 key_track 1 key_reference 261.626hz
    }
    node trim-loss3 math operation scale amount 0.9997
    node return3 math operation scale amount $sustain
    node strings sum max_inputs 3
    node bridge-dc dc_block cutoff 20hz
    node body modal_bank profile hammered-dulcimer-body max_modes 16 key_track 0 decay_scale 1 brightness 0 level 1
    node direct math operation scale amount 0.566483
    node wood math operation scale amount 0.433517
    node radiated math operation add
    node formants biquad_chain {
      band formant1 mode peak frequency 418.908hz q 1.35104 gain 13.3408db
      band formant2 mode peak frequency 4108.5hz q 2.02781 gain -10.168db
      band formant3 mode peak frequency 1014.31hz q 2.49992 gain -14.9587db
      band formant4 mode peak frequency 5618.91hz q 1.21624 gain -9.53281db
      band formant5 mode peak frequency 8384.34hz q 1.18236 gain -11.7285db
      band formant6 mode peak frequency 12000hz q 0.500278 gain 9.79558db
      band formant7 mode lowshelf frequency 572.618hz q 0.7071 gain 13.8593db
      band formant8 mode highshelf frequency 1903.55hz q 0.7071 gain 14.9944db
      band formant9 mode peak frequency 2364.44hz q 2.5 gain 7.5038db
      band formant10 mode peak frequency 544.305hz q 2.5 gain 10.6242db
      band formant11 mode peak frequency 544.02hz q 2.5 gain 10.2438db
      band formant12 mode peak frequency 9798.75hz q 0.5 gain 4.26238db
      band radiation mode highpass frequency 50hz q 0.7071
    }
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.5004
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus scrape-audio-scrape-band-audio scrape.audio -> scrape-band.audio
    bus note-gate-scrape-env-gate note.gate -> scrape-env.gate
    bus scrape-env-control-scrape-env-audio-control scrape-env.control -> scrape-env-audio.control
    bus scrape-band-audio-scrape-burst-a scrape-band.audio -> scrape-burst.a
    bus scrape-env-audio-audio-scrape-burst-b scrape-env-audio.audio -> scrape-burst.b
    bus scrape-burst-audio-scrape-level-a scrape-burst.audio -> scrape-level.a
    bus pluck-audio-attack-inputs pluck.audio -> attack.inputs
    bus scrape-level-audio-attack-inputs scrape-level.audio -> attack.inputs
    bus attack-audio-finger-audio attack.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus note-pitch-loss-key note.pitch -> loss.key
    bus loss-audio-return-a loss.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus note-pitch-loss2-key note.pitch -> loss2.key
    bus loss2-audio-trim-loss2-a loss2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus plucked-audio-share3-a plucked.audio -> share3.a
    bus note-pitch-string3-pitch note.pitch -> string3.pitch
    bus share3-audio-bridge3-a share3.audio -> bridge3.a
    bus return3-audio-bridge3-b return3.audio -> bridge3.b
    bus bridge3-audio-string3-audio bridge3.audio -> string3.audio
    bus string3-audio-loss3-audio string3.audio -> loss3.audio
    bus note-pitch-loss3-key note.pitch -> loss3.key
    bus loss3-audio-trim-loss3-a loss3.audio -> trim-loss3.a
    bus trim-loss3-audio-return3-a trim-loss3.audio -> return3.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus string3-audio-strings-inputs string3.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus bridge-dc-audio-body-audio bridge-dc.audio -> body.audio
    bus note-pitch-body-pitch note.pitch -> body.pitch
    bus note-gate-body-gate note.gate -> body.gate
    bus bridge-dc-audio-direct-a bridge-dc.audio -> direct.a
    bus body-audio-wood-a body.audio -> wood.a
    bus direct-audio-radiated-a direct.audio -> radiated.a
    bus wood-audio-radiated-b wood.audio -> radiated.b
    bus radiated-audio-formants-audio radiated.audio -> formants.audio
    bus formants-audio-register-level-a formants.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile hammered-dulcimer-body {
  root 261.626hz
  mode m0 frequency 137.2hz decay 0.0304256s gain 0.000876456 after_decay 0.0304256s after_gain 0
  mode m1 frequency 274.4hz decay 0.0253546s gain 0.00131468 after_decay 0.0253546s after_gain 0
  mode m2 frequency 329hz decay 0.0202837s gain 0.000821678 after_decay 0.0202837s after_gain 0
  mode m3 frequency 539hz decay 0.0152128s gain 0.00131468 after_decay 0.0152128s after_gain 0
  mode m4 frequency 616hz decay 0.0121702s gain 0.00136946 after_decay 0.0121702s after_gain 0
  mode m5 frequency 777hz decay 0.0101419s gain 0.00147902 after_decay 0.0101419s after_gain 0
  mode m6 frequency 910hz decay 0.00912767s gain 0.00146076 after_decay 0.00912767s after_gain 0
  mode m7 frequency 1106hz decay 0.00811348s gain 0.00143794 after_decay 0.00811348s after_gain 0
  mode m8 frequency 1295hz decay 0.0070993s gain 0.00164336 after_decay 0.0070993s after_gain 0
  mode m9 frequency 1540hz decay 0.00608511s gain 0.00164336 after_decay 0.00608511s after_gain 0
  mode m10 frequency 1890hz decay 0.00507093s gain 0.00197203 after_decay 0.00507093s after_gain 0
  mode m11 frequency 2268hz decay 0.00456383s gain 0.00204506 after_decay 0.00456383s after_gain 0
  mode m12 frequency 2730hz decay 0.00405674s gain 0.00205419 after_decay 0.00405674s after_gain 0
  mode m13 frequency 3360hz decay 0.00354965s gain 0.00206593 after_decay 0.00354965s after_gain 0
  mode m14 frequency 4060hz decay 0.00304256s gain 0.00219114 after_decay 0.00304256s after_gain 0
  mode m15 frequency 4900hz decay 0.00253546s gain 0.00236643 after_decay 0.00253546s after_gain 0
}
