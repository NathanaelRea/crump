crump-module 2
instrument hammered-dulcimer "Hammered Dulcimer" graph {
  polyphony 7
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-level note_key per_voice bipolar reference E4 range 12st
    route key-gain-low source key-level target key-gain depth 0.138332 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth 0.422446 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 19 {
    # Hammered strings: stretched partials on two courses.
    node strike1 exciter kind impact contact 0.000409014s hardness $hardness level 1
    node body2 modal_bank profile hammered-dulcimer-strings max_modes 40 key_track 1 decay_scale $ring brightness 0 level 1
    node hiss3 noise level 1
    node fall4 math operation add
    node fall4-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall4-leak math operation scale amount 0.997399221234
    node times5 math operation multiply
    node lo-6 lowpass mode lowpass cutoff 2600hz resonance 0.308309
    node gain7 math operation scale amount 0.0277128
    node plus8 math operation add
    node body9 modal_bank profile hammered-dulcimer-box max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node gain10 math operation scale amount 0.2
    node plus11 math operation add
    node hi-12 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.142996
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus fall4-audio-fall4-previous-audio fall4.audio -> fall4-previous.audio
    bus strike1-audio-fall4-a strike1.audio -> fall4.a
    bus fall4-previous-audio-fall4-leak-a fall4-previous.audio -> fall4-leak.a
    bus fall4-leak-audio-fall4-b fall4-leak.audio -> fall4.b
    bus hiss3-audio-times5-a hiss3.audio -> times5.a
    bus fall4-audio-times5-b fall4.audio -> times5.b
    bus times5-audio-lo-6-audio times5.audio -> lo-6.audio
    bus lo-6-audio-gain7-a lo-6.audio -> gain7.a
    bus body2-audio-plus8-a body2.audio -> plus8.a
    bus gain7-audio-plus8-b gain7.audio -> plus8.b
    bus plus8-audio-body9-audio plus8.audio -> body9.audio
    bus note-pitch-body9-pitch note.pitch -> body9.pitch
    bus note-gate-body9-gate note.gate -> body9.gate
    bus body9-audio-gain10-a body9.audio -> gain10.a
    bus plus8-audio-plus11-a plus8.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-hi-12-audio plus11.audio -> hi-12.audio
    bus hi-12-audio-register-a hi-12.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile hammered-dulcimer-strings {
  root 261.626hz
  mode m0 frequency 261.165hz decay 2.43478s gain 0.181503 after_decay 2.43478s after_gain 0
  mode m1 frequency 522.393hz decay 2.06374s gain 0.178355 after_decay 2.06374s after_gain 0
