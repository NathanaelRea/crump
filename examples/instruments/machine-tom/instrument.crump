crump-module 2
instrument machine-tom "Machine Tom" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z40-soft-0 asset machine-tom-40-soft-0 keys D2 G2 velocity 0 0.65 root E2
      zone z40-hard-0 asset machine-tom-40-hard-0 keys D2 G2 velocity 0.65 1 root E2
      zone z46-soft-0 asset machine-tom-46-soft-0 keys G#2 C#3 velocity 0 0.65 root A#2
      zone z46-hard-0 asset machine-tom-46-hard-0 keys G#2 C#3 velocity 0.65 1 root A#2
      zone z52-soft-0 asset machine-tom-52-soft-0 keys D3 G3 velocity 0 0.65 root E3
      zone z52-hard-0 asset machine-tom-52-hard-0 keys D3 G3 velocity 0.65 1 root E3
      zone z58-soft-0 asset machine-tom-58-soft-0 keys G#3 C#4 velocity 0 0.65 root A#3
      zone z58-hard-0 asset machine-tom-58-hard-0 keys G#3 C#4 velocity 0.65 1 root A#3
      zone z64-soft-0 asset machine-tom-64-soft-0 keys D4 G4 velocity 0 0.65 root E4
      zone z64-hard-0 asset machine-tom-64-hard-0 keys D4 G4 velocity 0.65 1 root E4
      zone z70-soft-0 asset machine-tom-70-soft-0 keys G#4 C5 velocity 0 0.65 root A#4
      zone z70-hard-0 asset machine-tom-70-hard-0 keys G#4 C5 velocity 0.65 1 root A#4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
