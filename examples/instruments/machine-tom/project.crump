crump 2
import "instrument.crump"
project "Machine Tom" {
  id example-machine-tom
  seed 926523
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat E3 0.25beat 0.92
      note 4beat E3 2beat 0.48
      note 8beat A2 0.5beat 0.85
      note 10beat B3 0.25beat 0.65
      note 12beat E4 0.75beat 0.8
      note 16beat E3 0.4beat 0.75
      note 16.5beat G#3 0.4beat 0.75
      note 17beat B3 0.4beat 0.75
      note 17.5beat E4 0.4beat 0.75
      note 18beat G#4 0.4beat 0.75
      note 18.5beat E4 0.4beat 0.75
      note 19beat B3 0.4beat 0.75
      note 19.5beat G#3 0.4beat 0.75
      note 24beat E3 0.2beat 0.55
      note 24.25beat F#3 0.2beat 0.6
      note 24.5beat G#3 0.2beat 0.65
      note 24.75beat A3 0.2beat 0.55
      note 25beat B3 0.2beat 0.6
      note 25.25beat C#4 0.2beat 0.65
      note 25.5beat D#4 0.2beat 0.55
      note 25.75beat E4 0.2beat 0.6
    }
    track instrument "Machine Tom" instrument machine-tom level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
