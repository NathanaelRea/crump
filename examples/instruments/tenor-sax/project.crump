crump 2
import "instrument.crump"
project "Tenor Sax" {
  id example-tenor-sax
  seed 1243283
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat A#3 2beat 0.48
      note 2beat C4 1beat 0.7
      note 3beat D4 1beat 0.7
      note 4beat F4 3beat 0.92
      note 8beat A#3 0.35beat 0.85
      note 8.5beat D4 0.35beat 0.85
      note 9beat F4 0.35beat 0.85
      note 9.5beat A#4 0.35beat 0.85
      note 10beat A#4 2beat 0.6
      note 12beat F3 3.5beat 0.75
      note 16beat A#3 1beat 0.55
      note 17beat C4 1beat 0.6
      note 18beat D4 1beat 0.65
      note 19beat D#4 1beat 0.7
      note 20beat F4 1beat 0.75
      note 21beat G4 1beat 0.8
      note 22beat A4 1beat 0.85
      note 24beat A#4 6beat 0.8
    }
    track instrument "Tenor Sax" instrument tenor-sax level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
