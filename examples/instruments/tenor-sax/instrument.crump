crump-module 2
instrument tenor-sax "Tenor Sax" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.12s 0.12s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z44-soft-0 asset tenor-sax-44-soft-0 keys G#2 A#2 velocity 0 0.65 root G#2 loop 48000 123676 crossfade 8160
      zone z44-hard-0 asset tenor-sax-44-hard-0 keys G#2 A#2 velocity 0.65 1 root G#2 loop 48000 123676 crossfade 8160
      zone z49-soft-0 asset tenor-sax-49-soft-0 keys B2 D#3 velocity 0 0.65 root C#3 loop 48000 125733 crossfade 8160
      zone z49-hard-0 asset tenor-sax-49-hard-0 keys B2 D#3 velocity 0.65 1 root C#3 loop 48000 125733 crossfade 8160
      zone z54-soft-0 asset tenor-sax-54-soft-0 keys E3 G#3 velocity 0 0.65 root F#3 loop 48000 123650 crossfade 8160
      zone z54-hard-0 asset tenor-sax-54-hard-0 keys E3 G#3 velocity 0.65 1 root F#3 loop 48000 123637 crossfade 8160
      zone z59-soft-0 asset tenor-sax-59-soft-0 keys A3 C#4 velocity 0 0.65 root B3 loop 48000 123717 crossfade 8160
      zone z59-hard-0 asset tenor-sax-59-hard-0 keys A3 C#4 velocity 0.65 1 root B3 loop 48000 123732 crossfade 8160
      zone z64-soft-0 asset tenor-sax-64-soft-0 keys D4 F#4 velocity 0 0.65 root E4 loop 48000 124698 crossfade 8160
      zone z64-hard-0 asset tenor-sax-64-hard-0 keys D4 F#4 velocity 0.65 1 root E4 loop 48000 124987 crossfade 8160
      zone z69-soft-0 asset tenor-sax-69-soft-0 keys G4 B4 velocity 0 0.65 root A4 loop 48000 123695 crossfade 8160
      zone z69-hard-0 asset tenor-sax-69-hard-0 keys G4 B4 velocity 0.65 1 root A4 loop 48000 124459 crossfade 8160
      zone z74-soft-0 asset tenor-sax-74-soft-0 keys C5 E5 velocity 0 0.65 root D5 loop 48000 123610 crossfade 8160
      zone z74-hard-0 asset tenor-sax-74-hard-0 keys C5 E5 velocity 0.65 1 root D5 loop 48000 123610 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
