crump-module 2
instrument tape-strings "Tape Strings" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.490909s 0.490909s modulatable
  parameter release "Release" seconds 0.02s 4s 0.2s 0.2s
  parameter vibrato-depth "Vibrato" ratio 0 2 0.0272727 0.0272727 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control vibrato-depth "Vibrato" "Vibrato depth in semitones" maps vibrato-depth
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-gain-curve key_curve per_voice bipolar {
      point c3 key C3 value 0.231553
      point c4 key C4 value 0
      point c5 key C5 value -1
    }
    route attack-velocity source velocity target attack depth -0.27272727s map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.068181818 map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(1.725) order 0 bypass false
    route key-gain-by-key source key-gain-curve target key-gain depth 0.227659 map bipolar curve linear order 0 bypass false
  }
  graph voice 54 {
    # A blown, bowed or sung tone: a saw through a fixed resonator bank fitted to the body.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node vibrato lfo waveform sine rate 5.5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-wait envelope mode ahdsr attack 0s hold 0.2s decay 0.3s sustain 0 release 0.3s
    node vibrato-wait-audio to_audio
    node vibrato-ramp math operation scale amount -1
    node vibrato-in math operation offset amount 1
    node times1 math operation multiply
    node gain2 math operation scale amount $vibrato-depth
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain3 math operation scale amount 0.02
    node plus4 math operation add
    node reed analog_oscillator waveform saw coarse 0st level 1.41421 velocity_amount 0 unison 3 detune 0.09st blend 1 width 0 fm_depth 1st
    node reed-mono stereo_to_mono
    node velocity-tone lowpass mode lowpass cutoff 30hz resonance 0.308309 velocity_depth 21000hz
    node breath noise level 1
    node hi-5 lowpass mode highpass cutoff 1500hz resonance 0.308309
    node lo-6 lowpass mode lowpass cutoff 8000hz resonance 0.308309
    node breath-amp to_audio
    node gain7 math operation scale amount 1
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node fall8 onepole mode leak time 5s
    node fall9 onepole mode leak time 0.01197s
    node gain10 math operation scale amount -1
    node plus11 math operation add
    node gain12 math operation scale amount 11
    node plus13 math operation add
    node times14 math operation multiply
    node gain15 math operation scale amount 0.00213717
    node plus16 math operation add
    node hi-17 lowpass mode highpass cutoff 400hz resonance 0.308309
    node lo-18 lowpass mode lowpass cutoff 5000hz resonance 0.308309
    node body19 modal_bank profile tape-strings-body max_modes 13 key_track 0 decay_scale $ring brightness 0 level 1
    node dynamics-gain math operation scale amount $dynamics
    node hi-20 lowpass mode highpass cutoff 32hz resonance 0.308309
    node wow lfo waveform sine rate 0.55hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node flutter lfo waveform sine rate 7.3hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node wow-audio to_audio
    node flutter-audio to_audio
    node gain21 math operation scale amount 0.208963
    node gain22 math operation scale amount 0.00787191
    node plus23 math operation add
    node tape-head delay_line mode time time 0.004s mod_depth 1 interpolation lagrange3 max_time 10ms
    node lo-24 lowpass mode lowpass cutoff 6500hz resonance 0.308309
    node lo-25 lowpass mode lowpass cutoff 6500hz resonance 0.308309
    node hi-26 lowpass mode highpass cutoff 90hz resonance 0.308309
    node shape27 shaper curve tanh drive 0.0648993 bias 0
    node gain28 math operation scale amount 26.7489
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.050459
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-wait-gate note.gate -> vibrato-wait.gate
    bus vibrato-wait-control-vibrato-wait-audio-control vibrato-wait.control -> vibrato-wait-audio.control
    bus vibrato-wait-audio-audio-vibrato-ramp-a vibrato-wait-audio.audio -> vibrato-ramp.a
    bus vibrato-ramp-audio-vibrato-in-a vibrato-ramp.audio -> vibrato-in.a
    bus vibrato-audio-audio-times1-a vibrato-audio.audio -> times1.a
    bus vibrato-in-audio-times1-b vibrato-in.audio -> times1.b
    bus times1-audio-gain2-a times1.audio -> gain2.a
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain3-a drift-audio.audio -> gain3.a
    bus gain2-audio-plus4-a gain2.audio -> plus4.a
    bus gain3-audio-plus4-b gain3.audio -> plus4.b
    bus note-pitch-reed-pitch note.pitch -> reed.pitch
    bus note-velocity-reed-velocity note.velocity -> reed.velocity
    bus plus4-audio-reed-fm plus4.audio -> reed.fm
    bus amplitude-control-reed-gain amplitude.control -> reed.gain
    bus reed-audio-reed-mono-audio reed.audio -> reed-mono.audio
    bus reed-mono-audio-velocity-tone-audio reed-mono.audio -> velocity-tone.audio
    bus note-velocity-velocity-tone-velocity note.velocity -> velocity-tone.velocity
    bus breath-audio-hi-5-audio breath.audio -> hi-5.audio
    bus hi-5-audio-lo-6-audio hi-5.audio -> lo-6.audio
    bus amplitude-control-breath-amp-control amplitude.control -> breath-amp.control
    bus breath-amp-audio-gain7-a breath-amp.audio -> gain7.a
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus onset-audio-fall8-audio onset.audio -> fall8.audio
    bus onset-audio-fall9-audio onset.audio -> fall9.audio
    bus fall9-audio-gain10-a fall9.audio -> gain10.a
    bus fall8-audio-plus11-a fall8.audio -> plus11.a
    bus gain10-audio-plus11-b gain10.audio -> plus11.b
    bus plus11-audio-gain12-a plus11.audio -> gain12.a
    bus gain7-audio-plus13-a gain7.audio -> plus13.a
    bus gain12-audio-plus13-b gain12.audio -> plus13.b
    bus lo-6-audio-times14-a lo-6.audio -> times14.a
    bus plus13-audio-times14-b plus13.audio -> times14.b
    bus times14-audio-gain15-a times14.audio -> gain15.a
    bus velocity-tone-audio-plus16-a velocity-tone.audio -> plus16.a
    bus gain15-audio-plus16-b gain15.audio -> plus16.b
    bus plus16-audio-hi-17-audio plus16.audio -> hi-17.audio
    bus hi-17-audio-lo-18-audio hi-17.audio -> lo-18.audio
    bus lo-18-audio-body19-audio lo-18.audio -> body19.audio
    bus note-pitch-body19-pitch note.pitch -> body19.pitch
    bus note-gate-body19-gate note.gate -> body19.gate
    bus body19-audio-dynamics-gain-a body19.audio -> dynamics-gain.a
    bus dynamics-gain-audio-hi-20-audio dynamics-gain.audio -> hi-20.audio
    bus wow-control-wow-audio-control wow.control -> wow-audio.control
    bus flutter-control-flutter-audio-control flutter.control -> flutter-audio.control
    bus wow-audio-audio-gain21-a wow-audio.audio -> gain21.a
    bus flutter-audio-audio-gain22-a flutter-audio.audio -> gain22.a
    bus gain21-audio-plus23-a gain21.audio -> plus23.a
    bus gain22-audio-plus23-b gain22.audio -> plus23.b
    bus hi-20-audio-tape-head-audio hi-20.audio -> tape-head.audio
    bus plus23-audio-tape-head-time-mod plus23.audio -> tape-head.time_mod
    bus tape-head-audio-lo-24-audio tape-head.audio -> lo-24.audio
    bus lo-24-audio-lo-25-audio lo-24.audio -> lo-25.audio
    bus lo-25-audio-hi-26-audio lo-25.audio -> hi-26.audio
    bus hi-26-audio-shape27-audio hi-26.audio -> shape27.audio
    bus shape27-audio-gain28-a shape27.audio -> gain28.a
    bus gain28-audio-register-a gain28.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile tape-strings-body {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.0293405 after_decay 0.0159155s after_gain 0
  mode m1 frequency 77.1282hz decay 0.0103176s gain 0.025303 after_decay 0.0103176s after_gain 0
  mode m2 frequency 118.975hz decay 0.00668859s gain 0.0207078 after_decay 0.00668859s after_gain 0
  mode m3 frequency 183.526hz decay 0.00433602s gain 0.00928566 after_decay 0.00433602s after_gain 0
  mode m4 frequency 283.101hz decay 0.00281092s gain 0.0391368 after_decay 0.00281092s after_gain 0
  mode m5 frequency 436.701hz decay 0.00182224s gain 0.033814 after_decay 0.00182224s after_gain 0
  mode m6 frequency 673.64hz decay 0.00118131s gain 0.0171344 after_decay 0.00118131s after_gain 0
  mode m7 frequency 1602.93hz decay 0.000496451s gain 0.0459016 after_decay 0.000496451s after_gain 0
  mode m8 frequency 2472.61hz decay 0.000321835s gain 0.100839 after_decay 0.000321835s after_gain 0
  mode m9 frequency 3814.16hz decay 0.000208637s gain 0.348959 after_decay 0.000208637s after_gain 0
  mode m10 frequency 5883.59hz decay 0.000135253s gain 1 after_decay 0.000135253s after_gain 0
  mode m11 frequency 9075.8hz decay 0.0001s gain 0.474964 after_decay 0.0001s after_gain 0
  mode m12 frequency 14000hz decay 0.0001s gain 0.683993 after_decay 0.0001s after_gain 0
}
