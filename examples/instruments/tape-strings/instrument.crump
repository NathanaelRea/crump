crump-module 2
instrument tape-strings "Tape Strings" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.2s 0.2s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z43-soft-0 asset tape-strings-43-soft-0 keys G2 A#2 velocity 0 0.65 root G2
      zone z43-hard-0 asset tape-strings-43-hard-0 keys G2 A#2 velocity 0.65 1 root G2
      zone z49-soft-0 asset tape-strings-49-soft-0 keys B2 E3 velocity 0 0.65 root C#3
      zone z49-hard-0 asset tape-strings-49-hard-0 keys B2 E3 velocity 0.65 1 root C#3
      zone z55-soft-0 asset tape-strings-55-soft-0 keys F3 A#3 velocity 0 0.65 root G3
      zone z55-hard-0 asset tape-strings-55-hard-0 keys F3 A#3 velocity 0.65 1 root G3
      zone z61-soft-0 asset tape-strings-61-soft-0 keys B3 E4 velocity 0 0.65 root C#4
      zone z61-hard-0 asset tape-strings-61-hard-0 keys B3 E4 velocity 0.65 1 root C#4
      zone z67-soft-0 asset tape-strings-67-soft-0 keys F4 A#4 velocity 0 0.65 root G4
      zone z67-hard-0 asset tape-strings-67-hard-0 keys F4 A#4 velocity 0.65 1 root G4
      zone z73-soft-0 asset tape-strings-73-soft-0 keys B4 F5 velocity 0 0.65 root C#5
      zone z73-hard-0 asset tape-strings-73-hard-0 keys B4 F5 velocity 0.65 1 root C#5
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
