crump-module 2
instrument crunch-guitar "Crunch Guitar" graph {
  polyphony 8
  parameter sustain "Sustain" ratio 0.5 0.99999 0.995919 0.995919 modulatable
  parameter length "String length 1" ratio 0.5 1.1 0.99246223 0.99246223 modulatable
  parameter length2 "String length 2" ratio 0.5 1.1 0.99217564 0.99217564 modulatable
  parameter room "Room" ratio 0 1 0.164489 0.164489
  parameter register "Register level" ratio 0.05 20 1.02329 1.02329 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control sustain "Sustain" "How long the string rings" maps sustain
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-c4-24 note_key per_voice bipolar reference C4 range 24st
    source key-from-c1-24 note_key per_voice bipolar reference C1 range 24st
    source key-from-c3-12 note_key per_voice bipolar reference C3 range 12st
    source key-from-c4-6 note_key per_voice bipolar reference C4 range 6st
    source key-from-fs4-6 note_key per_voice bipolar reference F#4 range 6st
    source key-from-c5-6 note_key per_voice bipolar reference C5 range 6st
    source key-from-fs5-6 note_key per_voice bipolar reference F#5 range 6st
    source key-from-c6-6 note_key per_voice bipolar reference C6 range 6st
    source key-from-fs6-18 note_key per_voice bipolar reference F#6 range 18st
    source key-from-e2-3 note_key per_voice bipolar reference E2 range 3st
    source key-from-g2-3 note_key per_voice bipolar reference G2 range 3st
    source key-from-as2-3 note_key per_voice bipolar reference A#2 range 3st
    source key-from-cs3-3 note_key per_voice bipolar reference C#3 range 3st
    source key-from-e3-3 note_key per_voice bipolar reference E3 range 3st
    source key-from-g3-3 note_key per_voice bipolar reference G3 range 3st
    source key-from-as3-3 note_key per_voice bipolar reference A#3 range 3st
    source key-from-cs4-3 note_key per_voice bipolar reference C#4 range 3st
    source key-from-e4-3 note_key per_voice bipolar reference E4 range 3st
    source key-from-g4-3 note_key per_voice bipolar reference G4 range 3st
    source key-from-as4-3 note_key per_voice bipolar reference A#4 range 3st
    source key-from-cs5-3 note_key per_voice bipolar reference C#5 range 3st
    source key-from-e5-3 note_key per_voice bipolar reference E5 range 3st
    source key-from-g5-3 note_key per_voice bipolar reference G5 range 3st
    source key-from-as5-3 note_key per_voice bipolar reference A#5 range 3st
    source key-from-cs6-1 note_key per_voice bipolar reference C#6 range 1st
    source velocity note_velocity per_voice unipolar
    route sustain-low source key-c4-24 target sustain depth -0.00309474 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route sustain-high source key-c4-24 target sustain depth -0.000745627 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-1 source key-from-c1-24 target length depth 0.0006369689 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-2 source key-from-c3-12 target length depth 0.0021967266 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-3 source key-from-c4-6 target length depth 0.003400245 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-4 source key-from-fs4-6 target length depth 0.00081423675 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-5 source key-from-c5-6 target length depth -0.00020306657 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-6 source key-from-fs5-6 target length depth -0.00028767648 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-7 source key-from-c6-6 target length depth -0.00040824673 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length-8 source key-from-fs6-18 target length depth -0.0026277102 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-1 source key-from-c1-24 target length2 depth 0.00063678497 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-2 source key-from-c3-12 target length2 depth 0.0021960923 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-3 source key-from-c4-6 target length2 depth 0.0033992631 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-4 source key-from-fs4-6 target length2 depth 0.00081400162 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-5 source key-from-c5-6 target length2 depth -0.00020300793 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-6 source key-from-fs5-6 target length2 depth -0.00028759341 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-7 source key-from-c6-6 target length2 depth -0.00040812884 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route length2-8 source key-from-fs6-18 target length2 depth -0.0026269514 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-1 source key-from-e2-3 target register depth -0.692162 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-2 source key-from-g2-3 target register depth 0.292604 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-3 source key-from-as2-3 target register depth 0.161501 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-4 source key-from-cs3-3 target register depth -0.0439254 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-5 source key-from-e3-3 target register depth 0.330209 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-6 source key-from-g3-3 target register depth -0.159508 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-7 source key-from-as3-3 target register depth 0.223 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-8 source key-from-cs4-3 target register depth -0.135011 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-9 source key-from-e4-3 target register depth 0.023293 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-10 source key-from-g4-3 target register depth -0.0117135 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-11 source key-from-as4-3 target register depth -0.0565869 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-12 source key-from-cs5-3 target register depth 0.154182 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-13 source key-from-e5-3 target register depth 0.0657227 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-14 source key-from-g5-3 target register depth -0.0528791 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-15 source key-from-as5-3 target register depth -0.251055 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route register-16 source key-from-cs6-1 target register depth 0.200556 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve linear order 0 bypass false
  }
  graph voice 61 {
    # A plucked string: a pitch-tracked loop that loses its upper partials first, then the body.
    node pluck exciter kind impact contact 0.00053214s hardness 0.4 level 1
    node released onepole mode leak time 0.02s
    node released-dc dc_block cutoff 25hz
    node finger lowpass mode lowpass cutoff 2352.53hz resonance 0.05 velocity_depth 5420.69hz key_track 0.3 key_reference 261.626hz
    node position delay_line mode pitch ratio 0.189187 interpolation lagrange3 max_time 0.03s
    node plucked math operation subtract
    node share math operation scale amount 0.6
    node string delay_line mode pitch ratio $length interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node twang envelope mode adsr attack 0s decay 0.08s sustain 0 release 0.08s decay_curve -0.6
    node twang-audio to_audio
    node twang-velocity math operation multiply
    node velocity-audio to_audio
    node twang-amount math operation scale amount -0.00354006
    node bridge math operation add
    node loss linear_phase_lowpass amount 0.606396
    node stiffness biquad mode allpass frequency 15697.5hz q 0.7 key_track 1 key_reference 261.626hz
    node return math operation scale amount $sustain
    node share2 math operation scale amount 0.4
    node string2 delay_line mode pitch ratio $length2 interpolation lagrange3 max_time 0.05s tune_compensation 1 mod_depth 1
    node bridge2 math operation add
    node loss2 linear_phase_lowpass amount 0.606396
    node stiffness2 biquad mode allpass frequency 15697.5hz q 0.7 key_track 1 key_reference 261.626hz
    node trim-loss2 math operation scale amount 0.9995
    node return2 math operation scale amount $sustain
    node strings sum max_inputs 2
    node bridge-dc dc_block cutoff 20hz
    node pickup-delay delay_line mode pitch ratio 0.15 interpolation lagrange3 max_time 0.03s
    node pickup math operation subtract
    node coil biquad mode lowpass frequency 2600hz q 1.3
    node scrape noise level 1
    node knock-env envelope mode adsr attack 0.001s decay 0.4s sustain 0 release 0.4s decay_curve -0.7
    node knock-env-audio to_audio
    node knock-low biquad mode highpass frequency 150hz q 0.7071
    node knock-band biquad mode lowpass frequency 6520.15hz q 0.7071
    node knock-burst math operation multiply
    node knock-velocity math operation multiply
    node knock-level math operation scale amount 0.110788
    node with-knock math operation add
    node preamp math operation scale amount 12
    node valve shaper curve asymmetric drive 4 bias 0.1 asymmetry 0.3
    node valve-dc dc_block cutoff 30hz
    node formant1 biquad mode peak frequency 517.962hz q 0.979019 gain -6.43522db
    node formant2 biquad mode peak frequency 238.588hz q 2 gain -9.3193db
    node formant3 biquad mode peak frequency 366.313hz q 0.918519 gain 12db
    node formant4 biquad mode peak frequency 1828.86hz q 1.3087 gain 4.08178db
    node formant5 biquad mode peak frequency 2751.59hz q 1.35122 gain -8.22516db
    node formant6 biquad mode peak frequency 64.4498hz q 2 gain 7.80911db
    node formant7 biquad mode lowshelf frequency 60hz q 0.7071 gain 4.00706db
    node formant8 biquad mode highshelf frequency 2973.36hz q 0.7071 gain -12db
    node cabinet1 biquad mode highpass frequency 90hz q 0.7
    node cabinet2 biquad mode peak frequency 120hz q 0.9 gain 3db
    node cabinet3 biquad mode peak frequency 2400hz q 1 gain 4db
    node cabinet4 biquad mode lowpass frequency 4800hz q 0.9
    node cabinet5 biquad mode lowpass frequency 6000hz q 0.7
    node radiation biquad mode highpass frequency 80hz q 0.7071
    node register-level math operation scale amount $register
    node dynamics-level math operation scale amount $dynamics
    node trim math operation scale amount 0.129646
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-pluck-gate note.gate -> pluck.gate
    bus note-velocity-pluck-velocity note.velocity -> pluck.velocity
    bus pluck-audio-released-audio pluck.audio -> released.audio
    bus released-audio-released-dc-audio released.audio -> released-dc.audio
    bus released-dc-audio-finger-audio released-dc.audio -> finger.audio
    bus note-velocity-finger-velocity note.velocity -> finger.velocity
    bus note-pitch-finger-key note.pitch -> finger.key
    bus note-pitch-position-pitch note.pitch -> position.pitch
    bus finger-audio-position-audio finger.audio -> position.audio
    bus finger-audio-plucked-a finger.audio -> plucked.a
    bus position-audio-plucked-b position.audio -> plucked.b
    bus plucked-audio-share-a plucked.audio -> share.a
    bus note-pitch-string-pitch note.pitch -> string.pitch
    bus note-gate-twang-gate note.gate -> twang.gate
    bus twang-control-twang-audio-control twang.control -> twang-audio.control
    bus twang-audio-audio-twang-velocity-a twang-audio.audio -> twang-velocity.a
    bus note-velocity-velocity-audio-control note.velocity -> velocity-audio.control
    bus velocity-audio-audio-twang-velocity-b velocity-audio.audio -> twang-velocity.b
    bus twang-velocity-audio-twang-amount-a twang-velocity.audio -> twang-amount.a
    bus twang-amount-audio-string-time-mod twang-amount.audio -> string.time_mod
    bus share-audio-bridge-a share.audio -> bridge.a
    bus return-audio-bridge-b return.audio -> bridge.b
    bus bridge-audio-string-audio bridge.audio -> string.audio
    bus string-audio-loss-audio string.audio -> loss.audio
    bus loss-audio-stiffness-audio loss.audio -> stiffness.audio
    bus note-pitch-stiffness-key note.pitch -> stiffness.key
    bus stiffness-audio-return-a stiffness.audio -> return.a
    bus plucked-audio-share2-a plucked.audio -> share2.a
    bus note-pitch-string2-pitch note.pitch -> string2.pitch
    bus twang-amount-audio-string2-time-mod twang-amount.audio -> string2.time_mod
    bus share2-audio-bridge2-a share2.audio -> bridge2.a
    bus return2-audio-bridge2-b return2.audio -> bridge2.b
    bus bridge2-audio-string2-audio bridge2.audio -> string2.audio
    bus string2-audio-loss2-audio string2.audio -> loss2.audio
    bus loss2-audio-stiffness2-audio loss2.audio -> stiffness2.audio
    bus note-pitch-stiffness2-key note.pitch -> stiffness2.key
    bus stiffness2-audio-trim-loss2-a stiffness2.audio -> trim-loss2.a
    bus trim-loss2-audio-return2-a trim-loss2.audio -> return2.a
    bus string-audio-strings-inputs string.audio -> strings.inputs
    bus string2-audio-strings-inputs string2.audio -> strings.inputs
    bus strings-audio-bridge-dc-audio strings.audio -> bridge-dc.audio
    bus note-pitch-pickup-delay-pitch note.pitch -> pickup-delay.pitch
    bus bridge-dc-audio-pickup-delay-audio bridge-dc.audio -> pickup-delay.audio
    bus bridge-dc-audio-pickup-a bridge-dc.audio -> pickup.a
    bus pickup-delay-audio-pickup-b pickup-delay.audio -> pickup.b
    bus pickup-audio-coil-audio pickup.audio -> coil.audio
    bus note-gate-knock-env-gate note.gate -> knock-env.gate
    bus knock-env-control-knock-env-audio-control knock-env.control -> knock-env-audio.control
    bus scrape-audio-knock-low-audio scrape.audio -> knock-low.audio
    bus knock-low-audio-knock-band-audio knock-low.audio -> knock-band.audio
    bus knock-band-audio-knock-burst-a knock-band.audio -> knock-burst.a
    bus knock-env-audio-audio-knock-burst-b knock-env-audio.audio -> knock-burst.b
    bus knock-burst-audio-knock-velocity-a knock-burst.audio -> knock-velocity.a
    bus velocity-audio-audio-knock-velocity-b velocity-audio.audio -> knock-velocity.b
    bus knock-velocity-audio-knock-level-a knock-velocity.audio -> knock-level.a
    bus coil-audio-with-knock-a coil.audio -> with-knock.a
    bus knock-level-audio-with-knock-b knock-level.audio -> with-knock.b
    bus with-knock-audio-preamp-a with-knock.audio -> preamp.a
    bus preamp-audio-valve-audio preamp.audio -> valve.audio
    bus valve-audio-valve-dc-audio valve.audio -> valve-dc.audio
    bus valve-dc-audio-formant1-audio valve-dc.audio -> formant1.audio
    bus formant1-audio-formant2-audio formant1.audio -> formant2.audio
    bus formant2-audio-formant3-audio formant2.audio -> formant3.audio
    bus formant3-audio-formant4-audio formant3.audio -> formant4.audio
    bus formant4-audio-formant5-audio formant4.audio -> formant5.audio
    bus formant5-audio-formant6-audio formant5.audio -> formant6.audio
    bus formant6-audio-formant7-audio formant6.audio -> formant7.audio
    bus formant7-audio-formant8-audio formant7.audio -> formant8.audio
    bus formant8-audio-cabinet1-audio formant8.audio -> cabinet1.audio
    bus cabinet1-audio-cabinet2-audio cabinet1.audio -> cabinet2.audio
    bus cabinet2-audio-cabinet3-audio cabinet2.audio -> cabinet3.audio
    bus cabinet3-audio-cabinet4-audio cabinet3.audio -> cabinet4.audio
    bus cabinet4-audio-cabinet5-audio cabinet4.audio -> cabinet5.audio
    bus cabinet5-audio-radiation-audio cabinet5.audio -> radiation.audio
    bus radiation-audio-register-level-a radiation.audio -> register-level.a
    bus register-level-audio-dynamics-level-a register-level.audio -> dynamics-level.a
    bus dynamics-level-audio-trim-a dynamics-level.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
  graph shared 2 {
    node room-reverb reverb room 0.35 damping 0.6 mix $room
    node shared-out output
    bus voice-sum voice_sum.audio -> room-reverb.audio
    bus shared-output room-reverb.audio -> shared-out.audio
  }
}
