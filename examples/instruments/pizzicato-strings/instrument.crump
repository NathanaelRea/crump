crump-module 2
instrument pizzicato-strings "Pizzicato Strings" graph {
  polyphony 6
  parameter leak "Leak" ratio 0.99 1 0.999810694 0.999810694 modulatable
  parameter treble "Treble body" ratio 0 1 0 0 modulatable
  parameter bass "Bass body" ratio 0 1 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-range note_key per_voice bipolar reference D#4 range 35st
    source treble note_key per_voice unipolar reference C3 range 16st
    route leak-key source key-range target leak depth -0.00019135835 map bipolar curve linear order 0 bypass false
    route treble-key source treble target treble depth 1 map unipolar curve linear order 0 bypass false
    route bass-key source treble target bass depth -1 map unipolar curve linear order 0 bypass false
  }
  graph voice 64 {
    # Plucked section strings through a body that changes with register.
    node onset exciter kind impact contact 2e-05s hardness 0 level 1
    node held math operation add
    node held-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node held-leak math operation scale amount 1
    node period-later delay_line mode pitch ratio 1 interpolation linear max_time 0.1s
    node period math operation subtract
    node pluck-window shaper curve hard_clip drive 64 bias 0
    node pluck-noise noise level 1
    node pluck math operation multiply
    node pluck-tone lowpass mode lowpass cutoff 1170hz resonance 0.308309 velocity_depth 1690hz
    node course1-in math operation add
    node course1 delay_line mode pitch ratio 1 interpolation lagrange3 tune_compensation 1 max_time 0.1s
    node course1-loss linear_phase_lowpass amount 1
    node course1-keep math operation scale amount 0.99999
    node course1-pickup delay_line mode pitch ratio 0.25 interpolation linear max_time 0.05s
    node course1-out math operation subtract
    node gain1 math operation scale amount 0.7
    node gain2 math operation scale amount 1.19078
    node course2-late delay_line mode time time 0.009s interpolation linear max_time 0.011s
    node course2-in math operation add
    node course2 delay_line mode pitch ratio 1.0034717 interpolation lagrange3 tune_compensation 1 max_time 0.1s
    node course2-loss linear_phase_lowpass amount 1
    node course2-keep math operation scale amount 0.99999
    node course2-pickup delay_line mode pitch ratio 0.250868 interpolation linear max_time 0.05s
    node course2-out math operation subtract
    node gain3 math operation scale amount 0.7
    node gain4 math operation scale amount 0.974279
    node course3-late delay_line mode time time 0.017s interpolation linear max_time 0.019s
    node course3-in math operation add
    node course3 delay_line mode pitch ratio 0.99711605 interpolation lagrange3 tune_compensation 1 max_time 0.1s
    node course3-loss linear_phase_lowpass amount 1
    node course3-keep math operation scale amount 0.99999
    node course3-pickup delay_line mode pitch ratio 0.249279 interpolation linear max_time 0.05s
    node course3-out math operation subtract
    node gain5 math operation scale amount 0.7
    node gain6 math operation scale amount 0.866025
    node mix7 sum max_inputs 3
    node string-tone lowpass mode lowpass cutoff 1170hz resonance 0.308309 velocity_depth 1690hz
    node string-decay math operation add
    node string-decay-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node string-decay-leak math operation scale amount $leak
    node times8 math operation multiply
    node hiss9 noise level 1
    node fall10 math operation add
    node fall10-previous delay_line mode time time 0.01ms interpolation linear max_time 1ms
    node fall10-leak math operation scale amount 0.998265395058
    node times11 math operation multiply
    node hi-12 lowpass mode highpass cutoff 80hz resonance 0.308309
    node lo-13 lowpass mode lowpass cutoff 1500hz resonance 0.308309
    node gain14 math operation scale amount 0.447048
    node plus15 math operation add
    node body16 modal_bank profile pizzicato-strings-low-body max_modes 28 key_track 0 decay_scale $ring brightness 0 level 1
    node gain17 math operation scale amount 1.5758
    node gain18 math operation scale amount $bass
    node body19 modal_bank profile pizzicato-strings-high-body max_modes 28 key_track 0 decay_scale 1 brightness 0 level 1
    node gain20 math operation scale amount 1
    node gain21 math operation scale amount $treble
    node gain22 math operation scale amount 0.3
    node mix23 sum max_inputs 3
    node hi-24 lowpass mode highpass cutoff 22hz resonance 0.308309
    node trim math operation scale amount 0.00138393
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-onset-gate note.gate -> onset.gate
    bus note-velocity-onset-velocity note.velocity -> onset.velocity
    bus held-audio-held-previous-audio held.audio -> held-previous.audio
    bus onset-audio-held-a onset.audio -> held.a
    bus held-previous-audio-held-leak-a held-previous.audio -> held-leak.a
    bus held-leak-audio-held-b held-leak.audio -> held.b
    bus note-pitch-period-later-pitch note.pitch -> period-later.pitch
    bus held-audio-period-later-audio held.audio -> period-later.audio
    bus held-audio-period-a held.audio -> period.a
    bus period-later-audio-period-b period-later.audio -> period.b
    bus period-audio-pluck-window-audio period.audio -> pluck-window.audio
    bus pluck-noise-audio-pluck-a pluck-noise.audio -> pluck.a
    bus pluck-window-audio-pluck-b pluck-window.audio -> pluck.b
    bus pluck-audio-pluck-tone-audio pluck.audio -> pluck-tone.audio
    bus note-velocity-pluck-tone-velocity note.velocity -> pluck-tone.velocity
    bus pluck-tone-audio-course1-in-a pluck-tone.audio -> course1-in.a
    bus note-pitch-course1-pitch note.pitch -> course1.pitch
    bus course1-in-audio-course1-audio course1-in.audio -> course1.audio
    bus course1-audio-course1-loss-audio course1.audio -> course1-loss.audio
    bus course1-loss-audio-course1-keep-a course1-loss.audio -> course1-keep.a
    bus course1-keep-audio-course1-in-b course1-keep.audio -> course1-in.b
    bus note-pitch-course1-pickup-pitch note.pitch -> course1-pickup.pitch
    bus course1-audio-course1-pickup-audio course1.audio -> course1-pickup.audio
    bus course1-audio-course1-out-a course1.audio -> course1-out.a
    bus course1-pickup-audio-gain1-a course1-pickup.audio -> gain1.a
    bus gain1-audio-course1-out-b gain1.audio -> course1-out.b
    bus course1-out-audio-gain2-a course1-out.audio -> gain2.a
    bus pluck-tone-audio-course2-late-audio pluck-tone.audio -> course2-late.audio
    bus course2-late-audio-course2-in-a course2-late.audio -> course2-in.a
    bus note-pitch-course2-pitch note.pitch -> course2.pitch
    bus course2-in-audio-course2-audio course2-in.audio -> course2.audio
    bus course2-audio-course2-loss-audio course2.audio -> course2-loss.audio
    bus course2-loss-audio-course2-keep-a course2-loss.audio -> course2-keep.a
    bus course2-keep-audio-course2-in-b course2-keep.audio -> course2-in.b
    bus note-pitch-course2-pickup-pitch note.pitch -> course2-pickup.pitch
    bus course2-audio-course2-pickup-audio course2.audio -> course2-pickup.audio
    bus course2-audio-course2-out-a course2.audio -> course2-out.a
    bus course2-pickup-audio-gain3-a course2-pickup.audio -> gain3.a
    bus gain3-audio-course2-out-b gain3.audio -> course2-out.b
    bus course2-out-audio-gain4-a course2-out.audio -> gain4.a
    bus pluck-tone-audio-course3-late-audio pluck-tone.audio -> course3-late.audio
    bus course3-late-audio-course3-in-a course3-late.audio -> course3-in.a
    bus note-pitch-course3-pitch note.pitch -> course3.pitch
    bus course3-in-audio-course3-audio course3-in.audio -> course3.audio
    bus course3-audio-course3-loss-audio course3.audio -> course3-loss.audio
    bus course3-loss-audio-course3-keep-a course3-loss.audio -> course3-keep.a
    bus course3-keep-audio-course3-in-b course3-keep.audio -> course3-in.b
    bus note-pitch-course3-pickup-pitch note.pitch -> course3-pickup.pitch
    bus course3-audio-course3-pickup-audio course3.audio -> course3-pickup.audio
    bus course3-audio-course3-out-a course3.audio -> course3-out.a
    bus course3-pickup-audio-gain5-a course3-pickup.audio -> gain5.a
    bus gain5-audio-course3-out-b gain5.audio -> course3-out.b
    bus course3-out-audio-gain6-a course3-out.audio -> gain6.a
    bus gain2-audio-mix7-inputs gain2.audio -> mix7.inputs
    bus gain4-audio-mix7-inputs gain4.audio -> mix7.inputs
    bus gain6-audio-mix7-inputs gain6.audio -> mix7.inputs
    bus mix7-audio-string-tone-audio mix7.audio -> string-tone.audio
    bus note-velocity-string-tone-velocity note.velocity -> string-tone.velocity
    bus string-decay-audio-string-decay-previous-audio string-decay.audio -> string-decay-previous.audio
    bus onset-audio-string-decay-a onset.audio -> string-decay.a
    bus string-decay-previous-audio-string-decay-leak-a string-decay-previous.audio -> string-decay-leak.a
    bus string-decay-leak-audio-string-decay-b string-decay-leak.audio -> string-decay.b
    bus string-tone-audio-times8-a string-tone.audio -> times8.a
    bus string-decay-audio-times8-b string-decay.audio -> times8.b
    bus fall10-audio-fall10-previous-audio fall10.audio -> fall10-previous.audio
    bus onset-audio-fall10-a onset.audio -> fall10.a
    bus fall10-previous-audio-fall10-leak-a fall10-previous.audio -> fall10-leak.a
    bus fall10-leak-audio-fall10-b fall10-leak.audio -> fall10.b
    bus hiss9-audio-times11-a hiss9.audio -> times11.a
    bus fall10-audio-times11-b fall10.audio -> times11.b
    bus times11-audio-hi-12-audio times11.audio -> hi-12.audio
    bus hi-12-audio-lo-13-audio hi-12.audio -> lo-13.audio
    bus lo-13-audio-gain14-a lo-13.audio -> gain14.a
    bus times8-audio-plus15-a times8.audio -> plus15.a
    bus gain14-audio-plus15-b gain14.audio -> plus15.b
    bus plus15-audio-body16-audio plus15.audio -> body16.audio
    bus note-pitch-body16-pitch note.pitch -> body16.pitch
    bus note-gate-body16-gate note.gate -> body16.gate
    bus body16-audio-gain17-a body16.audio -> gain17.a
    bus gain17-audio-gain18-a gain17.audio -> gain18.a
    bus plus15-audio-body19-audio plus15.audio -> body19.audio
    bus note-pitch-body19-pitch note.pitch -> body19.pitch
    bus note-gate-body19-gate note.gate -> body19.gate
    bus body19-audio-gain20-a body19.audio -> gain20.a
    bus gain20-audio-gain21-a gain20.audio -> gain21.a
    bus plus15-audio-gain22-a plus15.audio -> gain22.a
    bus gain22-audio-mix23-inputs gain22.audio -> mix23.inputs
    bus gain18-audio-mix23-inputs gain18.audio -> mix23.inputs
    bus gain21-audio-mix23-inputs gain21.audio -> mix23.inputs
    bus mix23-audio-hi-24-audio mix23.audio -> hi-24.audio
    bus hi-24-audio-trim-a hi-24.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
