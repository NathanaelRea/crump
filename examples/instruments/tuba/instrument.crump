crump-module 2
instrument tuba "Tuba" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.18s 0.18s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z28-soft-0 asset tuba-28-soft-0 keys D1 F#1 velocity 0 0.65 root E1 loop 48000 124871 crossfade 8160
      zone z28-hard-0 asset tuba-28-hard-0 keys D1 F#1 velocity 0.65 1 root E1 loop 48000 124870 crossfade 8160
      zone z33-soft-0 asset tuba-33-soft-0 keys G1 B1 velocity 0 0.65 root A1 loop 48000 125976 crossfade 8160
      zone z33-hard-0 asset tuba-33-hard-0 keys G1 B1 velocity 0.65 1 root A1 loop 48000 124231 crossfade 8160
      zone z38-soft-0 asset tuba-38-soft-0 keys C2 E2 velocity 0 0.65 root D2 loop 48000 125498 crossfade 8160
      zone z38-hard-0 asset tuba-38-hard-0 keys C2 E2 velocity 0.65 1 root D2 loop 48000 125497 crossfade 8160
      zone z43-soft-0 asset tuba-43-soft-0 keys F2 A2 velocity 0 0.65 root G2 loop 48000 125666 crossfade 8160
      zone z43-hard-0 asset tuba-43-hard-0 keys F2 A2 velocity 0.65 1 root G2 loop 48000 125666 crossfade 8160
      zone z48-soft-0 asset tuba-48-soft-0 keys A#2 D3 velocity 0 0.65 root C3 loop 48000 124423 crossfade 8160
      zone z48-hard-0 asset tuba-48-hard-0 keys A#2 D3 velocity 0.65 1 root C3 loop 48000 124790 crossfade 8160
      zone z53-soft-0 asset tuba-53-soft-0 keys D#3 G3 velocity 0 0.65 root F3 loop 48000 125982 crossfade 8160
      zone z53-hard-0 asset tuba-53-hard-0 keys D#3 G3 velocity 0.65 1 root F3 loop 48000 125983 crossfade 8160
      zone z58-soft-0 asset tuba-58-soft-0 keys G#3 C4 velocity 0 0.65 root A#3 loop 48000 125151 crossfade 8160
      zone z58-hard-0 asset tuba-58-hard-0 keys G#3 C4 velocity 0.65 1 root A#3 loop 48000 125973 crossfade 8160
      zone z63-soft-0 asset tuba-63-soft-0 keys C#4 F#4 velocity 0 0.65 root D#4 loop 48000 124177 crossfade 8160
      zone z63-hard-0 asset tuba-63-hard-0 keys C#4 F#4 velocity 0.65 1 root D#4 loop 48000 125873 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
