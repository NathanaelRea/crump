crump-module 2
instrument wood-rim "Wood Rim" graph {
  polyphony 4
  parameter level "Level" ratio 0 1.5 1 1
  parameter hardness "Contact hardness" ratio 0 1 0.5 0.5
  parameter ring "Damping" ratio 0.5 1.5 1 1
  parameter development "Development" ratio 0 1 0.5 0.5 automatable modulatable macro
  parameter grain "Body grain" ratio 0 1.5 1 1
  parameter rise-16 "Resonance development" seconds 0.005s 0.015s 0.005s 0.005s modulatable
  faceplate {
    control level "Level" "Overall instrument level" maps level
    control hardness "Contact hardness" "Shape of the contact force" maps hardness
    control ring "Damping" "Decay scale of the coherently struck resonances" maps ring
    control development "Development" "Buildup of the coherently struck resonances" maps development
    control grain "Body grain" "Independent grain remaining around the lower body" maps grain
  }
  modulation {
    source development-source parameter development instrument unipolar
    route rise-16 source development-source target rise-16 depth 0.01s map unipolar curve linear order 0 bypass false
  }
  graph voice 64 {
    node force-0 exciter kind texture contact 8e-05s hardness $hardness attack 0.004s duration 0.04s level 1
    node band-0 modal_bank profile wood-rim-band-0-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-1 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.075s level 1
    node band-1 modal_bank profile wood-rim-band-1-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-2 exciter kind texture contact 8e-05s hardness $hardness attack 0.02s duration 0.04s level 1
    node band-2 modal_bank profile wood-rim-band-2-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-3 exciter kind texture contact 8e-05s hardness $hardness attack 0.03s duration 0.08s level 1
    node band-3 modal_bank profile wood-rim-band-3-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-4 exciter kind texture contact 8e-05s hardness $hardness attack 0.02s duration 0.04s level 1
    node band-4 modal_bank profile wood-rim-band-4-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-5 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.016s level 1
    node band-5 modal_bank profile wood-rim-band-5-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-6 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.075s level 1
    node band-6 modal_bank profile wood-rim-band-6-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-7 exciter kind texture contact 8e-05s hardness $hardness attack 0.004s duration 0.011s level 1
    node band-7 modal_bank profile wood-rim-band-7-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-8 exciter kind texture contact 8e-05s hardness $hardness attack 0.02s duration 0.04s level 1
    node band-8 modal_bank profile wood-rim-band-8-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-9 exciter kind texture contact 8e-05s hardness $hardness attack 0.004s duration 0.011s level 1
    node band-9 modal_bank profile wood-rim-band-9-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-10 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.016s level 1
    node band-10 modal_bank profile wood-rim-band-10-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-11 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.016s level 1
    node band-11 modal_bank profile wood-rim-band-11-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-12 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.075s level 1
    node band-12 modal_bank profile wood-rim-band-12-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-13 exciter kind texture contact 8e-05s hardness $hardness attack 0.03s duration 0.08s level 1
    node band-13 modal_bank profile wood-rim-band-13-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-14 exciter kind texture contact 8e-05s hardness $hardness attack 0.001s duration 0.007s level 1
    node band-14 modal_bank profile wood-rim-band-14-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-15 exciter kind texture contact 8e-05s hardness $hardness attack 0.008s duration 0.016s level 1
    node band-15 modal_bank profile wood-rim-band-15-profile max_modes 1 key_track 0 rise 0.0s decay_scale 1 level $grain
    node force-16 exciter kind impact contact 8e-05s hardness $hardness attack 0.0s duration 0.025s level 1
    node band-16 modal_bank profile wood-rim-band-16-profile max_modes 4 key_track 0 rise $rise-16 decay_scale $ring level 1
    node sum-0 mixer a_level 1 b_level 1
    node sum-1 mixer a_level 1 b_level 1
    node sum-2 mixer a_level 1 b_level 1
    node sum-3 mixer a_level 1 b_level 1
    node sum-4 mixer a_level 1 b_level 1
    node sum-5 mixer a_level 1 b_level 1
    node sum-6 mixer a_level 1 b_level 1
    node sum-7 mixer a_level 1 b_level 1
    node sum-8 mixer a_level 1 b_level 1
    node sum-9 mixer a_level 1 b_level 1
    node sum-10 mixer a_level 1 b_level 1
    node sum-11 mixer a_level 1 b_level 1
    node sum-12 mixer a_level 1 b_level 1
    node sum-13 mixer a_level 1 b_level 1
    node sum-14 mixer a_level 1 b_level 1
    node sum-17 mixer a_level 1 b_level 1
    node level mixer a_level $level b_level 0
    node lowcut-0 filter mode highpass cutoff 650hz resonance 0 key_track 0
    node lowcut-1 filter mode highpass cutoff 650hz resonance 0 key_track 0
    node stereo mono_to_stereo
    node out output
    node output-gain mixer a_level 0.354813389234 b_level 0
