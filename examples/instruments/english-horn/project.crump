crump 2
import "instrument.crump"
project "English Horn" {
  id example-english-horn
  seed 1259121
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat D4 2beat 0.48
      note 2beat E4 1beat 0.7
      note 3beat F#4 1beat 0.7
      note 4beat A4 3beat 0.92
      note 8beat D4 0.35beat 0.85
      note 8.5beat F#4 0.35beat 0.85
      note 9beat A4 0.35beat 0.85
      note 9.5beat D5 0.35beat 0.85
      note 10beat D5 2beat 0.6
      note 12beat A3 3.5beat 0.75
      note 16beat D4 1beat 0.55
      note 17beat E4 1beat 0.6
      note 18beat F#4 1beat 0.65
      note 19beat G4 1beat 0.7
      note 20beat A4 1beat 0.75
      note 21beat B4 1beat 0.8
      note 22beat C#5 1beat 0.85
      note 24beat D5 6beat 0.8
    }
    track instrument "English Horn" instrument english-horn level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
