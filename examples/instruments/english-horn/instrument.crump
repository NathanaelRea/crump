crump-module 2
instrument english-horn "English Horn" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.15s 0.15s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z52-soft-0 asset english-horn-52-soft-0 keys E3 F#3 velocity 0 0.65 root E3 loop 48000 125185 crossfade 8160
      zone z52-hard-0 asset english-horn-52-hard-0 keys E3 F#3 velocity 0.65 1 root E3 loop 48000 124893 crossfade 8160
      zone z57-soft-0 asset english-horn-57-soft-0 keys G3 B3 velocity 0 0.65 root A3 loop 48000 125796 crossfade 8160
      zone z57-hard-0 asset english-horn-57-hard-0 keys G3 B3 velocity 0.65 1 root A3 loop 48000 125795 crossfade 8160
      zone z62-soft-0 asset english-horn-62-soft-0 keys C4 E4 velocity 0 0.65 root D4 loop 48000 125875 crossfade 8160
      zone z62-hard-0 asset english-horn-62-hard-0 keys C4 E4 velocity 0.65 1 root D4 loop 48000 125880 crossfade 8160
      zone z67-soft-0 asset english-horn-67-soft-0 keys F4 A4 velocity 0 0.65 root G4 loop 48000 123650 crossfade 8160
      zone z67-hard-0 asset english-horn-67-hard-0 keys F4 A4 velocity 0.65 1 root G4 loop 48000 123652 crossfade 8160
      zone z72-soft-0 asset english-horn-72-soft-0 keys A#4 D#5 velocity 0 0.65 root C5 loop 48000 125941 crossfade 8160
      zone z72-hard-0 asset english-horn-72-hard-0 keys A#4 D#5 velocity 0.65 1 root C5 loop 48000 125948 crossfade 8160
      zone z78-soft-0 asset english-horn-78-soft-0 keys E5 G#5 velocity 0 0.65 root F#5 loop 48000 123607 crossfade 8160
      zone z78-hard-0 asset english-horn-78-hard-0 keys E5 G#5 velocity 0.65 1 root F#5 loop 48000 123607 crossfade 8160
      zone z83-soft-0 asset english-horn-83-soft-0 keys A5 C6 velocity 0 0.65 root B5 loop 48000 123617 crossfade 8160
      zone z83-hard-0 asset english-horn-83-hard-0 keys A5 C6 velocity 0.65 1 root B5 loop 48000 125987 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
