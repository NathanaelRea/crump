crump-module 2
instrument celesta "Celesta" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset celesta-60-soft-0 keys A#3 D#4 velocity 0 0.65 root C4
      zone z60-hard-0 asset celesta-60-hard-0 keys A#3 D#4 velocity 0.65 1 root C4
      zone z66-soft-0 asset celesta-66-soft-0 keys E4 A4 velocity 0 0.65 root F#4
      zone z66-hard-0 asset celesta-66-hard-0 keys E4 A4 velocity 0.65 1 root F#4
      zone z72-soft-0 asset celesta-72-soft-0 keys A#4 D#5 velocity 0 0.65 root C5
      zone z72-hard-0 asset celesta-72-hard-0 keys A#4 D#5 velocity 0.65 1 root C5
      zone z78-soft-0 asset celesta-78-soft-0 keys E5 A5 velocity 0 0.65 root F#5
      zone z78-hard-0 asset celesta-78-hard-0 keys E5 A5 velocity 0.65 1 root F#5
      zone z84-soft-0 asset celesta-84-soft-0 keys A#5 D#6 velocity 0 0.65 root C6
      zone z84-hard-0 asset celesta-84-hard-0 keys A#5 D#6 velocity 0.65 1 root C6
      zone z90-soft-0 asset celesta-90-soft-0 keys E6 A6 velocity 0 0.65 root F#6
      zone z90-hard-0 asset celesta-90-hard-0 keys E6 A6 velocity 0.65 1 root F#6
      zone z96-soft-0 asset celesta-96-soft-0 keys A#6 D#7 velocity 0 0.65 root C7
      zone z96-hard-0 asset celesta-96-hard-0 keys A#6 D#7 velocity 0.65 1 root C7
      zone z102-soft-0 asset celesta-102-soft-0 keys E7 C8 velocity 0 0.65 root F#7
      zone z102-hard-0 asset celesta-102-hard-0 keys E7 C8 velocity 0.65 1 root F#7
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
