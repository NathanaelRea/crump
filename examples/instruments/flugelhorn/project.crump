crump 2
import "instrument.crump"
project "Flugelhorn" {
  id example-flugelhorn
  seed 1362068
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat F4 2beat 0.48
      note 2beat G4 1beat 0.7
      note 3beat A4 1beat 0.7
      note 4beat C5 3beat 0.92
      note 8beat F4 0.35beat 0.85
      note 8.5beat A4 0.35beat 0.85
      note 9beat C5 0.35beat 0.85
      note 9.5beat F5 0.35beat 0.85
      note 10beat F5 2beat 0.6
      note 12beat C4 3.5beat 0.75
      note 16beat F4 1beat 0.55
      note 17beat G4 1beat 0.6
      note 18beat A4 1beat 0.65
      note 19beat A#4 1beat 0.7
      note 20beat C5 1beat 0.75
      note 21beat D5 1beat 0.8
      note 22beat E5 1beat 0.85
      note 24beat F5 6beat 0.8
    }
    track instrument "Flugelhorn" instrument flugelhorn level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
