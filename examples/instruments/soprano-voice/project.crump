crump 2
import "instrument.crump"
project "Soprano Voice" {
  id example-soprano-voice
  seed 1449177
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C5 2beat 0.48
      note 2beat D5 1beat 0.7
      note 3beat E5 1beat 0.7
      note 4beat G5 3beat 0.92
      note 8beat C5 0.35beat 0.85
      note 8.5beat E5 0.35beat 0.85
      note 9beat G5 0.35beat 0.85
      note 9.5beat C6 0.35beat 0.85
      note 10beat C6 2beat 0.6
      note 12beat G4 3.5beat 0.75
      note 16beat C5 1beat 0.55
      note 17beat D5 1beat 0.6
      note 18beat E5 1beat 0.65
      note 19beat F5 1beat 0.7
      note 20beat G5 1beat 0.75
      note 21beat A5 1beat 0.8
      note 22beat B5 1beat 0.85
      note 24beat C6 6beat 0.8
    }
    track instrument "Soprano Voice" instrument soprano-voice level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
