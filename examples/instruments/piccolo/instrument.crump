crump-module 2
instrument piccolo "Piccolo" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.18s 0.18s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z74-soft-0 asset piccolo-74-soft-0 keys C5 E5 velocity 0 0.65 root D5 loop 48000 123650 crossfade 8160
      zone z74-hard-0 asset piccolo-74-hard-0 keys C5 E5 velocity 0.65 1 root D5 loop 48000 123648 crossfade 8160
      zone z79-soft-0 asset piccolo-79-soft-0 keys F5 A5 velocity 0 0.65 root G5 loop 48000 125986 crossfade 8160
      zone z79-hard-0 asset piccolo-79-hard-0 keys F5 A5 velocity 0.65 1 root G5 loop 48000 125986 crossfade 8160
      zone z84-soft-0 asset piccolo-84-soft-0 keys A#5 D6 velocity 0 0.65 root C6 loop 48000 123603 crossfade 8160
      zone z84-hard-0 asset piccolo-84-hard-0 keys A#5 D6 velocity 0.65 1 root C6 loop 48000 123602 crossfade 8160
      zone z89-soft-0 asset piccolo-89-soft-0 keys D#6 G6 velocity 0 0.65 root F6 loop 48000 123918 crossfade 8160
      zone z89-hard-0 asset piccolo-89-hard-0 keys D#6 G6 velocity 0.65 1 root F6 loop 48000 123607 crossfade 8160
      zone z94-soft-0 asset piccolo-94-soft-0 keys G#6 C7 velocity 0 0.65 root A#6 loop 48000 123603 crossfade 8160
      zone z94-hard-0 asset piccolo-94-hard-0 keys G#6 C7 velocity 0.65 1 root A#6 loop 48000 123602 crossfade 8160
      zone z99-soft-0 asset piccolo-99-soft-0 keys C#7 F7 velocity 0 0.65 root D#7 loop 48000 125983 crossfade 8160
      zone z99-hard-0 asset piccolo-99-hard-0 keys C#7 F7 velocity 0.65 1 root D#7 loop 48000 123710 crossfade 8160
      zone z104-soft-0 asset piccolo-104-soft-0 keys F#7 C8 velocity 0 0.65 root G#7 loop 48000 125621 crossfade 8160
      zone z104-hard-0 asset piccolo-104-hard-0 keys F#7 C8 velocity 0.65 1 root G#7 loop 48000 125837 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
