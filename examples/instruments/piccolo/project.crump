crump 2
import "instrument.crump"
project "Piccolo" {
  id example-piccolo
  seed 538492
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat D6 2beat 0.48
      note 2beat E6 1beat 0.7
      note 3beat F#6 1beat 0.7
      note 4beat A6 3beat 0.92
      note 8beat D6 0.35beat 0.85
      note 8.5beat F#6 0.35beat 0.85
      note 9beat A6 0.35beat 0.85
      note 9.5beat D7 0.35beat 0.85
      note 10beat D7 2beat 0.6
      note 12beat A5 3.5beat 0.75
      note 16beat D6 1beat 0.55
      note 17beat E6 1beat 0.6
      note 18beat F#6 1beat 0.65
      note 19beat G6 1beat 0.7
      note 20beat A6 1beat 0.75
      note 21beat B6 1beat 0.8
      note 22beat C#7 1beat 0.85
      note 24beat D7 6beat 0.8
    }
    track instrument "Piccolo" instrument piccolo level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
