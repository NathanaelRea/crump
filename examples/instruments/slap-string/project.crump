crump 2
import "instrument.crump"
project "Slap String" {
  id example-slap-string
  seed 277165
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C2 0.25beat 0.92
      note 4beat C2 2beat 0.48
      note 8beat C1 0.5beat 0.85
      note 10beat G2 0.25beat 0.65
      note 12beat C3 0.75beat 0.8
      note 16beat C2 0.2beat 0.75
      note 16.5beat G2 0.2beat 0.75
      note 17beat A#2 0.2beat 0.75
      note 17.5beat D#2 0.2beat 0.75
      note 18beat G2 0.2beat 0.75
      note 18.5beat C2 0.2beat 0.75
    }
    track instrument "Slap String" instrument slap-string level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
