crump-module 2
instrument erhu "Erhu" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.3s 0.3s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z62-soft-0 asset erhu-62-soft-0 keys D4 E4 velocity 0 0.65 root D4 loop 48000 125969 crossfade 8160
      zone z62-hard-0 asset erhu-62-hard-0 keys D4 E4 velocity 0.65 1 root D4 loop 48000 125965 crossfade 8160
      zone z67-soft-0 asset erhu-67-soft-0 keys F4 A4 velocity 0 0.65 root G4 loop 48000 125988 crossfade 8160
      zone z67-hard-0 asset erhu-67-hard-0 keys F4 A4 velocity 0.65 1 root G4 loop 48000 125981 crossfade 8160
      zone z72-soft-0 asset erhu-72-soft-0 keys A#4 D5 velocity 0 0.65 root C5 loop 48000 125608 crossfade 8160
      zone z72-hard-0 asset erhu-72-hard-0 keys A#4 D5 velocity 0.65 1 root C5 loop 48000 125605 crossfade 8160
      zone z77-soft-0 asset erhu-77-soft-0 keys D#5 G5 velocity 0 0.65 root F5 loop 48000 124255 crossfade 8160
      zone z77-hard-0 asset erhu-77-hard-0 keys D#5 G5 velocity 0.65 1 root F5 loop 48000 124323 crossfade 8160
      zone z82-soft-0 asset erhu-82-soft-0 keys G#5 C6 velocity 0 0.65 root A#5 loop 48000 125982 crossfade 8160
      zone z82-hard-0 asset erhu-82-hard-0 keys G#5 C6 velocity 0.65 1 root A#5 loop 48000 123951 crossfade 8160
      zone z87-soft-0 asset erhu-87-soft-0 keys C#6 F6 velocity 0 0.65 root D#6 loop 48000 124086 crossfade 8160
      zone z87-hard-0 asset erhu-87-hard-0 keys C#6 F6 velocity 0.65 1 root D#6 loop 48000 124050 crossfade 8160
      zone z92-soft-0 asset erhu-92-soft-0 keys F#6 A6 velocity 0 0.65 root G#6 loop 48000 124776 crossfade 8160
      zone z92-hard-0 asset erhu-92-hard-0 keys F#6 A6 velocity 0.65 1 root G#6 loop 48000 124961 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
