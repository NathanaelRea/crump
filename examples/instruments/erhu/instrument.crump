crump-module 2
instrument erhu "Erhu" graph {
  polyphony 6
  parameter attack "Attack" seconds 0.003s 1s 0.0305952s 0.0305952s modulatable
  parameter release "Release" seconds 0.01s 3s 0.25s 0.25s
  parameter pressure "Breath" ratio 0 2 0.0235905 0.0235905 modulatable
  parameter vibrato-depth "Vibrato" ratio 0 0.05 0.00148552 0.00148552 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "How quickly the note stops" maps release
    control pressure "Breath" "Breath pressure: louder and brighter" maps pressure
    control vibrato-depth "Vibrato" "Vibrato depth" maps vibrato-depth
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    route attack-velocity source velocity target attack depth 0.0133263s map unipolar curve linear order 0 bypass false
    route pressure-velocity source velocity target pressure depth 0.178425 map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.00660229 map unipolar curve linear order 0 bypass false
  }
  graph voice 39 {
    # A bowed string: stick-slip friction between two string halves.
    node blow envelope mode adsr attack $attack decay 0.08s sustain 1 release $release attack_curve 0.3
    node blow-audio to_audio
    node pressure math operation scale amount $pressure
    node swell lfo waveform sample_hold rate 3.1hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node swell-audio to_audio
    node swell-smooth onepole mode lowpass cutoff 4hz
    node gain1 math operation scale amount 0.03
    node swell-depth math operation scale amount 1
    node swell-gain math operation offset amount 1
    node pressure-live math operation multiply
    node neck delay_line mode pitch ratio 0.889096 interpolation lagrange3 tune_compensation 1 max_time 0.1s mod_depth 1
    node bridge delay_line mode pitch ratio 0.110904 interpolation lagrange3 max_time 0.02s
    node vibrato lfo waveform sine rate 5.5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-wait envelope mode ahdsr attack 0s hold 0.3s decay 0.5s sustain 0 release 0.5s
    node vibrato-wait-audio to_audio
    node vibrato-ramp math operation scale amount -1
    node vibrato-in math operation offset amount 1
    node vibrato-shape math operation multiply
    node vibrato-amount math operation scale amount $vibrato-depth
    node bridge-loss linear_phase_lowpass amount 0.539767
    node bridge-reflection math operation scale amount -0.95
    node nut-reflection math operation scale amount -1
    node string-velocity math operation add
    node slip math operation subtract
    node friction shaper {
      curve table
      drive 1
      bias 0
      point p0 input -1 output 0.0175106
      point p1 input -0.95 output 0.0203082
      point p2 input -0.9 output 0.0236876
      point p3 input -0.85 output 0.0278
      point p4 input -0.8 output 0.0328449
      point p5 input -0.75 output 0.0390879
      point p6 input -0.7 output 0.0468872
      point p7 input -0.65 output 0.0567325
      point p8 input -0.6 output 0.0693031
      point p9 input -0.55 output 0.0855564
      point p10 input -0.5 output 0.106866
      point p11 input -0.45 output 0.135244
      point p12 input -0.4 output 0.173698
      point p13 input -0.35 output 0.226844
      point p14 input -0.3 output 0.301962
      point p15 input -0.25 output 0.410913
      point p16 input -0.2 output 0.573746
      point p17 input -0.15 output 0.825844
      point p18 input -0.1 output 1
      point p19 input -0.05 output 1
      point p20 input 0 output 1
      point p21 input 0.05 output 1
      point p22 input 0.1 output 1
      point p23 input 0.15 output 0.819576
      point p24 input 0.2 output 0.569769
      point p25 input 0.25 output 0.408292
      point p26 input 0.3 output 0.300178
      point p27 input 0.35 output 0.225595
      point p28 input 0.4 output 0.172804
      point p29 input 0.45 output 0.13459
      point p30 input 0.5 output 0.106379
      point p31 input 0.55 output 0.0851872
      point p32 input 0.6 output 0.0690194
      point p33 input 0.65 output 0.0565116
      point p34 input 0.7 output 0.0467131
      point p35 input 0.75 output 0.0389492
      point p36 input 0.8 output 0.0327333
      point p37 input 0.85 output 0.0277094
      point p38 input 0.9 output 0.0236134
      point p39 input 0.95 output 0.020247
      point p40 input 1 output 0.0174597
    }
    node bow-force math operation multiply
    node to-neck math operation add
    node to-bridge math operation add
    node body1 biquad mode peak frequency 322.335hz q 3.0862 gain -11.045db
    node body2 biquad mode peak frequency 2979.43hz q 5.75722 gain -10.4685db
    node body3 biquad mode peak frequency 1966.72hz q 4.07213 gain 10.1268db
    node body4 biquad mode highshelf frequency 2682.33hz q 0.7071 gain -9.45654db
    node radiation biquad mode lowpass frequency 10765.5hz q 0.7071
    node sub-cut biquad mode highpass frequency 145.81hz q 0.7071 key_track 1 key_reference 261.626hz
    node trim math operation scale amount 0.348733
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-blow-gate note.gate -> blow.gate
    bus blow-control-blow-audio-control blow.control -> blow-audio.control
    bus blow-audio-audio-pressure-a blow-audio.audio -> pressure.a
    bus swell-control-swell-audio-control swell.control -> swell-audio.control
    bus swell-audio-audio-swell-smooth-audio swell-audio.audio -> swell-smooth.audio
    bus swell-smooth-audio-gain1-a swell-smooth.audio -> gain1.a
    bus gain1-audio-swell-depth-a gain1.audio -> swell-depth.a
    bus swell-depth-audio-swell-gain-a swell-depth.audio -> swell-gain.a
    bus pressure-audio-pressure-live-a pressure.audio -> pressure-live.a
    bus swell-gain-audio-pressure-live-b swell-gain.audio -> pressure-live.b
    bus note-pitch-neck-pitch note.pitch -> neck.pitch
    bus note-pitch-bridge-pitch note.pitch -> bridge.pitch
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-wait-gate note.gate -> vibrato-wait.gate
    bus vibrato-wait-control-vibrato-wait-audio-control vibrato-wait.control -> vibrato-wait-audio.control
    bus vibrato-wait-audio-audio-vibrato-ramp-a vibrato-wait-audio.audio -> vibrato-ramp.a
    bus vibrato-ramp-audio-vibrato-in-a vibrato-ramp.audio -> vibrato-in.a
    bus vibrato-audio-audio-vibrato-shape-a vibrato-audio.audio -> vibrato-shape.a
    bus vibrato-in-audio-vibrato-shape-b vibrato-in.audio -> vibrato-shape.b
    bus vibrato-shape-audio-vibrato-amount-a vibrato-shape.audio -> vibrato-amount.a
    bus vibrato-amount-audio-neck-time-mod vibrato-amount.audio -> neck.time_mod
    bus bridge-audio-bridge-loss-audio bridge.audio -> bridge-loss.audio
    bus bridge-loss-audio-bridge-reflection-a bridge-loss.audio -> bridge-reflection.a
    bus neck-audio-nut-reflection-a neck.audio -> nut-reflection.a
    bus bridge-reflection-audio-string-velocity-a bridge-reflection.audio -> string-velocity.a
    bus nut-reflection-audio-string-velocity-b nut-reflection.audio -> string-velocity.b
    bus pressure-live-audio-slip-a pressure-live.audio -> slip.a
    bus string-velocity-audio-slip-b string-velocity.audio -> slip.b
    bus slip-audio-friction-audio slip.audio -> friction.audio
    bus friction-audio-bow-force-a friction.audio -> bow-force.a
    bus slip-audio-bow-force-b slip.audio -> bow-force.b
    bus bridge-reflection-audio-to-neck-a bridge-reflection.audio -> to-neck.a
    bus bow-force-audio-to-neck-b bow-force.audio -> to-neck.b
    bus to-neck-audio-neck-audio to-neck.audio -> neck.audio
    bus nut-reflection-audio-to-bridge-a nut-reflection.audio -> to-bridge.a
    bus bow-force-audio-to-bridge-b bow-force.audio -> to-bridge.b
    bus to-bridge-audio-bridge-audio to-bridge.audio -> bridge.audio
    bus bridge-audio-body1-audio bridge.audio -> body1.audio
    bus body1-audio-body2-audio body1.audio -> body2.audio
    bus body2-audio-body3-audio body2.audio -> body3.audio
    bus body3-audio-body4-audio body3.audio -> body4.audio
    bus body4-audio-radiation-audio body4.audio -> radiation.audio
    bus radiation-audio-sub-cut-audio radiation.audio -> sub-cut.audio
    bus note-pitch-sub-cut-key note.pitch -> sub-cut.key
    bus sub-cut-audio-trim-a sub-cut.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
