crump-module 2
instrument viola "Viola" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  parameter attack "Attack" seconds 0.001s 2s 0.002s 0.002s
  parameter release "Release" seconds 0.02s 4s 0.4s 0.4s
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
    control attack "Attack" "Fade-in added to the natural onset" maps attack
    control release "Release" "Fade-out after Note Off" maps release
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z48-soft-0 asset viola-48-soft-0 keys C3 D3 velocity 0 0.65 root C3 loop 48000 125895 crossfade 8160
      zone z48-hard-0 asset viola-48-hard-0 keys C3 D3 velocity 0.65 1 root C3 loop 48000 125895 crossfade 8160
      zone z53-soft-0 asset viola-53-soft-0 keys D#3 G3 velocity 0 0.65 root F3 loop 48000 125958 crossfade 8160
      zone z53-hard-0 asset viola-53-hard-0 keys D#3 G3 velocity 0.65 1 root F3 loop 48000 125960 crossfade 8160
      zone z58-soft-0 asset viola-58-soft-0 keys G#3 C4 velocity 0 0.65 root A#3 loop 48000 123724 crossfade 8160
      zone z58-hard-0 asset viola-58-hard-0 keys G#3 C4 velocity 0.65 1 root A#3 loop 48000 123723 crossfade 8160
      zone z63-soft-0 asset viola-63-soft-0 keys C#4 F4 velocity 0 0.65 root D#4 loop 48000 123707 crossfade 8160
      zone z63-hard-0 asset viola-63-hard-0 keys C#4 F4 velocity 0.65 1 root D#4 loop 48000 123707 crossfade 8160
      zone z68-soft-0 asset viola-68-soft-0 keys F#4 B4 velocity 0 0.65 root G#4 loop 48000 123648 crossfade 8160
      zone z68-hard-0 asset viola-68-hard-0 keys F#4 B4 velocity 0.65 1 root G#4 loop 48000 125961 crossfade 8160
      zone z74-soft-0 asset viola-74-soft-0 keys C5 E5 velocity 0 0.65 root D5 loop 48000 125933 crossfade 8160
      zone z74-hard-0 asset viola-74-hard-0 keys C5 E5 velocity 0.65 1 root D5 loop 48000 125934 crossfade 8160
      zone z79-soft-0 asset viola-79-soft-0 keys F5 A5 velocity 0 0.65 root G5 loop 48000 123618 crossfade 8160
      zone z79-hard-0 asset viola-79-hard-0 keys F5 A5 velocity 0.65 1 root G5 loop 48000 123617 crossfade 8160
      zone z84-soft-0 asset viola-84-soft-0 keys A#5 D6 velocity 0 0.65 root C6 loop 48000 125762 crossfade 8160
      zone z84-hard-0 asset viola-84-hard-0 keys A#5 D6 velocity 0.65 1 root C6 loop 48000 125581 crossfade 8160
      zone z88-soft-0 asset viola-88-soft-0 keys D#6 E6 velocity 0 0.65 root E6 loop 48000 123628 crossfade 8160
      zone z88-hard-0 asset viola-88-hard-0 keys D#6 E6 velocity 0.65 1 root E6 loop 48000 123628 crossfade 8160
    }
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus amplitude amplitude.control -> source.gain
    bus amplitude-gate note.gate -> amplitude.gate
    bus output source.audio -> out.audio
  }
}
