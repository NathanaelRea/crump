crump 2
import "instrument.crump"
project "Viola" {
  id example-viola
  seed 490978
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat C4 2beat 0.48
      note 2beat D4 1beat 0.7
      note 3beat E4 1beat 0.7
      note 4beat G4 3beat 0.92
      note 8beat C4 0.35beat 0.85
      note 8.5beat E4 0.35beat 0.85
      note 9beat G4 0.35beat 0.85
      note 9.5beat C5 0.35beat 0.85
      note 10beat C5 2beat 0.6
      note 12beat G3 3.5beat 0.75
      note 16beat C4 1beat 0.55
      note 17beat D4 1beat 0.6
      note 18beat E4 1beat 0.65
      note 19beat F4 1beat 0.7
      note 20beat G4 1beat 0.75
      note 21beat A4 1beat 0.8
      note 22beat B4 1beat 0.85
      note 24beat C5 6beat 0.8
    }
    track instrument "Viola" instrument viola level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
