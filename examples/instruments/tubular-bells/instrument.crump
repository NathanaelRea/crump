crump-module 2
instrument tubular-bells "Tubular Bells" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset tubular-bells-60-soft-0 keys A#3 D4 velocity 0 0.65 root C4
      zone z60-hard-0 asset tubular-bells-60-hard-0 keys A#3 D4 velocity 0.65 1 root C4
      zone z64-soft-0 asset tubular-bells-64-soft-0 keys D#4 F#4 velocity 0 0.65 root E4
      zone z64-hard-0 asset tubular-bells-64-hard-0 keys D#4 F#4 velocity 0.65 1 root E4
      zone z68-soft-0 asset tubular-bells-68-soft-0 keys G4 A#4 velocity 0 0.65 root G#4
      zone z68-hard-0 asset tubular-bells-68-hard-0 keys G4 A#4 velocity 0.65 1 root G#4
      zone z72-soft-0 asset tubular-bells-72-soft-0 keys B4 D5 velocity 0 0.65 root C5
      zone z72-hard-0 asset tubular-bells-72-hard-0 keys B4 D5 velocity 0.65 1 root C5
      zone z76-soft-0 asset tubular-bells-76-soft-0 keys D#5 G5 velocity 0 0.65 root E5
      zone z76-hard-0 asset tubular-bells-76-hard-0 keys D#5 G5 velocity 0.65 1 root E5
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
