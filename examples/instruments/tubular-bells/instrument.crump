crump-module 2
instrument tubular-bells "Tubular Bells" graph {
  polyphony 8
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter ring "Ring" ratio 0.1 4 1 1
  parameter hardness "Hardness" ratio 0 1 0.3 0.3
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control ring "Ring" "How long the body rings" maps ring
    control hardness "Hardness" "How hard the strike is: brighter when harder" maps hardness
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source key-level note_key per_voice bipolar reference G4 range 12st
    route key-gain-low source key-level target key-gain depth 0.0485464 map bipolar curve linear order 0 bypass false {
      clamp -1 0
    }
    route key-gain-high source key-level target key-gain depth 0.20882 map bipolar curve linear order 0 bypass false {
      clamp 0 1
    }
  }
  graph voice 8 {
    # A mallet on a tuned bar's modes, optionally through a pickup.
    node strike1 exciter kind impact contact 0.0004356s hardness $hardness level 1
    node body2 modal_bank profile tubular-bells-bar max_modes 7 key_track 1 decay_scale $ring brightness 0 level 1
    node hi-3 lowpass mode highpass cutoff 32hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.0872542
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-strike1-gate note.gate -> strike1.gate
    bus note-velocity-strike1-velocity note.velocity -> strike1.velocity
    bus strike1-audio-body2-audio strike1.audio -> body2.audio
    bus note-pitch-body2-pitch note.pitch -> body2.pitch
    bus note-gate-body2-gate note.gate -> body2.gate
    bus body2-audio-hi-3-audio body2.audio -> hi-3.audio
    bus hi-3-audio-register-a hi-3.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile tubular-bells-bar {
  root 261.626hz
  mode m0 frequency 58.1332hz decay 4.72255s gain 0.12 after_decay 4.72255s after_gain 0
  mode m1 frequency 161.501hz decay 2.98186s gain 0.327337 after_decay 2.98186s after_gain 0
  mode m2 frequency 316.541hz decay 2.20279s gain 0.568548 after_decay 2.20279s after_gain 0
  mode m3 frequency 523.251hz decay 1.7569s gain 0.818052 after_decay 1.7569s after_gain 0
  mode m4 frequency 781.659hz decay 1.46659s gain 0.612066 after_decay 1.46659s after_gain 0
  mode m5 frequency 1091.71hz decay 1.26188s gain 0.357771 after_decay 1.26188s after_gain 0
  mode m6 frequency 1453.49hz decay 1.10939s gain 0.167302 after_decay 1.10939s after_gain 0
}
