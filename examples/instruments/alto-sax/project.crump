crump 2
import "instrument.crump"
project "Alto Sax" {
  id example-alto-sax
  seed 1235364
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat D#4 2beat 0.48
      note 2beat F4 1beat 0.7
      note 3beat G4 1beat 0.7
      note 4beat A#4 3beat 0.92
      note 8beat D#4 0.35beat 0.85
      note 8.5beat G4 0.35beat 0.85
      note 9beat A#4 0.35beat 0.85
      note 9.5beat D#5 0.35beat 0.85
      note 10beat D#5 2beat 0.6
      note 12beat A#3 3.5beat 0.75
      note 16beat D#4 1beat 0.55
      note 17beat F4 1beat 0.6
      note 18beat G4 1beat 0.65
      note 19beat G#4 1beat 0.7
      note 20beat A#4 1beat 0.75
      note 21beat C5 1beat 0.8
      note 22beat D5 1beat 0.85
      note 24beat D#5 6beat 0.8
    }
    track instrument "Alto Sax" instrument alto-sax level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
