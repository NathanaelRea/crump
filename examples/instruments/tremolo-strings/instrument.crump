crump-module 2
instrument tremolo-strings "Tremolo Strings" graph {
  polyphony 8
  parameter attack "Attack" seconds 0.002s 2s 0.927273s 0.927273s modulatable
  parameter release "Release" seconds 0.02s 4s 0.4s 0.4s
  parameter vibrato-depth "Vibrato" ratio 0 2 0.0172727 0.0172727 modulatable
  parameter dynamics "Dynamics" ratio 0 1 0 0 modulatable
  parameter key-gain "Register level" ratio 0.05 20 1 1 modulatable
  parameter level "Level" ratio 0 2 1 1
  parameter pan "Pan" pan -1 1 0 0
  faceplate {
    control attack "Attack" "How quickly the note speaks" maps attack
    control release "Release" "Fade-out after Note Off" maps release
    control vibrato-depth "Vibrato" "Vibrato depth in semitones" maps vibrato-depth
    control level "Level" "Output level" maps level
    control pan "Pan" "Stereo position" maps pan
  }
  modulation {
    source velocity note_velocity per_voice unipolar
    source key-gain-curve key_curve per_voice unipolar {
      point c3 key C3 value 1
      point c4 key C4 value 0
      point c5 key C5 value 0.825226
    }
    route attack-velocity source velocity target attack depth -0.68181818s map unipolar curve linear order 0 bypass false
    route vibrato-depth-velocity source velocity target vibrato-depth depth 0.068181818 map unipolar curve linear order 0 bypass false
    route dynamics-velocity source velocity target dynamics depth 1 map unipolar curve power(0.7701) order 0 bypass false
    route key-gain-by-key source key-gain-curve target key-gain depth 0.467616 map unipolar curve linear order 0 bypass false
  }
  graph voice 37 {
    # A bowed string: a Helmholtz saw through a jagged body and the instrument's body curve.
    node amplitude envelope mode adsr attack $attack decay 0.01s sustain 1 release $release attack_curve 0.4
    node vibrato lfo waveform sine rate 5.6hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node vibrato-audio to_audio
    node vibrato-wait envelope mode ahdsr attack 0s hold 0.15s decay 0.35s sustain 0 release 0.35s
    node vibrato-wait-audio to_audio
    node vibrato-ramp math operation scale amount -1
    node vibrato-in math operation offset amount 1
    node times1 math operation multiply
    node gain2 math operation scale amount $vibrato-depth
    node drift lfo waveform triangle rate 0.37hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node drift-audio to_audio
    node gain3 math operation scale amount 0.008
    node plus4 math operation add
    node bow analog_oscillator waveform saw coarse 0st level 1.41421 velocity_amount 0 unison 8 detune 0.06st blend 1 width 0 fm_depth 1st
    node bow-mono stereo_to_mono
    node strokes lfo waveform sine rate 6.5hz depth 1 phase 0 random_phase 1 polarity bipolar retrigger note
    node strokes-audio to_audio
    node bow-reversals math operation abs
    node shape5 shaper {
      curve table
      drive 1
      bias 0
      point p0 input 0 output 0
      point p1 input 0.125 output 0.287175
      point p2 input 0.25 output 0.435275
      point p3 input 0.375 output 0.555161
      point p4 input 0.5 output 0.659754
      point p5 input 0.625 output 0.754272
      point p6 input 0.75 output 0.841466
      point p7 input 0.875 output 0.923007
      point p8 input 1 output 1
    }
    node times6 math operation multiply
    node bow-hiss noise level 1
    node hi-7 lowpass mode highpass cutoff 2200hz resonance 0.308309
    node bow-amp to_audio
    node times8 math operation multiply
    node gain9 math operation scale amount 0.018405
    node plus10 math operation add
    node body11 modal_bank profile tremolo-strings-body-curve max_modes 5 key_track 0 decay_scale 1 brightness 0 level 1
    node body12 modal_bank profile tremolo-strings-body-curve-between max_modes 9 key_track 0 decay_scale 1 brightness 0 level 1
    node gain13 math operation scale amount -1
    node plus14 math operation add
    node dynamics-gain math operation scale amount $dynamics
    node hi-15 lowpass mode highpass cutoff 22hz resonance 0.308309
    node register math operation scale amount $key-gain
    node trim math operation scale amount 0.0275999
    node level math operation scale amount $level
    node place pan position $pan
    node out output
    bus note-gate-amplitude-gate note.gate -> amplitude.gate
    bus vibrato-control-vibrato-audio-control vibrato.control -> vibrato-audio.control
    bus note-gate-vibrato-wait-gate note.gate -> vibrato-wait.gate
    bus vibrato-wait-control-vibrato-wait-audio-control vibrato-wait.control -> vibrato-wait-audio.control
    bus vibrato-wait-audio-audio-vibrato-ramp-a vibrato-wait-audio.audio -> vibrato-ramp.a
    bus vibrato-ramp-audio-vibrato-in-a vibrato-ramp.audio -> vibrato-in.a
    bus vibrato-audio-audio-times1-a vibrato-audio.audio -> times1.a
    bus vibrato-in-audio-times1-b vibrato-in.audio -> times1.b
    bus times1-audio-gain2-a times1.audio -> gain2.a
    bus drift-control-drift-audio-control drift.control -> drift-audio.control
    bus drift-audio-audio-gain3-a drift-audio.audio -> gain3.a
    bus gain2-audio-plus4-a gain2.audio -> plus4.a
    bus gain3-audio-plus4-b gain3.audio -> plus4.b
    bus note-pitch-bow-pitch note.pitch -> bow.pitch
    bus note-velocity-bow-velocity note.velocity -> bow.velocity
    bus plus4-audio-bow-fm plus4.audio -> bow.fm
    bus amplitude-control-bow-gain amplitude.control -> bow.gain
    bus bow-audio-bow-mono-audio bow.audio -> bow-mono.audio
    bus strokes-control-strokes-audio-control strokes.control -> strokes-audio.control
    bus strokes-audio-audio-bow-reversals-a strokes-audio.audio -> bow-reversals.a
    bus bow-reversals-audio-shape5-audio bow-reversals.audio -> shape5.audio
    bus bow-mono-audio-times6-a bow-mono.audio -> times6.a
    bus shape5-audio-times6-b shape5.audio -> times6.b
    bus bow-hiss-audio-hi-7-audio bow-hiss.audio -> hi-7.audio
    bus amplitude-control-bow-amp-control amplitude.control -> bow-amp.control
    bus hi-7-audio-times8-a hi-7.audio -> times8.a
    bus bow-amp-audio-times8-b bow-amp.audio -> times8.b
    bus times8-audio-gain9-a times8.audio -> gain9.a
    bus times6-audio-plus10-a times6.audio -> plus10.a
    bus gain9-audio-plus10-b gain9.audio -> plus10.b
    bus plus10-audio-body11-audio plus10.audio -> body11.audio
    bus note-pitch-body11-pitch note.pitch -> body11.pitch
    bus note-gate-body11-gate note.gate -> body11.gate
    bus plus10-audio-body12-audio plus10.audio -> body12.audio
    bus note-pitch-body12-pitch note.pitch -> body12.pitch
    bus note-gate-body12-gate note.gate -> body12.gate
    bus body12-audio-gain13-a body12.audio -> gain13.a
    bus body11-audio-plus14-a body11.audio -> plus14.a
    bus gain13-audio-plus14-b gain13.audio -> plus14.b
    bus plus14-audio-dynamics-gain-a plus14.audio -> dynamics-gain.a
    bus dynamics-gain-audio-hi-15-audio dynamics-gain.audio -> hi-15.audio
    bus hi-15-audio-register-a hi-15.audio -> register.a
    bus register-audio-trim-a register.audio -> trim.a
    bus trim-audio-level-a trim.audio -> level.a
    bus level-audio-place-audio level.audio -> place.audio
    bus place-audio-out-audio place.audio -> out.audio
  }
}
profile tremolo-strings-body-curve {
  root 261.626hz
  mode m0 frequency 77.1282hz decay 0.0103176s gain 0.00180535 after_decay 0.0103176s after_gain 0
  mode m1 frequency 118.975hz decay 0.00668859s gain 0.00196379 after_decay 0.00668859s after_gain 0
  mode m2 frequency 283.101hz decay 0.00281092s gain 0.0868573 after_decay 0.00281092s after_gain 0
  mode m3 frequency 1602.93hz decay 0.000496451s gain 0.478227 after_decay 0.000496451s after_gain 0
  mode m4 frequency 3814.16hz decay 0.000208637s gain 0.919945 after_decay 0.000208637s after_gain 0
}
profile tremolo-strings-body-curve-between {
  root 261.626hz
  mode m0 frequency 50hz decay 0.0159155s gain 0.00152297 after_decay 0.0159155s after_gain 0
  mode m1 frequency 183.526hz decay 0.00433602s gain 0.0123584 after_decay 0.00433602s after_gain 0
  mode m2 frequency 436.701hz decay 0.00182224s gain 0.104891 after_decay 0.00182224s after_gain 0
  mode m3 frequency 673.64hz decay 0.00118131s gain 0.0777543 after_decay 0.00118131s after_gain 0
  mode m4 frequency 1039.13hz decay 0.000765808s gain 0.0247478 after_decay 0.000765808s after_gain 0
  mode m5 frequency 2472.61hz decay 0.000321835s gain 1 after_decay 0.000321835s after_gain 0
  mode m6 frequency 5883.59hz decay 0.000135253s gain 0.101742 after_decay 0.000135253s after_gain 0
  mode m7 frequency 9075.8hz decay 0.0001s gain 0.0698216 after_decay 0.0001s after_gain 0
  mode m8 frequency 14000hz decay 0.0001s gain 0.203747 after_decay 0.0001s after_gain 0
}
