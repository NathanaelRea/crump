crump 2
import "instrument.crump"
project "Wobble Bass" {
  id example-wobble-bass
  seed 760224
  sample_rate 48000
  render_tail 2s
  song {
    tempo 120bpm
    meter 4/4
    end 8bar
    pattern phrase 8bar {
      note 0beat A1 2beat 0.48
      note 2beat B1 1beat 0.7
      note 3beat C#2 1beat 0.7
      note 4beat E2 3beat 0.92
      note 8beat A1 0.35beat 0.85
      note 8.5beat C#2 0.35beat 0.85
      note 9beat E2 0.35beat 0.85
      note 9.5beat A2 0.35beat 0.85
      note 10beat A2 2beat 0.6
      note 12beat E1 3.5beat 0.75
      note 16beat A1 1beat 0.55
      note 17beat B1 1beat 0.6
      note 18beat C#2 1beat 0.65
      note 19beat D2 1beat 0.7
      note 20beat E2 1beat 0.75
      note 21beat F#2 1beat 0.8
      note 22beat G#2 1beat 0.85
      note 24beat A2 6beat 0.8
    }
    track instrument "Wobble Bass" instrument wobble-bass level 0db pan 0 {
      clip phrase pattern phrase start 0bar duration 8bar mode once
    }
  }
}
