crump-module 2
instrument felt-floor "Felt Floor" graph {
  polyphony 16
  parameter level "Level" ratio 0 1 0.2 0.2
  parameter tune "Tune" semitones -12st 12st 0st 0st
  parameter pan "Pan" pan -1 1 0 0
  parameter touch "Touch" ratio 0 1 0.5 0.5
  faceplate {
    control level "Level" "Output level" maps level
    control tune "Tune" "Repitch the instrument" maps tune
    control pan "Pan" "Stereo position" maps pan
    control touch "Touch" "Velocity amplitude response" maps touch
  }
  graph voice 8 {
    node source multisample {
      playback one_shot
      tune $tune
      rate 1
      velocity_amount $touch
      level $level
      pan $pan
      zone z60-soft-0 asset felt-floor-60-soft-0 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-0 asset felt-floor-60-hard-0 keys C-1 G9 velocity 0.65 1 root C4
      zone z60-soft-1 asset felt-floor-60-soft-1 keys C-1 G9 velocity 0 0.65 root C4
      zone z60-hard-1 asset felt-floor-60-hard-1 keys C-1 G9 velocity 0.65 1 root C4
    }
    node out output
    bus pitch note.pitch -> source.pitch
    bus gate note.gate -> source.gate
    bus velocity note.velocity -> source.velocity
    bus output source.audio -> out.audio
  }
}
asset felt-floor-60-soft-0 "Felt Floor" wav "media/60-soft-0.wav" sha256 "296e694d3b4f328fc7d3462d448f6d75b83ba17aeba0927f4011c3d9f2a221df" {
  usage multisample
}
